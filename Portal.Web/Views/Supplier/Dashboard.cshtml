@model Portal.Infrastructure.Models.SupplierDashboardViewModel
@{
    ViewData["Title"] = "Supplier Dashboard";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Supplier Dashboard</div>
        <h1 class="topbar-heading">@Model.SupplierName</h1>
        <p class="topbar-subtitle">
            Collaboration since @Model.CollaborationSince.ToString("dd MMM yyyy")
        </p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start;">
        @if (Model.IsActive)
        {
            <span class="pill pill-green">Active</span>
        }
        else
        {
            <span class="pill pill-red">Inactive</span>
        }
    </div>
</div>

<!-- Period Filter + KPI Cards (single row) -->
<section style="display:flex;gap:22px;margin-bottom:22px;align-items:stretch;flex-wrap:wrap;">
    <!-- Period Filter -->
    <div class="glass card-pad" style="display:flex;align-items:flex-end;">
        <form method="get" action="/Supplier/Dashboard/@Model.SupplierId" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;margin:0;">
            <div class="field" style="min-width:180px;">
                <label for="periodId">VAT Period</label>
                <select id="periodId" name="periodId">
                    <option value="">All Time</option>
                    @foreach (var period in Model.Periods)
                    {
                        <option value="@period.Id" selected="@(Model.SelectedPeriodId == period.Id)">@period.Label</option>
                    }
                </select>
            </div>
            <div style="padding-bottom:2px;">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a href="/Supplier/Dashboard/@Model.SupplierId" class="btn btn-secondary">Clear</a>
            </div>
        </form>
    </div>

    <!-- KPI Cards -->
    <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #0D5EA6;">
        <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Total Spend (Excl. VAT)</p>
        <h2 style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#0D5EA6;margin:0 0 4px 0;">@Model.CurrencySymbol@Model.TotalSpend.ToString("N2")</h2>
        <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">Across all periods</p>
    </div>
    <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #0D5EA6;">
        <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Total Purchases</p>
        <h2 style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#0D5EA6;margin:0 0 4px 0;">@Model.TotalPurchases</h2>
        <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">Since @Model.CollaborationSince.ToString("MMM yyyy")</p>
    </div>
    <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #0D5EA6;">
        <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Avg Monthly Spend</p>
        <h2 style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#0D5EA6;margin:0 0 4px 0;">@Model.CurrencySymbol@Model.AverageMonthlySpend.ToString("N2")</h2>
        <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">Over @Model.TotalPurchases months</p>
    </div>
</section>

<!-- Charts Section -->
<section style="display:flex;gap:22px;margin-bottom:22px;flex-wrap:wrap;">
    <!-- Spend Share Donut -->
    <div class="glass card-pad" style="flex:1;min-width:280px;max-width:25%;">
        <h3 id="spendShareTitle" style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 14px 0;color:#1a2b3c;">Spend Share</h3>
        <canvas id="spendShareCanvas"></canvas>
        <div class="chart-fallback" style="display:none;">Charts unavailable</div>
    </div>

    <!-- Monthly Spend Bar Chart -->
    <div class="glass card-pad" style="flex:1;min-width:280px;">
        <h3 id="monthlySpendTitle" style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 14px 0;color:#1a2b3c;">Monthly Spend</h3>
        <canvas id="monthlySpendCanvas"></canvas>
        <div class="chart-fallback" style="display:none;">Charts unavailable</div>
    </div>

    <!-- Period Spend Bar Chart -->
    <div class="glass card-pad" style="flex:1;min-width:280px;">
        <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 14px 0;color:#1a2b3c;">Period Spend</h3>
        <canvas id="periodSpendCanvas"></canvas>
        <div class="chart-fallback" style="display:none;">Charts unavailable</div>
    </div>
</section>

<!-- Purchase Filters -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <form method="get" action="/Supplier/Dashboard/@Model.SupplierId" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;margin:0;">
        @if (Model.SelectedPeriodId.HasValue)
        {
            <input type="hidden" name="periodId" value="@Model.SelectedPeriodId" />
        }
        <div class="field" style="min-width:180px;">
            <label for="description">Description</label>
            <input type="text" id="description" name="description" placeholder="Search description..." maxlength="200" value="@Model.FilterDescription" />
        </div>
        <div class="field" style="min-width:180px;">
            <label for="categoryId">Category</label>
            <select id="categoryId" name="categoryId">
                <option value="">All Categories</option>
                @foreach (var cat in Model.ExpenseCategories)
                {
                    <option value="@cat.Id" selected="@(Model.FilterCategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:180px;">
            <label for="dateFrom">From</label>
            <input type="date" id="dateFrom" name="dateFrom" value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field" style="min-width:180px;">
            <label for="dateTo">To</label>
            <input type="date" id="dateTo" name="dateTo" value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" />
        </div>
        <div style="padding-bottom:2px;">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/Supplier/Dashboard/@Model.SupplierId@(Model.SelectedPeriodId.HasValue ? "?periodId=" + Model.SelectedPeriodId : "")" class="btn btn-secondary">Clear</a>
        </div>
    </form>
</section>

<!-- Purchases Table -->
<section class="glass card-pad">
    @{
        var paginationParams = $"periodId={Model.SelectedPeriodId}";
        if (!string.IsNullOrEmpty(Model.FilterDescription))
        {
            paginationParams += $"&description={Uri.EscapeDataString(Model.FilterDescription)}";
        }
        if (Model.FilterCategoryId.HasValue)
        {
            paginationParams += $"&categoryId={Model.FilterCategoryId}";
        }
        if (Model.FilterDateFrom.HasValue)
        {
            paginationParams += $"&dateFrom={Model.FilterDateFrom:yyyy-MM-dd}";
        }
        if (Model.FilterDateTo.HasValue)
        {
            paginationParams += $"&dateTo={Model.FilterDateTo:yyyy-MM-dd}";
        }
    }
    @if (Model.Purchases.Any())
    {
        <table style="width:100%;border-collapse:collapse;">
            <thead>
                <tr style="border-bottom:2px solid #e2e8f0;">
                    <th style="text-align:left;padding:10px 8px;font-size:13px;font-weight:700;color:#5a6a7a;">Date</th>
                    <th style="text-align:left;padding:10px 8px;font-size:13px;font-weight:700;color:#5a6a7a;">Description</th>
                    <th style="text-align:left;padding:10px 8px;font-size:13px;font-weight:700;color:#5a6a7a;">Category</th>
                    <th style="text-align:right;padding:10px 8px;font-size:13px;font-weight:700;color:#5a6a7a;">Excl. VAT</th>
                    <th style="text-align:right;padding:10px 8px;font-size:13px;font-weight:700;color:#5a6a7a;">VAT</th>
                    <th style="text-align:right;padding:10px 8px;font-size:13px;font-weight:700;color:#5a6a7a;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var purchase in Model.Purchases)
                {
                    <tr style="border-bottom:1px solid #e2e8f0;">
                        <td style="padding:10px 8px;font-size:14px;">@purchase.InvoiceDate.ToString("dd MMM yyyy")</td>
                        <td style="padding:10px 8px;font-size:14px;">@purchase.Description</td>
                        <td style="padding:10px 8px;font-size:14px;">@purchase.Category</td>
                        <td style="text-align:right;padding:10px 8px;font-size:14px;">@Model.CurrencySymbol@purchase.AmountExcludingVat.ToString("N2")</td>
                        <td style="text-align:right;padding:10px 8px;font-size:14px;">@Model.CurrencySymbol@purchase.VatAmount.ToString("N2")</td>
                        <td style="text-align:right;padding:10px 8px;font-size:14px;">@Model.CurrencySymbol@purchase.TotalAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
            <div style="font-size:14px;color:#5a6a7a;">
                Showing @((Model.CurrentPage - 1) * 10 + 1)–@Math.Min(Model.CurrentPage * 10, Model.TotalRecords) of @Model.TotalRecords purchases
            </div>
            <div style="display:flex;gap:8px;">
                @if (Model.CurrentPage > 1)
                {
                    <a href="/Supplier/Dashboard/@Model.SupplierId?page=@(Model.CurrentPage - 1)&@paginationParams"
                       style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;background:#0D5EA6;color:#fff;text-decoration:none;">Previous</a>
                }
                else
                {
                    <span style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;background:#e2e8f0;color:#a0aec0;cursor:not-allowed;">Previous</span>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="/Supplier/Dashboard/@Model.SupplierId?page=@(Model.CurrentPage + 1)&@paginationParams"
                       style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;background:#0D5EA6;color:#fff;text-decoration:none;">Next</a>
                }
                else
                {
                    <span style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;background:#e2e8f0;color:#a0aec0;cursor:not-allowed;">Next</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No purchases found.</p>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" onerror="showChartsUnavailable()"></script>
    <script>
        function showChartsUnavailable() {
            var canvases = document.querySelectorAll('#spendShareCanvas, #monthlySpendCanvas, #periodSpendCanvas');
            canvases.forEach(function (canvas) {
                canvas.style.display = 'none';
            });
            var fallbacks = document.querySelectorAll('.chart-fallback');
            fallbacks.forEach(function (fallback) {
                fallback.style.display = 'block';
            });
        }
    </script>
    <script>
        var spendShareData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpendShareData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        var monthlySpendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySpendData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        var periodSpendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PeriodSpendData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        var selectedPeriodId = @Html.Raw(Model.SelectedPeriodId.HasValue ? Model.SelectedPeriodId.Value.ToString() : "null");

        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart === 'undefined') {
                showChartsUnavailable();
                return;
            }

            // Derive year(s) from monthly spend data for chart titles
            var years = monthlySpendData.map(function (m) { return m.year; }).filter(function (v, i, a) { return a.indexOf(v) === i; });
            var yearSuffix = '';
            if (years.length === 1) {
                yearSuffix = ' (' + years[0] + ')';
            } else if (years.length > 1) {
                yearSuffix = ' (' + Math.min.apply(null, years) + '–' + Math.max.apply(null, years) + ')';
            }
            document.getElementById('spendShareTitle').textContent = 'Spend Share' + yearSuffix;
            document.getElementById('monthlySpendTitle').textContent = 'Monthly Spend' + yearSuffix;

            // --- Spend Share Donut Chart ---
            var spendSharePalette = ['#57B8E8', '#129867', '#C8912E', '#C24A4A', '#8B5CF6', '#6B7280'];
            var spendShareLabels = spendShareData.map(function (s) { return s.supplierName; });
            var spendShareAmounts = spendShareData.map(function (s) { return s.amount; });
            var spendShareColors = [];
            var paletteIndex = 0;
            for (var i = 0; i < spendShareData.length; i++) {
                if (spendShareData[i].isCurrentSupplier) {
                    spendShareColors.push('#0D5EA6');
                } else {
                    spendShareColors.push(spendSharePalette[paletteIndex % spendSharePalette.length]);
                    paletteIndex++;
                }
            }

            var spendShareCtx = document.getElementById('spendShareCanvas').getContext('2d');
            new Chart(spendShareCtx, {
                type: 'doughnut',
                data: {
                    labels: spendShareLabels,
                    datasets: [{
                        data: spendShareAmounts,
                        backgroundColor: spendShareColors,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            align: 'start'
                        }
                    }
                }
            });

            // --- Monthly Spend Bar Chart ---
            var monthlyLabels = monthlySpendData.map(function (m) { return m.monthLabel; });
            var monthlyAmounts = monthlySpendData.map(function (m) { return m.amount; });

            var monthlyCtx = document.getElementById('monthlySpendCanvas').getContext('2d');
            new Chart(monthlyCtx, {
                type: 'bar',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Monthly Spend',
                        data: monthlyAmounts,
                        backgroundColor: '#0D5EA6',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

            // --- Period Spend Bar Chart ---
            var periodLabels = periodSpendData.map(function (p) { return p.periodLabel; });
            var periodAmounts = periodSpendData.map(function (p) { return p.amount; });
            var periodColors = periodSpendData.map(function (p) {
                if (selectedPeriodId === null) {
                    return '#0D5EA6';
                }
                return p.isSelected ? '#0D5EA6' : '#57B8E8';
            });

            var periodCtx = document.getElementById('periodSpendCanvas').getContext('2d');
            new Chart(periodCtx, {
                type: 'bar',
                data: {
                    labels: periodLabels,
                    datasets: [{
                        label: 'Period Spend',
                        data: periodAmounts,
                        backgroundColor: periodColors,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
}
