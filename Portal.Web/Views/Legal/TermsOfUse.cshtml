@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terms of Use — 3 Inventors Portal</title>
    <meta name="description" content="Acceptable use policies and user responsibilities when accessing the 3 Inventors Portal — Business Management Platform." />
    <meta name="theme-color" content="#0D5EA6" />
    <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon-180x180.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/images/favicon/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/images/favicon/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/images/favicon/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/images/favicon/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="57x57" href="/images/favicon/apple-touch-icon-57x57.png" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="msapplication-TileImage" content="/images/favicon/ms-icon-144x144.png" />
    <meta name="msapplication-TileColor" content="#0D5EA6" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        :root{
            --blue:#0D5EA6;--blue-dark:#0B4E89;--cyan:#57B8E8;--green:#129867;
            --warning:#C8912E;--danger:#C24A4A;--text:#0B1B28;--muted:#5E7385;
            --bg:#F7FAFC;--bg2:#EEF4F8;--line:rgba(13,94,166,.11);
            --shadow:0 24px 70px rgba(13,94,166,.11);--radius:28px;
        }
        html{scroll-behavior:smooth}
        body{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text);background:radial-gradient(circle at 12% 0%,rgba(13,94,166,.09),transparent 27%),radial-gradient(circle at 88% 8%,rgba(87,184,232,.09),transparent 24%),linear-gradient(180deg,#FBFDFF 0%,var(--bg2) 48%,var(--bg) 100%);line-height:1.6;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
        h1,h2,h3{font-family:Manrope,Inter,sans-serif;letter-spacing:-.035em;line-height:1.05}
        a{color:inherit;text-decoration:none}
        .container{max-width:1180px;margin:0 auto;padding:0 28px}

        /* Navigation */
        .nav{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.84);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(13,94,166,.08)}
        .nav-inner{height:76px;display:flex;align-items:center;justify-content:space-between}
        .brand{display:flex;align-items:center;gap:13px;text-decoration:none;color:var(--text)}
        .brand-logo{height:32px;width:auto}
        .nav-links-centre{display:flex;align-items:center;gap:24px}
        .nav-links-centre a{font-size:14px;font-weight:600;color:var(--muted);text-decoration:none;transition:.18s ease}
        .nav-links-centre a:hover{color:var(--blue)}
        .nav-links-centre a.active{color:var(--blue);font-weight:800}
        .nav-links{display:flex;align-items:center;gap:14px}
        .btn{display:inline-flex;align-items:center;justify-content:center;border-radius:15px;padding:13px 21px;font-weight:800;text-decoration:none;transition:.18s ease;border:1px solid transparent;font-size:14px}
        .btn-primary{background:linear-gradient(180deg,#1B6FBA,var(--blue));color:#fff;box-shadow:0 16px 34px rgba(13,94,166,.24)}
        .btn-primary:hover{transform:translateY(-1px);background:linear-gradient(180deg,#227AC8,#0B4E89)}
        .btn-secondary{background:rgba(255,255,255,.78);border-color:rgba(13,94,166,.15);color:var(--blue-dark)}
        .btn-secondary:hover{background:#fff;border-color:rgba(13,94,166,.28)}

        /* Hero */
        .hero{padding:80px 0 56px;text-align:center}
        .hero-content{max-width:720px;margin:0 auto}
        .eyebrow{display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(13,94,166,.12);background:rgba(255,255,255,.86);border-radius:999px;padding:10px 15px;font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:var(--blue-dark);box-shadow:0 10px 25px rgba(13,94,166,.06)}
        .dot{width:10px;height:10px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 8px rgba(87,184,232,.12)}
        .hero h1{margin:24px 0 0;font-size:clamp(38px,5vw,52px);font-weight:800}
        .hero-desc{margin:18px 0 0;color:var(--muted);font-size:18px;line-height:1.75;max-width:600px;margin-left:auto;margin-right:auto}
        .last-updated{margin:14px 0 0;color:var(--muted);font-size:14px;font-weight:600;opacity:.8}

        /* Content Card */
        .content-section{padding:0 0 80px;flex:1}
        .content-card{background:rgba(255,255,255,.78);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(13,94,166,.09);border-radius:28px;box-shadow:0 24px 70px rgba(13,94,166,.11);max-width:860px;margin:0 auto;padding:48px}
        .content-card h2{font-size:28px;font-weight:800;margin-bottom:32px;color:var(--text)}
        .content-card h3{font-size:20px;font-weight:700;margin-top:36px;margin-bottom:14px;color:var(--text)}
        .content-card p{margin-bottom:14px;color:#2a3d4e;font-size:15px;line-height:1.8}
        .content-card ul{margin:0 0 14px 24px;color:#2a3d4e;font-size:15px;line-height:1.8}
        .content-card ul li{margin-bottom:6px}
        .content-card a{color:var(--blue);text-decoration:underline}
        .content-card a:hover{opacity:.8}

        /* Footer */
        .footer-bottom{border-top:1px solid rgba(13,94,166,.08);padding:24px 0;background:rgba(255,255,255,.6)}
        .footer-inner{max-width:1180px;margin:0 auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
        .footer-inner span{font-size:14px;color:var(--muted)}
        .footer-links{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
        .footer-links a{color:var(--muted);text-decoration:none;font-size:14px;transition:.18s ease}
        .footer-links a:hover{opacity:.8}

        /* Responsive */
        @@media(max-width:720px){
            .container{padding:0 18px}
            .nav-inner{height:auto;padding:14px 0;flex-wrap:wrap;gap:12px}
            .nav-links-centre{gap:14px;flex-wrap:wrap;order:3;width:100%;justify-content:center}
            .nav-links-centre a{font-size:13px}
            .nav-links{gap:10px}
            .btn{padding:11px 16px;font-size:13px}
            .hero{padding:56px 0 40px}
            .hero h1{font-size:32px}
            .hero-desc{font-size:16px}
            .content-card{padding:24px;border-radius:22px}
            .content-card h2{font-size:24px;margin-bottom:24px}
            .content-card h3{font-size:18px;margin-top:28px}
            .content-card p,.content-card ul{font-size:14px}
            .content-section{padding:0 0 48px}
            .footer-inner{flex-direction:column;align-items:flex-start;gap:12px}
            .footer-links{flex-direction:column;align-items:flex-start;gap:10px}
        }
    </style>
</head>
<body>
    <!-- Legal Header -->
    <nav class="nav">
        <div class="container">
            <div class="nav-inner">
                <a class="brand" href="/">
                    <img src="/images/logo_blue_web_toolbar_oi.png" alt="3 Inventors" class="brand-logo" />
                </a>
                <div class="nav-links-centre">
                    <a href="/Terms-and-Conditions">Terms &amp; Conditions</a>
                    <a href="/Terms-of-Use" class="active">Terms of Use</a>
                    <a href="/Privacy-Policy">Privacy Policy</a>
                    <a href="/Cookies-Policy">Cookies Policy</a>
                </div>
                <div class="nav-links">
                    <a class="btn btn-secondary" href="/">Back to Site</a>
                    <a class="btn btn-primary" href="/Account/Login">Sign In</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <span class="eyebrow"><span class="dot"></span> Legal &amp; Policy</span>
                <h1>Terms of Use</h1>
