@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
}

<div style="text-align:center;">
    <div style="margin-bottom:20px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C8912E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
    </div>
    <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#ffffff;margin-bottom:12px;">Payment Cancelled</h2>
    <p style="color:rgba(255,255,255,0.75);font-size:15px;line-height:1.5;margin-bottom:28px;">
        Your payment was cancelled. No charges were made. You can try again when you're ready.
    </p>
    <a href="/Checkout"
       style="display:inline-block;padding:14px 32px;background:#0D5EA6;color:#ffffff;border-radius:12px;text-decoration:none;font-weight:700;font-size:15px;transition:background 0.2s;">
        Try Again
    </a>
</div>
