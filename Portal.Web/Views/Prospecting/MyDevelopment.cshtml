@{
    ViewData["Title"] = "My Development";
}

<style>
    .dev-privacy { display:flex; align-items:flex-start; gap:9px; font-size:12.5px; line-height:1.5; color:#4a3a63; background:rgba(107,77,138,.07); border:1px solid rgba(107,77,138,.16); border-radius:14px; padding:12px 15px; margin-bottom:22px; }
    .dev-privacy svg { flex-shrink:0; margin-top:1px; color:#6b4d8a; }

    .dev-summary { display:flex; gap:14px; flex-wrap:wrap; margin-bottom:22px; }
    .dev-stat { flex:1 1 180px; background:rgba(255,255,255,.78); border:1px solid rgba(13,94,166,.10); border-radius:16px; padding:16px 18px; }
    .dev-stat .label { font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#73889a; }
    .dev-stat .value { font-family:'Manrope',Inter,sans-serif; font-size:28px; font-weight:800; margin-top:6px; letter-spacing:-.04em; color:#0B1B28; }
    .dev-stat .value small { font-size:15px; color:#73889a; font-weight:700; }
    .dev-stat .value.text { font-size:15px; line-height:1.4; font-family:Inter,sans-serif; font-weight:700; margin-top:9px; }
    .dev-stat .hint { font-size:11px; color:#73889a; margin-top:4px; }

    .dev-grid { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(300px,.85fr); gap:18px; align-items:start; }
    .dev-grid .card + .card { margin-top:18px; }
    .dev-section-title { font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:#73889a; }

    .bar-row { display:grid; grid-template-columns:186px 1fr 52px; gap:12px; align-items:center; margin:13px 0; font-size:13px; }
    .bar-row .crit { line-height:1.3; }
    .bar-row .n { font-size:11px; color:#73889a; font-weight:700; }
    .bar-track { height:9px; background:rgba(13,94,166,.08); border-radius:20px; overflow:hidden; }
    .bar-fill { height:100%; border-radius:20px; background:linear-gradient(90deg,#1A6BB8,#0D5EA6); }
    .bar-fill.low { background:linear-gradient(90deg,#d99a3b,#C8912E); }
    .bar-row strong { text-align:right; font-family:'Manrope',Inter,sans-serif; }
    .bar-row .na { color:#73889a; font-weight:700; font-size:12px; text-align:right; }

    .trend-empty { display:flex; flex-direction:column; align-items:center; text-align:center; padding:30px 16px 20px; color:#73889a; }

    .focus-current { background:rgba(107,77,138,.06); border:1px solid rgba(107,77,138,.16); border-radius:12px; padding:12px 14px; font-size:13.5px; color:#3f2f57; margin-bottom:12px; }
    .focus-current .flabel { font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:#6b4d8a; margin-bottom:4px; }
    #devFocusInput { width:100%; min-height:72px; resize:vertical; padding:11px 13px; border:1px solid rgba(13,94,166,.15); border-radius:12px; font:inherit; font-size:13.5px; }

    .lesson { border:1px solid rgba(13,94,166,.10); border-radius:12px; padding:11px 13px; font-size:13px; color:#334155; margin-bottom:9px; background:rgba(255,255,255,.6); }
    .lesson .meta { font-size:11px; color:#73889a; margin-top:5px; }

    .queue-item { display:flex; justify-content:space-between; gap:10px; align-items:center; padding:11px 0; border-bottom:1px solid rgba(13,94,166,.10); font-size:13px; }
    .queue-item:last-child { border-bottom:none; }
    .queue-item .q-sub { font-size:11px; color:#73889a; margin-top:2px; }
    .q-pill { display:inline-block; padding:3px 9px; border-radius:999px; font-size:11px; font-weight:800; }
    .q-pill-call { background:rgba(200,145,46,.12); color:#C8912E; }
    .q-pill-meeting, .q-pill-demo { background:rgba(26,138,181,.12); color:#1A7BB0; }

    .interpret { font-size:12.5px; color:#5E7385; line-height:1.55; }
    .interpret strong { color:#0B1B28; }

    .dev-empty { padding:18px; text-align:center; color:#73889a; font-size:13px; }

    @@media(max-width:980px){ .dev-grid{ grid-template-columns:1fr; } }
</style>

<div class="topbar">
    <div>
        <div style="font-size:12px;color:#73889a;margin-bottom:4px;">
            Opportunities / <a href="/Prospecting/Campaigns" style="color:var(--blue);">Prospecting</a> / <strong>My Development</strong>
        </div>
        <div class="eyebrow" style="color:#6b4d8a;"><span class="dot" style="background:#6b4d8a;"></span> Personal development · Private workspace</div>
        <h1 class="topbar-heading">My Development</h1>
        <p class="topbar-subtitle">A private record of how you communicate on prospect calls — self-reported, for your own learning. Never a sales ranking, and it never affects pipeline, scores, or conversion.</p>
    </div>
</div>

<div class="dev-privacy">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
    <span>Everything here is <strong>private to you</strong> and <strong>self-reported</strong>. Sample sizes are shown so you don't over-read a trend from two or three calls. A strong conversation may not book a demo; a weak one sometimes does — these are kept separate on purpose.</span>
</div>

<!-- Filters -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:180px;">
            <label>From</label>
            <input type="date" id="devFrom" />
        </div>
        <div class="field" style="min-width:180px;">
            <label>To</label>
            <input type="date" id="devTo" />
        </div>
        <div style="padding-bottom:2px;display:flex;gap:8px;">
            <button class="btn btn-primary" onclick="applyDevFilters()">Apply</button>
            <button class="btn btn-secondary" onclick="clearDevFilters()">Clear</button>
        </div>
    </div>
    <div style="display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-top:14px;">
        <span style="font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#73889a;margin-right:4px;">Quick</span>
        <button class="btn btn-secondary dev-chip" data-period="last_7" style="padding:5px 12px;font-size:12px;">Last 7 days</button>
        <button class="btn btn-secondary dev-chip" data-period="last_30" style="padding:5px 12px;font-size:12px;">Last 30 days</button>
        <button class="btn btn-secondary dev-chip" data-period="this_quarter" style="padding:5px 12px;font-size:12px;">This quarter</button>
        <button class="btn btn-secondary dev-chip" data-period="all" style="padding:5px 12px;font-size:12px;">All time</button>
    </div>
</section>

<!-- Summary stats -->
<div class="dev-summary">
    <div class="dev-stat">
        <div class="label">Evaluations completed</div>
        <div class="value" id="devEvalCount">—</div>
        <div class="hint" id="devEvalRange"></div>
    </div>
    <div class="dev-stat">
        <div class="label">Average self-rating</div>
        <div class="value" id="devAvg">—</div>
        <div class="hint" id="devAvgHint"></div>
    </div>
    <div class="dev-stat">
        <div class="label">Calls reflected on</div>
        <div class="value" id="devReflected">—</div>
        <div class="hint" id="devReflectedHint"></div>
    </div>
    <div class="dev-stat">
        <div class="label">This week's focus</div>
        <div class="value text" id="devFocusPreview">Not set</div>
    </div>
</div>

<div class="dev-grid">
    <!-- LEFT -->
    <div>
        <section class="glass card-pad card">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div class="dev-section-title">Self-assessment by criterion</div>
                <span class="q-pill" style="background:rgba(13,94,166,.08);color:#0D5EA6;" id="devCriterionPeriod">Selected period</span>
            </div>
            <p style="font-size:12px;color:#73889a;margin:10px 0 4px;">Average of your rated criteria only. <strong>n</strong> is how many calls you assessed that criterion on — treat small n with caution.</p>
            <div id="devCriterionBars"></div>
        </section>

        <section class="glass card-pad card">
            <div class="dev-section-title" style="margin-bottom:0;">Weekly trend</div>
            <div class="trend-empty">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>
                <div style="font-weight:700;color:#0B1B28;margin-top:10px;">No data yet</div>
                <p style="font-size:12.5px;color:#73889a;margin:6px 0 0;max-width:340px;">A weekly trend will appear here once you have enough dated reflections to show one meaningfully.</p>
            </div>
        </section>
    </div>

    <!-- RIGHT -->
    <div>
        <section class="glass card-pad card">
            <div class="dev-section-title">This week's practice focus</div>
            <div class="focus-current" id="devFocusCurrentBox" style="display:none;">
                <div class="flabel">Current focus</div>
                <span id="devFocusCurrent"></span>
            </div>
            <label style="display:block;margin-bottom:10px;">
                <span style="font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#73889a;">Set a new focus</span>
                <textarea id="devFocusInput" maxlength="1000" placeholder="One behaviour to practise on your next calls."></textarea>
            </label>
            <div style="display:flex;justify-content:flex-end;">
                <button class="btn btn-primary" style="padding:6px 14px;font-size:12px;" onclick="saveDevFocus()">Save focus</button>
            </div>
        </section>

        <section class="glass card-pad card">
            <div class="dev-section-title">Recent lessons</div>
            <div id="devLessons"></div>
        </section>

        <section class="glass card-pad card">
            <div class="dev-section-title">Review queue</div>
            <p style="font-size:12px;color:#73889a;margin:0 0 6px;">Recent calls, meetings and demos you haven't reflected on yet. Unanswered calls are not listed.</p>
            <div id="devReviewQueue"></div>
        </section>

        <section class="glass card-pad card">
            <div class="dev-section-title">How to read this</div>
            <p class="interpret">A higher average is <strong>not</strong> automatic proof of better outcomes, and a booked demo was <strong>not</strong> caused by a high score. This is a private coaching tool — no employee rankings, no personality profiling, no inferred cause and effect.</p>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales/my-development.js?v=1"></script>
}
