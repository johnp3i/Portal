@using Portal.Infrastructure.Models.Sales
@{
    ViewData["Title"] = "Prospect Activity";
    var campaigns = ViewBag.Campaigns as List<ProspectCampaignListDto> ?? new List<ProspectCampaignListDto>();
    var cities = ViewBag.Cities as List<string> ?? new List<string>();
    var selectedCampaignId = ViewBag.SelectedCampaignId as int?;
}

<div class="topbar">
    <div>
        <div style="font-size:12px;color:#73889a;margin-bottom:4px;">
            Opportunities / <a href="/Prospecting/Campaigns" style="color:var(--blue);">Prospecting</a> / <strong>Activity</strong>
        </div>
        <div class="eyebrow"><span class="dot"></span> Prospect Activity</div>
        <h1 class="topbar-heading">Prospect Activity</h1>
        <p class="topbar-subtitle">Every call, email, meeting and note logged against your prospects — review what was done in any period.</p>
    </div>
    <div style="display:flex;gap:8px;" class="topbar-actions-desktop">
        <button class="btn btn-secondary" onclick="exportActivityCsv()">Export CSV</button>
    </div>
</div>

<!-- Mobile action bar (phone only — replaces the stacked topbar actions) -->
<div class="mobile-action-bar">
    <button type="button" class="mab-btn mab-primary" onclick="exportActivityCsv()">Export CSV</button>
    <button type="button" class="mab-btn mab-ghost filter-toggle" aria-expanded="false" aria-controls="activityFilterPanel">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 4h18M7 9h10M10 14h4"/></svg>
        <span>Filters</span>
    </button>
</div>

<!-- Filters -->
<section class="glass card-pad mobile-filter-card" style="margin-bottom:22px;">
    <div class="filter-panel" id="activityFilterPanel">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:200px;">
            <label>Campaign</label>
            <select id="filterCampaign">
                <option value="">All campaigns</option>
                @foreach (var c in campaigns)
                {
                    if (selectedCampaignId.HasValue && selectedCampaignId.Value == c.Id)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </div>
        <div class="field" style="min-width:160px;">
            <label>Activity type</label>
            <select id="filterActivityType">
                <option value="">All types</option>
                @{
                    var activityTypes = ViewBag.ActivityTypes as IReadOnlyList<ActivityTypeDto> ?? new List<ActivityTypeDto>();
                }
                @foreach (var t in activityTypes)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:160px;">
            <label>Interaction signal</label>
            <select id="filterSentiment">
                <option value="">Any</option>
                <option value="1">Positive</option>
                <option value="2">Neutral</option>
                <option value="3">Negative</option>
            </select>
        </div>
        <div class="field" style="min-width:160px;">
            <label>City</label>
            <select id="filterCity">
                <option value="">All cities</option>
                @foreach (var city in cities)
                {
                    <option value="@city">@city</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:150px;">
            <label>Date from</label>
            <input type="date" id="filterDateFrom" />
        </div>
        <div class="field" style="min-width:150px;">
            <label>Date to</label>
            <input type="date" id="filterDateTo" />
        </div>
        <div class="field" style="min-width:200px;flex:1;">
            <label>Search</label>
            <input type="text" id="filterSearch" placeholder="Prospect, outcome or note…" />
        </div>
        <div style="padding-bottom:2px;display:flex;gap:8px;">
            <button class="btn btn-primary" onclick="applyActivityFilters()">Filter</button>
            <button class="btn btn-secondary" onclick="clearActivityFilters()">Clear</button>
        </div>
    </div>
    <div style="display:flex;gap:7px;flex-wrap:wrap;margin-top:14px;align-items:center;">
        <span style="font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#73889a;margin-right:4px;">Quick</span>
        <button type="button" class="act-period chip" data-period="today" onclick="setActivityPeriod(this,'today')">Today</button>
        <button type="button" class="act-period chip" data-period="yesterday" onclick="setActivityPeriod(this,'yesterday')">Yesterday</button>
        <button type="button" class="act-period chip" data-period="this_week" onclick="setActivityPeriod(this,'this_week')">This week</button>
        <button type="button" class="act-period chip" data-period="last_7" onclick="setActivityPeriod(this,'last_7')">Last 7 days</button>
        <button type="button" class="act-period chip" data-period="this_month" onclick="setActivityPeriod(this,'this_month')">This month</button>
        <button type="button" class="act-period chip" data-period="all" onclick="setActivityPeriod(this,'all')">All time</button>
    </div>
    </div>
</section>

<!-- Period summary -->
<div id="activitySummary" style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:22px;"></div>

<!-- Activity log -->
<section class="glass card-pad">
    <div style="overflow-x:auto;">
        <table class="data-table" id="activityTable">
            <thead>
                <tr>
                    <th style="width:120px;">When</th>
                    <th>Prospect</th>
                    <th>Campaign</th>
                    <th>Type</th>
                    <th>Outcome</th>
                    <th>Signal</th>
                    <th>Next action</th>
                    <th>By</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="activityTableBody">
                <tr><td colspan="9" style="text-align:center;color:#73889a;padding:24px;">Loading…</td></tr>
            </tbody>
        </table>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
        <div id="activityPaginationInfo" style="font-size:14px;color:#5a6a7a;"></div>
        <div id="activityPaginationControls" style="display:flex;gap:6px;"></div>
    </div>
</section>

@section Scripts {
    <style>
        .act-period.chip { border:1px solid rgba(13,94,166,.10); background:#fff; border-radius:999px; padding:5px 12px; font-size:12px; font-weight:700; color:var(--blue); cursor:pointer; }
        .act-period.chip.active { background:var(--blue); color:#fff; border-color:var(--blue); }
        #activitySummary .stat { flex:1 1 150px; background:rgba(255,255,255,.78); border:1px solid rgba(13,94,166,.10); border-radius:16px; padding:16px 18px; }
        #activitySummary .stat .label { font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#73889a; }
        #activitySummary .stat .value { font-family:'Manrope',Inter,sans-serif; font-size:26px; font-weight:800; margin-top:4px; }

        /* ══ Prospect Activity — native stacked card feed on phones ═══════════════
           Mirrors the Purchases list pattern (Purchase/Index #purchaseTable). One
           activity = one card. Cell order (data-mobile): when, prospect, hide
           (campaign), type, outcome, signal, next, hide (by), open.
           Scoped to #activityTable so it never affects other tables. */
        @@media (max-width: 768px) {
            /* Period summary: clean 2-column grid instead of uneven flex wrap. */
            #activitySummary {
                display: grid !important;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            #activitySummary .stat { flex: none !important; }

            /* Quick period shortcuts: the generic mobile rule forces any
               flex-wrap row into a centered vertical stack. Override so the
               chips flow as a compact 3-column pill grid (matches the Purchase
               page's quick row feel). The row is the .filter-panel's last
               direct child. */
            #activityFilterPanel > div:last-child {
                display: grid !important;
                grid-template-columns: repeat(3, 1fr);
                gap: 8px !important;
                align-items: stretch !important;
                margin-top: 12px !important;
            }
            /* The "Quick" caption spans the full row above the pills. */
            #activityFilterPanel > div:last-child > span {
                grid-column: 1 / -1;
                margin: 0 0 2px !important;
            }
            #activityFilterPanel .act-period.chip {
                width: 100%;
                text-align: center;
                padding: 9px 8px;
                font-size: 12.5px;
            }

            /* Cancel the generic .data-table rules (max-content width + nowrap from
               mobile.css) so cards shrink to the viewport and never scroll. */
            #activityTable,
            #activityTable tbody {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
            }
            #activityTable thead { display: none !important; }

            #activityTable tbody td {
                white-space: normal !important;
                min-width: 0 !important;
                overflow-wrap: anywhere;
                border: none !important;
                padding: 0;
            }

            /* The card */
            #activityTable tbody tr {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) auto;
                gap: 2px 12px;
                align-items: start;
                width: 100%;
                max-width: 100%;
                box-sizing: border-box;
                padding: 16px !important;
                margin-bottom: 12px;
                border: 1px solid rgba(13, 94, 166, 0.10) !important;
                border-radius: 16px;
                background: #fff !important;
                box-shadow: 0 1px 3px rgba(11, 27, 40, 0.05);
            }

            /* Hidden on phone: Campaign + By */
            #activityTable tbody td[data-mobile="hide"] { display: none !important; }

            /* Row 1 — Prospect (title, left) */
            #activityTable tbody td[data-mobile="prospect"] {
                grid-row: 1; grid-column: 1;
                font-weight: 700; font-size: 15px; line-height: 1.25;
            }
            #activityTable tbody td[data-mobile="prospect"] a { font-size: 15px; }

            /* Row 1 — When (right, muted) */
            #activityTable tbody td[data-mobile="when"] {
                grid-row: 1; grid-column: 2;
                text-align: right; font-size: 12px; color: #73889a; font-weight: 700;
                white-space: nowrap;
            }

            /* Row 2 — Type + Signal pills together */
            #activityTable tbody td[data-mobile="type"] {
                grid-row: 2; grid-column: 1;
                margin-top: 10px;
            }
            #activityTable tbody td[data-mobile="signal"] {
                grid-row: 2; grid-column: 2;
                justify-self: end; margin-top: 10px;
            }

            /* Row 3 — Outcome, full width */
            #activityTable tbody td[data-mobile="outcome"] {
                grid-row: 3; grid-column: 1 / -1;
                margin-top: 10px; font-size: 13.5px; color: #334155;
            }

            /* Row 4 — Next action, full width (amber, as rendered) */
            #activityTable tbody td[data-mobile="next"] {
                grid-row: 4; grid-column: 1 / -1;
                margin-top: 8px; font-size: 13px;
            }

            /* Footer — Open link as a full-width action row */
            #activityTable tbody td[data-mobile="open"] {
                grid-row: 5; grid-column: 1 / -1;
                text-align: center !important;
                margin-top: 14px; padding-top: 14px !important;
                border-top: 1px solid rgba(13, 94, 166, 0.08) !important;
                white-space: normal !important;
            }
            #activityTable tbody td[data-mobile="open"] .tbl-action {
                display: block; width: 100%; box-sizing: border-box;
                padding: 11px 12px; font-size: 13.5px;
            }
        }
    </style>
    <script src="~/js/sales/prospecting.js?v=17"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initActivityLog();
        });
    </script>
}
