@using Portal.Infrastructure.Models.Sales
@model ProspectCampaignDashboardDto
@{
    ViewData["Title"] = $"Prospects — {Model.Name}";
}

<div class="topbar">
    <div>
        <div style="font-size:12px;color:#73889a;margin-bottom:4px;">
            Opportunities / <a href="/Prospecting/Campaigns" style="color:var(--blue);">Prospecting</a> /
            <a href="/Prospecting/CampaignDashboard/@Model.Id" style="color:var(--blue);">@Model.Name</a> / <strong>Prospects</strong>
        </div>
        <div class="eyebrow"><span class="dot"></span> Prospects · working list</div>
        <h1 class="topbar-heading">Prospects — @Model.Name</h1>
        <p class="topbar-subtitle">Research targets for this campaign. These are <strong>not</strong> Sales contacts or leads yet.</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a class="btn btn-secondary" href="/Prospecting/Import?campaignId=@Model.Id">Import Excel</a>
        <button class="btn btn-primary" onclick="openCreateProspectModal()">+ Add Prospect</button>
    </div>
</div>

<section class="glass card-pad" style="margin-bottom:22px;">
    <p style="margin:0;font-size:13px;color:#8D5D07;background:rgba(200,145,46,.06);border:1px solid rgba(200,145,46,.18);border-radius:10px;padding:10px 14px;">
        ⓘ A phone number here is a <strong>prospecting target</strong>, not a Sales contact. Nothing on this list touches your pipeline until you press <strong>Convert to Lead</strong>.
    </p>
</section>

<!-- Filters -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:180px;">
            <label>Priority</label>
            <select id="filterPriority">
                <option value="">All</option>
                <option value="A">A (16–20)</option>
                <option value="B">B (12–15)</option>
                <option value="Hold">Hold</option>
            </select>
        </div>
        <div class="field" style="min-width:180px;">
            <label>Status</label>
            <select id="filterStatus">
                <option value="">All</option>
                <option value="1">Research</option>
                <option value="2">Ready</option>
                <option value="3">Contacting</option>
                <option value="4">Engaged</option>
                <option value="5">Converted</option>
                <option value="6">Disqualified</option>
            </select>
        </div>
        <div class="field" style="min-width:180px;">
            <label>Segment</label>
            <input type="text" id="filterSegment" placeholder="Any segment" />
        </div>
        <div class="field" style="min-width:180px;">
            <label>Next action</label>
            <select id="filterNextAction">
                <option value="">Any</option>
                <option value="due_today">Due today</option>
                <option value="overdue">Overdue</option>
                <option value="this_week">This week</option>
            </select>
        </div>
        <div style="padding-bottom:2px;">
            <button class="btn btn-primary" onclick="applyProspectFilters()">Filter</button>
            <button class="btn btn-secondary" onclick="clearProspectFilters()">Clear</button>
        </div>
    </div>
</section>

<!-- Data table (populated via AJAX) -->
<section class="glass card-pad">
    <table class="data-table">
        <thead>
            <tr>
                <th>Prospect</th>
                <th>Segment</th>
                <th>Priority</th>
                <th>Score</th>
                <th>Status</th>
                <th>Last activity</th>
                <th>Next action</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="prospectTableBody">
            <tr><td colspan="8" style="text-align:center;color:#73889a;padding:24px;">Loading…</td></tr>
        </tbody>
    </table>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
        <div id="prospectPaginationInfo" style="font-size:14px;color:#5a6a7a;"></div>
        <div id="prospectPaginationControls"></div>
    </div>
</section>

<!-- Add / Edit Prospect Modal -->
<div id="prospectModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:640px;max-height:90vh;overflow:auto;">
        <h3 id="prospectModalTitle" style="margin-bottom:16px;">Add Prospect</h3>
        <input type="hidden" id="prospectId" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Prospect Name *</label><input type="text" id="prospectName" required /></div>
            <div class="field"><label>Segment</label><input type="text" id="prospectSegment" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Location</label><input type="text" id="prospectLocation" /></div>
            <div class="field"><label>Business Type</label><input type="text" id="prospectBusinessType" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Public Contact / Role</label><input type="text" id="prospectContactRole" /></div>
            <div class="field"><label>Phone (research)</label><input type="text" id="prospectPhone" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Email (research)</label><input type="text" id="prospectEmail" /></div>
            <div class="field"><label>Website</label><input type="text" id="prospectWebsite" /></div>
        </div>
        <div class="field"><label>Why it may fit</label><textarea id="prospectWhyFit" rows="2"></textarea></div>
        <div class="field"><label>Public evidence</label><textarea id="prospectEvidence" rows="2"></textarea></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Research source URL</label><input type="text" id="prospectSourceUrl" /></div>
            <div class="field"><label>Recommended first contact</label><input type="text" id="prospectFirstContact" /></div>
        </div>
        <div style="font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#73889a;margin:6px 0 8px;">Scoring (each 0–5)</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;">
            <div class="field"><label>ICP Fit</label><input type="number" id="prospectIcp" min="0" max="5" value="0" /></div>
            <div class="field"><label>Pain Prob.</label><input type="number" id="prospectPain" min="0" max="5" value="0" /></div>
            <div class="field"><label>Accessibility</label><input type="number" id="prospectAccess" min="0" max="5" value="0" /></div>
            <div class="field"><label>Learning Value</label><input type="number" id="prospectLearning" min="0" max="5" value="0" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Next action</label><input type="text" id="prospectNextAction" /></div>
            <div class="field"><label>Next action date</label><input type="date" id="prospectNextActionDate" /></div>
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
            <button class="btn btn-secondary" onclick="closeProspectModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitProspect()">Save</button>
        </div>
    </div>
</div>

<input type="hidden" id="campaignIdField" value="@Model.Id" />

@section Scripts {
    <script src="~/js/sales/prospecting.js?v=6"></script>
    <script>document.addEventListener('DOMContentLoaded', function () { if (window.initProspectsList) initProspectsList(@Model.Id); });</script>
}
