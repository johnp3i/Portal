@using Portal.Infrastructure.Models.Sales
@model ProspectDetailDto
@{
    ViewData["Title"] = $"Prospect — {Model.Name}";

    string PriorityPill(string p) => p switch { "A" => "pill-green", "B" => "pill-gold", _ => "pill-grey" };
    string StatusPill(byte s) => s switch
    {
        3 => "pill-blue",
        4 => "pill-cyan",
        5 => "pill-green",
        6 => "pill-grey",
        2 => "pill-slate",
        _ => "pill-slate"
    };

    string Val(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
}

<style>
    .prospect-timeline { display: flex; flex-direction: column; }
    .prospect-timeline .tl { display: flex; gap: 12px; padding: 11px 0; font-size: 13px; border-bottom: 1px solid rgba(13,94,166,.05); }
    .prospect-timeline .tl:last-child { border-bottom: none; }
    .prospect-timeline .tl-dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
    .prospect-timeline .tl-body { flex: 1; min-width: 0; }
    .prospect-timeline .tl-line { font-size: 14px; color: #0B1B28; display: flex; align-items: baseline; gap: 4px; }
    .prospect-timeline .tl-line strong { font-weight: 700; }
    .prospect-timeline .tl-sub { font-size: 12px; color: #73889a; margin-top: 2px; }
    .prospect-timeline .tl-notes { font-size: 13px; color: #334155; margin-top: 4px; }
    .prospect-timeline .tl-next { font-size: 12px; color: #C8912E; margin-top: 4px; }
    .prospect-timeline .tl-edit { margin-left: auto; background: none; border: none; color: #73889a; font-size: 12px; font-weight: 600; cursor: pointer; padding: 0 0 0 8px; font-family: inherit; }
    .prospect-timeline .tl-edit:hover { color: #0D5EA6; text-decoration: underline; }
    /* Per-activity private self-evaluation entry point. Sits after Edit; not auto-margined so Edit
       keeps the right edge. */
    .prospect-timeline .tl-reflect { background: none; border: none; color: #0D5EA6; font-size: 12px; font-weight: 700; cursor: pointer; padding: 0 0 0 10px; font-family: inherit; }
    .prospect-timeline .tl-reflect:hover { text-decoration: underline; }
    /* Private "reflected" lock chip — presence only, never a score. */
    .prospect-timeline .tl-reflect-lock { display: inline-flex; align-items: center; gap: 3px; margin-left: 6px; font-size: 11px; font-weight: 700; color: #6b4d8a; background: rgba(107,77,138,.10); border-radius: 7px; padding: 1px 7px; }
    .prospect-timeline .tl-reflect-lock svg { opacity: .85; }

    /* ── Call Reflection modal ─────────────────────────────────────────────── */
    .reflect-close { background: rgba(13,94,166,.06); border: none; width: 34px; height: 34px; border-radius: 50%; font-size: 22px; line-height: 1; color: #5E7385; cursor: pointer; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; padding: 0; }
    .reflect-close:hover { background: rgba(13,94,166,.12); color: #0B1B28; }
    .reflection-modal .reflect-privacy { display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; font-size: 12px; line-height: 1.5; color: #4a3a63; background: rgba(107,77,138,.07); border: 1px solid rgba(107,77,138,.16); border-radius: 12px; padding: 10px 13px; }
    .reflection-modal .reflect-privacy svg { flex-shrink: 0; margin-top: 1px; color: #6b4d8a; }
    .reflect-section-title { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #73889a; margin-bottom: 10px; }
    /* Criterion row */
    .reflect-crit { padding: 13px 0; border-bottom: 1px solid rgba(13,94,166,.07); }
    .reflect-crit:last-child { border-bottom: none; }
    .reflect-crit-head { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
    .reflect-crit-title { font-weight: 700; font-size: 13.5px; color: #0B1B28; }
    .reflect-crit-state { font-size: 11px; font-weight: 700; color: #73889a; }
    .reflect-crit-q { font-size: 12px; color: #73889a; margin: 3px 0 9px; }
    .reflect-scores { display: flex; gap: 6px; flex-wrap: wrap; }
    .reflect-score { min-width: 38px; height: 34px; border: 1.5px solid rgba(13,94,166,.16); background: #fff; color: #55748c; border-radius: 9px; font-weight: 800; font-size: 13px; cursor: pointer; font-family: inherit; }
    .reflect-score:hover { border-color: #0D5EA6; }
    .reflect-score.sel { background: #0D5EA6; border-color: #0D5EA6; color: #fff; }
    .reflect-score.na { width: auto; padding: 0 12px; font-size: 11px; font-weight: 700; }
    .reflect-score.na.sel { background: rgba(13,94,166,.1); border-color: #0D5EA6; color: #0D5EA6; }
    .reflect-summary { display: flex; justify-content: space-between; align-items: center; background: rgba(13,94,166,.04); border: 1px solid rgba(13,94,166,.1); border-radius: 13px; padding: 13px 16px; margin: 14px 0; }
    .reflect-avg { font-family: 'Manrope', sans-serif; font-size: 26px; font-weight: 800; letter-spacing: -.03em; color: #0B1B28; }
    .reflect-tips { margin-top: 14px; border: 1px solid rgba(13,94,166,.1); border-radius: 12px; padding: 4px 14px; }
    .reflect-tips summary { cursor: pointer; font-weight: 700; color: #0D5EA6; padding: 10px 0; font-size: 13px; }
    .reflect-tip-note { font-size: 12px; font-weight: 700; color: #6b4d8a; background: rgba(107,77,138,.07); border-radius: 10px; padding: 9px 12px; }
    .reflect-tip-body { font-size: 13px; color: #334155; line-height: 1.5; background: rgba(13,94,166,.04); border-radius: 10px; padding: 11px 13px; margin-bottom: 12px; }
    .reflect-delete { color: #C24A4A; border-color: rgba(194,74,74,.3); }
    .reflect-delete:hover { background: rgba(194,74,74,.06); }

    /* Activity modal enhancements */
    .act-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .act-chip { border: 1.5px solid rgba(13,94,166,.15); background: rgba(13,94,166,.04); color: #0B4E89; border-radius: 999px; padding: 5px 11px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .act-chip:hover { background: rgba(13,94,166,.1); }
    .act-seg { display: inline-flex; border: 1.5px solid rgba(13,94,166,.15); border-radius: 10px; overflow: hidden; }
    .act-seg button { border: none; background: #fff; padding: 9px 14px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; color: #5E7385; }
    .act-seg button + button { border-left: 1.5px solid rgba(13,94,166,.12); }
    .act-seg button.on-pos { background: rgba(18,152,103,.12); color: #0C734B; }
    .act-seg button.on-neu { background: rgba(90,106,122,.12); color: #4A5568; }
    .act-seg button.on-neg { background: rgba(194,74,74,.1); color: #A23A3A; }

    /* ── Breadcrumb / back-nav row (its own row above the topbar) ─────────────
       Desktop shows the full trail; the right padding keeps a long trail from
       running under the floating top-right chrome (search / What's New at
       right:200px). The compact back link is hidden until phone. */
    .prospect-breadcrumb { margin-bottom: 10px; }
    .prospect-breadcrumb-trail {
        font-size: 12px;
        color: #73889a;
        display: block;
        padding-right: 600px; /* clear the absolute top-right search/What's New/account strip */
        line-height: 1.6;
    }
    /* Slim native back row — hidden on desktop (the trail above handles nav),
       shown on phone as a quiet top-left back button. */
    .prospect-back-row {
        display: none;
        align-items: center;
        gap: 4px;
        font-size: 14px;
        font-weight: 700;
        color: var(--blue);
        text-decoration: none;
        margin-bottom: 10px;
        padding: 2px 0;
    }
    .prospect-back-row svg { flex-shrink: 0; }

    /* Priority pill in the action column — desktop keeps it inline in the title,
       so hide the action-column copy here; it's shown on phone only. */
    .prospect-priority-mobile { display: none; }

    /* Status badge that rides the back row — phone only. */
    .prospect-status-mobile { display: none; }

    /* Narrower desktops / tablets: the float still sits top-right, but reserve
       less room and let the trail wrap instead of pushing width. */
    @@media (max-width: 1100px) {
        .prospect-breadcrumb-trail { padding-right: 0; }
    }

    /* ── Mobile (≤768px): collapse the two-column layout so nothing bleeds off
          the screen, and let the timeline scroll horizontally if a row is wide. */
    @@media (max-width: 768px) {
        .prospect-detail-grid {
            grid-template-columns: 1fr !important;
            gap: 16px !important;
        }
        .identity-grid {
            grid-template-columns: 1fr !important;
        }
        /* Activity timeline: keep each entry on its own line but allow a wide
           entry (long outcome + pills + follow-up + Edit) to scroll sideways
           inside the card instead of forcing the page wider than the viewport. */
        .prospect-timeline { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .prospect-timeline .tl { min-width: 0; }
        .prospect-timeline .tl-line { flex-wrap: wrap; }

        /* Native header flow: [ ← Prospects ........ STATUS ] on its own line,
           then the title + meta, then a full-width primary action. Hide the
           desktop trail and the in-subtitle status (it rides the back row now). */
        .prospect-breadcrumb { display: none; }
        .prospect-back-row { display: inline-flex; }
        .prospect-back-nav {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        .prospect-back-row { margin-bottom: 0; }
        .prospect-status-mobile { display: inline-flex; margin-left: auto; }
        .prospect-status-subtitle { display: none; }

        /* Priority pill moves out of the title and sits above the button in the
           action column, saving a line of vertical space. */
        .prospect-priority-inline { display: none; }
        .prospect-priority-mobile { display: inline-flex; align-self: flex-start; }

        /* Action column: priority pill on top, full-width Convert button below. */
        .prospect-topbar-actions {
            width: 100%;
            margin-top: 4px;
            flex-direction: column;
            align-items: flex-start;
        }
        .prospect-topbar-actions .btn {
            width: 100%;
        }
    }
</style>

<!-- Slim native-style back row: shown on phone only, at the very top-left.
     Quiet, on its own line. The status badge shares this row (pushed right) to
     keep the title/meta lines uncluttered. -->
<div class="prospect-back-nav">
    <a class="prospect-back-row" href="/Prospecting/Prospects?campaignId=@Model.ProspectCampaignId">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        Prospects
    </a>
    <span class="pill pill-sm @StatusPill(Model.Status) prospect-status-mobile">@Model.StatusName</span>
</div>

<!-- Desktop breadcrumb trail: its own row above the topbar so it never runs
     under the floating top-right chrome. Hidden on phone (the back row above
     replaces it). -->
<nav class="prospect-breadcrumb" aria-label="Breadcrumb">
    <span class="prospect-breadcrumb-trail">
        Opportunities / <a href="/Prospecting/Campaigns" style="color:var(--blue);">Prospecting</a> /
        <a href="/Prospecting/CampaignDashboard/@Model.ProspectCampaignId" style="color:var(--blue);">@Model.CampaignName</a> /
        <a href="/Prospecting/Prospects?campaignId=@Model.ProspectCampaignId" style="color:var(--blue);">Prospects</a> / <strong>@Model.Name</strong>
    </span>
</nav>

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Prospect</div>
        <h1 class="topbar-heading" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            @Model.Name
            <span class="pill @PriorityPill(Model.Priority) prospect-priority-inline">Priority @Model.Priority · @Model.Total/20</span>
        </h1>
        <p class="topbar-subtitle">
            @Val(Model.Segment) · @Val(Model.Location)<span class="prospect-status-subtitle"> · <span class="pill pill-sm @StatusPill(Model.Status)">@Model.StatusName</span></span>
        </p>
    </div>
    <div class="prospect-topbar-actions" style="display:flex;gap:8px;flex-wrap:wrap;">
        <span class="pill @PriorityPill(Model.Priority) prospect-priority-mobile">Priority @Model.Priority · @Model.Total/20</span>
        @{
            // Latest conversational activity (Call / Meeting / Demo) the founder would reflect on.
            // Activities arrive newest-first from the service.
            var latestReflectable = Model.Activities.FirstOrDefault(a => a.ActivityType is 2 or 4 or 5);
        }
        <button class="btn btn-secondary prospect-reflect-btn" style="display:inline-flex;align-items:center;gap:6px;"
                onclick="openPreCallIntention()" title="Record a pre-call objective and practice focus (private)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>
            Pre-call intention
        </button>
        @if (latestReflectable != null)
        {
            <button class="btn btn-secondary prospect-reflect-btn" style="display:inline-flex;align-items:center;gap:6px;"
                    data-reflect-for="@latestReflectable.Id"
                    data-reflect-type="@((byte)latestReflectable.ActivityType)"
                    data-reflect-typename="@latestReflectable.ActivityTypeName"
                    data-reflect-date="@latestReflectable.OccurredAtUtc.ToString("dd MMM yyyy")"
                    data-reflect-outcome="@latestReflectable.Outcome"
                    onclick="openReflectionFromButton(this)"
                    title="Self-evaluate your most recent call / meeting / demo (private)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4Z"/></svg>
                Evaluate latest call
            </button>
        }
        @if (!Model.IsConverted)
        {
            <button class="btn btn-primary" onclick="openConvertModal()">Convert to Lead</button>
        }
        else
        {
            <span class="pill pill-green" style="align-self:center;">Converted → Lead #@Model.ConvertedLeadRequestId</span>
        }
    </div>
</div>

@{
    // Dot colour per activity type (matches the mockup palette).
    string DotColour(byte t) => t switch
    {
        1 => "#129867", // Research — green
        2 => "#C8912E", // Call — gold
        3 => "#0D5EA6", // Email — blue
        4 => "#1A8AB5", // Meeting — cyan
        5 => "#1A8AB5", // Demo — cyan
        6 => "#8a9bab", // Note — grey
        7 => "#8a9bab", // Social — grey
        _ => "#8a9bab"  // Other — grey
    };

    void ScoreRow(string label, byte value)
    {
        <div style="margin-bottom:12px;">
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;"><span>@label</span><strong>@value / 5</strong></div>
            <div style="height:8px;background:rgba(13,94,166,.08);border-radius:999px;overflow:hidden;">
                <div style="height:100%;width:@(value * 20)%;background:linear-gradient(90deg,#1A6BB8,#0D5EA6);"></div>
            </div>
        </div>
    }
}

<div class="prospect-detail-grid" style="display:grid;grid-template-columns:1.35fr 1fr;gap:22px;align-items:start;">
    <!-- LEFT: Identity & contact, then Activity timeline -->
    <div style="display:flex;flex-direction:column;gap:22px;">
        <section class="glass card-pad">
            <div style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#73889a;margin-bottom:14px;">Identity &amp; contact</div>
            <div class="identity-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:13px;">
                <div><div style="color:#73889a;font-size:11px;">Phone (research)</div>@Val(Model.Phone)</div>
                <div><div style="color:#73889a;font-size:11px;">Email (research)</div>@Val(Model.Email)</div>
                <div>
                    <div style="color:#73889a;font-size:11px;">Website</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Website))
                    {
                        <a href="@Model.Website" target="_blank" rel="noopener" style="color:var(--blue);">@Model.Website</a>
                    }
                    else { <text>—</text> }
                </div>
                <div><div style="color:#73889a;font-size:11px;">Public Contact / Role</div>@Val(Model.PublicContactRole)</div>
                <div><div style="color:#73889a;font-size:11px;">Business Type</div>@Val(Model.BusinessType)</div>
                <div><div style="color:#73889a;font-size:11px;">Recommended First Contact</div>@Val(Model.RecommendedFirstContact)</div>
            </div>
            <p style="margin-top:16px;font-size:12px;color:#8D5D07;background:rgba(200,145,46,.06);border:1px solid rgba(200,145,46,.18);border-radius:10px;padding:10px 14px;">
                These are <strong>public prospecting details</strong>, not a Sales contact. A Sales Contact is created only on conversion.
            </p>
        </section>

        <section class="glass card-pad">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <div style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#73889a;">Activity timeline</div>
                <button class="btn btn-secondary" style="font-size:12px;padding:7px 13px;" onclick="openActivityModal()">+ Add Activity</button>
            </div>
            @if (Model.Activities.Count == 0)
            {
                <div class="empty-state"><p>No activity yet. Record research, a call, an email, or a note.</p></div>
            }
            else
            {
                <div class="prospect-timeline">
                    @foreach (var a in Model.Activities)
                    {
                        <div class="activity-row tl"
                             data-id="@a.Id"
                             data-type="@a.ActivityType"
                             data-occurred="@a.OccurredAtUtc.ToString("yyyy-MM-ddTHH:mm")"
                             data-sentiment="@(a.Sentiment?.ToString() ?? "")"
                             data-isfollowup="@(a.IsFollowUp ? "1" : "0")"
                             data-outcome="@a.Outcome"
                             data-notes="@a.Notes"
                             data-nextaction="@a.NextAction"
                             data-nextactiondate="@(a.NextActionDate?.ToString("yyyy-MM-dd") ?? "")"
                             data-nextactiontime="@(a.NextActionTime?.ToString("HH:mm") ?? "")"
                             data-nextactioncontactname="@a.NextActionContactName"
                             data-nextactionphone="@a.NextActionPhone"
                             data-nextactionemail="@a.NextActionEmail">
                            <span class="tl-dot" style="background:@DotColour(a.ActivityType);"></span>
                            <div class="tl-body">
                                <div class="tl-line">
                                    <strong>@a.ActivityTypeName</strong>@if (!string.IsNullOrWhiteSpace(a.Outcome)) { <span> — @a.Outcome</span> }
                                    @if (a.Sentiment == 1)
                                    {
                                        <span class="pill pill-sm pill-green" style="margin-left:6px;">Positive</span>
                                    }
                                    else if (a.Sentiment == 3)
                                    {
                                        <span class="pill pill-sm pill-red" style="margin-left:6px;">Negative</span>
                                    }
                                    else if (a.Sentiment == 2)
                                    {
                                        <span class="pill pill-sm pill-grey" style="margin-left:6px;">Neutral</span>
                                    }
                                    @if (a.IsFollowUp)
                                    {
                                        <span style="margin-left:6px;font-size:11px;color:#8D5D07;">⚑ follow-up</span>
                                    }
                                    @{
                                        var evaluatedIds = ViewBag.EvaluatedActivityIds as HashSet<int> ?? new HashSet<int>();
                                        var isReflectable = a.ActivityType is 2 or 4 or 5; // Call / Meeting / Demo
                                        var hasReflection = evaluatedIds.Contains(a.Id);
                                    }
                                    @if (isReflectable && hasReflection)
                                    {
                                        <span class="tl-reflect-lock" title="You have a private reflection on this activity" aria-label="Private reflection recorded">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                                            Reflected
                                        </span>
                                    }
                                    <button class="tl-edit" onclick="editActivityFromRow(this)" title="Edit activity">Edit</button>
                                    @if (isReflectable)
                                    {
                                        <button class="tl-reflect"
                                                data-reflect-for="@a.Id"
                                                data-reflect-type="@((byte)a.ActivityType)"
                                                data-reflect-typename="@a.ActivityTypeName"
                                                data-reflect-date="@a.OccurredAtUtc.ToString("dd MMM yyyy")"
                                                data-reflect-outcome="@a.Outcome"
                                                onclick="openReflectionFromButton(this)"
                                                title="Private self-evaluation">@(hasReflection ? "View Reflection" : "Evaluate")</button>
                                    }
                                </div>
                                <div class="tl-sub">@a.OccurredAtUtc.ToString("dd MMM yyyy") · You</div>
                                @if (!string.IsNullOrWhiteSpace(a.Notes))
                                {
                                    <div class="tl-notes">@a.Notes</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(a.NextAction) || a.NextActionDate.HasValue || !string.IsNullOrWhiteSpace(a.NextActionContactName) || !string.IsNullOrWhiteSpace(a.NextActionPhone))
                                {
                                    var whenParts = new List<string>();
                                    if (a.NextActionDate.HasValue) { whenParts.Add(a.NextActionDate.Value.ToString("dd MMM yyyy")); }
                                    if (a.NextActionTime.HasValue) { whenParts.Add(a.NextActionTime.Value.ToString("HH:mm")); }
                                    var contactParts = new List<string>();
                                    if (!string.IsNullOrWhiteSpace(a.NextActionContactName)) { contactParts.Add(a.NextActionContactName!); }
                                    if (!string.IsNullOrWhiteSpace(a.NextActionPhone)) { contactParts.Add(a.NextActionPhone!); }
                                    if (!string.IsNullOrWhiteSpace(a.NextActionEmail)) { contactParts.Add(a.NextActionEmail!); }
                                    <div class="tl-next">
                                        Next: @(string.IsNullOrWhiteSpace(a.NextAction) ? "Follow up" : a.NextAction)@(whenParts.Any() ? " · " + string.Join(" ", whenParts) : "")@(contactParts.Any() ? " · " + string.Join(" — ", contactParts) : "")
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            <div style="margin-top:16px;padding-top:14px;font-size:12px;color:#73889a;border-top:1px dashed rgba(13,94,166,.12);">
                Recording activity never creates a Lead or Contact — entries stay with the prospect and survive conversion.
            </div>
        </section>
    </div>

    <!-- RIGHT: Research, then Qualification score + Status -->
    <div style="display:flex;flex-direction:column;gap:22px;">
        <section class="glass card-pad">
            <div style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#73889a;margin-bottom:14px;">Research</div>
            <div style="margin-bottom:14px;">
                <div style="color:#73889a;font-size:11px;">Public evidence</div>
                <div style="font-size:13px;">@Val(Model.PublicEvidence)</div>
            </div>
            <div style="margin-bottom:14px;">
                <div style="color:#73889a;font-size:11px;">Why it may fit</div>
                <div style="font-size:13px;">@Val(Model.WhyFit)</div>
            </div>
            <div>
                <div style="color:#73889a;font-size:11px;">Research source</div>
                @if (!string.IsNullOrWhiteSpace(Model.ResearchSourceUrl))
                {
                    <a href="@Model.ResearchSourceUrl" target="_blank" rel="noopener" style="color:var(--blue);">@Model.ResearchSourceUrl</a>
                }
                else { <text>—</text> }
            </div>
        </section>

        <section class="glass card-pad">
            <div style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#73889a;margin-bottom:14px;">Qualification score</div>
            @{ ScoreRow("ICP Fit", Model.IcpFitScore); }
            @{ ScoreRow("Pain Probability", Model.PainProbabilityScore); }
            @{ ScoreRow("Accessibility", Model.AccessibilityScore); }
            @{ ScoreRow("Learning Value", Model.LearningValueScore); }
            <div style="margin-top:16px;padding-top:14px;border-top:1px solid rgba(13,94,166,.1);display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div style="font-family:Manrope,Inter,sans-serif;font-weight:800;font-size:28px;">@Model.Total<span style="font-size:16px;color:#73889a;">/20</span></div>
                    <div style="font-size:11px;color:#73889a;">Total (computed)</div>
                </div>
                <span class="pill @PriorityPill(Model.Priority)">Priority @Model.Priority</span>
            </div>
            <div style="margin-top:16px;">
                <div class="field"><label>Status</label>
                    <select id="statusSelect" onchange="changeProspectStatus(@Model.Id, this.value)" @(Model.IsConverted ? "disabled" : "")>
                        <option value="1" selected="@(Model.Status == 1)">Research</option>
                        <option value="2" selected="@(Model.Status == 2)">Ready</option>
                        <option value="3" selected="@(Model.Status == 3)">Contacting</option>
                        <option value="4" selected="@(Model.Status == 4)">Engaged</option>
                        <option value="6" selected="@(Model.Status == 6)">Disqualified</option>
                        @if (Model.Status == 5)
                        {
                            <option value="5" selected="selected">Converted</option>
                        }
                    </select>
                </div>
            </div>

            @{
                // Status meaning reference — explains each stage of the prospect lifecycle so the
                // operator understands what a status represents and what moves a prospect forward.
                // The current stage is highlighted; terminal stages (Converted / Disqualified) are
                // shown with their own tints.
                var statusGuide = new (int Id, string Name, string Meaning, string Tint, string Fg)[]
                {
                    (1, "Research", "Gathering intel. Not yet ready to contact — qualification is still being built.", "rgba(115,136,154,.10)", "#5a6a7a"),
                    (2, "Ready", "Qualified and cleared for outreach. Waiting for the first contact to be made.", "rgba(13,94,166,.08)", "#0D5EA6"),
                    (3, "Contacting", "Outreach has started. Attempting to reach the prospect, no two-way conversation yet.", "rgba(87,184,232,.12)", "#2b7bb0"),
                    (4, "Engaged", "A real conversation is underway — replies, meetings or demos. Ready to convert when it lands.", "rgba(200,145,46,.12)", "#C8912E"),
                    (5, "Converted", "Became a customer. The prospect record is closed-won and locked.", "rgba(18,152,103,.12)", "#129867"),
                    (6, "Disqualified", "Not a fit, or will not proceed. Closed-lost — kept for history, no further action.", "rgba(194,74,74,.10)", "#C24A4A"),
                };
            }
            <div style="margin-top:16px;padding-top:14px;border-top:1px solid rgba(13,94,166,.1);">
                <div style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#73889a;margin-bottom:10px;">What these statuses mean</div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    @foreach (var s in statusGuide)
                    {
                        var isCurrent = Model.Status == s.Id;
                        <div style="display:flex;gap:10px;align-items:flex-start;padding:9px 11px;border-radius:12px;background:@(isCurrent ? s.Tint : "transparent");@(isCurrent ? "border:1px solid " + s.Fg + "33;" : "border:1px solid transparent;")">
                            <span style="flex:0 0 auto;margin-top:1px;font-size:11px;font-weight:800;color:@s.Fg;background:@s.Tint;border-radius:7px;padding:2px 8px;white-space:nowrap;">@s.Name</span>
                            <div style="font-size:12px;line-height:1.5;color:#5a6a7a;">
                                @s.Meaning
                                @if (isCurrent)
                                {
                                    <span style="display:inline-block;margin-left:4px;font-weight:800;color:@s.Fg;">• Current</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Add / Edit Activity Modal -->
<div id="activityModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:520px;">
        <h3 id="activityModalTitle" style="margin-bottom:16px;">Add Activity</h3>
        <input type="hidden" id="activityProspectId" value="@Model.Id" />
        <input type="hidden" id="activityId" value="" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field">
                <label>Type</label>
                <select id="activityType">
                    @{
                        var activityTypes = ViewBag.ActivityTypes as IReadOnlyList<ActivityTypeDto> ?? new List<ActivityTypeDto>();
                    }
                    @foreach (var t in activityTypes)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>
            <div class="field" id="activityNewStatusField">
                <label>Advance status to</label>
                <select id="activityNewStatus">
                    <option value="">— Leave unchanged —</option>
                    <option value="2">Ready</option>
                    <option value="3">Contacting</option>
                    <option value="4">Engaged</option>
                    <option value="6">Disqualified</option>
                </select>
            </div>
        </div>
        <div class="field">
            <label>When</label>
            <div class="act-chips" style="margin-bottom:8px;">
                <button type="button" class="act-chip" onclick="setActivityWhen('now')">Now</button>
                <button type="button" class="act-chip" onclick="setActivityWhen('today')">Today</button>
                <button type="button" class="act-chip" onclick="setActivityWhen('yesterday')">Yesterday</button>
            </div>
            <input type="datetime-local" id="activityOccurredAt" />
        </div>
        <div class="field">
            <label>Outcome</label>
            <div class="act-chips" id="activityPresets" style="margin-bottom:8px;"></div>
            <input type="text" id="activityOutcome" placeholder="e.g. Spoke with principal — interested" />
        </div>
        <div class="field">
            <label>Interaction signal</label>
            <div class="act-seg" id="activitySentiment">
                <button type="button" data-v="1" onclick="pickActivitySentiment(this)">🙂 Positive</button>
                <button type="button" data-v="2" onclick="pickActivitySentiment(this)">😐 Neutral</button>
                <button type="button" data-v="3" onclick="pickActivitySentiment(this)">🙁 Negative</button>
            </div>
            <div style="font-size:11px;color:#73889a;margin-top:6px;">Optional. Helps later evaluate whether the prospect score predicted well.</div>
        </div>
        <div class="field"><label>Notes</label><textarea id="activityNotes" rows="2"></textarea></div>
        <label class="act-check" style="display:flex;align-items:center;gap:9px;font-size:13px;font-weight:600;color:#334155;cursor:pointer;margin-bottom:12px;">
            <input type="checkbox" id="activityIsFollowUp" onchange="toggleActivityFollowUp(this)" /> This needs a follow-up
        </label>
        <div id="activityFollowUpBox" style="display:none;background:rgba(200,145,46,.05);border:1px solid rgba(200,145,46,.16);border-radius:12px;padding:12px 14px;margin-bottom:12px;">
            <div class="field" style="margin-bottom:12px;">
                <label>Next action</label>
                <div class="act-chips" style="margin-bottom:8px;">
                    <button type="button" class="act-chip" onclick="setNextAction('Call again')">Call again</button>
                    <button type="button" class="act-chip" onclick="setNextAction('Send SMS')">Send SMS</button>
                    <button type="button" class="act-chip" onclick="setNextAction('Send email')">Send email</button>
                    <button type="button" class="act-chip" onclick="setNextAction('Send proposal')">Send proposal</button>
                    <button type="button" class="act-chip" onclick="setNextAction('Book meeting')">Book meeting</button>
                    <button type="button" class="act-chip" onclick="setNextAction('Book demo')">Book demo</button>
                    <button type="button" class="act-chip" onclick="setNextAction('Check back')">Check back</button>
                </div>
                <input type="text" id="activityNextAction" />
            </div>
            <div class="field" style="margin-bottom:12px;">
                <label>Due date</label>
                <div class="act-chips" style="margin-bottom:8px;">
                    <button type="button" class="act-chip" onclick="setNextActionDate('tomorrow')">Tomorrow</button>
                    <button type="button" class="act-chip" onclick="setNextActionDate('3d')">+3 days</button>
                    <button type="button" class="act-chip" onclick="setNextActionDate('nextweek')">Next week</button>
                    <button type="button" class="act-chip" onclick="setNextActionDate('2w')">+2 weeks</button>
                    <button type="button" class="act-chip" onclick="setNextActionDate('1m')">+1 month</button>
                </div>
                <input type="date" id="activityNextActionDate" />
            </div>
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:0;">
                <div class="field" style="margin-bottom:0;flex:0 0 120px;">
                    <label>Time</label>
                    <div class="act-chips" style="margin-bottom:8px;">
                        <button type="button" class="act-chip" onclick="setNextActionTime('09:00')">09:00</button>
                        <button type="button" class="act-chip" onclick="setNextActionTime('10:00')">10:00</button>
                        <button type="button" class="act-chip" onclick="setNextActionTime('14:00')">14:00</button>
                    </div>
                    <input type="time" id="activityNextActionTime" />
                </div>
                <div class="field" style="margin-bottom:0;flex:1 1 180px;">
                    <label>Contact name</label>
                    <input type="text" id="activityNextActionContactName" placeholder="e.g. Mrs Louiza" maxlength="200" />
                </div>
                <div class="field" style="margin-bottom:0;flex:1 1 150px;">
                    <label>Phone</label>
                    <input type="text" id="activityNextActionPhone" placeholder="e.g. 99464295" maxlength="30" />
                </div>
                <div class="field" style="margin-bottom:0;flex:1 1 200px;">
                    <label>Email</label>
                    <input type="email" id="activityNextActionEmail" placeholder="e.g. stella@acme.com" maxlength="320" />
                </div>
            </div>
            <div style="font-size:11px;color:#8D5D07;margin-top:8px;">Counts toward the campaign's "follow-ups due".</div>
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
            <button class="btn btn-secondary" onclick="closeActivityModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitActivity()">Save activity</button>
        </div>
    </div>
</div>

<!-- Convert to Lead Modal -->
<div id="convertModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:560px;">
        <h3 style="margin-bottom:8px;">Convert to Lead</h3>
        <p style="font-size:12px;color:#5a6a7a;margin-bottom:16px;">
            This creates a <strong>Sales Contact</strong> and a <strong>Lead</strong> (Source: Cold Call), links them back to this prospect for scoring measurement, and marks the prospect <strong>Converted</strong>.
        </p>
        <input type="hidden" id="convertProspectId" value="@Model.Id" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>First Name *</label><input type="text" id="convertFirstName" /></div>
            <div class="field"><label>Last Name</label><input type="text" id="convertLastName" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Email</label><input type="text" id="convertEmail" value="@Model.Email" /></div>
            <div class="field"><label>Phone</label><input type="text" id="convertPhone" value="@Model.Phone" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Company</label><input type="text" id="convertCompany" value="@Model.Name" /></div>
            <div class="field"><label>Job Title</label><input type="text" id="convertJobTitle" value="@Model.PublicContactRole" /></div>
        </div>
        <div class="field"><label>Country</label><input type="text" id="convertCountry" value="@Model.Location" /></div>
        <div class="field"><label>Request / note for the lead</label><textarea id="convertRequestText" rows="2">@Model.WhyFit</textarea></div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
            <button class="btn btn-secondary" onclick="closeConvertModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitConvert()">Create Contact &amp; Lead</button>
        </div>
    </div>
</div>

<!-- ══ Call Reflection (private self-evaluation) Modal ══════════════════════════ -->
<div id="reflectionModal" class="modal-overlay" style="display:none;">
    <div class="modal-content reflection-modal" style="max-width:640px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
            <div>
                <div class="eyebrow" style="color:#6b4d8a;"><span class="dot" style="background:#6b4d8a;"></span> Private self-assessment</div>
                <h3 id="reflectionTitle" style="margin:4px 0 2px;">Call Reflection</h3>
                <div style="font-size:12px;color:#73889a;" id="reflectionContext">Personal development · Private evaluation</div>
            </div>
            <button type="button" class="reflect-close" onclick="closeReflection()" aria-label="Close reflection">&times;</button>
        </div>

        <div class="reflect-privacy">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            <span>Personal development only. Private to you — never shown in shared views, exports, or the activity feed, and it never changes the prospect's status, score, or conversion.</span>
        </div>

        <input type="hidden" id="reflectionActivityId" value="" />
        <input type="hidden" id="reflectionMode" value="activity" />

        <!-- Pre-call intention (shown in both modes; the only section in pre-call mode) -->
        <div id="reflectionPreCallBox" style="margin-top:18px;">
            <div class="reflect-section-title">Before the call — intention <span style="font-weight:500;color:#73889a;">(optional)</span></div>
            <div class="field" style="margin-bottom:12px;">
                <label for="reflectPreCallObjective">Commercial objective</label>
                <textarea id="reflectPreCallObjective" rows="2" maxlength="1000" placeholder="e.g. Understand their client-coordination workflow and assess whether a demo fits."></textarea>
            </div>
            <div class="field" style="margin-bottom:0;">
                <label for="reflectPreCallFocus">Personal practice focus</label>
                <textarea id="reflectPreCallFocus" rows="2" maxlength="1000" placeholder="e.g. Ask one discovery question before describing features."></textarea>
            </div>
        </div>

        <!-- Everything below is the post-call reflection; hidden in pure pre-call mode -->
        <div id="reflectionBody">
            <div class="reflect-section-title" style="margin-top:20px;">How did I communicate?</div>
            <p style="font-size:12px;color:#73889a;margin:0 0 6px;">Rate 1–5, or leave a criterion <strong>Not assessed</strong>. 1 = needs improvement · 5 = particularly effective.</p>
            <div id="reflectionCriteria"></div>

            <div class="reflect-summary">
                <div>
                    <div style="font-weight:700;color:#0B1B28;">Self-assessment average</div>
                    <div style="font-size:12px;color:#73889a;" id="reflectionAssessedCount">Not scored · 0 of 6 assessed</div>
                </div>
                <div class="reflect-avg" id="reflectionAverage">—</div>
            </div>

            <div class="field" style="margin-bottom:12px;">
                <label for="reflectObservations">What did I notice about this conversation?</label>
                <textarea id="reflectObservations" rows="2" maxlength="2000" placeholder="Consider the circumstances, your listening, and how they responded."></textarea>
            </div>
            <div class="field" style="margin-bottom:12px;">
                <label for="reflectStrengths">What did I do effectively?</label>
                <textarea id="reflectStrengths" rows="2" maxlength="2000" placeholder="Identify what worked — even if there was no commercial progress."></textarea>
            </div>
            <div class="field" style="margin-bottom:4px;">
                <label for="reflectImprovement">What will I do differently next time?</label>
                <textarea id="reflectImprovement" rows="2" maxlength="2000" placeholder="Choose one concrete behaviour to practise."></textarea>
            </div>

            <details class="reflect-tips">
                <summary>Communication tips</summary>
                <div class="reflect-tip-note">Adapt your communication style, not your integrity or claims.</div>
                <div class="field" style="margin:10px 0;">
                    <label for="reflectTipSituation">Observed circumstance</label>
                    <select id="reflectTipSituation" onchange="renderReflectionTip()">
                        <option value="busy">Busy / direct</option>
                        <option value="analytical">Analytical / technical questions</option>
                        <option value="experienced">Experienced / sceptical</option>
                        <option value="friendly">Friendly / conversational</option>
                        <option value="price">Price-focused</option>
                        <option value="distracted">Distracted / driving</option>
                    </select>
                </div>
                <div id="reflectTipBody" class="reflect-tip-body"></div>
            </details>
        </div>

        <div style="display:flex;gap:12px;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;">
            <button class="btn btn-secondary reflect-delete" id="reflectionDeleteBtn" onclick="deleteReflection()" style="display:none;">Delete reflection</button>
            <div style="display:flex;gap:12px;margin-left:auto;">
                <button class="btn btn-secondary" onclick="closeReflection()">Cancel</button>
                <button class="btn btn-primary" id="reflectionSaveBtn" onclick="saveReflection()">Save reflection</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales/prospecting.js?v=16"></script>
    <script src="~/js/sales/prospect-reflection.js?v=1"></script>
}
