@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            background: #F7FAFC;
        }

        .canvas-panel {
            position: relative;
            flex: 1;
            background: #0B1B28;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .canvas-panel canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        .canvas-brand {
            position: relative;
            z-index: 2;
            text-align: center;
        }

        .canvas-brand img {
            width: 100px;
            height: auto;
            margin-bottom: 24px;
        }

        .canvas-brand .tagline {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: rgba(255,255,255,.5);
        }

        .form-panel {
            width: 480px;
            min-width: 480px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
            background: #fff;
        }

        .denied-card {
            width: 100%;
            max-width: 380px;
            text-align: center;
        }

        .denied-card .icon {
            width: 64px;
            height: 64px;
            background: #fef2f2;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

        .denied-card .icon svg {
            width: 32px;
            height: 32px;
            color: #C24A4A;
        }

        .denied-card h1 {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 28px;
            color: #C24A4A;
            letter-spacing: -.03em;
            margin-bottom: 12px;
        }

        .denied-card p {
            font-size: 15px;
            color: #5E7385;
            line-height: 1.7;
            margin-bottom: 32px;
        }

        .btn-back {
            display: inline-block;
            padding: 16px 32px;
            background: #0D5EA6;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            transition: background 0.2s, transform 0.1s;
        }

        .btn-back:hover {
            background: #0B4E89;
        }

        .btn-back:active {
            transform: scale(0.98);
        }

        .footer-text {
            margin-top: 32px;
            font-size: 12px;
            color: #94a3b8;
            letter-spacing: .04em;
        }

        @@media (max-width: 960px) {
            .canvas-panel { display: none; }
            .form-panel {
                width: 100%;
                min-width: unset;
                min-height: 100vh;
                background:
                    radial-gradient(circle at top left, rgba(13,94,166,.04), transparent 40%),
                    #F7FAFC;
            }
        }
    </style>
</head>
<body>

    <!-- Left: Particle Canvas -->
    <div class="canvas-panel">
        <canvas id="particles"></canvas>
        <div class="canvas-brand">
            <img src="/images/favicon.png" alt="3 Inventors" />
            <div class="tagline">Knowledge · Professionalism · Innovation</div>
        </div>
    </div>

    <!-- Right: Access Denied -->
    <div class="form-panel">
        <div class="denied-card">
            <div class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
            </div>
            <h1>Access Denied</h1>
            <p>You do not have permission to access this resource. Please contact your administrator if you believe this is an error.</p>
            <a href="/" class="btn-back">Back to Dashboard</a>
            <div class="footer-text">
                3 Inventors Limited · Operational Intelligence
            </div>
        </div>
    </div>

    <!-- Particle Animation -->
    <script>
    (function() {
        const canvas = document.getElementById('particles');
        const ctx = canvas.getContext('2d');
        let width, height;
        const particles = [];
        const PARTICLE_COUNT = 60;
        const CONNECTION_DISTANCE = 140;
        const SPEED = 0.3;

        const colors = [
            'rgba(13, 94, 166, 0.6)',
            'rgba(87, 184, 232, 0.5)',
            'rgba(255, 255, 255, 0.3)'
        ];

        function resize() {
            width = canvas.width = canvas.offsetWidth;
            height = canvas.height = canvas.offsetHeight;
        }

        function createParticle() {
            return {
                x: Math.random() * width,
                y: Math.random() * height,
                vx: (Math.random() - 0.5) * SPEED,
                vy: (Math.random() - 0.5) * SPEED,
                radius: Math.random() * 2 + 1,
                color: colors[Math.floor(Math.random() * colors.length)]
            };
        }

        function init() {
            resize();
            particles.length = 0;
            for (let i = 0; i < PARTICLE_COUNT; i++) {
                particles.push(createParticle());
            }
        }

        function update() {
            for (const p of particles) {
                p.x += p.vx;
                p.y += p.vy;
                if (p.x < 0 || p.x > width) p.vx *= -1;
                if (p.y < 0 || p.y > height) p.vy *= -1;
            }
        }

        function draw() {
            ctx.clearRect(0, 0, width, height);

            for (let i = 0; i < particles.length; i++) {
                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const dist = Math.sqrt(dx * dx + dy * dy);

                    if (dist < CONNECTION_DISTANCE) {
                        const opacity = 1 - (dist / CONNECTION_DISTANCE);
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.strokeStyle = `rgba(13, 94, 166, ${opacity * 0.15})`;
                        ctx.lineWidth = 1;
                        ctx.stroke();
                    }
                }
            }

            for (const p of particles) {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.fill();
            }
        }

        function animate() {
            update();
            draw();
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', resize);
        init();
        animate();
    })();
    </script>

</body>
</html>
