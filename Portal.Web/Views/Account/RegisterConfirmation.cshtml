@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
}

<div style="text-align:center;">
    <div style="margin-bottom:20px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#57B8E8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <polyline points="22,5 12,13 2,5"></polyline>
            <circle cx="18" cy="15" r="3" fill="none" stroke="#129867" stroke-width="2"></circle>
            <polyline points="17 15 18 16 19.5 14" stroke="#129867" stroke-width="2"></polyline>
        </svg>
    </div>
    <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#ffffff;margin-bottom:12px;">Check Your Email</h2>
    <p style="color:rgba(255,255,255,0.75);font-size:15px;line-height:1.5;margin-bottom:28px;">
        We've sent a confirmation link to your email address. Please check your inbox and click the link to verify your account.
    </p>
    <p style="color:rgba(255,255,255,0.5);font-size:13px;line-height:1.5;">
        Didn't receive the email? Check your spam folder or wait a few minutes and try again.
    </p>
</div>
