@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
}

<div style="text-align:center;">
    <div style="margin-bottom:20px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#57B8E8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <polyline points="22,5 12,13 2,5"></polyline>
            <path d="M16 12l2 2 4-4" stroke="#129867" stroke-width="2" fill="none"></path>
        </svg>
    </div>
    <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#ffffff;margin-bottom:12px;">Check Your Email</h2>
    <p style="color:rgba(255,255,255,0.75);font-size:15px;line-height:1.5;margin-bottom:12px;">
        If an account exists with that email, a reset link has been sent.
    </p>
    <p style="color:rgba(255,255,255,0.5);font-size:13px;line-height:1.5;margin-bottom:28px;">
        Please check your inbox and spam folder. The link will expire in 24 hours.
    </p>
    <a href="@Url.Action("Login", "Account")"
       style="display:inline-block;padding:12px 28px;background:#0D5EA6;color:#ffffff;border-radius:10px;font-size:15px;font-weight:600;text-decoration:none;">
        Back to Login
    </a>
</div>
