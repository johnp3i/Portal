@model Portal.Web.Models.ResetPasswordViewModel
@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
}

@if (ViewData["Error"] != null)
{
    <div style="text-align:center;">
        <div style="margin-bottom:20px;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C24A4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#ffffff;margin-bottom:12px;">Reset Link Invalid</h2>
        <p role="alert" style="color:rgba(255,255,255,0.75);font-size:15px;line-height:1.5;margin-bottom:24px;">@ViewData["Error"]</p>
        <a href="@Url.Action("ForgotPassword", "Account")"
           style="display:inline-block;padding:12px 28px;background:#0D5EA6;color:#ffffff;border-radius:12px;text-decoration:none;font-weight:600;font-size:15px;">
            Request New Reset Link
        </a>
    </div>
}
else
{
    <h2 style="font-family:'Manrope',sans-serif;font-size:24px;font-weight:700;color:#ffffff;margin-bottom:8px;text-align:center;">Reset Password</h2>
    <p style="color:rgba(255,255,255,0.7);font-size:14px;text-align:center;margin-bottom:28px;">Enter your new password below.</p>

    <form method="post" asp-action="ResetPassword" asp-controller="Account" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Any() == true)
        {
            <div role="alert" style="background:rgba(194,74,74,0.15);border:1px solid rgba(194,74,74,0.4);border-radius:10px;padding:12px 16px;margin-bottom:20px;">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <p style="color:#ff8a8a;font-size:13px;margin:0;">@error.ErrorMessage</p>
                }
            </div>
        }

        <div style="margin-bottom:18px;">
            <label for="Password" style="display:block;font-size:13px;font-weight:600;color:rgba(255,255,255,0.85);margin-bottom:6px;">New Password</label>
            <input id="Password" name="Password" type="password" asp-for="Password"
                   aria-required="true"
                   aria-invalid="@(ViewData.ModelState["Password"]?.Errors.Any() == true ? "true" : null)"
                   aria-describedby="@(ViewData.ModelState["Password"]?.Errors.Any() == true ? "Password-error" : null)"
                   autocomplete="new-password"
                   style="width:100%;padding:12px 16px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.2);border-radius:10px;color:#ffffff;font-size:15px;outline:none;transition:border-color 0.2s;" />
            <span id="Password-error" asp-validation-for="Password" role="alert"
                  style="display:block;color:#ff8a8a;font-size:12px;margin-top:4px;min-height:16px;"></span>
        </div>

        <div style="margin-bottom:24px;">
            <label for="ConfirmPassword" style="display:block;font-size:13px;font-weight:600;color:rgba(255,255,255,0.85);margin-bottom:6px;">Confirm Password</label>
            <input id="ConfirmPassword" name="ConfirmPassword" type="password" asp-for="ConfirmPassword"
                   aria-required="true"
                   aria-invalid="@(ViewData.ModelState["ConfirmPassword"]?.Errors.Any() == true ? "true" : null)"
                   aria-describedby="@(ViewData.ModelState["ConfirmPassword"]?.Errors.Any() == true ? "ConfirmPassword-error" : null)"
                   autocomplete="new-password"
                   style="width:100%;padding:12px 16px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.2);border-radius:10px;color:#ffffff;font-size:15px;outline:none;transition:border-color 0.2s;" />
            <span id="ConfirmPassword-error" asp-validation-for="ConfirmPassword" role="alert"
                  style="display:block;color:#ff8a8a;font-size:12px;margin-top:4px;min-height:16px;"></span>
        </div>

        <button type="submit"
                style="width:100%;padding:14px;background:#0D5EA6;color:#ffffff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;transition:background 0.2s;">
            Reset Password
        </button>
    </form>

    <div style="text-align:center;margin-top:20px;">
        <a href="@Url.Action("ForgotPassword", "Account")" style="color:#57B8E8;font-size:13px;text-decoration:none;font-weight:500;">Request a new reset link</a>
    </div>
}
