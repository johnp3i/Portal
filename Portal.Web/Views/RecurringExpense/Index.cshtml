@{
    ViewData["Title"] = "Recurring Expense Validation";
    var vatPeriods = (List<Portal.Infrastructure.Entities.VatSubmissionPeriod>)ViewBag.VatPeriods;
}

@Html.AntiForgeryToken()

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Purchases</div>
        <h1 class="topbar-heading">Recurring Expense Validation</h1>
        <p class="topbar-subtitle">Check whether expected recurring purchases have been recorded for a given period.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <a href="/RecurringExpense/Rules"
           style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:12px;font-size:13px;font-weight:700;color:#fff;background:linear-gradient(135deg,#0D5EA6 0%,#57B8E8 100%);box-shadow:0 8px 20px rgba(13,94,166,.22);text-decoration:none;transition:all .2s;letter-spacing:.02em;"
           onmouseenter="this.style.transform='translateY(-1px)';this.style.boxShadow='0 12px 28px rgba(13,94,166,.28)'"
           onmouseleave="this.style.transform='none';this.style.boxShadow='0 8px 20px rgba(13,94,166,.22)'">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33h.09a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82v.09a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
            Manage Rules
        </a>
    </div>
</div>

<!-- Filter Panel -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:220px;">
            <label for="vatPeriodSelect">VAT Period</label>
            <select id="vatPeriodSelect" onchange="onPeriodChange()">
                <option value="">Custom Date Range</option>
                @foreach (var period in vatPeriods)
                {
                    <option value="@period.Id"
                            data-start="@period.PeriodStartDate.ToString("yyyy-MM-dd")"
                            data-end="@period.PeriodEndDate.ToString("yyyy-MM-dd")">
                        @period.PeriodStartDate.ToString("MMM yyyy") &ndash; @period.PeriodEndDate.ToString("MMM yyyy")
                    </option>
                }
            </select>
        </div>
        <div class="field" style="min-width:180px;" id="dateFromField">
            <label for="dateFrom">From</label>
            <input type="date" id="dateFrom" />
        </div>
        <div class="field" style="min-width:180px;" id="dateToField">
            <label for="dateTo">To</label>
            <input type="date" id="dateTo" />
        </div>
        <div style="padding-bottom:2px;">
            <button type="button" class="btn btn-primary" onclick="runValidation()">Validate</button>
        </div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#5E7385;margin-right:4px;">Quick:</span>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('this_month')">This Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_month')">Last Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_3')">Last 3 Months</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_6')">Last 6 Months</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('this_year')">This Year</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_year')">Last Year</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('all')">All Time</button>
    </div>
</section>

<!-- Results -->
<section class="glass card-pad">
    <div id="validationResults">
        <div class="empty-state">
            <p>Select a period or date range and click Validate to check recurring expenses.</p>
        </div>
    </div>
</section>

@section Scripts {
    <style>
        .period-shortcut{padding:5px 12px;border-radius:8px;border:1.5px solid rgba(13,94,166,.12);background:#fff;font-size:12px;font-weight:600;font-family:'Inter',sans-serif;color:#5E7385;cursor:pointer;transition:all .15s}
        .period-shortcut:hover{background:rgba(13,94,166,.06);border-color:rgba(13,94,166,.25);color:#0D5EA6}
        .period-shortcut.active{background:rgba(13,94,166,.08);border-color:#0D5EA6;color:#0D5EA6}
    </style>
    <script>
        var dateFromField = document.getElementById('dateFromField');
        var dateToField = document.getElementById('dateToField');
        var vatPeriodSelect = document.getElementById('vatPeriodSelect');

        // Auto-select current open period if available (first unsubmitted period)
        (function initDefaults() {
            var options = vatPeriodSelect.options;
            for (var i = 1; i < options.length; i++) {
                // Select the first period by default
                options[i].selected = true;
                onPeriodChange();
                break;
            }
        })();

        function onPeriodChange() {
            var selected = vatPeriodSelect.options[vatPeriodSelect.selectedIndex];
            if (selected.value) {
                // Period selected — hide custom date fields, populate from data attrs
                dateFromField.style.display = 'none';
                dateToField.style.display = 'none';
                document.getElementById('dateFrom').value = selected.getAttribute('data-start');
                document.getElementById('dateTo').value = selected.getAttribute('data-end');
            } else {
                // Custom — show date fields
                dateFromField.style.display = '';
                dateToField.style.display = '';
            }
        }

        async function runValidation() {
            var startDate = document.getElementById('dateFrom').value;
            var endDate = document.getElementById('dateTo').value;

            if (!startDate || !endDate) {
                Swal.fire({ icon: 'warning', title: 'Missing Dates', text: 'Please select a date range or VAT period.', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var container = document.getElementById('validationResults');
            BlockUI.show('Validating...');

            try {
                var response = await fetch('/RecurringExpense/Validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ startDate: startDate, endDate: endDate })
                });
                var data = await response.json();
                BlockUI.hide();

                if (!data.success) {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Validation failed.', confirmButtonColor: '#0D5EA6' });
                    return;
                }

                if (data.ruleResults.length === 0) {
                    container.innerHTML = '<div class="empty-state"><p>No recurring expense rules configured. <a href="/RecurringExpense/Rules" style="color:#0D5EA6;font-weight:600;">Set up rules</a></p></div>';
                    return;
                }

                renderResults(data, container);
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        }

        var currencySymbol = '@Html.Raw(ViewBag.CurrencySymbol ?? "€")';

        function renderResults(data, container) {
            var s = data.summary;
            var html = '';

            // Summary dots strip
            html += '<div style="display:flex;gap:18px;align-items:center;padding:12px 16px;background:#EEF4F8;border-radius:12px;margin-bottom:18px;">';
            if (s.passCount > 0) html += '<div style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;"><span style="width:8px;height:8px;border-radius:50%;background:#129867;display:inline-block;"></span> ' + s.passCount + ' Pass</div>';
            if (s.warningCount > 0) html += '<div style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;"><span style="width:8px;height:8px;border-radius:50%;background:#C8912E;display:inline-block;"></span> ' + s.warningCount + ' Warning</div>';
            if (s.failCount > 0) html += '<div style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;"><span style="width:8px;height:8px;border-radius:50%;background:#C24A4A;display:inline-block;"></span> ' + s.failCount + ' Missing</div>';
            html += '</div>';

            // Result rows (mockup style)
            data.ruleResults.forEach(function(r) {
                var statusIcon = '';
                var statusColor = '';
                if (r.status === 'fail') { statusIcon = '&#10007;'; statusColor = '#C24A4A'; }
                else if (r.status === 'warning') { statusIcon = '&#9650;'; statusColor = '#C8912E'; }
                else { statusIcon = '&#10003;'; statusColor = '#129867'; }

                var title = escapeHtml(r.supplierName) + ' &mdash; ' + (r.categoryName ? escapeHtml(r.categoryName) : '<span style="font-style:italic;color:#5E7385;">Any category</span>');

                var detail = escapeHtml(r.description);
                if (r.expectedAmount && r.expectedAmount > 0) {
                    var tolerance = r.amountTolerancePercent || 5;
                    detail += ' &middot; Expected ' + currencySymbol + r.expectedAmount.toFixed(2) + ' (&plusmn;' + tolerance + '%)';
                    if (r.status === 'fail' || (r.isAmountMatched === false)) {
                        detail += ' &middot; <span style="color:#C24A4A;font-weight:600;">Amount not found</span>';
                    } else if (r.isAmountMatched === true) {
                        detail += ' &middot; <span style="color:#129867;font-weight:600;">Amount matched</span>';
                    }
                }
                if (r.gracePeriodDays && r.gracePeriodDays > 0) {
                    detail += ' &middot; Grace: ' + r.gracePeriodDays + ' days';
                }

                var freqLabel = r.frequencyMonths === 1 ? 'months' : r.frequencyMonths === 3 ? 'quarter' : 'expected';
                var countText = '<span style="font-weight:700;color:' + statusColor + ';">' + r.actualCount + '</span> <span style="color:#5E7385;">/ ' + r.expectedCount + ' ' + freqLabel + '</span>';

                html += '<div style="display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid rgba(13,94,166,.05);">';
                html += '<div style="flex-shrink:0;width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;';
                if (r.status === 'fail') html += 'background:rgba(194,74,74,.1);color:#C24A4A;';
                else if (r.status === 'warning') html += 'background:rgba(200,145,46,.1);color:#C8912E;';
                else html += 'background:rgba(18,152,103,.1);color:#129867;';
                html += '">' + statusIcon + '</div>';
                html += '<div style="flex:1;min-width:0;">';
                html += '<div style="font-size:13px;font-weight:600;color:#0B1B28;">' + title + '</div>';
                html += '<div style="font-size:12px;color:#5E7385;margin-top:2px;">' + detail + '</div>';
                html += '</div>';
                html += '<div style="text-align:right;font-size:13px;white-space:nowrap;">' + countText + '</div>';
                html += '</div>';
            });

            // Advisory note
            html += '<div style="margin-top:16px;display:flex;align-items:center;gap:8px;padding:10px 14px;border-radius:10px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.08);font-size:12px;color:#5E7385;">';
            html += '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>';
            html += 'This check is advisory only. Record missing purchases and re-validate.';
            html += '</div>';

            container.innerHTML = html;
        }

        function setQuickPeriod(preset) {
            var now = new Date();
            var from, to;
            switch (preset) {
                case 'this_month': from = new Date(now.getFullYear(), now.getMonth(), 1); to = now; break;
                case 'last_month': from = new Date(now.getFullYear(), now.getMonth() - 1, 1); to = new Date(now.getFullYear(), now.getMonth(), 0); break;
                case 'last_3': from = new Date(now.getFullYear(), now.getMonth() - 3, 1); to = now; break;
                case 'last_6': from = new Date(now.getFullYear(), now.getMonth() - 6, 1); to = now; break;
                case 'this_year': from = new Date(now.getFullYear(), 0, 1); to = now; break;
                case 'last_year': from = new Date(now.getFullYear() - 1, 0, 1); to = new Date(now.getFullYear() - 1, 11, 31); break;
                case 'all': from = null; to = null; break;
            }
            // Reset VAT period dropdown to custom
            document.getElementById('vatPeriodSelect').value = '';
            // Show date fields (in case they were hidden by VAT period selection)
            document.getElementById('dateFromField').style.display = '';
            document.getElementById('dateToField').style.display = '';
            document.getElementById('dateFrom').value = from ? formatDateISO(from) : '';
            document.getElementById('dateTo').value = to ? formatDateISO(to) : '';
            document.querySelectorAll('.period-shortcut').forEach(function(b) { b.classList.remove('active'); });
            event.target.classList.add('active');
            runValidation();
        }

        function formatDateISO(d) {
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    </script>
}
