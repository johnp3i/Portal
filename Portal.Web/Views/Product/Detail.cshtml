@model Portal.Infrastructure.Models.ProductInsights.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Description;
    var cs = Model.CurrencySymbol;
    var p = Model.Product;
    var kpi = Model.Kpis;
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Product Catalogue</div>
        <h1 class="topbar-heading">@p.Description</h1>
        <p class="topbar-subtitle">@p.ProductCode · @(Model.ProductTypeName ?? "General") · @(p.IsActive ? "Active" : "Inactive")</p>
        <p style="font-size:13px;color:var(--muted);margin-top:4px;"><a href="/Product" style="color:var(--blue);text-decoration:none;font-weight:600;">Catalogue</a> › <a href="/Product" style="color:var(--blue);text-decoration:none;font-weight:600;">Products</a> › @p.ProductCode</p>
    </div>
    <div>
        <a href="/Product" class="btn btn-secondary" style="margin-right:8px;">← Back</a>
    </div>
</div>

<!-- Product Header -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
        @if (p.IsActive) { <span class="pill pill-green">Active</span> } else { <span class="pill" style="background:#fdeaea;color:#C24A4A;">Inactive</span> }
        @if (Model.ProductTypeName != null) { <span class="pill" style="background:rgba(13,94,166,.08);color:var(--blue);">@Model.ProductTypeName</span> }
    </div>
    <div class="product-meta-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:18px;">
        <div><div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Product Code</div><div style="font-size:15px;font-weight:600;margin-top:4px;">@p.ProductCode</div></div>
        <div><div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Selling Price</div><div style="font-size:15px;font-weight:600;margin-top:4px;">@cs@p.DefaultSellingPrice.ToString("N2")</div></div>
        <div><div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Cost Price</div><div style="font-size:15px;font-weight:600;margin-top:4px;">@cs@p.DefaultCostPrice.ToString("N2")</div></div>
        <div><div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">VAT Rate</div><div style="font-size:15px;font-weight:600;margin-top:4px;">@p.DefaultVatRate.ToString("N2")%</div></div>
        <div><div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Supplier</div><div style="font-size:15px;font-weight:600;margin-top:4px;">@(Model.SupplierName ?? "—")</div></div>
        <div><div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Last Used</div><div style="font-size:15px;font-weight:600;margin-top:4px;">@(p.LastUsedDate?.ToString("dd MMM yyyy") ?? "Never")</div></div>
    </div>
</section>

<!-- KPI Cards -->
<div class="product-kpi-grid" style="display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-bottom:22px;">
    <div class="glass card-pad" style="border-left:4px solid var(--green);">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Total Revenue</div>
        <div style="font-size:24px;font-weight:800;font-family:'Manrope',sans-serif;margin-top:6px;">@cs@kpi.TotalRevenue.ToString("N2")</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px;">From @kpi.InvoiceCount invoices</div>
    </div>
    <div class="glass card-pad">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Units Sold</div>
        <div style="font-size:24px;font-weight:800;font-family:'Manrope',sans-serif;margin-top:6px;">@kpi.TotalUnits.ToString("N0")</div>
    </div>
    <div class="glass card-pad">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Avg. Selling Price</div>
        <div style="font-size:24px;font-weight:800;font-family:'Manrope',sans-serif;margin-top:6px;">@cs@kpi.AvgSellingPrice.ToString("N2")</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px;">vs default @cs@p.DefaultSellingPrice.ToString("N2")</div>
    </div>
    <div class="glass card-pad">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Gross Margin</div>
        <div style="font-size:24px;font-weight:800;font-family:'Manrope',sans-serif;margin-top:6px;">@cs@kpi.GrossMargin.ToString("N2")</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px;">@kpi.MarginPercentage.ToString("N1")% margin</div>
    </div>
    <div class="glass card-pad">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);">Last Sold</div>
        <div style="font-size:18px;font-weight:800;font-family:'Manrope',sans-serif;margin-top:6px;">@(kpi.LastSoldDate?.ToString("dd MMM yyyy") ?? "Never")</div>
    </div>
</div>

<!-- Two Column: Customers + Trend -->
<div class="product-two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-bottom:22px;">
    <!-- Top Customers -->
    <section class="glass card-pad">
        <h3 style="font-size:16px;margin-bottom:4px;">Top Customers</h3>
        <p style="font-size:12px;color:var(--muted);margin-bottom:16px;">@Model.CustomerSummary.UniqueCustomerCount unique customers · @Model.CustomerSummary.RepeatPurchaseRate% repeat rate</p>
        @if (Model.TopCustomers.Any())
        {
            <table>
                <thead><tr><th>Customer</th><th style="text-align:right;">Units</th><th style="text-align:right;">Revenue</th><th>Last Purchase</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.TopCustomers)
                    {
                        <tr>
                            <td style="font-weight:600;">@c.CustomerName</td>
                            <td style="text-align:right;">@c.Units.ToString("N0")</td>
                            <td style="text-align:right;font-weight:700;color:var(--green);">@cs@c.Revenue.ToString("N2")</td>
                            <td>@c.LastPurchase.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p style="color:var(--muted);font-size:14px;">No customers yet.</p>
        }
    </section>

    <!-- Monthly Trend -->
    <section class="glass card-pad">
        <h3 style="font-size:16px;margin-bottom:4px;">Monthly Revenue Trend</h3>
        <p style="font-size:12px;color:var(--muted);margin-bottom:8px;">Last 12 months</p>
        <div style="position:relative;height:220px;">
            <canvas id="trendChart"></canvas>
        </div>
    </section>
</div>

<!-- Price Tiers -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 style="font-size:16px;margin:0;">Price Tiers</h3>
        @if (p.IsActive)
        {
            <button id="btnAddTier" class="btn btn-primary" style="font-size:13px;padding:8px 16px;" onclick="showAddTierModal(@p.Id)">Add Tier</button>
        }
    </div>
    <div id="tierTableContainer">
        <p class="muted" style="font-size:14px;">Loading tiers...</p>
    </div>
</section>

<!-- Price History -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <h3 style="font-size:16px;margin-bottom:16px;">Price History</h3>
    @if (Model.PriceHistory.Any())
    {
        <table>
            <thead><tr><th>Effective From</th><th style="text-align:right;">Selling Price</th><th style="text-align:right;">Cost Price</th><th>Changed By</th></tr></thead>
            <tbody>
                @foreach (var h in Model.PriceHistory)
                {
                    <tr>
                        <td>@h.EffectiveFromUtc.ToString("dd MMM yyyy, HH:mm")</td>
                        <td style="text-align:right;font-weight:600;">@cs@h.SellingPrice.ToString("N2")</td>
                        <td style="text-align:right;">@cs@h.CostPrice.ToString("N2")</td>
                        <td style="font-size:12px;color:var(--muted);">@h.ChangedByUserId</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color:var(--muted);font-size:14px;">No price changes recorded.</p>
    }
</section>

<!-- Demand Forecast -->
@if (Model.IsProfessional && Model.Forecast != null)
{
    <section class="glass card-pad" style="margin-bottom:22px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
            <h3 style="font-size:16px;">Demand Forecast</h3>
            <span class="pill" style="background:rgba(13,94,166,.08);color:var(--blue);">Professional</span>
        </div>
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px;">Based on 6-month average of @Model.Forecast.AvgMonthlyUnits.ToString("N0") units/month.</p>
        <div class="product-forecast-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
            <div style="padding:18px;border-radius:14px;background:rgba(13,94,166,.04);border:1px solid rgba(13,94,166,.08);text-align:center;">
                <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;">Next 30 days</div>
                <div style="font-size:22px;font-weight:800;margin-top:6px;">@cs@Model.Forecast.Forecast30Revenue.ToString("N2")</div>
                <div style="font-size:12px;color:var(--muted);margin-top:4px;">~@Model.Forecast.Forecast30Units.ToString("N0") units</div>
            </div>
            <div style="padding:18px;border-radius:14px;background:rgba(13,94,166,.04);border:1px solid rgba(13,94,166,.08);text-align:center;">
                <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;">Next 60 days</div>
                <div style="font-size:22px;font-weight:800;margin-top:6px;">@cs@Model.Forecast.Forecast60Revenue.ToString("N2")</div>
                <div style="font-size:12px;color:var(--muted);margin-top:4px;">~@Model.Forecast.Forecast60Units.ToString("N0") units</div>
            </div>
            <div style="padding:18px;border-radius:14px;background:rgba(13,94,166,.04);border:1px solid rgba(13,94,166,.08);text-align:center;">
                <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;">Next 90 days</div>
                <div style="font-size:22px;font-weight:800;margin-top:6px;">@cs@Model.Forecast.Forecast90Revenue.ToString("N2")</div>
                <div style="font-size:12px;color:var(--muted);margin-top:4px;">~@Model.Forecast.Forecast90Units.ToString("N0") units</div>
            </div>
        </div>
    </section>
}
else if (!Model.IsProfessional)
{
    <section class="glass card-pad" style="margin-bottom:22px;opacity:0.7;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
                <h3 style="font-size:16px;">Demand Forecast</h3>
                <p style="font-size:13px;color:var(--muted);margin-top:4px;">Project future demand based on sales history. Available on Professional plan.</p>
            </div>
            <span class="pill" style="background:rgba(13,94,166,.08);color:var(--blue);">Upgrade</span>
        </div>
    </section>
}

<!-- Pipeline Activity -->
@if (Model.Pipeline != null)
{
    <section class="glass card-pad">
        <h3 style="font-size:16px;margin-bottom:16px;">Pipeline Activity</h3>
        <div class="product-pipeline-kpi" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px;">
            <div style="padding:18px;border-radius:14px;background:rgba(13,94,166,.04);border:1px solid rgba(13,94,166,.08);border-left:4px solid var(--blue);text-align:center;">
                <div style="font-size:28px;font-weight:800;color:var(--blue);font-family:'Manrope',sans-serif;">@Model.Pipeline.ActiveLeadCount</div>
                <div style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;margin-top:6px;letter-spacing:.04em;">Active Leads</div>
            </div>
            <div style="padding:18px;border-radius:14px;background:rgba(18,152,103,.04);border:1px solid rgba(18,152,103,.08);border-left:4px solid var(--green);text-align:center;">
                <div style="font-size:28px;font-weight:800;color:var(--green);font-family:'Manrope',sans-serif;">@cs@Model.Pipeline.EstimatedValue.ToString("N2")</div>
                <div style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;margin-top:6px;letter-spacing:.04em;">Estimated Value</div>
            </div>
            <div style="padding:18px;border-radius:14px;background:rgba(200,145,46,.04);border:1px solid rgba(200,145,46,.08);border-left:4px solid var(--gold);text-align:center;">
                <div style="font-size:28px;font-weight:800;color:var(--gold);font-family:'Manrope',sans-serif;">@Model.Pipeline.ConversionRate%</div>
                <div style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;margin-top:6px;letter-spacing:.04em;">Conversion Rate</div>
            </div>
        </div>
        @if (Model.Pipeline.Leads.Any())
        {
            <table>
                <thead><tr><th>Lead</th><th>Stage</th><th style="text-align:right;">Est. Value</th><th>Assigned To</th></tr></thead>
                <tbody>
                    @foreach (var lead in Model.Pipeline.Leads)
                    {
                        <tr>
                            <td style="font-weight:600;">@lead.Title</td>
                            <td><span class="pill pill-green">@lead.Stage</span></td>
                            <td style="text-align:right;font-weight:700;">@cs@lead.EstimatedValue.ToString("N2")</td>
                            <td>@(lead.AssignedTo ?? "Unassigned")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@Html.AntiForgeryToken()

@section Scripts {
<style>
    @@media (max-width: 768px) {
        .product-kpi-grid { grid-template-columns: repeat(2, 1fr) !important; }
        .product-two-col { grid-template-columns: 1fr !important; }
        .product-meta-grid { grid-template-columns: 1fr 1fr !important; }
        .product-forecast-grid { grid-template-columns: 1fr !important; }
        .product-pipeline-kpi { grid-template-columns: 1fr !important; }
    }
    @@media (max-width: 480px) {
        .product-kpi-grid { grid-template-columns: 1fr !important; }
        .product-meta-grid { grid-template-columns: 1fr !important; }
    }
    .tier-badge-default {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        background: rgba(13,94,166,.08);
        color: #0D5EA6;
    }
    .tier-badge-active {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        background: #E6F7EF;
        color: #129867;
    }
    .tier-badge-inactive {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        background: #FDEAEA;
        color: #C24A4A;
    }
    .tier-row-inactive td {
        opacity: 0.6;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
    var ctx = document.getElementById('trendChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.MonthlyTrend.Select(m => $"'{m.Label}'")))],
            datasets: [{
                label: 'Revenue',
                data: [@Html.Raw(string.Join(",", Model.MonthlyTrend.Select(m => m.Revenue.ToString("F2"))))],
                borderColor: '#0D5EA6',
                backgroundColor: 'rgba(13,94,166,.08)',
                fill: true,
                tension: 0.4,
                pointRadius: 4,
                pointBackgroundColor: '#0D5EA6'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { callback: function(v) { return '\u20ac' + v; } }, grid: { color: 'rgba(13,94,166,.06)' } },
                x: { grid: { display: false } }
            }
        }
    });
</script>
<script>
(function () {
    // =========================================================================
    // Price Tier Management — Product Detail Page
    // =========================================================================

    var productId = @p.Id;
    var productIsActive = @(p.IsActive ? "true" : "false");
    var currencySymbol = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(cs))';
    var defaultSellingPrice = @p.DefaultSellingPrice.ToString("F2");
    var defaultCostPrice = @p.DefaultCostPrice.ToString("F2");

    function getAntiForgeryToken() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    // =========================================================================
    // Load Tier Table
    // =========================================================================
    async function loadTierTable(prodId) {
        var container = document.getElementById('tierTableContainer');

        try {
            var response = await fetch('/Product/AxGetProductTiers?productId=' + prodId);
            var result = await response.json();

            if (!result.success) {
                container.innerHTML = '<p class="muted" style="font-size:14px;">Failed to load tiers.</p>';
                return;
            }

            var tiers = result.data;

            if (!tiers || tiers.length === 0) {
                if (productIsActive) {
                    container.innerHTML = '<div style="text-align:center;padding:24px 0;">'
                        + '<p style="color:var(--muted);font-size:14px;margin-bottom:12px;">No price tiers configured. Add tiers to offer multiple pricing profiles.</p>'
                        + '<button class="btn btn-primary" style="font-size:13px;padding:8px 20px;" onclick="showAddTierModal(' + prodId + ', true)">Add Price Tiers</button>'
                        + '</div>';
                } else {
                    container.innerHTML = '<p class="muted" style="font-size:14px;">No price tiers configured.</p>';
                }
                var btnAdd = document.getElementById('btnAddTier');
                if (btnAdd) btnAdd.style.display = 'none';
                return;
            }

            // Show the "Add Tier" button
            var btnAdd = document.getElementById('btnAddTier');
            if (btnAdd) btnAdd.style.display = productIsActive ? 'inline-block' : 'none';

            // Check if max tiers reached
            var activeTierCount = tiers.filter(function(t) { return t.isActive; }).length;
            if (btnAdd && activeTierCount >= 20) {
                btnAdd.disabled = true;
                btnAdd.title = 'Maximum of 20 active tiers reached';
            } else if (btnAdd) {
                btnAdd.disabled = false;
                btnAdd.title = '';
            }

            var html = '<table style="width:100%;"><thead><tr>'
                + '<th>Tier Name</th>'
                + '<th style="text-align:right;">Selling Price</th>'
                + '<th style="text-align:right;">Cost Price</th>'
                + '<th>Default</th>'
                + '<th>Status</th>'
                + (productIsActive ? '<th>Actions</th>' : '')
                + '</tr></thead><tbody>';

            for (var i = 0; i < tiers.length; i++) {
                var t = tiers[i];
                var rowClass = t.isActive ? '' : ' class="tier-row-inactive"';
                html += '<tr' + rowClass + '>';
                html += '<td style="font-weight:600;">' + escapeHtml(t.tierName) + '</td>';
                html += '<td style="text-align:right;font-weight:600;">' + currencySymbol + parseFloat(t.sellingPrice).toFixed(2) + '</td>';
                html += '<td style="text-align:right;">' + currencySymbol + parseFloat(t.costPrice).toFixed(2) + '</td>';
                html += '<td>' + (t.isDefault ? '<span class="tier-badge-default">Default</span>' : '') + '</td>';
                html += '<td>' + (t.isActive ? '<span class="tier-badge-active">Active</span>' : '<span class="tier-badge-inactive">Inactive</span>') + '</td>';

                if (productIsActive) {
                    html += '<td style="white-space:nowrap;">';
                    if (t.isActive) {
                        // Store tier data in a data attribute for the edit action
                        var tierJson = JSON.stringify(t).replace(/"/g, '&quot;');
                        html += '<a href="javascript:void(0)" onclick=\'showEditTierModal(JSON.parse(this.getAttribute("data-tier")))\' data-tier="' + tierJson + '" class="tbl-action tbl-action--primary">Edit</a> ';
                        if (!t.isDefault) {
                            html += '<a href="javascript:void(0)" onclick="setDefaultTier(' + t.id + ', ' + prodId + ')" class="tbl-action tbl-action--primary">Set Default</a> ';
                            html += '<a href="javascript:void(0)" onclick="deactivateTier(' + t.id + ', ' + prodId + ')" class="tbl-action tbl-action--danger">Deactivate</a>';
                        }
                    } else {
                        html += '<a href="javascript:void(0)" onclick="reactivateTier(' + t.id + ', ' + prodId + ')" class="tbl-action tbl-action--primary" style="opacity:0.7;">Reactivate</a>';
                    }
                    html += '</td>';
                }

                html += '</tr>';
            }

            html += '</tbody></table>';
            container.innerHTML = html;

        } catch (e) {
            container.innerHTML = '<p class="muted" style="font-size:14px;">Failed to load tiers.</p>';
        }
    }

    // =========================================================================
    // Add Tier Modal
    // =========================================================================
    window.showAddTierModal = async function (prodId, isFirstTier) {
        var prefillSelling = isFirstTier ? defaultSellingPrice : '0.00';
        var prefillCost = isFirstTier ? defaultCostPrice : '0.00';

        var result = await Swal.fire({
            title: 'Add Price Tier',
            html:
                '<div style="text-align:left;">' +
                '<div style="margin-bottom:14px;">' +
                    '<label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Tier Name <span style="color:#C24A4A;">*</span></label>' +
                    '<input id="swalTierName" type="text" class="swal2-input" placeholder="e.g. Retail, Wholesale, VIP" maxlength="100" style="margin:0;width:100%;box-sizing:border-box;" />' +
                '</div>' +
                '<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">' +
                    '<div>' +
                        '<label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Selling Price</label>' +
                        '<input id="swalSellingPrice" type="number" class="swal2-input" min="0" step="0.01" value="' + prefillSelling + '" style="margin:0;width:100%;box-sizing:border-box;" />' +
                    '</div>' +
                    '<div>' +
                        '<label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Cost Price</label>' +
                        '<input id="swalCostPrice" type="number" class="swal2-input" min="0" step="0.01" value="' + prefillCost + '" style="margin:0;width:100%;box-sizing:border-box;" />' +
                    '</div>' +
                '</div>' +
                '</div>',
            showCancelButton: true,
            confirmButtonText: 'Create Tier',
