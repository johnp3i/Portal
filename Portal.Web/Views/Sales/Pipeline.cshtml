@using Portal.Infrastructure.Entities.Sales
@{
    ViewData["Title"] = "Sales Pipeline";
    var statuses = (List<LeadStatusType>)ViewBag.Statuses;
    var products = (List<SalesProduct>)ViewBag.Products;
}

<style>
    /* Desktop-hide defaults */
    .stage-pill-nav { display: none; }
    .pipeline-fab { display: none; }

    /* View toggle — desktop default */
    #pipelineViewToggle { display: flex; gap: 8px; align-items: center; }
    #pipelineTopbarActions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }

    /* FAB base styles */
    .pipeline-fab {
        display: none;
        position: fixed;
        bottom: calc(24px + env(safe-area-inset-bottom, 0px));
        right: 24px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #0D5EA6;
        color: #fff;
        border: none;
        box-shadow: 0 4px 16px rgba(13, 94, 166, 0.35);
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 900;
        transition: transform 0.15s, box-shadow 0.15s;
    }
    .pipeline-fab:active {
        transform: scale(0.92);
        box-shadow: 0 2px 8px rgba(13, 94, 166, 0.25);
    }

    /* Stage pill nav base styles */
    .stage-pill-nav {
        display: none;
        gap: 8px;
        overflow-x: auto;
        padding: 8px 0 12px 0;
        -webkit-overflow-scrolling: touch;
    }
    .stage-pill {
        flex-shrink: 0;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        min-height: 44px;
        display: flex;
        align-items: center;
        border: none;
    }

    /* Mobile responsive rules */
    @@media (max-width: 768px) {
        /* Topbar — Pipeline-specific overrides for mobile.css */
        .topbar {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 10px !important;
        }
        .topbar-heading { font-size: 22px !important; margin-top: 4px !important; }
        .topbar-subtitle { font-size: 12px !important; margin-bottom: 4px !important; }
        .topbar > div:first-child { width: 100% !important; }
        #pipelineTopbarActions {
            width: 100% !important;
            display: flex !important;
            flex-direction: row !important;
            justify-content: space-between !important;
            align-items: center !important;
            gap: 12px !important;
            margin-top: 0 !important;
        }
        /* New Lead button — compact on mobile */
        #pipelineTopbarActions > .btn-primary {
            display: inline-flex !important;
            width: auto !important;
            padding: 8px 16px !important;
            font-size: 13px !important;
            min-height: 38px !important;
            border-radius: 10px !important;
        }
        /* Board/Table segmented toggle */
        #pipelineViewToggle {
            display: flex !important;
            flex-direction: row !important;
            width: auto !important;
            background: rgba(13,94,166,.06) !important;
            border-radius: 12px !important;
            padding: 4px !important;
            gap: 4px !important;
        }
        #pipelineViewToggle .btn,
        #pipelineViewToggle .btn.btn-secondary {
            flex: 1 !important;
            width: auto !important;
            display: flex !important;
            align-items: center;
            justify-content: center;
            min-height: 38px !important;
            border-radius: 10px !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            border: none !important;
            background: transparent !important;
            color: #5E7385 !important;
            padding: 8px 16px !important;
        }
        #pipelineViewToggle .btn.active,
        #pipelineViewToggle .btn.btn-secondary.active {
            background: #fff !important;
            color: #0B1B28 !important;
            box-shadow: 0 2px 8px rgba(0,0,0,.08) !important;
        }

        /* Filter Panel — scoped to #pipelineFilters to avoid affecting modals */
        #pipelineFilters .field { min-width: 100% !important; }
        #pipelineFilters select { min-height: 44px; width: 100%; }
        #pipelineFilters > div {
            flex-direction: column;
            gap: 12px !important;
            width: 100%;
        }
        #pipelineFilters > div > div:last-child {
            display: flex;
            gap: 10px;
            padding-bottom: 0 !important;
            width: 100%;
        }
        #pipelineFilters > div > div:last-child .btn {
            flex: 1;
            min-height: 44px;
            text-align: center;
        }

        /* Task Cards */
        .task-card-action {
            flex-wrap: wrap;
            position: relative;
            overflow: hidden;
            padding: 14px 16px !important;
            gap: 10px;
            border-radius: 14px;
            border: 1px solid rgba(13,94,166,.06);
            background: #fff;
            margin-bottom: 10px;
        }
        .task-card-action > span:first-child {
            display: none;
        }
        .task-card-action > div:nth-child(2) {
            width: 28px !important;
            height: 28px !important;
            border-radius: 6px;
        }
        .task-card-action > div:nth-child(3) {
            flex: 1;
            min-width: 0;
        }
        .task-card-action > div:nth-child(3) > div:first-child {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: calc(100vw - 100px);
            font-size: 13px !important;
        }
        .task-card-action > div:last-child {
            width: 100%;
            display: flex !important;
            justify-content: flex-start;
            margin-top: 4px;
            flex-wrap: wrap;
            gap: 8px !important;
            padding-top: 8px;
            border-top: 1px solid rgba(138,155,171,.08);
        }
        .task-card-action .btn,
        .task-card-action .btn.btn-sm {
            min-width: 44px;
            min-height: 38px;
            padding: 6px 12px !important;
            font-size: 12px !important;
            border-radius: 10px !important;
        }

        /* Kanban Board */
        .pipeline-board {
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            gap: 10px !important;
        }
        .pipeline-column {
            scroll-snap-align: start;
            min-width: 85vw !important;
            min-height: 120px !important;
            max-width: none !important;
        }

        /* Stage Pill Navigator */
        .stage-pill-nav {
            display: flex;
            padding: 8px 0;
            margin: 0;
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .stage-pill-nav::-webkit-scrollbar { display: none; }
        .stage-pill {
            min-height: 36px;
            padding: 6px 14px;
            font-size: 12px;
        }

        /* Meeting Cards */
        #upcomingMeetingsList > a > div { flex-direction: column; align-items: flex-start; }
        #upcomingMeetingsList > a > div > div:last-child {
            align-items: flex-start;
            flex-direction: row;
            gap: 8px;
        }

        /* KPI Footer */
        .kpi-footer {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            cursor: pointer;
            text-align: center;
        }
        .kpi-footer > div {
            padding: 10px 8px;
            background: rgba(13,94,166,.03);
            border-radius: 12px;
        }
        .kpi-footer .kpi-value { font-size: 22px; }
        .kpi-footer .kpi-label { font-size: 10px; margin-top: 2px; }
        .kpi-footer.kpi-expanded .kpi-value { font-size: 28px; }
        .kpi-footer.kpi-expanded .kpi-label { font-size: 12px; }

        /* FAB — hidden since New Lead stays in topbar */
        .pipeline-fab { display: none !important; }

        /* Touch targets & spacing */
        #pipelineFilters .btn,
        #pipelineFilters select,
        .topbar .btn { min-height: 44px; min-width: 44px; }
        .glass.card-pad { padding: 16px; }

        /* Today's Actions panel tweaks */
        #todaysActionsPanel h3 { font-size: 15px !important; }
        #todaysActionsList { display: flex; flex-direction: column; gap: 0; }

        /* Collapse buttons — small icon in top-right */
        #todaysActionsPanel > div:first-child,
        #upcomingMeetingsPanel > div:first-child {
            position: relative;
        }
        #todaysActionsPanel > div:first-child > div:last-child,
        #upcomingMeetingsPanel > div:first-child > div:last-child {
            position: absolute !important;
            top: 0;
            right: 0;
        }
        #todaysActionsPanel > div:first-child > div:last-child .btn,
        #upcomingMeetingsPanel > div:first-child > div:last-child .btn {
            width: 28px !important;
            height: 28px !important;
            min-width: 28px !important;
            min-height: 28px !important;
            padding: 0 !important;
            border-radius: 8px !important;
            display: flex !important;
            align-items: center;
            justify-content: center;
            background: rgba(138,155,171,.06) !important;
            border: none !important;
        }

        /* Content padding */
        body > .content-area { padding-left: 16px; padding-right: 16px; }

        /* Table View — horizontal scroll on mobile */
        #tableView .glass.card-pad { padding: 12px !important; overflow-x: auto; }
        #leadsTable { font-size: 12px; min-width: 600px; }
        #leadsTable th, #leadsTable td { padding: 10px 8px; white-space: nowrap; }

        /* Create Lead Modal — mobile adjustments */
        #createLeadModal > div {
            border-radius: 18px !important;
            padding: 20px !important;
            margin: 12px !important;
            max-width: calc(100vw - 24px) !important;
        }
        #createLeadModal h2 { font-size: 18px !important; margin-bottom: 16px !important; }
        #createLeadModal .field { margin-bottom: 14px !important; }
        #createLeadModal select,
        #createLeadModal input,
        #createLeadModal textarea {
            padding: 10px 14px !important;
            font-size: 14px !important;
            border-radius: 10px !important;
        }

        /* Recent Lead Activity — compact on mobile */
        #recentLeadActivityList > div {
            flex-wrap: wrap !important;
            gap: 4px !important;
            padding: 8px 0 !important;
        }
        #recentLeadActivityList > div > span:last-child {
            margin-left: 0 !important;
            width: 100%;
        }

        /* Cancelled Leads — full-width cards on mobile */
        #cancelledLeadsList {
            flex-direction: column !important;
        }
        #cancelledLeadsList > div {
            min-width: 100% !important;
            max-width: 100% !important;
        }

        /* Badges in section headers — allow wrapping */
        #todaysBadges, #meetingsBadge {
            flex-wrap: wrap;
            max-width: 150px;
            justify-content: flex-end;
        }

        /* Pipeline cards — disable hover transforms on touch */
        .pipeline-card {
            box-shadow: 0 2px 8px rgba(13,94,166,.06) !important;
            transform: none !important;
        }
    }
</style>

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Sales Pipeline</div>
        <h1 class="topbar-heading">Pipeline</h1>
        <p class="topbar-subtitle">Track leads through your sales pipeline from enquiry to conversion.</p>
    </div>
    <div id="pipelineTopbarActions">
        <button class="btn btn-primary" onclick="openCreateLeadModal()">New Lead</button>
        <div id="pipelineViewToggle">
            <button id="btnKanbanView" class="btn btn-secondary active" onclick="switchView('kanban')">Board</button>
            <button id="btnTableView" class="btn btn-secondary" onclick="switchView('table')">Table</button>
        </div>
    </div>
</div>

<!-- Today's Actions Panel -->
<section id="todaysActionsPanel" class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;display:flex;align-items:center;gap:10px;margin:0;">
            <svg width="20" height="20" fill="none" stroke="#C8912E" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Today's Actions
        </h3>
        <div style="display:flex;align-items:center;gap:10px;">
            <span id="todaysBadges" style="display:flex;gap:6px;"></span>
            <button class="btn btn-secondary" style="padding:5px 8px;" onclick="toggleTodaysActions()" title="Collapse">
                <svg id="todaysCollapseIcon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
            </button>
        </div>
    </div>
    <div id="todaysActionsList">
        <!-- Skeleton placeholder while loading -->
        <div id="todaysActionsSkeleton" style="display:flex;flex-direction:column;gap:10px;">
            <div style="display:flex;align-items:center;gap:12px;padding:14px 16px;background:#fff;border-radius:14px;border:1px solid rgba(13,94,166,.06);">
                <span style="width:8px;height:8px;border-radius:50%;background:#e2e8f0;flex-shrink:0;"></span>
                <div style="width:32px;height:32px;border-radius:8px;background:#f1f5f9;flex-shrink:0;"></div>
                <div style="flex:1;"><div style="height:14px;width:60%;background:#f1f5f9;border-radius:6px;margin-bottom:6px;"></div><div style="height:10px;width:40%;background:#f7fafc;border-radius:6px;"></div></div>
            </div>
            <div style="display:flex;align-items:center;gap:12px;padding:14px 16px;background:#fff;border-radius:14px;border:1px solid rgba(13,94,166,.06);">
                <span style="width:8px;height:8px;border-radius:50%;background:#e2e8f0;flex-shrink:0;"></span>
                <div style="width:32px;height:32px;border-radius:8px;background:#f1f5f9;flex-shrink:0;"></div>
                <div style="flex:1;"><div style="height:14px;width:50%;background:#f1f5f9;border-radius:6px;margin-bottom:6px;"></div><div style="height:10px;width:35%;background:#f7fafc;border-radius:6px;"></div></div>
            </div>
        </div>
    </div>
</section>

<!-- Upcoming Meetings Panel -->
<section id="upcomingMeetingsPanel" class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;display:flex;align-items:center;gap:10px;margin:0;">
            <svg width="20" height="20" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Upcoming Meetings
        </h3>
        <div style="display:flex;align-items:center;gap:10px;">
            <span id="meetingsBadge" style="display:flex;gap:6px;"></span>
            <button class="btn btn-secondary" style="padding:5px 8px;" onclick="toggleUpcomingMeetings()" title="Collapse">
                <svg id="meetingsCollapseIcon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
            </button>
        </div>
    </div>
    <div id="upcomingMeetingsList">
        <!-- Skeleton placeholder while loading -->
        <div id="upcomingMeetingsSkeleton" style="display:flex;flex-direction:column;gap:10px;">
            <div style="display:flex;align-items:center;gap:12px;padding:14px 16px;background:#fff;border-radius:14px;border:1px solid rgba(13,94,166,.06);">
                <span style="width:8px;height:8px;border-radius:50%;background:#e2e8f0;flex-shrink:0;"></span>
                <div style="width:32px;height:32px;border-radius:8px;background:#f1f5f9;flex-shrink:0;"></div>
                <div style="flex:1;"><div style="height:14px;width:60%;background:#f1f5f9;border-radius:6px;margin-bottom:6px;"></div><div style="height:10px;width:40%;background:#f7fafc;border-radius:6px;"></div></div>
            </div>
            <div style="display:flex;align-items:center;gap:12px;padding:14px 16px;background:#fff;border-radius:14px;border:1px solid rgba(13,94,166,.06);">
                <span style="width:8px;height:8px;border-radius:50%;background:#e2e8f0;flex-shrink:0;"></span>
                <div style="width:32px;height:32px;border-radius:8px;background:#f1f5f9;flex-shrink:0;"></div>
                <div style="flex:1;"><div style="height:14px;width:50%;background:#f1f5f9;border-radius:6px;margin-bottom:6px;"></div><div style="height:10px;width:35%;background:#f7fafc;border-radius:6px;"></div></div>
            </div>
        </div>
    </div>
</section>

<!-- Filter Panel -->
<section id="pipelineFilters" class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:180px;">
            <label for="filterProduct">Product</label>
            <select id="filterProduct">
                <option value="">All Products</option>
                @foreach (var product in products)
                {
                    <option value="@product.Id">@product.Name</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:180px;">
            <label for="filterAssigned">Assigned To</label>
            <select id="filterAssigned">
                <option value="">All Users</option>
            </select>
        </div>
        <div style="padding-bottom:2px;">
            <button class="btn btn-primary" onclick="applyFilters()">Filter</button>
            <button class="btn btn-secondary" onclick="clearFilters()">Clear</button>
        </div>
    </div>
</section>

<!-- Kanban Board -->
<div id="kanbanView">
    <section class="glass card-pad" style="padding:16px;">
        <div class="pipeline-board" id="pipelineBoard" style="display:flex;gap:14px;overflow-x:auto;padding-bottom:8px;">
            <!-- Skeleton columns while loading -->
            <div id="pipelineSkeleton" style="display:flex;gap:14px;width:100%;">
                @for (int i = 0; i < 5; i++)
                {
                    <div style="min-width:220px;flex:1;max-width:280px;background:rgba(138,155,171,.04);border-radius:16px;padding:16px;border:1px solid rgba(138,155,171,.08);min-height:200px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span style="width:8px;height:8px;border-radius:50%;background:#e2e8f0;"></span>
                                <div style="height:14px;width:80px;background:#f1f5f9;border-radius:6px;"></div>
                            </div>
                            <div style="height:20px;width:28px;background:#f7fafc;border-radius:10px;"></div>
                        </div>
                        <div style="background:#fff;border-radius:14px;padding:16px;margin-bottom:10px;border:1px solid rgba(13,94,166,.04);">
                            <div style="height:14px;width:70%;background:#f1f5f9;border-radius:6px;margin-bottom:8px;"></div>
                            <div style="height:10px;width:50%;background:#f7fafc;border-radius:6px;margin-bottom:10px;"></div>
                            <div style="display:flex;align-items:center;gap:8px;"><div style="width:22px;height:22px;border-radius:50%;background:#f1f5f9;"></div><div style="height:10px;width:40px;background:#f7fafc;border-radius:6px;"></div></div>
                        </div>
                        <div style="background:#fff;border-radius:14px;padding:16px;border:1px solid rgba(13,94,166,.04);">
                            <div style="height:14px;width:60%;background:#f1f5f9;border-radius:6px;margin-bottom:8px;"></div>
                            <div style="height:10px;width:40%;background:#f7fafc;border-radius:6px;margin-bottom:10px;"></div>
                            <div style="display:flex;align-items:center;gap:8px;"><div style="width:22px;height:22px;border-radius:50%;background:#f1f5f9;"></div><div style="height:10px;width:40px;background:#f7fafc;border-radius:6px;"></div></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Cancelled Leads Section -->
    <div id="cancelledLeadsSection" style="display:none;margin-top:22px;">
        <section class="glass card-pad">
            <details>
                <summary style="cursor:pointer;font-size:14px;font-weight:700;color:#C24A4A;display:flex;align-items:center;gap:8px;list-style:none;">
                    <svg width="16" height="16" fill="none" stroke="#C24A4A" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6m0-6l6 6"/></svg>
                    Cancelled Leads <span id="cancelledCount" style="font-size:12px;font-weight:700;background:rgba(194,74,74,.1);color:#C24A4A;padding:2px 8px;border-radius:8px;margin-left:4px;">0</span>
                </summary>
                <div id="cancelledLeadsList" style="margin-top:14px;display:flex;flex-wrap:wrap;gap:10px;">
                    <!-- Cards rendered by JS -->
                </div>
            </details>
        </section>
    </div>
</div>

<!-- Table View (hidden by default) -->
<div id="tableView" style="display:none;">
    <section class="glass card-pad">
        <table class="data-table" id="leadsTable">
            <thead>
                <tr>
                    <th>Lead #</th>
                    <th>Contact</th>
                    <th>Company</th>
                    <th>Product</th>
                    <th>Stage</th>
                    <th>Source</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="leadsTableBody">
                <!-- Rows rendered by JS -->
            </tbody>
        </table>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
            <div id="paginationInfo" style="font-size:14px;color:#5a6a7a;"></div>
            <div id="paginationControls"></div>
        </div>
    </section>
</div>

<!-- Pipeline KPI Footer -->
<section class="glass card-pad" style="margin-top:22px;">
    <div id="kpiFooterSection" class="kpi-footer" style="display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:16px;text-align:center;">
        <div>
            <div id="kpiTotalLeads" class="kpi-value" style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">0</div>
            <div class="kpi-label" style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Total Active Leads</div>
        </div>
        <div>
            <div id="kpiThisMonth" class="kpi-value" style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">0</div>
            <div class="kpi-label" style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">This Month</div>
        </div>
        <div>
            <div id="kpiConversionRate" class="kpi-value" style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">0%</div>
            <div class="kpi-label" style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Conversion Rate</div>
        </div>
        <div>
            <div id="kpiAvgDaysToWon" class="kpi-value" style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">—</div>
            <div class="kpi-label" style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Avg. Days to Won</div>
        </div>
    </div>
</section>

<!-- Recent Lead Activity -->
<section class="glass card-pad" style="margin-top:22px;">
    <h3 style="font-size:16px;font-weight:700;color:#1a2b3c;margin-bottom:14px;">Recent Lead Activity</h3>
    <div id="recentLeadActivityList" style="font-size:13px;color:#5E7385;">Loading...</div>
</section>

<!-- Create Lead Modal -->
<div id="createLeadModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.4);backdrop-filter:blur(2px);align-items:flex-start;justify-content:center;overflow-y:auto;padding:24px 0;">
    <div style="background:#fff;border-radius:24px;padding:32px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,.15);margin:auto;flex-shrink:0;">
        <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#0B1B28;margin:0 0 24px 0;">New Lead</h2>
        <div class="field" style="margin-bottom:18px;">
            <label for="leadContactId" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Contact *</label>
            <select id="leadContactId" required style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;background:#fff;appearance:auto;"></select>
        </div>
        <div class="field" style="margin-bottom:18px;">
            <label for="leadProductId" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Product</label>
            <select id="leadProductId" style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;background:#fff;appearance:auto;"><option value="">None</option></select>
        </div>
        <div class="field" style="margin-bottom:18px;">
            <label for="leadSourceTypeId" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Source *</label>
            <select id="leadSourceTypeId" required style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;background:#fff;appearance:auto;"></select>
        </div>
        <div class="field" style="margin-bottom:18px;">
            <label for="leadSourceRefTypeId" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Source Reference</label>
            <select id="leadSourceRefTypeId" style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;background:#fff;appearance:auto;"><option value="">None</option></select>
        </div>
        <div class="field" style="margin-bottom:18px;">
            <label for="leadSourceUrl" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Source URL</label>
            <input type="text" id="leadSourceUrl" placeholder="https://..." style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;" />
        </div>
        <div class="field" style="margin-bottom:18px;">
            <label for="leadRequestText" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Request Details</label>
            <textarea id="leadRequestText" rows="3" style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;resize:vertical;"></textarea>
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:24px;">
            <button class="btn btn-secondary" onclick="closeCreateLeadModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitCreateLead()">Create Lead</button>
        </div>
    </div>
</div>

<!-- Floating Action Button — Mobile only -->
<button class="pipeline-fab" onclick="openCreateLeadModal()" aria-label="Create new lead">
    <svg width="24" height="24" fill="none" stroke="#fff" stroke-width="2.5" viewBox="0 0 24 24">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    </svg>
</button>

@section Scripts {
    <script src="~/js/sales/pipeline.js?v=11"></script>
    <script src="~/js/sales/follow-up-tasks.js?v=4"></script>
}
