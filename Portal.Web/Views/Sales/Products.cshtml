@using Portal.Infrastructure.Entities.Sales
@using Portal.Infrastructure.Models
@model PagedResult<SalesProduct>
@{
    ViewData["Title"] = "Sales Products";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Sales Pipeline</div>
        <h1 class="topbar-heading">Products</h1>
        <p class="topbar-subtitle">Manage your product catalogue for the sales pipeline.</p>
    </div>
    <div>
        <button class="btn btn-primary" onclick="openCreateProductModal()">New Product</button>
    </div>
</div>

<!-- Search -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <form method="get" asp-action="Products">
        <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
            <div class="field" style="min-width:280px;flex:1;">
                <label>Search</label>
                <input type="text" name="search" value="@searchTerm" placeholder="Product name..." />
            </div>
            <div style="padding-bottom:2px;">
                <button type="submit" class="btn btn-primary">Search</button>
                <a href="/Sales/Products" class="btn btn-secondary">Clear</a>
            </div>
        </div>
    </form>
</section>

<!-- Products Table -->
<section class="glass card-pad">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><p>No products found.</p></div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Items)
                {
                    <tr>
                        <td style="font-weight:600;">@product.Name</td>
                        <td>@(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "…" : product.Description ?? "—")</td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="pill pill-green">Active</span>
                            }
                            else
                            {
                                <span class="pill pill-red">Inactive</span>
                            }
                        </td>
                        <td>@product.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                        <td style="white-space:nowrap;">
                            <button class="tbl-action tbl-action--primary" onclick="editProduct(@product.Id, '@product.Name.Replace("'", "\\'")' , '@(product.Description?.Replace("'", "\\'") ?? "")')">Edit</button>
                            @if (product.IsActive)
                            {
                                <button class="tbl-action tbl-action--danger" onclick="deactivateProduct(@product.Id, '@(product.Name.Replace("'", "\\'"))')">Deactivate</button>
                            }
                            else
                            {
                                <button class="tbl-action tbl-action--secondary" onclick="activateProduct(@product.Id, '@(product.Name.Replace("'", "\\'"))')">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
            <div style="font-size:14px;color:#5a6a7a;">Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount</div>
            <div>
                @if (Model.HasPreviousPage)
                {
                    <a href="/Sales/Products?search=@searchTerm&page=@(Model.CurrentPage - 1)" class="btn btn-secondary" style="padding:6px 12px;font-size:13px;">Previous</a>
                }
                @if (Model.HasNextPage)
                {
                    <a href="/Sales/Products?search=@searchTerm&page=@(Model.CurrentPage + 1)" class="btn btn-secondary" style="padding:6px 12px;font-size:13px;">Next</a>
                }
            </div>
        </div>
    }
</section>

<!-- Create/Edit Product Modal -->
<div id="productModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:460px;">
        <h3 id="productModalTitle" style="margin-bottom:16px;">New Product</h3>
        <input type="hidden" id="productId" />
        <div class="field"><label>Name *</label><input type="text" id="productName" required /></div>
        <div class="field"><label>Description</label><textarea id="productDescription" rows="3"></textarea></div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:16px;">
            <button class="btn btn-secondary" onclick="closeProductModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitProduct()">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales/products.js?v=2"></script>
}
