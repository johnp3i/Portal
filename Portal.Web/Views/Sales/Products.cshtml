@using Portal.Infrastructure.Entities.Sales
@using Portal.Infrastructure.Models
@model PagedResult<SalesProduct>
@{
    ViewData["Title"] = "Products & Services";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Opportunities / Products</div>
        <h1 class="topbar-heading">Products & Services</h1>
        <p class="topbar-subtitle">Manage your product and service offerings for the sales pipeline.</p>
    </div>
    <div>
        <button class="btn btn-primary" onclick="openCreateProductModal()">New Product / Service</button>
    </div>
</div>

<!-- Search -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <form method="get" asp-action="Products">
        <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
            <div class="field" style="min-width:280px;flex:1;">
                <label>Search</label>
                <input type="text" name="search" value="@searchTerm" placeholder="Product name..." />
            </div>
            <div style="padding-bottom:2px;">
                <button type="submit" class="btn btn-primary">Search</button>
                <a href="/Sales/Products" class="btn btn-secondary">Clear</a>
            </div>
        </div>
    </form>
</section>

<!-- Products Table -->
<section class="glass card-pad">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><p>No products found.</p></div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Linked Catalogue</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Items)
                {
                    <tr>
                        <td style="font-weight:600;">@product.Name</td>
                        <td>@(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "…" : product.Description ?? "—")</td>
                        <td>
                            @{
                                var catalogLookup = ViewBag.CatalogLookup as Dictionary<int, string> ?? new Dictionary<int, string>();
                                // Only render a link when the linked catalogue row actually resolves.
                                // If the ProductId no longer exists (deleted), show a muted note
                                // instead of a dead link to a missing /Product/Detail page.
                                var catalogName = product.ProductId.HasValue
                                    ? catalogLookup.GetValueOrDefault(product.ProductId.Value)
                                    : null;
                            }
                            @if (product.ProductId.HasValue && catalogName != null)
                            {
                                <a href="/Product/Detail/@product.ProductId.Value" style="font-size:12px;color:#0D5EA6;font-weight:600;text-decoration:none;" title="View in Product Catalogue">@catalogName</a>
                            }
                            else if (product.ProductId.HasValue)
                            {
                                <span style="color:var(--muted);font-size:12px;" title="Linked catalogue item no longer exists">Linked (unavailable)</span>
                            }
                            else
                            {
                                <span style="color:var(--muted);font-size:12px;">—</span>
                            }
                        </td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="pill pill-green">Active</span>
                            }
                            else
                            {
                                <span class="pill pill-red">Inactive</span>
                            }
                        </td>
                        <td>@product.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                        <td style="white-space:nowrap;">
                            <button class="tbl-action tbl-action--primary"
                                    data-id="@product.Id"
                                    data-name="@product.Name"
                                    data-description="@(product.Description ?? "")"
                                    data-catalog-id="@(product.ProductId?.ToString() ?? "")"
                                    onclick="editProductFromData(this)">Edit</button>
                            @if (product.IsActive)
                            {
                                <button class="tbl-action tbl-action--danger" data-id="@product.Id" data-name="@product.Name" onclick="deactivateProductFromData(this)">Deactivate</button>
                            }
                            else
                            {
                                <button class="tbl-action tbl-action--secondary" data-id="@product.Id" data-name="@product.Name" onclick="activateProductFromData(this)">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_ListPager", new Portal.Web.Models.ListPagerModel
        {
            CurrentPage = Model.CurrentPage,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            PageSize = Model.PageSize,
            BasePath = "/Sales/Products",
            SearchTerm = searchTerm,
            ItemNoun = "products"
        })
    }
</section>

<!-- Create/Edit Product Modal -->
<div id="productModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:460px;">
        <h3 id="productModalTitle" style="margin-bottom:16px;">New Product / Service</h3>
        <input type="hidden" id="productId" />
        <div class="field"><label>Name *</label><input type="text" id="productName" required /></div>
        <div class="field"><label>Description</label><textarea id="productDescription" rows="3"></textarea></div>
        <div class="field">
            <label>Link to Catalogue (optional)</label>
            <select id="productCatalogLink">
                <option value="">— No link —</option>
            </select>
            <p style="font-size:11px;color:#5a6a7a;margin-top:4px;line-height:1.5;">
                Optionally link this item to your Product Catalogue. This shows reference pricing from the catalogue on this sales entry. The link is for reference only — no live sync.
            </p>
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:16px;">
            <button class="btn btn-secondary" onclick="closeProductModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitProduct()">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales/products.js?v=3"></script>
}
