@{
    ViewData["Title"] = "Follow-Up Tasks";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Opportunities / Tasks</div>
        <h1 class="topbar-heading">Follow-Up Tasks</h1>
        <p class="topbar-subtitle">Manage all your follow-up reminders in one place.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <button class="btn btn-primary" onclick="openCreateTaskModal(null, null, null)">New Task</button>
    </div>
</div>

<!-- Filter Panel -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:150px;">
            <label for="filterStatus">Status</label>
            <select id="filterStatus">
                <option value="">All</option>
                <option value="overdue">Overdue</option>
                <option value="pending" selected>Pending</option>
                <option value="completed">Completed</option>
                <option value="unprocessed">Unprocessed</option>
                <option value="all_closed">All Closed</option>
            </select>
        </div>
        <div class="field" style="min-width:140px;">
            <label for="filterType">Type</label>
            <select id="filterType">
                <option value="">All Types</option>
                <option value="Call">Call</option>
                <option value="Email">Email</option>
                <option value="Follow-up">Follow-up</option>
                <option value="Meeting Prep">Meeting Prep</option>
                <option value="Other">Other</option>
            </select>
        </div>
        <div class="field" style="min-width:140px;">
            <label for="filterDateFrom">From</label>
            <input type="date" id="filterDateFrom" />
        </div>
        <div class="field" style="min-width:140px;">
            <label for="filterDateTo">To</label>
            <input type="date" id="filterDateTo" />
        </div>
        <div style="padding-bottom:2px;">
            <button class="btn btn-primary" onclick="loadTasksPage(1)">Filter</button>
            <button class="btn btn-secondary" onclick="clearTaskFilters()">Clear</button>
        </div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#5E7385;margin-right:4px;">Quick:</span>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('this_month')">This Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('next_month')">Next Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_month')">Last Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_3')">Last 3 Months</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_6')">Last 6 Months</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('this_year')">This Year</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('last_year')">Last Year</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod('all')">All Time</button>
        <select class="mobile-period-select" onchange="if(this.value) setQuickPeriod(this.value)">
            <option value="">Quick date range...</option>
            <option value="this_month">This Month</option>
            <option value="next_month">Next Month</option>
            <option value="last_month">Last Month</option>
            <option value="last_3">Last 3 Months</option>
            <option value="last_6">Last 6 Months</option>
            <option value="this_year">This Year</option>
            <option value="last_year">Last Year</option>
            <option value="all">All Time</option>
        </select>
    </div>
</section>

<!-- Tasks Table -->
<section class="glass card-pad">
    <table class="data-table" id="tasksTable">
        <thead>
            <tr>
                <th>Title</th>
                <th>Contact</th>
                <th>Type</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Assigned</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody id="tasksTableBody">
            <tr><td colspan="7" style="text-align:center;color:#8a9bab;padding:32px;">Loading...</td></tr>
        </tbody>
    </table>

    <!-- Pagination -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
        <div id="tasksPaginationInfo" style="font-size:14px;color:#5a6a7a;"></div>
        <div id="tasksPaginationControls"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/sales/follow-up-tasks.js?v=1"></script>
    <script>
        var _tasksCurrentPage = 1;

        function loadTasksPage(page) {
            _tasksCurrentPage = page;
            var status = document.getElementById('filterStatus').value;
            var taskType = document.getElementById('filterType').value;
            var dateFrom = document.getElementById('filterDateFrom').value;
            var dateTo = document.getElementById('filterDateTo').value;

            var params = new URLSearchParams();
            if (status) params.append('status', status);
            if (taskType) params.append('taskType', taskType);
            if (dateFrom) params.append('dateFrom', dateFrom);
            if (dateTo) params.append('dateTo', dateTo);
            params.append('page', page);

            fetch('/Sales/AxGetTasksPaged?' + params.toString())
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    if (!result.success) return;
                    renderTasksTable(result.data, result.totalCount, result.currentPage, result.totalPages);
                })
                .catch(function () {
                    document.getElementById('tasksTableBody').innerHTML = '<tr><td colspan="7" style="text-align:center;color:#C24A4A;">Failed to load tasks.</td></tr>';
                });
        }

        function renderTasksTable(tasks, totalCount, currentPage, totalPages) {
            var tbody = document.getElementById('tasksTableBody');

            if (!tasks || tasks.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#8a9bab;padding:32px;">No tasks found.</td></tr>';
                document.getElementById('tasksPaginationInfo').textContent = '';
                document.getElementById('tasksPaginationControls').innerHTML = '';
                return;
            }

            var html = '';
            tasks.forEach(function (t) {
                if (typeof cacheTaskData === 'function') cacheTaskData(t);
                var dueColor = t.urgency === 'overdue' ? 'color:#C24A4A;font-weight:600;' : t.urgency === 'today' ? 'color:#C8912E;font-weight:600;' : '';
                var statusBadge = getStatusBadgeHtml(t);
                var dueStr = new Date(t.dueAtUtc).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                // Append scheduled time-of-day (HH:mm) when set; otherwise show "All day".
                var timeStr = t.scheduledTimeUtc
                    ? '<div style="font-size:11px;color:#5a6a7a;margin-top:2px;">\u23F0 ' + t.scheduledTimeUtc.substring(0, 5) + '</div>'
                    : '<div style="font-size:11px;color:#b8c4d0;margin-top:2px;">All day</div>';

                html += '<tr>';
                html += '<td style="font-weight:600;">' + escapeHtml(t.title) + (t.meetingSubject ? '<div style="font-size:11px;color:#8a9bab;margin-top:2px;">from: ' + escapeHtml(t.meetingSubject) + '</div>' : '') + '</td>';
                html += '<td>' + (t.contactName ? '<span style="color:#0D5EA6;">' + escapeHtml(t.contactName) + '</span>' : '<span style="color:#8a9bab;">\u2014</span>') + '</td>';
                html += '<td>' + getTypeBadgeHtml(t.taskType) + '</td>';
                html += '<td style="' + dueColor + '">' + dueStr + timeStr + '</td>';
                html += '<td>' + statusBadge + '</td>';
                html += '<td>' + (t.assignedToName ? escapeHtml(t.assignedToName) : '<span style="color:#8a9bab;">Me</span>') + '</td>';
                html += '<td style="text-align:right;white-space:nowrap;">';
                if (t.notes) {
                    html += '<button class="btn btn-sm" style="background:rgba(13,94,166,.06);color:#0D5EA6;border:1.5px solid rgba(13,94,166,.12);padding:4px 8px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;" onclick="openViewNotesModal(' + t.id + ')" title="View notes">&#128221;</button> ';
                }
                html += '<button class="btn btn-sm" style="background:rgba(138,155,171,.06);color:#5E7385;border:1.5px solid rgba(138,155,171,.15);padding:4px 8px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;" onclick="openEditTaskModalFromTable(' + t.id + ')" title="Edit task">&#9998;</button> ';
                if (!t.isCompleted) {
                    html += '<button class="btn btn-sm" style="background:rgba(200,145,46,.06);color:#C8912E;border:1.5px solid rgba(200,145,46,.18);padding:4px 8px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;font-family:Inter,sans-serif;" onclick="markTaskUnprocessedFromList(' + t.id + ')" title="Mark as unprocessed">Unprocessed</button> ';
                    html += '<button class="btn btn-sm" style="background:rgba(18,152,103,.08);color:#129867;border:1.5px solid rgba(18,152,103,.2);padding:4px 8px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;" onclick="completeTaskFromList(' + t.id + ')" title="Mark as completed">&#10003;</button> ';
                    html += '<button class="btn btn-sm" style="background:rgba(87,184,232,.08);color:#1a8fc7;border:1.5px solid rgba(87,184,232,.2);padding:4px 8px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;" onclick="snoozeTaskFromList(' + t.id + ')" title="Snooze +1 day">+1d</button>';
                } else {
                    html += '<button class="btn btn-sm" style="background:rgba(200,145,46,.08);color:#C8912E;border:1.5px solid rgba(200,145,46,.2);padding:4px 8px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;" onclick="reopenTaskFromList(' + t.id + ')" title="Reopen task">Reopen</button>';
                }
                if (t.leadRequestId) {
                    html += ' <a href="/Sales/LeadDetail/' + t.leadRequestId + '" class="btn btn-sm" style="padding:4px 8px;border-radius:8px;font-size:11px;font-weight:700;border:1.5px solid rgba(13,94,166,.15);color:#0D5EA6;text-decoration:none;">View Lead</a>';
                }
                html += '</td>';
                html += '</tr>';
            });
            tbody.innerHTML = html;

            // Pagination info
            var start = (currentPage - 1) * 15 + 1;
            var end = Math.min(currentPage * 15, totalCount);
            document.getElementById('tasksPaginationInfo').textContent = 'Showing ' + start + '\u2013' + end + ' of ' + totalCount + ' tasks';

            // Pagination controls
            var pHtml = '';
            for (var i = 1; i <= totalPages; i++) {
                if (i === currentPage) {
                    pHtml += '<button class="btn btn-secondary" style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:800;background:#0D5EA6;color:#fff;border-color:#0D5EA6;">' + i + '</button> ';
                } else {
                    pHtml += '<button class="btn btn-secondary" style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;" onclick="loadTasksPage(' + i + ')">' + i + '</button> ';
                }
            }
            document.getElementById('tasksPaginationControls').innerHTML = pHtml;
        }

        function getStatusBadgeHtml(t) {
            if (t.isCompleted && t.taskOutcome === 'Unprocessed') return '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(200,145,46,.08);color:#C8912E;">Unprocessed</span>';
            if (t.isCompleted) return '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(18,152,103,.08);color:#129867;">Completed</span>';
            if (t.urgency === 'overdue') return '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(194,74,74,.08);color:#C24A4A;">Overdue</span>';
            if (t.urgency === 'today') return '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(200,145,46,.08);color:#C8912E;">Today</span>';
            if (t.urgency === 'tomorrow') return '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(138,155,171,.08);color:#8a9bab;">Tomorrow</span>';
            return '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(138,155,171,.08);color:#8a9bab;">Upcoming</span>';
        }

        function getTypeBadgeHtml(type) {
            var colors = { 'Call': 'rgba(13,94,166,.08);color:#0D5EA6', 'Email': 'rgba(18,152,103,.08);color:#129867', 'Follow-up': 'rgba(200,145,46,.08);color:#C8912E', 'Meeting Prep': 'rgba(87,184,232,.08);color:#1a8fc7', 'Other': 'rgba(138,155,171,.08);color:#8a9bab' };
            var c = colors[type] || colors['Other'];
            return '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:' + c + ';">' + type + '</span>';
        }

        async function markTaskUnprocessedFromList(taskId) {
            BlockUI.show('Processing...');
            try {
                var response = await fetch('/Sales/AxPostMarkTaskUnprocessed?id=' + taskId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                var data = await response.json();
                BlockUI.hide();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Done', text: data.message, confirmButtonColor: '#0D5EA6' });
                    loadTasksPage(_tasksCurrentPage);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function completeTaskFromList(taskId) {
            BlockUI.show('Completing...');
            try {
                var response = await fetch('/Sales/AxPostCompleteTask?id=' + taskId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                var data = await response.json();
                BlockUI.hide();
                if (data.success) {
                    loadTasksPage(_tasksCurrentPage);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function snoozeTaskFromList(taskId) {
            // Quick snooze: +1 day
            var newDate = new Date();
            newDate.setDate(newDate.getDate() + 1);
            BlockUI.show('Snoozing...');
            try {
                var response = await fetch('/Sales/AxPostSnoozeTask?id=' + taskId + '&newDueDate=' + encodeURIComponent(newDate.toISOString()), {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                var data = await response.json();
                BlockUI.hide();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Snoozed', text: 'Task moved to tomorrow.', timer: 1500, showConfirmButton: false });
                    loadTasksPage(_tasksCurrentPage);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function reopenTaskFromList(taskId) {
            BlockUI.show('Reopening...');
            try {
                var response = await fetch('/Sales/AxPostReopenTask?id=' + taskId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                var data = await response.json();
                BlockUI.hide();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Reopened', text: 'Task has been moved back to pending.', timer: 1500, showConfirmButton: false });
                    loadTasksPage(_tasksCurrentPage);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        }

        function clearTaskFilters() {
            document.getElementById('filterStatus').value = '';
            document.getElementById('filterType').value = '';
            document.getElementById('filterDateFrom').value = '';
            document.getElementById('filterDateTo').value = '';
            loadTasksPage(1);
        }

        // Load on page ready
        loadTasksPage(1);

        function openEditTaskModalFromTable(taskId) {
            if (typeof openEditTaskModal === 'function') openEditTaskModal(taskId);
        }

        function setQuickPeriod(preset) {
            var now = new Date();
            var from, to;
            switch (preset) {
                case 'this_month': from = new Date(now.getFullYear(), now.getMonth(), 1); to = now; break;
                case 'next_month': from = new Date(now.getFullYear(), now.getMonth() + 1, 1); to = new Date(now.getFullYear(), now.getMonth() + 2, 0); break;
                case 'last_month': from = new Date(now.getFullYear(), now.getMonth() - 1, 1); to = new Date(now.getFullYear(), now.getMonth(), 0); break;
                case 'last_3': from = new Date(now.getFullYear(), now.getMonth() - 3, 1); to = now; break;
                case 'last_6': from = new Date(now.getFullYear(), now.getMonth() - 6, 1); to = now; break;
                case 'this_year': from = new Date(now.getFullYear(), 0, 1); to = now; break;
                case 'last_year': from = new Date(now.getFullYear() - 1, 0, 1); to = new Date(now.getFullYear() - 1, 11, 31); break;
                case 'all': from = null; to = null; break;
            }
            document.getElementById('filterDateFrom').value = from ? formatDateISO(from) : '';
            document.getElementById('filterDateTo').value = to ? formatDateISO(to) : '';
            document.querySelectorAll('.period-shortcut').forEach(function(b) { b.classList.remove('active'); });
            event.target.classList.add('active');
            loadTasksPage(1);
        }

        function formatDateISO(d) {
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }
    </script>
}
