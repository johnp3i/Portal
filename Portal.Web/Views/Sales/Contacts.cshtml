@using Portal.Infrastructure.Entities.Sales
@using Portal.Infrastructure.Models
@model PagedResult<SalesContact>
@{
    ViewData["Title"] = "Sales Contacts";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Sales Pipeline</div>
        <h1 class="topbar-heading">Contacts</h1>
        <p class="topbar-subtitle">Manage your sales contacts directory.</p>
    </div>
    <div>
        <button class="btn btn-primary" onclick="openCreateContactModal()">New Contact</button>
    </div>
</div>

<!-- Search -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:280px;flex:1;">
            <label>Search</label>
            <input type="text" id="contactSearch" value="@searchTerm" placeholder="Name, email, phone, or company..." />
        </div>
        <div style="padding-bottom:2px;">
            <button class="btn btn-primary" onclick="searchContacts()">Search</button>
            <button class="btn btn-secondary" onclick="clearContactSearch()">Clear</button>
        </div>
    </div>
</section>

<!-- Contacts Table -->
<section class="glass card-pad">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><p>No contacts found.</p></div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in Model.Items)
                {
                    var fullName = string.IsNullOrWhiteSpace(contact.LastName) ? contact.FirstName : $"{contact.FirstName} {contact.LastName}";
                    <tr>
                        <td><a href="/Sales/ContactDetail/@contact.Id" style="color:var(--blue);font-weight:600;">@fullName</a></td>
                        <td>@(contact.Email ?? "—")</td>
                        <td>@(contact.PhoneNumber ?? "—")</td>
                        <td>@(contact.CompanyName ?? "—")</td>
                        <td>
                            @if (contact.IsActive)
                            {
                                <span class="pill pill-green">Active</span>
                            }
                            else
                            {
                                <span class="pill pill-red">Inactive</span>
                            }
                        </td>
                        <td>@contact.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                        <td style="white-space:nowrap;">
                            <a href="/Sales/ContactDetail/@contact.Id" class="tbl-action tbl-action--primary">Detail</a>
                            <button class="tbl-action tbl-action--primary" onclick="editContact(@contact.Id, '@contact.FirstName.Replace("'", "\\'")','@(contact.LastName?.Replace("'", "\\'") ?? "")','@(contact.Email?.Replace("'", "\\'") ?? "")','@(contact.PhoneNumber?.Replace("'", "\\'") ?? "")','@(contact.CompanyName?.Replace("'", "\\'") ?? "")','@(contact.JobTitle?.Replace("'", "\\'") ?? "")','@(contact.Country?.Replace("'", "\\'") ?? "")','@(contact.Notes?.Replace("'", "\\'").Replace("\n", "\\n") ?? "")')">Edit</button>
                            @if (contact.IsActive)
                            {
                                <button class="tbl-action tbl-action--danger" onclick="deactivateContact(@contact.Id, '@fullName')">Deactivate</button>
                            }
                            else
                            {
                                <button class="tbl-action tbl-action--secondary" onclick="activateContact(@contact.Id, '@fullName')">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
            <div style="font-size:14px;color:#5a6a7a;">Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount</div>
            <div>
                @if (Model.HasPreviousPage)
                {
                    <a href="/Sales/Contacts?search=@searchTerm&page=@(Model.CurrentPage - 1)" class="btn btn-secondary" style="padding:6px 12px;font-size:13px;">Previous</a>
                }
                @if (Model.HasNextPage)
                {
                    <a href="/Sales/Contacts?search=@searchTerm&page=@(Model.CurrentPage + 1)" class="btn btn-secondary" style="padding:6px 12px;font-size:13px;">Next</a>
                }
            </div>
        </div>
    }
</section>

<!-- Create/Edit Contact Modal -->
<div id="contactModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:520px;">
        <h3 id="contactModalTitle" style="margin-bottom:16px;">New Contact</h3>
        <input type="hidden" id="contactId" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>First Name *</label><input type="text" id="contactFirstName" required /></div>
            <div class="field"><label>Last Name</label><input type="text" id="contactLastName" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Email</label><input type="email" id="contactEmail" /></div>
            <div class="field"><label>Phone</label><input type="tel" id="contactPhone" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Company</label><input type="text" id="contactCompany" /></div>
            <div class="field"><label>Job Title</label><input type="text" id="contactJobTitle" /></div>
        </div>
        <div class="field"><label>Country</label><input type="text" id="contactCountry" /></div>
        <div class="field"><label>Notes</label><textarea id="contactNotes" rows="2"></textarea></div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:16px;">
            <button class="btn btn-secondary" onclick="closeContactModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitContact()">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales/contacts.js?v=2"></script>
}
