@using Portal.Infrastructure.Entities.Sales
@{
    ViewData["Title"] = "Meetings";
    var meetingTypes = (List<MeetingType>)ViewBag.MeetingTypes;
}

<style>
    /* Attendee picker — toggleable member chips (replaces the raw multi-select) */
    .attendee-picker {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 12px;
        border: 1px solid rgba(13, 94, 166, .15);
        border-radius: 12px;
        background: #fff;
        min-height: 52px;
        align-content: flex-start;
    }
    .attendee-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 13px 7px 9px;
        border-radius: 999px;
        border: 1.5px solid rgba(13, 94, 166, .18);
        background: rgba(13, 94, 166, .04);
        color: #5E7385;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
        transition: background .15s, border-color .15s, color .15s;
        font-family: inherit;
    }
    .attendee-chip:hover {
        border-color: rgba(13, 94, 166, .4);
        background: rgba(13, 94, 166, .07);
    }
    .attendee-chip .attendee-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: rgba(13, 94, 166, .12);
        color: #0D5EA6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        flex-shrink: 0;
        transition: background .15s, color .15s;
    }
    .attendee-chip .attendee-check { display: none; }
    .attendee-chip.selected {
        background: linear-gradient(180deg, #1A6BB8 0%, #0D5EA6 100%);
        border-color: #0D5EA6;
        color: #fff;
        box-shadow: 0 4px 12px rgba(13, 94, 166, .2);
    }
    .attendee-chip.selected .attendee-avatar {
        background: rgba(255, 255, 255, .22);
        color: #fff;
    }
    .attendee-chip.selected .attendee-check { display: inline-flex; }
    .attendee-picker .attendee-empty {
        font-size: 13px;
        color: #8a9bab;
        padding: 4px 2px;
    }
</style>

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Sales Pipeline</div>
        <h1 class="topbar-heading">Meetings</h1>
        <p class="topbar-subtitle">Scheduled meetings with contacts and leads.</p>
    </div>
    <div>
        <button class="btn btn-primary" onclick="openCreateMeetingModal()">Schedule Meeting</button>
    </div>
</div>

<!-- Filter Panel -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:150px;">
            <label for="filterStatus">Status</label>
            <select id="filterStatus">
                <option value="">All</option>
                <option value="upcoming" selected>Upcoming</option>
                <option value="completed">Completed</option>
                <option value="cancelled">Cancelled</option>
            </select>
        </div>
        <div class="field" style="min-width:160px;">
            <label for="filterMeetingType">Meeting Type</label>
            <select id="filterMeetingType">
                <option value="">All Types</option>
                @foreach (var mt in meetingTypes)
                {
                    <option value="@mt.Id">@mt.Name</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:160px;">
            <label for="filterOutcomeClassification">Classification</label>
            <select id="filterOutcomeClassification">
                <option value="">All</option>
                <option value="1">Positive</option>
                <option value="2">Neutral</option>
                <option value="3">Negative</option>
                <option value="4">Rescheduled</option>
                <option value="5">No Show</option>
            </select>
        </div>
        <div class="field" style="min-width:140px;">
            <label for="filterDateFrom">From</label>
            <input type="date" id="filterDateFrom" />
        </div>
        <div class="field" style="min-width:140px;">
            <label for="filterDateTo">To</label>
            <input type="date" id="filterDateTo" />
        </div>
        <div style="padding-bottom:2px;">
            <button class="btn btn-primary" onclick="loadMeetingsPage(1)">Filter</button>
            <button class="btn btn-secondary" onclick="clearMeetingFilters()">Clear</button>
        </div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#5E7385;margin-right:4px;">Quick:</span>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'this_month')">This Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'next_month')">Next Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'last_month')">Last Month</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'last_3')">Last 3 Months</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'last_6')">Last 6 Months</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'this_year')">This Year</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'last_year')">Last Year</button>
        <button type="button" class="period-shortcut" onclick="setQuickPeriod(event, 'all')">All Time</button>
        <select class="mobile-period-select" onchange="if(this.value) setQuickPeriod(null, this.value)">
            <option value="">Quick date range...</option>
            <option value="this_month">This Month</option>
            <option value="next_month">Next Month</option>
            <option value="last_month">Last Month</option>
            <option value="last_3">Last 3 Months</option>
            <option value="last_6">Last 6 Months</option>
            <option value="this_year">This Year</option>
            <option value="last_year">Last Year</option>
            <option value="all">All Time</option>
        </select>
    </div>
</section>

<!-- Meetings Table -->
<section class="glass card-pad">
    <!-- Calendar Task info banner -->
    <details style="margin-bottom:18px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.08);border-radius:12px;overflow:hidden;">
        <summary style="padding:12px 16px;cursor:pointer;font-size:13px;font-weight:600;color:#0D5EA6;display:flex;align-items:center;gap:8px;list-style:none;">
            <svg width="16" height="16" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
            What does "Calendar Task" do?
        </summary>
        <div style="padding:0 16px 14px;font-size:13px;color:#5E7385;line-height:1.7;">
            Clicking <strong>Calendar Task</strong> downloads a calendar file (.ics) for the meeting. Open it to add the meeting directly to your calendar app (Google Calendar, Outlook, Apple Calendar, etc.) with the correct date, time, duration, and location pre-filled.
        </div>
    </details>

    <table class="data-table" id="meetingsTable">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Type</th>
                <th>Contact</th>
                <th>Scheduled</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Outcome</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="meetingsTableBody">
            <tr><td colspan="8" style="text-align:center;color:#8a9bab;padding:32px;">Loading...</td></tr>
        </tbody>
    </table>

    <!-- Pagination -->
    <div id="meetingsPagination" style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
        <div id="meetingsPaginationInfo" style="font-size:14px;color:#5a6a7a;"></div>
        <div id="meetingsPaginationControls"></div>
    </div>
</section>

<!-- Create Meeting Modal -->
<div id="meetingModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:520px;">
        <h3 style="margin-bottom:16px;">Schedule Meeting</h3>
        <div class="field"><label>Lead (optional)</label><select id="meetingLeadRequestId"><option value="">— Not linked to a lead —</option></select></div>
        <div class="field"><label>Contact</label><select id="meetingContactId" required></select></div>
        <div class="field"><label>Subject *</label><input type="text" id="meetingSubject" required /></div>
        <div class="field"><label>Meeting Type</label>
            <select id="meetingTypeId">
                @foreach (var mt in meetingTypes)
                {
                    <option value="@mt.Id">@mt.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Attendees</label>
            <div id="meetingAttendees" class="attendee-picker"></div>
            <div style="font-size:11px;color:#8a9bab;margin-top:4px;">Team members assigned to attend. Each receives their own task &amp; meeting reminder.</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Date & Time</label><input type="datetime-local" id="meetingScheduledAt" required /></div>
            <div class="field"><label>Duration (min)</label><input type="number" id="meetingDuration" value="60" min="15" step="15" /></div>
        </div>
        <div class="field"><label>Location</label><input type="text" id="meetingLocation" /></div>
        <div class="field"><label>Notes</label><textarea id="meetingNotes" rows="2"></textarea></div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:16px;">
            <button class="btn btn-secondary" onclick="closeMeetingModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitMeeting()">Schedule</button>
        </div>
    </div>
</div>

<!-- Edit Meeting Modal -->
<div id="editMeetingModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:600px;">
        <h3 style="margin-bottom:16px;">Edit Meeting</h3>
        <input type="hidden" id="editMeetingId" />
        <div class="field">
            <label>Contact</label>
            <div id="editMeetingContactName" style="padding:8px 12px;background:rgba(138,155,171,.06);border:1px solid rgba(138,155,171,.15);border-radius:8px;font-size:14px;color:#5E7385;"></div>
        </div>
        <div class="field"><label>Lead (optional)</label><select id="editMeetingLeadRequestId"><option value="">— Not linked to a lead —</option></select></div>
        <div class="field"><label>Subject *</label><input type="text" id="editMeetingSubject" required /></div>
        <div class="field"><label>Meeting Type</label>
            <select id="editMeetingTypeId">
                @foreach (var mt in meetingTypes)
                {
                    <option value="@mt.Id">@mt.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Attendees</label>
            <div id="editMeetingAttendees" class="attendee-picker"></div>
            <div style="font-size:11px;color:#8a9bab;margin-top:4px;">Team members assigned to attend. Each receives their own task &amp; meeting reminder.</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Date & Time</label><input type="datetime-local" id="editMeetingScheduledAt" required /></div>
            <div class="field"><label>Duration (min)</label><input type="number" id="editMeetingDuration" value="60" min="15" step="15" /></div>
        </div>
        <div class="field"><label>Location</label><input type="text" id="editMeetingLocation" /></div>
        <div class="field"><label>Notes</label><textarea id="editMeetingNotes" rows="2"></textarea></div>
        <div class="field">
            <label>Classification</label>
            <select id="editMeetingClassification">
                <option value="">— Select outcome —</option>
                <option value="1">Positive</option>
                <option value="2">Neutral</option>
                <option value="3">Negative</option>
                <option value="4">Rescheduled</option>
                <option value="5">No Show</option>
            </select>
        </div>
        <div class="field"><label>Outcome</label><textarea id="editMeetingOutcome" rows="3" placeholder="Record the outcome of the meeting..."></textarea></div>

        <!-- Meeting Tasks Section -->
        <div style="margin-top:18px;border-top:1.5px solid rgba(138,155,171,.1);padding-top:16px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                <h4 id="meetingTasksHeading" style="margin:0;font-size:15px;font-weight:700;color:#0B1B28;">Meeting Tasks (0)</h4>
                <button type="button" class="btn btn-sm" style="background:rgba(13,94,166,.06);color:#0D5EA6;border:1.5px solid rgba(13,94,166,.12);padding:5px 12px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;" onclick="showMeetingTaskForm()">+ Add Task</button>
            </div>

            <!-- Inline task creation form (hidden by default) -->
            <div id="meetingTaskForm" style="display:none;background:rgba(13,94,166,.03);border:1.5px solid rgba(13,94,166,.08);border-radius:10px;padding:14px;margin-bottom:12px;">
                <div class="field" style="margin-bottom:10px;"><label style="font-size:12px;">Title *</label><input type="text" id="meetingTaskTitle" placeholder="e.g. Send demo account credentials" /></div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
                    <div class="field"><label style="font-size:12px;">Type</label>
                        <select id="meetingTaskType"><option value="">Loading...</option></select>
                    </div>
                    <div class="field"><label style="font-size:12px;">Due Date &amp; Time *</label><input type="datetime-local" id="meetingTaskDueDate" /></div>
                </div>
                <div class="field" style="margin-bottom:12px;"><label style="font-size:12px;">Notes</label><textarea id="meetingTaskNotes" rows="1" placeholder="Optional notes..."></textarea></div>
                <div style="display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="btn btn-secondary btn-sm" style="padding:5px 12px;font-size:12px;" onclick="hideMeetingTaskForm()">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" style="padding:5px 12px;font-size:12px;" onclick="submitMeetingTask()">Create Task</button>
                </div>
            </div>

            <!-- Task list rendered by JS -->
            <div id="editMeetingTasksList" style="max-height:200px;overflow-y:auto;"></div>
        </div>

        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:16px;">
            <button class="btn btn-secondary" onclick="closeEditMeetingModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitEditMeeting()">Save Changes</button>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ContactInfoModal")

@section Scripts {
    <script src="~/js/sales/contact-modal.js?v=2"></script>
    <script src="~/js/sales/meetings.js?v=16"></script>
}
