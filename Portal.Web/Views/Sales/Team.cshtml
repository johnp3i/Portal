@model List<Portal.Infrastructure.Models.Sales.TeamMemberDto>
@{
    ViewData["Title"] = "Team";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Opportunities</div>
        <h1 class="topbar-heading">Team</h1>
        <p class="topbar-subtitle">Manage people who can be assigned to leads.</p>
    </div>
    <div>
        <button class="btn btn-primary" onclick="openCreateTeamMemberModal()">Add Member</button>
    </div>
</div>

<section class="glass card-pad">
    @if (Model != null && Model.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Active Leads</th>
                    <th>Portal User</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr style="@(!member.IsActive ? "opacity:.6;" : "")">
                        <td><strong>@member.DisplayName</strong></td>
                        <td>@(member.Email ?? "—")</td>
                        <td>@(member.PhoneNumber ?? "—")</td>
                        <td>@(member.Role ?? "—")</td>
                        <td style="font-weight:700;text-align:center;">@member.ActiveLeadCount</td>
                        <td>
                            @if (member.IsLinkedToPortalUser)
                            {
                                <span class="pill pill-blue">Linked</span>
                            }
                            else
                            {
                                <span style="font-size:12px;color:#8a9bab;">—</span>
                            }
                        </td>
                        <td>
                            @if (member.IsActive)
                            {
                                <span class="pill pill-green">Active</span>
                            }
                            else
                            {
                                <span class="pill pill-red">Inactive</span>
                            }
                        </td>
                        <td style="white-space:nowrap;">
                            <button class="tbl-action tbl-action--primary" onclick="editTeamMember(@member.Id, '@member.FirstName.Replace("'", "\\'")','@(member.LastName?.Replace("'", "\\'") ?? "")','@(member.Email?.Replace("'", "\\'") ?? "")','@(member.PhoneNumber?.Replace("'", "\\'") ?? "")','@(member.Role?.Replace("'", "\\'") ?? "")','@(member.UserId ?? "")')">Edit</button>
                            @if (member.IsActive)
                            {
                                <button class="tbl-action tbl-action--danger" onclick="deactivateTeamMember(@member.Id, '@(member.DisplayName.Replace("'", "\\'"))')">Deactivate</button>
                            }
                            else
                            {
                                <button class="tbl-action tbl-action--secondary" onclick="activateTeamMember(@member.Id, '@(member.DisplayName.Replace("'", "\\'"))')">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <p>No team members yet. Add your first team member to start assigning leads.</p>
        </div>
    }
</section>

<!-- Team KPIs -->
<section class="glass card-pad" style="margin-top:22px;">
    <div style="display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:16px;text-align:center;">
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">@ViewBag.ActiveMembers</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Active Members</div>
        </div>
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">@ViewBag.TotalActiveLeads</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Total Active Leads</div>
        </div>
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">@ViewBag.AvgLeadsPerMember</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Avg. Leads / Member</div>
        </div>
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:@(((int)ViewBag.UnassignedLeads) > 0 ? "#C8912E" : "#0B1B28");">@ViewBag.UnassignedLeads</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Unassigned Leads</div>
        </div>
    </div>
</section>

<!-- Create/Edit Modal -->
<div id="teamMemberModal" class="modal-overlay" style="display:none;">
    <div class="modal-content" style="max-width:480px;">
        <h3 id="teamModalTitle" style="margin-bottom:20px;">Add Team Member</h3>
        <input type="hidden" id="teamMemberId" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>First Name *</label><input type="text" id="tmFirstName" required /></div>
            <div class="field"><label>Last Name</label><input type="text" id="tmLastName" /></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="field"><label>Email</label><input type="email" id="tmEmail" /></div>
            <div class="field"><label>Phone</label><input type="tel" id="tmPhone" /></div>
        </div>
        <div class="field"><label>Role</label><input type="text" id="tmRole" placeholder="e.g., Sales Agent, Partner" /></div>
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:16px;">
            <button class="btn btn-secondary" onclick="closeTeamMemberModal()">Cancel</button>
            <button class="btn btn-primary" onclick="submitTeamMember()">Save</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        window.openCreateTeamMemberModal = function() {
            document.getElementById('teamModalTitle').textContent = 'Add Team Member';
            document.getElementById('teamMemberId').value = '';
            document.getElementById('tmFirstName').value = '';
            document.getElementById('tmLastName').value = '';
            document.getElementById('tmEmail').value = '';
            document.getElementById('tmPhone').value = '';
            document.getElementById('tmRole').value = '';
            document.getElementById('teamMemberModal').style.display = 'flex';
        };

        window.editTeamMember = function(id, firstName, lastName, email, phone, role, userId) {
            document.getElementById('teamModalTitle').textContent = 'Edit Team Member';
            document.getElementById('teamMemberId').value = id;
            document.getElementById('tmFirstName').value = firstName || '';
            document.getElementById('tmLastName').value = lastName || '';
            document.getElementById('tmEmail').value = email || '';
            document.getElementById('tmPhone').value = phone || '';
            document.getElementById('tmRole').value = role || '';
            document.getElementById('teamMemberModal').style.display = 'flex';
        };

        window.closeTeamMemberModal = function() {
            document.getElementById('teamMemberModal').style.display = 'none';
        };

        document.getElementById('teamMemberModal').addEventListener('click', function(e) {
            if (e.target === this) closeTeamMemberModal();
        });

        window.submitTeamMember = async function() {
            var id = document.getElementById('teamMemberId').value;
            var payload = {
                firstName: document.getElementById('tmFirstName').value.trim(),
                lastName: document.getElementById('tmLastName').value.trim() || null,
                email: document.getElementById('tmEmail').value.trim() || null,
                phoneNumber: document.getElementById('tmPhone').value.trim() || null,
                role: document.getElementById('tmRole').value.trim() || null
            };

            if (!payload.firstName) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'First name is required.', confirmButtonColor: '#0D5EA6' });
                return;
            }

            if (payload.email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(payload.email)) {
                Swal.fire({ icon: 'warning', title: 'Invalid Email', text: 'Please enter a valid email address.', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var url = id ? '/Sales/AxPostUpdateTeamMember' : '/Sales/AxPostCreateTeamMember';
            if (id) payload.id = parseInt(id);

            BlockUI.show(id ? 'Updating...' : 'Creating...');
            closeTeamMemberModal();

            try {
                var response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
                    body: JSON.stringify(payload)
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Done', text: id ? 'Team member updated.' : 'Team member created.', confirmButtonColor: '#0D5EA6' }).then(function() { window.location.reload(); });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        };

        window.deactivateTeamMember = function(id, name) {
            Swal.fire({
                title: 'Deactivate?',
                text: 'Deactivate ' + name + '? They will no longer appear in assignment dropdowns.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, deactivate',
                confirmButtonColor: '#C24A4A'
            }).then(async function(result) {
                if (result.isConfirmed) {
                    BlockUI.show('Deactivating...');
                    try {
                        var response = await fetch('/Sales/AxPostDeactivateTeamMember?id=' + id, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                        var data = await response.json();
                        BlockUI.hide();
                        if (data.success) { Swal.fire({ icon: 'success', title: 'Done', confirmButtonColor: '#0D5EA6' }).then(function() { window.location.reload(); }); }
                        else { Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' }); }
                    } catch (e) { BlockUI.hide(); Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', confirmButtonColor: '#0D5EA6' }); }
                }
            });
        };

        window.activateTeamMember = function(id, name) {
            Swal.fire({
                title: 'Activate?',
                text: 'Reactivate ' + name + '?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, activate',
                confirmButtonColor: '#0D5EA6'
            }).then(async function(result) {
                if (result.isConfirmed) {
                    BlockUI.show('Activating...');
                    try {
                        var response = await fetch('/Sales/AxPostActivateTeamMember?id=' + id, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                        var data = await response.json();
                        BlockUI.hide();
                        if (data.success) { Swal.fire({ icon: 'success', title: 'Done', confirmButtonColor: '#0D5EA6' }).then(function() { window.location.reload(); }); }
                        else { Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' }); }
                    } catch (e) { BlockUI.hide(); Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', confirmButtonColor: '#0D5EA6' }); }
                }
            });
        };
    </script>
}
