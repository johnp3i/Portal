@model List<Portal.Infrastructure.Models.Compliance.ApplicationCategoryDto>
@{
    ViewData["Title"] = "Application Categories";
}

@Html.AntiForgeryToken()

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Admin</div>
        <h1 class="topbar-heading">Application Categories</h1>
        <p class="topbar-subtitle">Manage categories used to group compliance application types.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <button id="btnShowCreate" class="btn btn-primary" onclick="toggleCreateForm()">Create Category</button>
        <a asp-action="Index" asp-controller="AdminCompliance" class="btn btn-secondary">Back to Templates</a>
    </div>
</div>

<!-- Create/Edit Form (hidden by default) -->
<section id="categoryFormSection" class="glass card-pad" style="margin-bottom:22px;display:none;">
    <h3 id="formTitle" style="margin:0 0 16px 0;font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;color:#1a2a3a;">Create Category</h3>
    <input type="hidden" id="editCategoryId" value="" />
    <div style="display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;">
        <div class="field" style="min-width:200px;">
            <label for="categoryName">Name</label>
            <input type="text" id="categoryName" placeholder="e.g. Tax & Revenue" />
        </div>
        <div class="field" style="min-width:300px;">
            <label for="categoryDescription">Description</label>
            <input type="text" id="categoryDescription" placeholder="Brief description of the category" />
        </div>
    </div>
    <div style="display:flex;gap:10px;margin-top:16px;">
        <button id="btnSubmitCategory" class="btn btn-primary" onclick="submitCategory()">Save Category</button>
        <button class="btn btn-secondary" onclick="cancelForm()">Cancel</button>
    </div>
</section>

<!-- Categories Table -->
<section class="glass card-pad">
    @if (Model != null && Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="cat-row-@item.Id"
                            data-id="@item.Id"
                            data-name="@item.Name"
                            data-description="@item.Description">
                            <td><strong>@item.Name</strong></td>
                            <td>@(item.Description ?? "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="pill pill-green">Active</span>
                                }
                                else
                                {
                                    <span class="pill pill-grey">Inactive</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-secondary" style="font-size:12px;padding:6px 14px;" onclick="editCategory(@item.Id)">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No categories found. Create a category to organise your compliance templates.</p>
        </div>
    }
</section>

<script>
    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    function toggleCreateForm() {
        var section = document.getElementById('categoryFormSection');
        document.getElementById('formTitle').textContent = 'Create Category';
        document.getElementById('editCategoryId').value = '';
        clearFormFields();
        section.style.display = section.style.display === 'none' ? 'block' : 'none';
    }

    function cancelForm() {
        document.getElementById('categoryFormSection').style.display = 'none';
        clearFormFields();
    }

    function clearFormFields() {
        document.getElementById('categoryName').value = '';
        document.getElementById('categoryDescription').value = '';
    }

    function editCategory(id) {
        var row = document.getElementById('cat-row-' + id);
        document.getElementById('editCategoryId').value = id;
        document.getElementById('categoryName').value = row.dataset.name;
        document.getElementById('categoryDescription').value = row.dataset.description || '';
        document.getElementById('formTitle').textContent = 'Edit Category';
        document.getElementById('categoryFormSection').style.display = 'block';
        document.getElementById('categoryFormSection').scrollIntoView({ behavior: 'smooth' });
    }

    async function submitCategory() {
        var editId = document.getElementById('editCategoryId').value;
        var isEdit = editId !== '';
        var url = isEdit ? '/AdminCompliance/AxPostUpdateCategory' : '/AdminCompliance/AxPostCreateCategory';

        var payload = {
            name: document.getElementById('categoryName').value.trim(),
            description: document.getElementById('categoryDescription').value.trim() || null
        };

        if (isEdit) {
            payload.id = parseInt(editId);
        }

        if (!payload.name) {
            Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please enter a category name.', confirmButtonColor: '#0D5EA6' });
            return;
        }

        BlockUI.show('Saving category...');
        try {
            var response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify(payload)
            });
            var data = await response.json();
            BlockUI.hide();

            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Done', text: data.message, confirmButtonColor: '#0D5EA6' }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
            }
        } catch (e) {
            BlockUI.hide();
            Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
        }
    }
</script>
