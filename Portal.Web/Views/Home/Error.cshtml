@{
    ViewData["Title"] = "Error";
}

<div style="display:flex;align-items:center;justify-content:center;min-height:60vh;">
    <section class="glass card-pad" style="text-align:center;max-width:500px;">
        <h1 style="color:var(--red);font-size:28px;">Something went wrong</h1>
        <p class="muted" style="margin-top:12px;font-size:16px;line-height:1.7;">An unexpected error occurred. Please try again or contact support if the problem persists.</p>
        <a href="/" class="back-link" style="margin-top:24px;">&larr; Back to Dashboard</a>
    </section>
</div>
