                        };
                        <tr>
                            <td>@payment.PaymentDateUtc.ToString("dd MMM yyyy")</td>
                            <td>@payment.CustomerName</td>
                            <td><span class="pill @methodPillClass">@payment.PaymentMethodName</span></td>
                            <td class="right" style="color:#129867;font-weight:700;">@Model.CurrencySymbol@payment.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="padding:20px;text-align:center;color:var(--muted);font-size:14px;">
                <p>No recent payments available.</p>
            </div>
        }
    </section>
</div>
}
else if (Model.ShowQuotation)
{
<div style="margin-top:24px;">
    <section class="glass card-pad">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
            <h3>Recent Quotations</h3>
            <a asp-controller="Quotation" asp-action="Index" style="font-size:13px;font-weight:700;color:var(--blue);text-decoration:none;">View All →</a>
        </div>
        @if (Model.RecentQuotations.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th class="right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.RecentQuotations)
                    {
                        var quotationPillClass = q.QuotationStatusTypeId switch
                        {
                            1 => "pill-gold",    // Draft
                            2 => "pill-blue",    // Sent
                            3 => "pill-green",   // Accepted
                            4 => "pill-blue",    // Converted
                            5 => "pill-red",     // Rejected
                            _ => "pill-gold"
                        };
                        <tr>
                            <td><strong>@q.Reference</strong></td>
                            <td>@q.CustomerName</td>
                            <td><span class="pill @quotationPillClass">@q.StatusName</span></td>
                            <td class="right">@Model.CurrencySymbol@q.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="padding:20px;text-align:center;color:var(--muted);font-size:14px;">
                <p>No recent quotations available.</p>
            </div>
        }
    </section>
</div>
}

<!-- Bottom Row: Top Customers + Chart -->
@if (Model.ShowRevenue)
{
<div class="grid-2" style="margin-top:24px;">
    <section class="glass card-pad">
        <h3 style="margin-bottom:16px;">Top Customers <span style="font-size:12px;font-weight:400;color:var(--muted);">(Last 12 Months)</span></h3>
        @if (Model.TopCustomers.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th class="right">Total Invoiced</th>
                        <th class="right">Total Paid</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.TopCustomers)
                    {
                        <tr>
                            <td><strong>@customer.CustomerName</strong></td>
                            <td class="right">@Model.CurrencySymbol@customer.TotalInvoiced.ToString("N2")</td>
                            <td class="right" style="color:#129867;">@Model.CurrencySymbol@customer.TotalPaid.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="padding:20px;text-align:center;color:var(--muted);font-size:14px;">
                <p>No customer invoice data available for the last 12 months.</p>
            </div>
        }
    </section>
    <section class="glass card-pad">
        <h3 style="margin-bottom:16px;">Revenue by Customer</h3>
        @if (Model.TopCustomers.Any())
        {
            <div style="position:relative;height:220px;">
                <canvas id="topCustomersChart"></canvas>
            </div>
        }
        else
        {
            <div style="padding:40px 20px;text-align:center;color:var(--muted);font-size:14px;">
                <p>No customer data available.</p>
            </div>
        }
    </section>
</div>
}
}
else
{
    <!-- Empty state welcome message -->
    <section class="glass card-pad" style="text-align:center;padding:60px 30px;">
        <h2 style="font-family:'Manrope',sans-serif;font-weight:700;color:#1a2b3c;margin-bottom:12px;">Welcome to the Dashboard</h2>
        @if (!string.IsNullOrEmpty(Model.BusinessName))
        {
            <p style="font-size:16px;color:#5a6a7a;margin-bottom:8px;">@Model.BusinessName</p>
        }
        <p style="font-size:14px;color:#7a8a9a;">No dashboard data is available for your current permissions.</p>
        <p style="font-size:14px;color:#7a8a9a;">If you need additional access, please contact an administrator.</p>
    </section>
}

<!-- Chart.js Scripts -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        @if (Model.ShowRevenue)
        {
            @if (Model.RevenueVsExpenses.Any())
            {
                <text>
                var revenueVsExpensesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueVsExpenses.Select(r => new { label = r.Label, revenue = r.Revenue, expenses = r.Expenses })));
                (function() {
                    var currencySymbol = '@Html.Raw(Model.CurrencySymbol)';
                    var chartData = revenueVsExpensesData;
                    var labels = chartData.map(function(d) { return d.label; });
                    var revenueValues = chartData.map(function(d) { return d.revenue; });
                    var expensesValues = chartData.map(function(d) { return d.expenses; });

                    var ctx = document.getElementById('revenueVsExpensesChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    label: 'Revenue',
                                    data: revenueValues,
                                    backgroundColor: '#129867',
                                    borderRadius: 4
                                },
                                {
                                    label: 'Expenses',
                                    data: expensesValues,
                                    backgroundColor: '#0D5EA6',
                                    borderRadius: 4
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return currencySymbol + Math.round(value).toLocaleString();
                                        }
                                    }
                                }
                            }
                        }
                    });
                })();
                </text>
            }
        }
        @if (Model.ShowInvoice)
        {
            @if (Model.InvoiceStatusBreakdown.TotalCount > 0)
            {
                <text>
                var invoiceStatusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { paid = Model.InvoiceStatusBreakdown.PaidCount, partiallyPaid = Model.InvoiceStatusBreakdown.PartiallyPaidCount, unpaid = Model.InvoiceStatusBreakdown.UnpaidCount, overdue = Model.InvoiceStatusBreakdown.OverdueCount }));
                (function() {
                    var statusData = invoiceStatusData;
                    var ctx2 = document.getElementById('invoiceStatusChart').getContext('2d');
                    new Chart(ctx2, {
                        type: 'doughnut',
                        data: {
                            labels: ['Paid (' + statusData.paid + ')', 'Partially Paid (' + statusData.partiallyPaid + ')', 'Unpaid (' + statusData.unpaid + ')', 'Overdue (' + statusData.overdue + ')'],
                            datasets: [{
                                data: [statusData.paid, statusData.partiallyPaid, statusData.unpaid, statusData.overdue],
                                backgroundColor: ['#129867', '#C8912E', '#0D5EA6', '#C24A4A'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        generateLabels: function(chart) {
                                            var data = chart.data;
                                            return data.labels.map(function(label, i) {
                                                return {
                                                    text: label,
                                                    fillStyle: data.datasets[0].backgroundColor[i],
                                                    hidden: false,
                                                    index: i
                                                };
                                            });
                                        }
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return context.label + ': ' + context.raw;
                                        }
                                    }
                                }
                            }
                        }
                    });
                })();
                </text>
            }
        }
        @if (Model.ShowRevenue)
        {
            @if (Model.TopCustomers.Any())
            {
                <text>
                var topCustomersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopCustomers.Select(c => new { name = c.CustomerName, invoiced = c.TotalInvoiced, paid = c.TotalPaid })));
                (function() {
                    var data = topCustomersData;
                    var currencySymbol = '@Html.Raw(Model.CurrencySymbol)';

                    var ctx = document.getElementById('topCustomersChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: data.map(function(d) { return d.name; }),
                            datasets: [
                                {
                                    label: 'Invoiced',
                                    data: data.map(function(d) { return d.invoiced; }),
                                    backgroundColor: '#0D5EA6',
                                    borderRadius: 4
                                },
                                {
                                    label: 'Paid',
                                    data: data.map(function(d) { return d.paid; }),
                                    backgroundColor: '#129867',
                                    borderRadius: 4
                                }
                            ]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' }
                            },
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return currencySymbol + Math.round(value).toLocaleString();
                                        }
                                    }
                                }
                            }
                        }
                    });
                })();
                </text>
            }
        }
    </script>
}
