    @if (Model.ShowVat)
    {
    <div class="qs-vat">
        <span class="qs-label" style="font-weight:700;margin-right:4px;">VAT@(Model.HasVatData && !string.IsNullOrEmpty(Model.VatPeriodLabel) ? $" ({Model.VatPeriodLabel})" : ""):</span>
        <span class="qs-vat-item"><span style="color:#C8912E;font-weight:800;">@Model.CurrencySymbol@Model.OutputVat.ToString("N0")</span> out</span>
        <span class="qs-vat-item"><span style="color:#129867;font-weight:800;">@Model.CurrencySymbol@Model.InputVat.ToString("N0")</span> in</span>
        <span class="qs-vat-item"><span style="color:#C24A4A;font-weight:800;">@Model.CurrencySymbol@Model.NetVatPayable.ToString("N0")</span> net</span>
