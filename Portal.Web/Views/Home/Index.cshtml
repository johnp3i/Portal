        <a href="/MyBusiness" style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:10px;background:rgba(13,94,166,.02);text-decoration:none;transition:background .15s;">
            <div style="width:22px;height:22px;border-radius:50%;@(onboarding.HasBusinessProfile ? "background:#129867;border:2px solid #129867;color:#fff;" : "background:#fff;border:2px solid rgba(13,94,166,.2);")display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">@(onboarding.HasBusinessProfile ? "✓" : "")</div>
            <span style="font-size:14px;font-weight:600;color:@(onboarding.HasBusinessProfile ? "#5E7385" : "#0B1B28");@(onboarding.HasBusinessProfile ? "text-decoration:line-through;" : "")">Complete your business profile</span>
        </a>
        <a href="/MyBusiness" style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:10px;background:rgba(13,94,166,.02);text-decoration:none;transition:background .15s;">
            <div style="width:22px;height:22px;border-radius:50%;@(onboarding.HasLogo ? "background:#129867;border:2px solid #129867;color:#fff;" : "background:#fff;border:2px solid rgba(13,94,166,.2);")display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">@(onboarding.HasLogo ? "✓" : "")</div>
            <span style="font-size:14px;font-weight:600;color:@(onboarding.HasLogo ? "#5E7385" : "#0B1B28");@(onboarding.HasLogo ? "text-decoration:line-through;" : "")">Upload your logo</span>
        </a>
        <a href="/MyBusiness" style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:10px;background:rgba(13,94,166,.02);text-decoration:none;transition:background .15s;">
            <div style="width:22px;height:22px;border-radius:50%;@(onboarding.HasPaymentDetails ? "background:#129867;border:2px solid #129867;color:#fff;" : "background:#fff;border:2px solid rgba(13,94,166,.2);")display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">@(onboarding.HasPaymentDetails ? "✓" : "")</div>
            <span style="font-size:14px;font-weight:600;color:@(onboarding.HasPaymentDetails ? "#5E7385" : "#0B1B28");@(onboarding.HasPaymentDetails ? "text-decoration:line-through;" : "")">Add payment details</span>
