            <div style="width:22px;height:22px;border-radius:50%;@(onboarding.HasCustomer ? "background:#129867;border:2px solid #129867;color:#fff;" : "background:#fff;border:2px solid rgba(13,94,166,.2);")display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">@(onboarding.HasCustomer ? "✓" : "")</div>
            <span style="font-size:14px;font-weight:600;color:@(onboarding.HasCustomer ? "#5E7385" : "#0B1B28");@(onboarding.HasCustomer ? "text-decoration:line-through;" : "")">Create your first customer</span>
        </a>
        <a href="/Quotation/Create" style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:10px;background:rgba(13,94,166,.02);text-decoration:none;transition:background .15s;">
            <div style="width:22px;height:22px;border-radius:50%;@(onboarding.HasQuotationOrInvoice ? "background:#129867;border:2px solid #129867;color:#fff;" : "background:#fff;border:2px solid rgba(13,94,166,.2);")display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">@(onboarding.HasQuotationOrInvoice ? "✓" : "")</div>
            <span style="font-size:14px;font-weight:600;color:@(onboarding.HasQuotationOrInvoice ? "#5E7385" : "#0B1B28");@(onboarding.HasQuotationOrInvoice ? "text-decoration:line-through;" : "")">Create a quotation or invoice</span>
        </a>
        <a href="/Invoice" style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:10px;background:rgba(13,94,166,.02);text-decoration:none;transition:background .15s;">
            <div style="width:22px;height:22px;border-radius:50%;@(onboarding.HasIssuedInvoice ? "background:#129867;border:2px solid #129867;color:#fff;" : "background:#fff;border:2px solid rgba(13,94,166,.2);")display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">@(onboarding.HasIssuedInvoice ? "✓" : "")</div>
            <span style="font-size:14px;font-weight:600;color:@(onboarding.HasIssuedInvoice ? "#5E7385" : "#0B1B28");@(onboarding.HasIssuedInvoice ? "text-decoration:line-through;" : "")">Issue your first invoice</span>
        </a>
    </div>
</section>
}
@if (onboarding != null && onboarding.IsVisible && onboarding.IsCelebration)
{
<section id="onboardingPanel" class="glass card-pad" style="margin-bottom:22px;border-left:4px solid #129867;">
    <div style="display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:50%;background:rgba(18,152,103,.1);display:flex;align-items:center;justify-content:center;">
            <svg width="22" height="22" fill="none" stroke="#129867" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div style="flex:1;">
            <h3 style="font-family:'Manrope',sans-serif;font-size:15px;font-weight:700;color:#129867;margin:0;">
                Setup Complete!
            </h3>
            <p style="font-size:13px;color:#5a6a7a;margin:4px 0 0;">
                You're all set. Your business is ready to create quotations, send invoices, and track revenue.
            </p>
        </div>
        <button type="button" onclick="dismissOnboarding()" style="padding:6px 14px;font-size:12px;font-weight:600;color:#129867;background:rgba(18,152,103,.06);border:1px solid rgba(18,152,103,.2);border-radius:8px;cursor:pointer;">
            Got it
        </button>
    </div>
</section>
}
<script>
async function dismissOnboarding() {
    BlockUI.show('Saving...');
    try {
        var response = await fetch('/Home/AxPostDismissOnboarding', {
            method: 'POST',
            headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        var data = await response.json();
        BlockUI.hide();

        if (data.success) {
            document.getElementById('onboardingPanel').style.display = 'none';
        } else {
            Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
        }
    } catch (e) {
        BlockUI.hide();
        Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
    }
}
</script>
<!-- KPI Gauges Row -->
@if (Model.ShowRevenue || Model.ShowPurchase)
{
<div class="gauge-row">
    @if (Model.ShowRevenue)
    {
    <div class="gauge-item">
        <div class="gauge-header">
            <span class="gauge-label">Revenue</span>
            <span class="gauge-value" style="color:#129867;">@Model.CurrencySymbol@Model.RevenueThisMonth.ToString("N0")</span>
        </div>
        <div class="gauge-track">
            <div class="gauge-fill" style="width:@(revenuePct)%;background:#129867;"></div>
        </div>
        <div class="gauge-sub">@Model.RevenuePaymentCount payments this month</div>
    </div>
    <div class="gauge-item">
        <div class="gauge-header">
            <span class="gauge-label">Outstanding</span>
            <span class="gauge-value" style="color:#C24A4A;">@Model.CurrencySymbol@Model.OutstandingAmount.ToString("N0")</span>
        </div>
        <div class="gauge-track">
            <div class="gauge-fill" style="width:@(outstandingPct)%;background:#C24A4A;"></div>
        </div>
        <div class="gauge-sub">@Model.OutstandingInvoiceCount unpaid invoices</div>
    </div>
    <div class="gauge-item">
        <div class="gauge-header">
            <span class="gauge-label">Overdue</span>
            <span class="gauge-value" style="color:#C8912E;">@Model.CurrencySymbol@Model.OverdueAmount.ToString("N0")</span>
        </div>
        <div class="gauge-track">
            <div class="gauge-fill" style="width:@(overduePct)%;background:#C8912E;"></div>
        </div>
        <div class="gauge-sub">@overduePct% of outstanding</div>
    </div>
    }
    @if (Model.ShowPurchase)
    {
    <div class="gauge-item">
        <div class="gauge-header">
            <span class="gauge-label">Expenses</span>
            <span class="gauge-value" style="color:#0D5EA6;">@Model.CurrencySymbol@Model.ExpensesThisMonth.ToString("N0")</span>
        </div>
        <div class="gauge-track">
            <div class="gauge-fill" style="width:@(expensesPct)%;background:#0D5EA6;"></div>
        </div>
        <div class="gauge-sub">@expensesPct% of revenue &middot; @Model.ExpensesPurchaseCount purchases</div>
    </div>
    }
</div>
}

<!-- Quotation Stats Strip -->
@if (Model.ShowQuotation || Model.ShowVat)
{
<div class="quotation-strip">
    @if (Model.ShowQuotation)
    {
    <span class="qs-label" style="font-weight:700;margin-right:4px;">Quotations:</span>
    <div class="qs-item">
        <span class="qs-value">@Model.DraftCount</span>
        <span class="qs-label">Drafts</span>
    </div>
    <div class="qs-item">
        <span class="qs-value">@Model.SentThisMonthCount</span>
        <span class="qs-label">Sent</span>
        <span class="qs-sub">@Model.CurrencySymbol@Model.SentThisMonthValue.ToString("N0")</span>
    </div>
    <div class="qs-item">
        <span class="qs-value">@Model.AcceptedCount</span>
        <span class="qs-label">Accepted</span>
        <span class="qs-sub">@Model.AcceptanceRate%</span>
    </div>
    <div class="qs-item">
        <span class="qs-value">@Model.ActiveCustomerCount</span>
        <span class="qs-label">Customers</span>
    </div>
