@model Portal.Infrastructure.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Operations Workspace</div>
        <h1 class="topbar-heading">Dashboard</h1>
        <p class="topbar-subtitle">Track quotations, revenue, expenses, and operational activity in one workspace.</p>
    </div>
</div>

@{
    // Compute gauge percentages (computed before conditional block for Razor compatibility)
    var maxFinancial = new[] { Model.RevenueThisMonth, Model.OutstandingAmount, Model.ExpensesThisMonth }.Max();
    if (maxFinancial == 0) maxFinancial = 1; // avoid division by zero
    var revenuePct = (int)Math.Round(Model.RevenueThisMonth / maxFinancial * 100);
    var outstandingPct = (int)Math.Round(Model.OutstandingAmount / maxFinancial * 100);
    var overduePct = Model.OutstandingAmount > 0
        ? (int)Math.Round(Model.OverdueAmount / Model.OutstandingAmount * 100)
        : 0;
    var expensesPct = Model.RevenueThisMonth > 0
        ? (int)Math.Round(Model.ExpensesThisMonth / Model.RevenueThisMonth * 100)
        : 0;

    var onboarding = ViewBag.Onboarding as Portal.Infrastructure.Models.OnboardingStateDto;
}

@if (Model.HasAnyKpiSection)
{
<!-- Operational Briefing -->
var briefing = ViewBag.Briefing as Portal.Infrastructure.Models.BriefingViewModel;
if (briefing != null)
{
    @await Html.PartialAsync("_DashboardBriefing", briefing)
}

var systemBriefing = ViewBag.SystemBriefing as Portal.Infrastructure.Models.BriefingViewModel;
if (systemBriefing != null)
{
    <div style="margin-bottom:22px;">
        <button type="button" onclick="toggleSystemBriefing()" style="display:flex;align-items:center;gap:8px;background:none;border:none;cursor:pointer;padding:6px 0;font-size:13px;font-weight:600;color:#5a6a7a;">
            <svg id="systemBriefingChevron" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="transition:transform .2s;transform:rotate(-90deg);"><path d="M6 9l6 6 6-6"/></svg>
            System Health (SuperAdmin)
        </button>
        <div id="systemBriefingContent" style="display:none;margin-top:8px;">
            @await Html.PartialAsync("_DashboardBriefing", systemBriefing)
        </div>
    </div>
    <script>
        function toggleSystemBriefing() {
            var content = document.getElementById('systemBriefingContent');
            var chevron = document.getElementById('systemBriefingChevron');
            if (content.style.display === 'none') {
                content.style.display = 'block';
                chevron.style.transform = 'rotate(0deg)';
            } else {
                content.style.display = 'none';
                chevron.style.transform = 'rotate(-90deg)';
            }
        }
    </script>
}

<!-- Quick Actions -->
