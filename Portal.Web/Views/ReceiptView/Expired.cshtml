@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt Link Expired</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', -apple-system, sans-serif; background: #F7FAFC; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,.06); padding: 60px 40px; text-align: center; max-width: 480px; }
        h1 { color: #C8912E; margin-bottom: 12px; font-size: 24px; }
        p { color: #5a6a7a; font-size: 15px; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Link Expired</h1>
        <p>This receipt share link has expired. Please contact the sender for a new link.</p>
    </div>
</body>
</html>
