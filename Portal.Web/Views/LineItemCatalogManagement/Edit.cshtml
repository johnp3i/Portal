@model Portal.Web.Models.LineItemCatalogEditViewModel
@{
    ViewData["Title"] = "Edit Catalog Entry";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Catalog</div>
        <h1 style="margin-top:14px;font-size:42px;">Edit Catalog Entry</h1>
        <p class="muted" style="margin-top:10px;font-size:18px;line-height:1.8;">Update the catalog entry details below.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form method="post" asp-action="Edit" asp-controller="LineItemCatalogManagement" asp-route-id="@Model.Id" asp-antiforgery="true">
        <div class="form-grid">
            <div class="field">
                <label asp-for="Description">Description *</label>
                <input asp-for="Description" placeholder="Item description" />
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="UnitPrice">Unit Price *</label>
                <input asp-for="UnitPrice" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="UnitPrice" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="VatRate">VAT Rate (%) *</label>
                <input asp-for="VatRate" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="VatRate" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="ReferenceUrl">Reference URL</label>
                <input asp-for="ReferenceUrl" type="url" placeholder="https://example.com" />
                <span asp-validation-for="ReferenceUrl" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="Discount">Discount</label>
                <input asp-for="Discount" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Discount" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="DiscountType">Discount Type *</label>
                <select asp-for="DiscountType">
                    <option value="Percentage">Percentage</option>
                    <option value="Fixed">Fixed</option>
                </select>
                <span asp-validation-for="DiscountType" class="field-validation-error"></span>
            </div>
        </div>

        <div style="margin-top:22px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" asp-controller="LineItemCatalogManagement" class="btn btn-outline">&larr; Back to Catalog</a>
        </div>
    </form>
</section>
