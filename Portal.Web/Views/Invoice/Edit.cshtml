@model Portal.Infrastructure.Entities.Invoice
@{
    ViewData["Title"] = "Edit Invoice";
    var customers = ViewBag.Customers as IEnumerable<Portal.Infrastructure.Entities.Customer> ?? Enumerable.Empty<Portal.Infrastructure.Entities.Customer>();
    var lines = ViewBag.Lines as List<Portal.Infrastructure.Entities.InvoiceLine> ?? new List<Portal.Infrastructure.Entities.InvoiceLine>();
    var sections = ViewBag.Sections as List<Portal.Infrastructure.Entities.InvoiceSection> ?? new List<Portal.Infrastructure.Entities.InvoiceSection>();
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Edit Invoice</div>
        <h1 class="topbar-heading">@Model.InvoiceNumber</h1>
        <p class="topbar-subtitle">Update invoice details, manage line items and sections.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a asp-action="Detail" asp-controller="Invoice" asp-route-id="@Model.Id" class="btn btn-outline">&larr; Back to Detail</a>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom:18px;">
            @TempData["Error"]
        </div>
    }

    <form id="invoiceEditForm" method="post" asp-action="Edit" asp-controller="Invoice" asp-route-id="@Model.Id" asp-antiforgery="true">
        <div class="form-grid">
            <div class="field">
                <label for="invoiceNumber">Invoice Number *</label>
                <input type="text" name="invoiceNumber" id="invoiceNumber" required value="@Model.InvoiceNumber" maxlength="50" />
            </div>
            <div class="field">
                <label for="customerId">Customer *</label>
                <div style="display:flex;gap:10px;align-items:flex-end;">
                    <select name="customerId" id="customerId" required style="flex:1;">
                        <option value="">-- Select Customer --</option>
                        @foreach (var customer in customers)
                        {
                            <option value="@customer.Id" selected="@(customer.Id == Model.CustomerId ? "selected" : null)">@customer.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-secondary" onclick="openCustomerModal('customerId')">+ Add New</button>
                </div>
            </div>
            <div class="field">
                <label for="invoiceDate">Invoice Date *</label>
                <input type="date" name="invoiceDate" id="invoiceDate" required value="@Model.InvoiceDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field">
                <label for="dueDate">Due Date *</label>
                <input type="date" name="dueDate" id="dueDate" required value="@Model.DueDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field" style="grid-column:1 / -1;">
                <label for="notes">Notes</label>
                <textarea name="notes" id="notes" placeholder="Optional notes for this invoice">@Model.Notes</textarea>
            </div>
            <div class="field">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input type="checkbox" name="isGrandTotalShown" value="true" @(Model.IsGrandTotalShown ? "checked" : "") style="width:auto;" />
                    Show Grand Total
                </label>
            </div>
            <div class="field">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input type="checkbox" name="isQuotationReferenceShown" value="true" @(Model.IsQuotationReferenceShown ? "checked" : "") style="width:auto;" />
                    Show Quotation Reference
                </label>
            </div>
        </div>

    </form>
</section>

<!-- Editable Line Items -->
<section class="glass card-pad" style="margin-top:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;">
        <div>
            <div class="label">Line Items</div>
            <h2 style="margin-top:8px;font-size:24px;">Invoice lines</h2>
        </div>
    </div>

    @if (lines.Any())
    {
        <div class="scroll-hint">← Scroll horizontally →</div>
        <div class="table-responsive">
        <table class="line-item-table" style="margin-top:18px;">
            <thead>
                <tr>
                    <th class="col-row-num">#</th>
                    <th class="col-description">Description</th>
                    <th class="col-qty">Qty</th>
                    <th class="col-unit-price">Unit Price</th>
                    <th class="col-discount">Discount</th>
                    <th class="col-total">Total</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ var rowNum = 0; }
                @foreach (var line in lines.OrderBy(l => l.SortOrder))
                {
                    rowNum++;
                    var discountAmount = line.DiscountType == "Percentage"
                        ? (line.Quantity * line.UnitPrice * line.Discount / 100m)
                        : line.Discount;

                    <tr data-line-id="@line.Id"
                        data-description="@line.Description"
                        data-subtitle="@(line.Subtitle ?? "")"
                        data-reference-url="@(line.ReferenceUrl ?? "")"
                        data-quantity="@line.Quantity.ToString("G")"
                        data-unit-price="@line.UnitPrice.ToString("G")"
                        data-vat-rate="@line.VatRate.ToString("G")"
                        data-discount="@line.Discount.ToString("G")"
                        data-discount-type="@line.DiscountType"
                        data-cost-price="@(line.CostPrice?.ToString("G") ?? "")"
                        data-is-reverse-charge="@(line.IsReverseCharge ? "true" : "false")"
                        data-product-code="@(line.ProductCode ?? "")">
                        <td class="col-row-num"><span class="muted">@rowNum</span></td>
                        <td class="col-description">
                            <span class="line-desc">@line.Description</span>
                            @if (!string.IsNullOrWhiteSpace(line.Subtitle))
                            {
                                <span class="line-subtitle">@line.Subtitle</span>
                            }
                        </td>
                        <td class="col-qty">@line.Quantity.ToString("N2")</td>
                        <td class="col-unit-price">€@line.UnitPrice.ToString("N2")</td>
                        <td class="col-discount">
                            @if (line.Discount > 0)
                            {
                                <span class="discount-green">-€@discountAmount.ToString("N2")</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="col-total"><strong>€@line.LineTotal.ToString("N2")</strong></td>
                        <td class="col-actions">
                            <button type="button" class="btn-edit" onclick="showEditInvoiceLineModal(@line.Id)">Edit</button>
                            <button type="button" class="btn-remove" onclick="confirmRemoveInvoiceLine(@line.Id)">×</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="line-items-empty-state" style="margin-top:18px;">
            <p class="muted">No line items yet. Click below to add your first line item.</p>
        </div>
    }

    <!-- + Add Line button -->
    <button type="button" class="btn-add-line" onclick="showAddInvoiceLineModal()">+ Add Line</button>

    <div class="surface card-pad totals" style="margin-top:18px;">
        <div class="row"><span class="muted">Subtotal</span><strong id="totals-subtotal">@Model.Subtotal.ToString("N2")</strong></div>
        <div class="row"><span class="muted">Tax</span><strong id="totals-tax">@Model.TaxAmount.ToString("N2")</strong></div>
        <div class="row"><span>Total</span><span class="big-total" id="totals-total">@Model.TotalAmount.ToString("N2")</span></div>
    </div>
</section>

<!-- Sections Management -->
@if (sections.Any())
{
    <section class="glass card-pad" style="margin-top:24px;">
        <div>
            <div class="label">Sections</div>
            <h2 style="margin-top:8px;font-size:24px;">Manage sections</h2>
        </div>

        @foreach (var sec in sections.OrderBy(s => s.SortOrder))
        {
            <div class="surface card-pad" style="margin-top:16px;position:relative;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <div>
                        <strong style="font-size:15px;">@sec.Name</strong>
                        <span class="muted" style="margin-left:8px;font-size:12px;">(@sec.SectionType)</span>
                    </div>
                    <div style="display:flex;gap:8px;">
                        <button type="button" class="btn btn-secondary" style="padding:4px 10px;font-size:12px;" onclick="showEditSectionForm(@sec.Id)">Edit</button>
                        <button type="button" class="btn btn-danger" style="padding:4px 10px;font-size:12px;" onclick="removeSection(@sec.Id)">Remove</button>
                    </div>
                </div>

                <!-- Edit Section Form (hidden) -->
                <div id="edit-section-@sec.Id" style="display:none;margin-top:16px;">
                    <div class="form-grid">
                        <div class="field">
                            <label>Name *</label>
                            <input type="text" id="editSec_name_@sec.Id" value="@sec.Name" />
                        </div>
                        <div class="field" style="grid-column:1 / -1;">
                            <label>Description</label>
                            <div id="editSec_description_@sec.Id" contenteditable="true" class="richtext-editor">@Html.Raw(sec.Description ?? "")</div>
                        </div>
                        <div class="field" style="grid-column:1 / -1;">
                            <label>Notes</label>
                            <div id="editSec_notes_@sec.Id" contenteditable="true" class="richtext-editor">@Html.Raw(sec.Notes ?? "")</div>
                        </div>
                    </div>
                    <div style="margin-top:12px;display:flex;gap:12px;">
                        <button type="button" class="btn btn-primary" style="padding:8px 16px;font-size:13px;" onclick="updateSection(@sec.Id)">Save</button>
                        <button type="button" class="btn btn-secondary" style="padding:8px 16px;font-size:13px;" onclick="hideEditSectionForm(@sec.Id)">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </section>
}

<!-- Back to Detail (bottom right) -->
<div style="margin-top:24px;display:flex;justify-content:flex-end;">
    <a asp-action="Detail" asp-controller="Invoice" asp-route-id="@Model.Id" class="btn btn-outline">&larr; Back to Detail</a>
</div>

@await Html.PartialAsync("_CustomerModal")
@await Html.PartialAsync("_InvoiceLineItemModal", Model)

<!-- Bottom spacer for sticky action bar -->
<div style="height:80px;"></div>

<!-- Sticky Action Bar -->
<div class="sticky-action-bar">
    <div class="sticky-action-bar__inner">
        <a asp-action="Index" asp-controller="Invoice" class="btn btn-secondary">Cancel</a>
        <button type="submit" form="invoiceEditForm" class="btn btn-primary">Save Invoice</button>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/invoice-line-modal.css" />
    <style>
.sticky-action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: #d6e6f0;
    border-top: 1.5px solid rgba(13,94,166,.15);
    box-shadow: 0 -4px 20px rgba(0,0,0,.08);
    padding: 14px 32px;
}
.sticky-action-bar__inner {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
}
        .catalog-autocomplete {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 10000;
            max-height: 240px;
            overflow-y: auto;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(13,94,166,.12);
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(13,94,166,.10);
            margin-top: 4px;
            display: none;
        }
        .catalog-autocomplete.active { display: block; }
        .catalog-autocomplete-item {
            padding: 10px 14px;
            cursor: pointer;
            border-bottom: 1px solid rgba(13,94,166,.06);
            transition: background .15s;
            font-size: 13px;
            line-height: 1.5;
        }
        .catalog-autocomplete-item:last-child { border-bottom: none; }
        .catalog-autocomplete-item:hover,
        .catalog-autocomplete-item.selected {
            background: rgba(13,94,166,.06);
        }
        .catalog-autocomplete-item .catalog-desc {
            font-weight: 600;
            color: #1a2b3c;
        }
        .catalog-autocomplete-item .catalog-meta {
            font-size: 11px;
            color: var(--muted2, #6b7c8d);
            margin-top: 2px;
        }
    </style>
    <script src="~/js/customer-modal.js"></script>
    <script src="~/js/invoice-line-modal.js"></script>
    <script>
        var invoiceId = @Model.Id;
        var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        function showEditSectionForm(sectionId) {
            document.getElementById('edit-section-' + sectionId).style.display = 'block';
        }

        function hideEditSectionForm(sectionId) {
            document.getElementById('edit-section-' + sectionId).style.display = 'none';
        }

        function updateSection(sectionId) {
            var data = 'sectionId=' + sectionId
                + '&name=' + encodeURIComponent(document.getElementById('editSec_name_' + sectionId).value)
                + '&description=' + encodeURIComponent(document.getElementById('editSec_description_' + sectionId).innerHTML || '')
                + '&notes=' + encodeURIComponent(document.getElementById('editSec_notes_' + sectionId).innerHTML || '');

            BlockUI.show('Updating section...');
            fetch('/Invoice/UpdateSection', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': antiForgeryToken
                },
                body: data
            })
            .then(function(r) { return r.json(); })
            .then(function(result) {
                BlockUI.hide();
                if (result.success) {
                    window.location.reload();
                } else {
                    Swal.fire({ title: 'Error', text: result.message || 'Failed to update section.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            })
            .catch(function() { BlockUI.hide(); Swal.fire({ title: 'Error', text: 'An error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' }); });
        }

        function removeSection(sectionId) {
            Swal.fire({
                title: 'Remove this section?',
                text: 'Lines will be moved to the General group.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6B7F8E',
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Cancel'
            }).then(function(result) {
                if (!result.isConfirmed) return;

                BlockUI.show('Removing section...');
                fetch('/Invoice/RemoveSection', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'sectionId=' + sectionId + '&invoiceId=' + invoiceId
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    BlockUI.hide();
                    if (data.success) {
                        window.location.reload();
                    } else {
                        Swal.fire({ title: 'Error', text: data.message || 'Failed to remove section.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                    }
                })
                .catch(function() { BlockUI.hide(); Swal.fire({ title: 'Error', text: 'An error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' }); });
            });
        }
    </script>
    <script>
        // --- Catalog Autocomplete for Invoice Line Item Modal ---
        (function() {
            var debounceTimer = null;
            var activeDropdown = null;
            var activeInput = null;
            var selectedIndex = -1;

            function createDropdown(input) {
                var existing = input.parentElement.querySelector('.catalog-autocomplete');
                if (existing) return existing;
                var dropdown = document.createElement('div');
                dropdown.className = 'catalog-autocomplete';
                input.parentElement.appendChild(dropdown);
                return dropdown;
            }

            function hideDropdown(dropdown) {
                if (dropdown) {
                    dropdown.classList.remove('active');
                    dropdown.innerHTML = '';
                }
                selectedIndex = -1;
                activeDropdown = null;
                activeInput = null;
            }

            function fillFormFields(form, entry) {
                var fields = { 'unitPrice': entry.unitPrice, 'vatRate': entry.vatRate, 'costPrice': entry.costPrice || '' };
                Object.keys(fields).forEach(function(name) {
                    var el = form.querySelector('[name="' + name + '"]');
                    if (el) el.value = fields[name];
                });
                var productCodeEl = form.querySelector('[name="productCode"]');
                if (productCodeEl && entry.productCode) {
                    productCodeEl.value = entry.productCode;
                }
            }

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function renderDropdown(dropdown, results, input) {
                dropdown.innerHTML = '';
                if (results.length === 0) { hideDropdown(dropdown); return; }
                results.forEach(function(entry, index) {
                    var item = document.createElement('div');
                    item.className = 'catalog-autocomplete-item';
                    item.dataset.index = index;
                    var discount = entry.discount > 0
                        ? ' | Discount: ' + entry.discount + (entry.discountType === 'Percentage' ? '%' : ' Fixed')
                        : '';
                    item.innerHTML = '<div class="catalog-desc">' + escapeHtml(entry.description) + '</div>'
                        + '<div class="catalog-meta">Price: ' + entry.unitPrice.toFixed(2) + ' | VAT: ' + entry.vatRate + '%' + discount + '</div>';
                    item.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        var form = input.closest('form');
                        input.value = entry.description;
                        fillFormFields(form, entry);
                        hideDropdown(dropdown);
                    });
                    dropdown.appendChild(item);
                });
                dropdown.classList.add('active');
                activeDropdown = dropdown;
                activeInput = input;
                selectedIndex = -1;
            }

            async function fetchCatalog(query, input) {
                if (query.length < 2) {
                    var dropdown = input.parentElement.querySelector('.catalog-autocomplete');
                    if (dropdown) hideDropdown(dropdown);
                    return;
                }
                try {
                    var response = await fetch('/api/catalog/search?q=' + encodeURIComponent(query));
                    if (!response.ok) return;
                    var results = await response.json();
                    var dropdown = createDropdown(input);
                    renderDropdown(dropdown, results, input);
                } catch (e) {
                    // Silently fail — autocomplete is supplementary
                }
            }

            function isInvoiceLineForm(field) {
                var form = field.closest('form');
                if (!form) return false;
                return form.id === 'invoiceLineItemForm';
            }

            // Debounced input handler
            document.addEventListener('input', function(e) {
                var isDescField = (e.target.tagName === 'INPUT')
                                  && e.target.name === 'description'
                                  && isInvoiceLineForm(e.target);
                if (isDescField) {
                    clearTimeout(debounceTimer);
                    var field = e.target;
                    var query = field.value.trim();
                    debounceTimer = setTimeout(function() { fetchCatalog(query, field); }, 300);
                }
            });

            // Hide dropdown on blur (with delay for mousedown to fire first)
            document.addEventListener('focusout', function(e) {
                if (e.target.tagName === 'INPUT' && e.target.name === 'description' && isInvoiceLineForm(e.target)) {
                    var target = e.target;
                    setTimeout(function() {
                        var dropdown = target.parentElement.querySelector('.catalog-autocomplete');
                        if (dropdown) hideDropdown(dropdown);
                    }, 200);
                }
            });

            // Keyboard navigation
            document.addEventListener('keydown', function(e) {
                if (!activeDropdown || !activeDropdown.classList.contains('active')) return;
                if (e.target.tagName !== 'INPUT' || e.target.name !== 'description') return;

                var items = activeDropdown.querySelectorAll('.catalog-autocomplete-item');
                if (items.length === 0) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                    items.forEach(function(it, i) { it.classList.toggle('selected', i === selectedIndex); });
                    items[selectedIndex].scrollIntoView({ block: 'nearest' });
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    selectedIndex = Math.max(selectedIndex - 1, 0);
                    items.forEach(function(it, i) { it.classList.toggle('selected', i === selectedIndex); });
                    items[selectedIndex].scrollIntoView({ block: 'nearest' });
                } else if (e.key === 'Enter' && selectedIndex >= 0) {
                    e.preventDefault();
                    items[selectedIndex].dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
                } else if (e.key === 'Escape') {
                    hideDropdown(activeDropdown);
                }
            });
        })();
    </script>
    @Html.AntiForgeryToken()
}
