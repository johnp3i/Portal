@{
    ViewData["Title"] = "Create Invoice";
    var customers = ViewBag.Customers as IEnumerable<Portal.Infrastructure.Entities.Customer> ?? Enumerable.Empty<Portal.Infrastructure.Entities.Customer>();
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Create Invoice</div>
        <h1 class="topbar-heading">Create a new invoice</h1>
        <p class="topbar-subtitle">Build a standalone invoice with line items, sections, and controlled totals.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom:18px;">
            @TempData["Error"]
        </div>
    }

    <form method="post" asp-action="Create" asp-controller="Invoice" asp-antiforgery="true" id="invoiceForm">
        <!-- Invoice Header -->
        <div class="form-grid">
            <div class="field">
                <label for="customerId">Customer *</label>
                <div style="display:flex;gap:10px;align-items:flex-end;">
                    <select name="customerId" id="customerId" required style="flex:1;">
                        <option value="">-- Select Customer --</option>
                        @foreach (var customer in customers)
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-secondary" onclick="openCustomerModal('customerId')">+ Add New</button>
                </div>
            </div>
            <div class="field">
                <label for="invoiceDate">Invoice Date *</label>
                <input type="date" name="invoiceDate" id="invoiceDate" required />
            </div>
            <div class="field">
                <label for="dueDate">Due Date *</label>
                <input type="date" name="dueDate" id="dueDate" required />
            </div>
            <div class="field" style="grid-column:1 / -1;position:relative;">
                <button type="button" onclick="var t=this.parentElement.querySelector('textarea');var svg=this.querySelector('svg');if(t.style.display==='none'){t.style.display='';svg.style.transform='rotate(180deg)';}else{t.style.display='none';svg.style.transform='rotate(0deg)';}" style="position:absolute;top:0;right:0;background:rgba(13,94,166,.06);border:1.5px solid rgba(13,94,166,.12);border-radius:10px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5E7385" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <label for="notes">Notes</label>
                <textarea name="notes" id="notes" placeholder="Optional notes for this invoice" style="display:none;margin-top:8px;"></textarea>
            </div>
            <div class="field">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input type="checkbox" name="isGrandTotalShown" value="true" checked style="width:auto;" />
                    Show Grand Total
                </label>
            </div>
        </div>

        <!-- Line Items Section -->
        <div style="margin-top:32px;border-top:1px solid rgba(13,94,166,.08);padding-top:24px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div class="label">Line Items</div>
                    <h2 style="margin-top:8px;font-size:24px;">Invoice lines</h2>
                </div>
                <button type="button" class="btn btn-primary" onclick="addLineItem()">+ Add Line</button>
            </div>

            <div id="lineItemsContainer" style="margin-top:18px;">
                <!-- Line items will be added here dynamically -->
            </div>
        </div>

        <!-- Sections (Optional) -->
        <div style="margin-top:32px;border-top:1px solid rgba(13,94,166,.08);padding-top:24px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div class="label">Sections (Optional)</div>
                    <h2 style="margin-top:8px;font-size:24px;">Group line items</h2>
                </div>
                <button type="button" class="btn btn-secondary" onclick="addSection()">+ Add Section</button>
            </div>

            <div id="sectionsContainer" style="margin-top:18px;">
                <!-- Sections will be added here dynamically -->
            </div>
        </div>

        <!-- Submit -->
        <div style="margin-top:32px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary">Create Invoice</button>
            <a asp-action="Index" asp-controller="Invoice" class="btn btn-outline">&larr; Back to Invoices</a>
        </div>
    </form>
</section>

@await Html.PartialAsync("_CustomerModal")

@section Scripts {
    <style>
        /* Catalog autocomplete dropdown (per line card) */
        .catalog-autocomplete {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 999;
            max-height: 240px;
            overflow-y: auto;
            background: rgba(255,255,255,.96);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(13,94,166,.12);
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(13,94,166,.10);
            margin-top: 4px;
            display: none;
        }
        .catalog-autocomplete.active { display: block; }
        .catalog-autocomplete-item { padding: 10px 14px; cursor: pointer; border-bottom: 1px solid rgba(13,94,166,.05); }
        .catalog-autocomplete-item:hover { background: rgba(13,94,166,.05); }
        .catalog-autocomplete-item .catalog-desc { font-size: 14px; font-weight: 600; color: #0B1B28; }
        .catalog-autocomplete-item .catalog-meta { font-size: 12px; color: #5a6a7a; margin-top: 2px; }

        /* Price Tier selector — highlighted styling to match the tier-selector mockup */
        .tier-selector .tier-select {
            background: rgba(13,94,166,.03);
            border-color: #0D5EA6 !important;
            font-weight: 600;
        }
        .tier-price-highlight {
            background: rgba(18,152,103,.04);
            border: 1.5px solid rgba(18,152,103,.15);
            border-radius: 10px;
            padding: 12px 16px;
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .tier-price-highlight .tph-label { font-size: 12px; color: #5a6a7a; }
        .tier-price-highlight .tph-value { font-size: 18px; font-weight: 800; color: #129867; font-family: 'Manrope', sans-serif; }
        .tier-price-highlight .tph-value--muted { color: #5a6a7a; font-size: 14px; }
    </style>
    <script src="~/js/customer-modal.js"></script>
    <script>
        var lineIndex = 0;
        var sectionIndex = 0;

        function addLineItem() {
            var container = document.getElementById('lineItemsContainer');
            var idx = lineIndex;
            var html = '<div class="surface card-pad" style="margin-bottom:16px;position:relative;" id="line-' + idx + '">'
                + '<button type="button" class="btn btn-danger" style="position:absolute;top:12px;right:12px;padding:4px 10px;font-size:12px;" onclick="removeLineItem(' + idx + ')">Remove</button>'
                + '<input type="hidden" name="lines[' + idx + '].ProductCode" id="line-productcode-' + idx + '" />'
                + '<input type="hidden" name="lines[' + idx + '].ProductPriceTierId" id="line-tierid-' + idx + '" />'
                + '<div class="form-grid">'
                + '<div class="field" style="grid-column:1 / -1;position:relative;">'
                + '<label>Description *</label>'
                + '<input type="text" name="lines[' + idx + '].Description" id="line-desc-' + idx + '" required placeholder="Line item description" autocomplete="off" />'
                + '</div>'
                + '<div class="field tier-selector" style="grid-column:1 / -1;display:none;" id="line-tierrow-' + idx + '">'
                + '<label>Price Tier</label>'
                + '<select class="tier-select" id="line-tierselect-' + idx + '" onchange="onCreateLineTierChange(' + idx + ')"></select>'
                + '<div class="helper" style="font-size:11px;color:#5a6a7a;margin-top:4px;">Select the pricing level for this line item. The default tier is pre-selected.</div>'
                + '<div class="tier-price-highlight" id="line-tierhighlight-' + idx + '" style="display:none;">'
                + '<div><div class="tph-label">Unit Price (from tier)</div><div class="tph-value" id="line-tierhighlight-unit-' + idx + '">\u2014</div></div>'
                + '<div style="margin-left:auto;"><div class="tph-label">Cost Price</div><div class="tph-value tph-value--muted" id="line-tierhighlight-cost-' + idx + '">\u2014</div></div>'
                + '</div>'
                + '</div>'
                + '<div class="field">'
                + '<label>Quantity *</label>'
                + '<input type="number" name="lines[' + idx + '].Quantity" step="0.01" min="0.01" required value="1" inputmode="decimal" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Unit Price *</label>'
                + '<input type="number" name="lines[' + idx + '].UnitPrice" id="line-unitprice-' + idx + '" step="0.01" min="0" required value="0" inputmode="decimal" />'
                + '</div>'
                + '<div style="grid-column:1 / -1;display:flex;align-items:center;gap:8px;padding:8px 0;">'
                + '<input type="checkbox" name="lines[' + idx + '].IsReverseCharge" value="true" id="line-rc-' + idx + '" onchange="toggleCreateReverseCharge(this, ' + idx + ')" style="width:16px;height:16px;" />'
                + '<label for="line-rc-' + idx + '" style="margin:0;font-size:13px;font-weight:600;">Reverse Charge</label>'
                + '<span style="font-size:12px;color:#5a6a7a;margin-left:4px;">— VAT is accounted for by the buyer (B2B EU cross-border services)</span>'
                + '</div>'
                + '<div class="field">'
                + '<label>VAT Rate (%)</label>'
                + '<input type="number" name="lines[' + idx + '].VatRate" step="0.01" min="0" max="100" value="0" inputmode="decimal" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Discount</label>'
                + '<input type="number" name="lines[' + idx + '].Discount" step="0.01" min="0" value="0" inputmode="decimal" />'
                + '</div>'
                // (Discount is never auto-filled — the user sets it manually.)
                + '<div class="field">'
                + '<label>Discount Type</label>'
                + '<select name="lines[' + idx + '].DiscountType">'
                + '<option value="Percentage">Percentage</option>'
                + '<option value="Fixed">Fixed</option>'
                + '</select>'
                + '</div>'
                + '<div class="field">'
                + '<label>Cost Price</label>'
                + '<input type="number" name="lines[' + idx + '].CostPrice" id="line-costprice-' + idx + '" step="0.01" min="0" placeholder="Optional" inputmode="decimal" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Reference URL</label>'
                + '<input type="url" name="lines[' + idx + '].ReferenceUrl" placeholder="Optional URL" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Subtitle</label>'
                + '<input type="text" name="lines[' + idx + '].Subtitle" placeholder="Optional subtitle" />'
                + '</div>'
                + '</div>'
                + '</div>';

            container.insertAdjacentHTML('beforeend', html);
            lineIndex++;
        }

        function removeLineItem(idx) {
            var el = document.getElementById('line-' + idx);
            if (el) el.remove();
        }

        // ─── Per-card price-tier selector, driven by the shared product-autocomplete.js ──────────────
        var _createLineTiers = {};            // idx -> tiers array
        var _createLineCurrency = {};         // idx -> currency symbol

        // Given a line card element, extract its numeric index from an id like "line-5".
        function cardIndexFromContainer(container) {
            if (!container || !container.id) return null;
            var m = container.id.match(/^line-(\d+)$/);
            return m ? parseInt(m[1], 10) : null;
        }

        // Called by product-autocomplete.js after a product is selected in a line card.
        // The shared script already filled Description/UnitPrice/VatRate/CostPrice/ProductCode.
        window.onProductAutocompleteSelected = function (container, entry) {
            var idx = cardIndexFromContainer(container);
            if (idx === null) return;

            if (entry && entry.productCode) {
                fetchCreateLineTiers(idx, entry.productCode, null);
            } else if (entry && entry.description) {
                fetchCreateLineTiers(idx, null, entry.description);
            } else {
                hideCreateLineTiers(idx);
            }
        };

        async function fetchCreateLineTiers(idx, productCode, description) {
            hideCreateLineTiers(idx);
            var query = '';
            if (productCode) query = 'productCode=' + encodeURIComponent(productCode);
            else if (description) query = 'description=' + encodeURIComponent(description);
            else return;

            try {
                var response = await fetch('/Invoice/AxGetProductTiersForSelection?' + query);
                if (!response.ok) return;
                var result = await response.json();
                if (!result.success || !result.data || !result.data.hasTiers) return;

                var data = result.data;
                _createLineTiers[idx] = data.tiers || [];
                _createLineCurrency[idx] = data.currencySymbol || '\u20ac';
                if (_createLineTiers[idx].length === 0) return;

                var select = document.getElementById('line-tierselect-' + idx);
                select.innerHTML = '';
                data.tiers.forEach(function (tier) {
                    var opt = document.createElement('option');
                    opt.value = tier.id.toString();
                    opt.textContent = tier.tierName + ' \u2014 ' + _createLineCurrency[idx] + parseFloat(tier.sellingPrice).toFixed(2);
                    if (tier.id === data.defaultTierId) opt.selected = true;
                    select.appendChild(opt);
                });

                document.getElementById('line-tierrow-' + idx).style.display = '';

                if (data.defaultTierId) {
                    select.value = data.defaultTierId.toString();
                    applyCreateLineTier(idx, data.defaultTierId);
                }
            } catch (e) { /* silently fail — tiers are supplementary */ }
        }

        function onCreateLineTierChange(idx) {
            var select = document.getElementById('line-tierselect-' + idx);
            var tierId = parseInt(select.value);
            if (isNaN(tierId)) {
                document.getElementById('line-tierid-' + idx).value = '';
                return;
            }
            applyCreateLineTier(idx, tierId);
        }

        function applyCreateLineTier(idx, tierId) {
            var tiers = _createLineTiers[idx] || [];
            var tier = tiers.find(function (t) { return t.id === tierId; });
            if (!tier) return;

            document.getElementById('line-unitprice-' + idx).value = parseFloat(tier.sellingPrice).toFixed(2);
            var costEl = document.getElementById('line-costprice-' + idx);
            if (costEl) costEl.value = tier.costPrice > 0 ? parseFloat(tier.costPrice).toFixed(2) : '';
            document.getElementById('line-tierid-' + idx).value = tierId.toString();

            // Update the highlight box
            var cur = _createLineCurrency[idx] || '\u20ac';
            var box = document.getElementById('line-tierhighlight-' + idx);
            document.getElementById('line-tierhighlight-unit-' + idx).textContent = cur + parseFloat(tier.sellingPrice).toFixed(2);
            document.getElementById('line-tierhighlight-cost-' + idx).textContent = tier.costPrice > 0 ? cur + parseFloat(tier.costPrice).toFixed(2) : '\u2014';
            if (box) box.style.display = 'flex';
        }

        function hideCreateLineTiers(idx) {
            var row = document.getElementById('line-tierrow-' + idx);
            if (row) row.style.display = 'none';
            var select = document.getElementById('line-tierselect-' + idx);
            if (select) select.innerHTML = '';
            var tierIdEl = document.getElementById('line-tierid-' + idx);
            if (tierIdEl) tierIdEl.value = '';
            var box = document.getElementById('line-tierhighlight-' + idx);
            if (box) box.style.display = 'none';
            _createLineTiers[idx] = [];
        }

        function toggleCreateReverseCharge(checkbox, idx) {
            var vatInput = document.querySelector('input[name="lines[' + idx + '].VatRate"]');
            if (checkbox.checked) {
                vatInput.dataset.previousVatRate = vatInput.value;
                vatInput.value = '0';
                vatInput.readOnly = true;
                vatInput.style.opacity = '0.6';
            } else {
                var previousRate = vatInput.dataset.previousVatRate || '0';
                vatInput.value = previousRate;
                vatInput.readOnly = false;
                vatInput.style.opacity = '1';
            }
        }

        function addSection() {
            var container = document.getElementById('sectionsContainer');
            var idx = sectionIndex;
            var html = '<div class="surface card-pad" style="margin-bottom:16px;position:relative;" id="section-' + idx + '">'
                + '<button type="button" class="btn btn-danger" style="position:absolute;top:12px;right:12px;padding:4px 10px;font-size:12px;" onclick="removeSection(' + idx + ')">Remove</button>'
                + '<div class="form-grid">'
                + '<div class="field">'
                + '<label>Section Name *</label>'
                + '<input type="text" name="sections[' + idx + '].Name" required placeholder="Section name" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Column Configuration</label>'
                + '<select name="sections[' + idx + '].ColumnConfiguration">'
                + '<option value="OneTime">OneTime</option>'
                + '<option value="Monthly">Monthly</option>'
                + '<option value="Yearly">Yearly</option>'
                + '</select>'
                + '</div>'
                + '<div class="field">'
                + '<label>Section Type</label>'
                + '<select name="sections[' + idx + '].SectionType">'
                + '<option value="LineItems">LineItems</option>'
                + '<option value="Narrative">Narrative</option>'
                + '</select>'
                + '</div>'
                + '<div class="field" style="grid-column:1 / -1;">'
                + '<label>Description</label>'
                + '<textarea name="sections[' + idx + '].Description" placeholder="Optional section description"></textarea>'
                + '</div>'
                + '</div>'
                + '</div>';

            container.insertAdjacentHTML('beforeend', html);
            sectionIndex++;
        }

        function removeSection(idx) {
            var el = document.getElementById('section-' + idx);
            if (el) el.remove();
        }

        // Add one line item by default
        document.addEventListener('DOMContentLoaded', function() {
            addLineItem();
        });
    </script>
}
