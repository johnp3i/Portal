@{
    ViewData["Title"] = "Create Invoice";
    var customers = ViewBag.Customers as IEnumerable<Portal.Infrastructure.Entities.Customer> ?? Enumerable.Empty<Portal.Infrastructure.Entities.Customer>();
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Create Invoice</div>
        <h1 class="topbar-heading">Create a new invoice</h1>
        <p class="topbar-subtitle">Build a standalone invoice with line items, sections, and controlled totals.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom:18px;">
            @TempData["Error"]
        </div>
    }

    <form method="post" asp-action="Create" asp-controller="Invoice" asp-antiforgery="true" id="invoiceForm">
        <!-- Invoice Header -->
        <div class="form-grid">
            <div class="field">
                <label for="customerId">Customer *</label>
                <div style="display:flex;gap:10px;align-items:flex-end;">
                    <select name="customerId" id="customerId" required style="flex:1;">
                        <option value="">-- Select Customer --</option>
                        @foreach (var customer in customers)
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-secondary" onclick="openCustomerModal('customerId')">+ Add New</button>
                </div>
            </div>
            <div class="field">
                <label for="invoiceDate">Invoice Date *</label>
                <input type="date" name="invoiceDate" id="invoiceDate" required />
            </div>
            <div class="field">
                <label for="dueDate">Due Date *</label>
                <input type="date" name="dueDate" id="dueDate" required />
            </div>
            <div class="field" style="grid-column:1 / -1;position:relative;">
                <button type="button" onclick="var t=this.parentElement.querySelector('textarea');var svg=this.querySelector('svg');if(t.style.display==='none'){t.style.display='';svg.style.transform='rotate(180deg)';}else{t.style.display='none';svg.style.transform='rotate(0deg)';}" style="position:absolute;top:0;right:0;background:rgba(13,94,166,.06);border:1.5px solid rgba(13,94,166,.12);border-radius:10px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5E7385" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <label for="notes">Notes</label>
                <textarea name="notes" id="notes" placeholder="Optional notes for this invoice" style="display:none;margin-top:8px;"></textarea>
            </div>
            <div class="field">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input type="checkbox" name="isGrandTotalShown" value="true" checked style="width:auto;" />
                    Show Grand Total
                </label>
            </div>
        </div>

        <!-- Line Items Section — modal-driven, matching the Edit page UX -->
        <div style="margin-top:32px;border-top:1px solid rgba(13,94,166,.08);padding-top:24px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div class="label">Line Items</div>
                    <h2 style="margin-top:8px;font-size:24px;">Invoice lines
                        <span id="createLineItemsCount" style="font-size:14px;font-weight:600;color:#5E7385;margin-left:8px;">· 0 items</span>
                    </h2>
                </div>
            </div>

            <!-- Line items table (hidden until the first line is added) -->
            <div id="createLineItemsTableWrap" class="table-responsive" style="display:none;margin-top:18px;">
                <table class="line-item-table">
                    <thead>
                        <tr>
                            <th class="col-row-num">#</th>
                            <th class="col-description">Description</th>
                            <th class="col-qty">Qty</th>
                            <th class="col-unit-price">Unit Price</th>
                            <th class="col-subtotal">Subtotal</th>
                            <th class="col-vat">VAT %</th>
                            <th class="col-discount">Discount</th>
                            <th class="col-total">Total</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="createLineItemsTableBody"></tbody>
                </table>
            </div>

            <!-- Empty state -->
            <div id="createLineItemsEmptyState" class="lines-empty" style="margin-top:18px;display:flex;flex-direction:column;align-items:center;text-align:center;">
                <div class="lines-empty__icon" aria-hidden="true" style="display:flex;align-items:center;justify-content:center;">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2.5" />
                        <path d="M3 9h18" />
                        <path d="M8 14h5" />
                        <path d="M8 17h8" />
                    </svg>
                </div>
                <h3 class="lines-empty__title">No line items yet</h3>
                <p class="lines-empty__text">Add products or services to this invoice. Each line can carry its own quantity, pricing, VAT, and discount.</p>
                <button type="button" class="btn btn-primary lines-empty__cta" onclick="showAddCreateLineModal()" style="display:inline-flex;align-items:center;gap:8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Add your first line item
                </button>
            </div>

            <!-- + Add Line opens the modal (same UX as the Edit page). Hidden while the
                 empty state is showing to avoid two competing "add" actions. -->
            <button type="button" id="createAddLineBtn" class="btn-add-line" style="display:none;" onclick="showAddCreateLineModal()">+ Add Line</button>

            <!-- Hidden lines[idx].* inputs are injected here so the Create POST binds List<CreateInvoiceLineDto> -->
            <div id="createLineHiddenInputs" style="display:none;"></div>
        </div>

        <!-- Sections (Optional) -->
        <div style="margin-top:32px;border-top:1px solid rgba(13,94,166,.08);padding-top:24px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div class="label">Sections (Optional)</div>
                    <h2 style="margin-top:8px;font-size:24px;">Group line items</h2>
                </div>
                <button type="button" class="btn btn-secondary" onclick="addSection()">+ Add Section</button>
            </div>

            <div id="sectionsContainer" style="margin-top:18px;">
                <!-- Sections will be added here dynamically -->
            </div>
        </div>

        <!-- Bulk Discount (info) — applied after the invoice is created -->
        <div style="margin-top:32px;border-top:1px solid rgba(13,94,166,.08);padding-top:24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
            <div>
                <div class="label">Invoice-level discount</div>
                <p style="margin:6px 0 0;font-size:13px;color:#5a6a7a;max-width:520px;">
                    Need to round the total or apply a single discount across all lines? Use a bulk discount.
                    It's applied once the invoice is created.
                </p>
            </div>
            <button type="button" class="btn btn-secondary" onclick="showBulkDiscountInfo()" style="display:inline-flex;align-items:center;gap:8px;">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 12H4M12 4v16"/></svg>
                Bulk Discount
            </button>
        </div>

        <!-- Submit -->
        <div style="margin-top:32px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary">Create Invoice</button>
            <a asp-action="Index" asp-controller="Invoice" class="btn btn-outline">&larr; Back to Invoices</a>
        </div>
    </form>
</section>

@await Html.PartialAsync("_CustomerModal")
@await Html.PartialAsync("_CreateInvoiceLineModal")

@section Scripts {
    <link rel="stylesheet" href="~/css/invoice-line-modal.css" />
    <style>
        /* Line items empty state — dashed card with icon, copy, and a primary CTA */
        .lines-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 40px 24px;
            border: 1.5px dashed rgba(13, 94, 166, .22);
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(87,184,232,.05), rgba(13,94,166,.03));
        }
        .lines-empty__icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0D5EA6;
            background: rgba(13, 94, 166, .08);
            margin-bottom: 16px;
        }
        .lines-empty__title {
            margin: 0;
            font-family: 'Manrope', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #0B1B28;
            letter-spacing: -0.01em;
        }
        .lines-empty__text {
            margin: 8px 0 20px;
            font-size: 13.5px;
            line-height: 1.6;
            color: #5a6a7a;
            max-width: 420px;
        }
        .lines-empty__cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        /* Catalog autocomplete dropdown (per line card) */
        .catalog-autocomplete {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 999;
            max-height: 240px;
            overflow-y: auto;
            background: rgba(255,255,255,.96);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(13,94,166,.12);
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(13,94,166,.10);
            margin-top: 4px;
            display: none;
        }
        .catalog-autocomplete.active { display: block; }
        .catalog-autocomplete-item { padding: 10px 14px; cursor: pointer; border-bottom: 1px solid rgba(13,94,166,.05); }
        .catalog-autocomplete-item:hover { background: rgba(13,94,166,.05); }
        .catalog-autocomplete-item .catalog-desc { font-size: 14px; font-weight: 600; color: #0B1B28; }
        .catalog-autocomplete-item .catalog-meta { font-size: 12px; color: #5a6a7a; margin-top: 2px; }

        /* Price Tier selector — highlighted styling to match the tier-selector mockup */
        .tier-selector .tier-select {
            background: rgba(13,94,166,.03);
            border-color: #0D5EA6 !important;
            font-weight: 600;
        }
        .tier-price-highlight {
            background: rgba(18,152,103,.04);
            border: 1.5px solid rgba(18,152,103,.15);
            border-radius: 10px;
            padding: 12px 16px;
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .tier-price-highlight .tph-label { font-size: 12px; color: #5a6a7a; }
        .tier-price-highlight .tph-value { font-size: 18px; font-weight: 800; color: #129867; font-family: 'Manrope', sans-serif; }
        .tier-price-highlight .tph-value--muted { color: #5a6a7a; font-size: 14px; }
    </style>
    <script src="~/js/customer-modal.js"></script>
    <script src="~/js/invoice-create-lines.js"></script>
    <script>
        var sectionIndex = 0;

        // Bulk Discount info + guided action. Bulk discount is a post-creation operation
        // (it needs a saved invoice with persisted lines), so here we explain it and offer to
        // create the invoice now and continue to it to apply the discount.
        function showBulkDiscountInfo() {
            var customerId = document.getElementById('customerId').value;
            var lineCount = (typeof window.getCreateLineCount === 'function') ? window.getCreateLineCount() : 0;
            var formReady = customerId && lineCount > 0
                && document.getElementById('invoiceDate').value
                && document.getElementById('dueDate').value;

            Swal.fire({
                icon: 'info',
                title: 'Bulk Discount',
                html: '<p style="margin:0 0 10px;text-align:left;">A <strong>bulk discount</strong> applies a single discount across the whole invoice — a percentage or a fixed amount. It\'s handy for rounding the total or giving an overall discount.</p>'
                    + '<p style="margin:0;text-align:left;">Because it applies to the finished invoice, you add it <strong>after creating</strong> the invoice: create it now, then click <strong>Bulk Discount</strong> on the invoice page to set a percentage or fixed amount.</p>',
                showCancelButton: formReady,
                confirmButtonColor: '#0D5EA6',
                cancelButtonColor: '#5E7385',
                confirmButtonText: formReady ? 'Create invoice & add discount' : 'Got it',
                cancelButtonText: 'Cancel',
                footer: formReady ? null : 'Add a customer and at least one line item to continue.'
            }).then(function (result) {
                if (!result.isConfirmed || !formReady) return;
                // Submit the form to create the draft; the user lands on the invoice page
                // where the (existing) Bulk Discount action is available.
                document.getElementById('invoiceForm').requestSubmit
                    ? document.getElementById('invoiceForm').requestSubmit()
                    : document.getElementById('invoiceForm').submit();
            });
        }

        // Line item collection + modal UX lives in /js/invoice-create-lines.js
        // (showAddCreateLineModal / showEditCreateLineModal / removeCreateLine, the modal
        // tier selector, and the hidden lines[idx].* input generation). The product-tier +
        // autocomplete integration is wired there via window.onProductAutocompleteSelected.

        function addSection() {
            var container = document.getElementById('sectionsContainer');
            var idx = sectionIndex;
            var html = '<div class="surface card-pad" style="margin-bottom:16px;position:relative;" id="section-' + idx + '">'
                + '<button type="button" class="btn btn-danger" style="position:absolute;top:12px;right:12px;padding:4px 10px;font-size:12px;" onclick="removeSection(' + idx + ')">Remove</button>'
                + '<div class="form-grid">'
                + '<div class="field">'
                + '<label>Section Name *</label>'
                + '<input type="text" name="sections[' + idx + '].Name" required placeholder="Section name" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Column Configuration</label>'
                + '<select name="sections[' + idx + '].ColumnConfiguration">'
                + '<option value="OneTime">OneTime</option>'
                + '<option value="Monthly">Monthly</option>'
                + '<option value="Yearly">Yearly</option>'
                + '</select>'
                + '</div>'
                + '<div class="field">'
                + '<label>Section Type</label>'
                + '<select name="sections[' + idx + '].SectionType">'
                + '<option value="LineItems">LineItems</option>'
                + '<option value="Narrative">Narrative</option>'
                + '</select>'
                + '</div>'
                + '<div class="field" style="grid-column:1 / -1;">'
                + '<label>Description</label>'
                + '<textarea name="sections[' + idx + '].Description" placeholder="Optional section description"></textarea>'
                + '</div>'
                + '</div>'
                + '</div>';

            container.insertAdjacentHTML('beforeend', html);
            sectionIndex++;
        }

        function removeSection(idx) {
            var el = document.getElementById('section-' + idx);
            if (el) el.remove();
        }
    </script>
}
