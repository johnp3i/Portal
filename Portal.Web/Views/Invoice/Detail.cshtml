@model Portal.Infrastructure.Entities.Invoice
@{
    ViewData["Title"] = "Invoice Detail";
    var invoice = Model;
    var lines = ViewBag.Lines as List<Portal.Infrastructure.Entities.InvoiceLine> ?? new List<Portal.Infrastructure.Entities.InvoiceLine>();
    var sections = ViewBag.Sections as List<Portal.Infrastructure.Entities.InvoiceSection> ?? new List<Portal.Infrastructure.Entities.InvoiceSection>();
    var vatPeriodLabel = invoice.VatSubmissionPeriod?.PeriodLabel;
}

@Html.AntiForgeryToken()

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Invoice Detail</div>
        <h1 class="topbar-heading">@invoice.InvoiceNumber &middot; @ViewBag.CustomerName</h1>
        <p class="topbar-subtitle">Review status, financial details, and manage this invoice.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        @if (invoice.InvoiceStatusTypeId == 1)
        {
            <a class="btn btn-secondary" asp-action="Edit" asp-controller="Invoice" asp-route-id="@invoice.Id">Edit</a>
        }
        <a href="@Url.Action("Preview", "Invoice", new { id = invoice.Id })" target="_blank" class="btn btn-secondary">Preview</a>
        <button type="button" class="btn btn-secondary" onclick="duplicateInvoice(@invoice.Id)">Duplicate</button>
        @if (invoice.InvoiceStatusTypeId == 1)
        {
            <button type="button" class="btn btn-danger" onclick="deleteInvoice(@invoice.Id)">Delete</button>
        }
    </div>
</div>

<!-- Invoice Overview -->
<section class="glass card-pad">
    <div style="display:flex;justify-content:space-between;align-items:start;gap:24px;flex-wrap:wrap;">
        <div>
            <div class="label">Status</div>
            <div style="margin-top:10px;display:flex;align-items:center;gap:12px;">
                @{
                    var statusPillClass = invoice.InvoiceStatusTypeId switch
                    {
                        1 => "pill-gold",
                        2 => "pill-green",
                        3 => "pill-red",
                        _ => "pill-gold"
                    };
                }
                <span class="pill @statusPillClass">@ViewBag.StatusName</span>
                @if (invoice.InvoiceStatusTypeId == 1)
                {
                    <button type="button" class="btn btn-primary" style="font-size:13px;padding:6px 16px;" onclick="issueInvoice(@invoice.Id)">Issue Invoice</button>
                }
                @if (invoice.InvoiceStatusTypeId == 2 && invoice.InvoiceFinancialStatusTypeId != 3)
                {
                    <a href="/Revenue/InvoiceDetail/@invoice.Id" class="btn btn-primary" style="font-size:13px;padding:6px 16px;">Record Payment</a>
                }
            </div>
        </div>
        <div style="display:flex;gap:32px;flex-wrap:wrap;">
            <div>
                <div class="label">Customer</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">@ViewBag.CustomerName</div>
            </div>
            <div>
                <div class="label">Invoice Number</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">@invoice.InvoiceNumber</div>
            </div>
            <div>
                <div class="label">Invoice Date</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">@invoice.InvoiceDate.ToString("yyyy-MM-dd")</div>
            </div>
            <div>
                <div class="label">Due Date</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">@invoice.DueDate.ToString("yyyy-MM-dd")</div>
            </div>
            <div>
                <div class="label">Financial Status</div>
                <div style="margin-top:6px;">
                    @{
                        var financialPillClass = invoice.InvoiceFinancialStatusTypeId switch
                        {
                            1 => "pill-gold",
                            2 => "pill-blue",
                            3 => "pill-green",
                            4 => "pill-red",
                            5 => "pill-red",
                            _ => "pill-gold"
                        };
                    }
                    <span class="pill @financialPillClass">@ViewBag.FinancialStatusName</span>
                </div>
            </div>
            <div>
                <div class="label">VAT Period</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">
                    @if (!string.IsNullOrWhiteSpace(vatPeriodLabel))
                    {
                        @vatPeriodLabel
                    }
                    else
                    {
                        <span style="color:var(--muted);font-weight:400;">Unassigned</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(invoice.Notes))
    {
        <div style="margin-top:18px;padding-top:18px;border-top:1px solid rgba(13,94,166,.08);">
            <div class="label">Notes</div>
            <div style="margin-top:6px;font-size:14px;color:var(--muted);line-height:1.7;white-space:pre-wrap;">@invoice.Notes</div>
        </div>
    }
</section>

<!-- VAT Period Reassignment -->
<section class="glass card-pad" style="margin-top:24px;">
    <div class="label">VAT Period</div>
    <h2 style="margin-top:8px;font-size:24px;">Reassign VAT Period</h2>
    <p class="muted" style="margin-top:6px;font-size:14px;line-height:1.6;">
        Move this invoice to a different unsubmitted VAT period. This affects the Output VAT totals for both the source and target periods.
    </p>

    <div style="margin-top:18px;display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:220px;">
            <label style="font-size:13px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;">Target Period</label>
            <select id="vatPeriodSelect" style="margin-top:6px;width:100%;">
                <option value="">Loading periods...</option>
            </select>
        </div>
        <div style="padding-bottom:2px;">
            <button type="button" class="btn btn-danger" id="btnReassignVatPeriod" onclick="initiateReassignment()" disabled>
                Reassign Period
            </button>
        </div>
    </div>
</section>

<!-- Line Items -->
<section class="glass card-pad" style="margin-top:24px;">
    <div class="label">Line Items</div>
    <h2 style="margin-top:8px;font-size:24px;">Pricing breakdown</h2>

    <div style="margin-top:18px;">
        @if (lines.Count > 0)
        {
            <table>
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>VAT %</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in lines)
                    {
                        var discountedPrice = line.DiscountType == "Percentage"
                            ? line.UnitPrice * (1 - line.Discount / 100)
                            : line.UnitPrice - line.Discount;
                        var lineTotal = line.Quantity * discountedPrice;
                        <tr>
                            <td>
                                <strong>@line.Description</strong>
                                @if (!string.IsNullOrWhiteSpace(line.ReferenceUrl))
                                {
                                    <a href="@line.ReferenceUrl" target="_blank" style="margin-left:8px;font-size:11px;color:var(--blue);">&nearr; ref</a>
                                }
                            </td>
                            <td>@line.Quantity.ToString("N2")</td>
                            <td>@(ViewBag.CurrencySymbol)@line.UnitPrice.ToString("N2")</td>
                            <td>@line.VatRate.ToString("N2")%</td>
                            <td><strong>@(ViewBag.CurrencySymbol)@lineTotal.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted" style="font-size:14px;">No line items on this invoice.</p>
        }
    </div>

    <div class="surface card-pad totals" style="margin-top:18px;">
        <div class="row"><span class="muted">Subtotal</span><strong>@(ViewBag.CurrencySymbol)@invoice.Subtotal.ToString("N2")</strong></div>
        <div class="row"><span class="muted">Tax</span><strong>@(ViewBag.CurrencySymbol)@invoice.TaxAmount.ToString("N2")</strong></div>
        <div class="row"><span>Grand Total</span><span class="big-total">@(ViewBag.CurrencySymbol)@invoice.TotalAmount.ToString("N2")</span></div>
    </div>
</section>

<!-- Back link -->
<div style="margin-top:24px;display:flex;justify-content:flex-end;">
    <a asp-action="Index" asp-controller="Invoice" class="btn btn-outline">&larr; Back to Invoices</a>
</div>

@section Scripts {
    <script>
        var invoiceId = @invoice.Id;

        // Load unsubmitted periods on page load
        (async function loadPeriods() {
            try {
                var response = await fetch('/Invoice/GetUnsubmittedPeriods?invoiceId=' + invoiceId);
                var periods = await response.json();
                var select = document.getElementById('vatPeriodSelect');
                var btn = document.getElementById('btnReassignVatPeriod');

                if (!periods || periods.length === 0) {
                    select.innerHTML = '<option value="">No unsubmitted periods available</option>';
                    btn.disabled = true;
                    return;
                }

                select.innerHTML = '<option value="">Select a period...</option>';
                periods.forEach(function(p) {
                    var opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.periodLabel;
                    select.appendChild(opt);
                });

                select.addEventListener('change', function() {
                    btn.disabled = !select.value;
                });
            } catch (e) {
                var select = document.getElementById('vatPeriodSelect');
                select.innerHTML = '<option value="">Failed to load periods</option>';
            }
        })();

        async function initiateReassignment() {
            var select = document.getElementById('vatPeriodSelect');
            var targetPeriodId = select.value;
            if (!targetPeriodId) return;

            // Fetch impact data before showing confirmation
            var impactResponse;
            try {
                impactResponse = await fetch('/Invoice/GetReassignmentImpact?invoiceId=' + invoiceId + '&targetPeriodId=' + targetPeriodId);
            } catch (e) {
                Swal.fire({ title: 'Error', text: 'Failed to load reassignment impact data.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var impactData = await impactResponse.json();
            if (!impactData.success) {
                Swal.fire({ title: 'Error', text: impactData.message || 'Failed to load impact data.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var d = impactData.data;
            var sym = d.currencySymbol || '€';

            var confirmed = await Swal.fire({
                title: 'Reassign VAT Period',
                html:
                    '<div style="text-align:left;font-size:14px;line-height:1.8;">' +
                    '<div style="margin-bottom:10px;"><strong>Invoice:</strong> ' + d.invoiceNumber + '</div>' +
                    '<div style="margin-bottom:10px;"><strong>From period:</strong> ' + d.sourcePeriodLabel + '</div>' +
                    '<div style="margin-bottom:10px;"><strong>To period:</strong> ' + d.targetPeriodLabel + '</div>' +
                    '<div style="margin-bottom:10px;"><strong>Tax amount moved:</strong> ' + sym + parseFloat(d.taxAmount).toFixed(2) + '</div>' +
                    '<hr style="margin:12px 0;border-color:rgba(0,0,0,.08);"/>' +
                    '<div style="margin-bottom:6px;font-weight:600;color:#5E7385;font-size:13px;text-transform:uppercase;letter-spacing:.04em;">Projected Output VAT</div>' +
                    '<div style="margin-bottom:6px;"><strong>' + d.sourcePeriodLabel + ':</strong> ' + sym + parseFloat(d.sourcePeriodProjectedOutputVat).toFixed(2) + '</div>' +
                    '<div><strong>' + d.targetPeriodLabel + ':</strong> ' + sym + parseFloat(d.targetPeriodProjectedOutputVat).toFixed(2) + '</div>' +
                    '</div>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Confirm Reassignment',
                cancelButtonText: 'Cancel'
            });

            if (!confirmed.isConfirmed) return;

            BlockUI.show('Reassigning VAT period...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Invoice/ReassignVatPeriod', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'invoiceId=' + invoiceId + '&targetPeriodId=' + targetPeriodId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Done!',
                        text: 'VAT period reassigned successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    location.reload();
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function issueInvoice(invoiceId) {
            var result = await Swal.fire({
                title: 'Issue Invoice',
                text: 'Are you sure you want to issue this invoice? Once issued, it cannot be edited.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0D5EA6',
                confirmButtonText: 'Yes, issue it'
            });

            if (!result.isConfirmed) return;

            BlockUI.show('Issuing invoice...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Invoice/TransitionStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'invoiceId=' + invoiceId + '&newStatusId=2'
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Issued!',
                        text: 'The invoice has been issued successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    location.reload();
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function duplicateInvoice(invoiceId) {
            var result = await Swal.fire({
                title: 'Duplicate Invoice',
                text: 'Are you sure you want to duplicate this invoice?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0D5EA6',
                confirmButtonText: 'Yes, duplicate it'
            });

            if (!result.isConfirmed) return;

            BlockUI.show('Duplicating...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Invoice/Duplicate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'id=' + invoiceId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    window.location = data.redirectUrl;
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function deleteInvoice(invoiceId) {
            // Step 1: First confirmation
            const firstResult = await Swal.fire({
                title: 'Are you sure?',
                text: 'This invoice will be deleted.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it'
            });

            if (!firstResult.isConfirmed) return;

            // Step 2: Second confirmation
            const secondResult = await Swal.fire({
                title: 'Final Warning',
                text: 'This action cannot be easily undone. Are you sure you want to proceed?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete permanently'
            });

            if (!secondResult.isConfirmed) return;

            // Step 3: Execute deletion
            BlockUI.show('Deleting...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Invoice/SoftDelete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'id=' + invoiceId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Deleted!',
                        text: 'The invoice has been deleted.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.href = '/Invoice';
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message,
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            }
        }
    </script>
}
