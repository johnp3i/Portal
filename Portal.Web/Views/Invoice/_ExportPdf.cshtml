@model Portal.Web.Models.InvoiceExportPdfModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice Export</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 12px;
            color: #1a2b3c;
            margin: 0;
            padding: 20px;
        }
        h1 {
            font-size: 20px;
            font-weight: 700;
            margin: 0 0 4px 0;
        }
        .subtitle {
            font-size: 11px;
            color: #5a6a7a;
            margin-bottom: 16px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }
        th {
            background: #0D5EA6;
            color: #fff;
            padding: 8px 10px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        td {
            padding: 7px 10px;
            border-bottom: 1px solid #e8edf2;
            font-size: 11px;
        }
        tr:nth-child(even) td {
            background: #f7fafc;
        }
        .text-right {
            text-align: right;
        }
        .total-row {
            font-weight: 700;
            background: #eef4f8 !important;
        }
        .total-row td {
            border-top: 2px solid #0D5EA6;
            padding-top: 10px;
        }
        .pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: 600;
        }
        .pill-draft { background: #FEF3CD; color: #856404; }
        .pill-issued { background: #D4EDDA; color: #155724; }
        .pill-cancelled { background: #F8D7DA; color: #721C24; }
        .pill-unpaid { background: #FEF3CD; color: #856404; }
        .pill-partial { background: #CCE5FF; color: #004085; }
        .pill-paid { background: #D4EDDA; color: #155724; }
        .pill-overdue { background: #F8D7DA; color: #721C24; }
        .pill-writtenoff { background: #F8D7DA; color: #721C24; }
    </style>
</head>
<body>
    <h1>Invoice Export</h1>
    <div class="subtitle">Generated: @Model.GeneratedAt.ToString("dd MMM yyyy HH:mm") &bull; @Model.Invoices.Count invoice(s)</div>

    <table>
        <thead>
            <tr>
                <th>Invoice #</th>
                <th>Customer</th>
                <th>Invoice Date</th>
                <th>Due Date</th>
                <th class="text-right">Total</th>
                <th>Status</th>
                <th>Financial Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model.Invoices)
            {
                var statusClass = inv.InvoiceStatusTypeId switch
                {
                    1 => "pill-draft",
                    2 => "pill-issued",
                    3 => "pill-cancelled",
                    _ => "pill-draft"
                };
                var financialClass = inv.InvoiceFinancialStatusTypeId switch
                {
                    1 => "pill-unpaid",
                    2 => "pill-partial",
                    3 => "pill-paid",
                    4 => "pill-overdue",
                    5 => "pill-writtenoff",
                    _ => "pill-unpaid"
                };
                <tr>
                    <td><strong>@inv.InvoiceNumber</strong></td>
                    <td>@inv.CustomerName</td>
                    <td>@inv.InvoiceDate.ToString("dd MMM yyyy")</td>
                    <td>@inv.DueDate.ToString("dd MMM yyyy")</td>
                    <td class="text-right">@Model.CurrencySymbol@inv.TotalAmount.ToString("N2")</td>
                    <td><span class="pill @statusClass">@inv.StatusName</span></td>
                    <td><span class="pill @financialClass">@inv.FinancialStatusName</span></td>
                </tr>
            }
            <tr class="total-row">
                <td colspan="4"><strong>Total (@Model.Invoices.Count invoices)</strong></td>
                <td class="text-right"><strong>@Model.CurrencySymbol@Model.Invoices.Sum(i => i.TotalAmount).ToString("N2")</strong></td>
                <td colspan="2"></td>
            </tr>
        </tbody>
    </table>
</body>
</html>
