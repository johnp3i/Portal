@model List<Portal.Infrastructure.Models.InvoiceListDto>
@using Portal.Infrastructure.Models
@{
    ViewData["Title"] = "Invoices";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Invoices</div>
        <h1 class="topbar-heading">Invoice List</h1>
        <p class="topbar-subtitle">Filter, review, and manage invoices with full financial traceability.</p>
    </div>
    <div class="topbar-actions" style="display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn-primary" asp-action="Create" asp-controller="Invoice">Create Invoice</a>
        <div class="topbar-actions-secondary" style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn btn-secondary" href="/Invoice/ExportCsv?status=@ViewBag.StatusFilter&financialStatus=@ViewBag.FinancialStatusFilter&customer=@ViewBag.CustomerFilter&search=@ViewBag.SearchTerm&vatPeriodId=@ViewBag.VatPeriodFilter">Export CSV</a>
            <a class="btn btn-secondary" href="/Invoice/ExportPdf?status=@ViewBag.StatusFilter&financialStatus=@ViewBag.FinancialStatusFilter&customer=@ViewBag.CustomerFilter&search=@ViewBag.SearchTerm&vatPeriodId=@ViewBag.VatPeriodFilter">Export PDF</a>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:18px;">
        @TempData["Error"]
    </div>
}

<section class="glass card-pad">
    <form method="get" asp-action="Index" asp-controller="Invoice">
        <button type="button" class="filter-toggle" aria-expanded="false" aria-controls="invoiceFilterPanel">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 4h18M7 9h10M10 14h4"/></svg>
            Filters
        </button>
        <div class="filter-panel" id="invoiceFilterPanel" style="display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;">
            <div class="field" style="min-width:180px;">
                <label>Search</label>
                <input type="text" name="search" placeholder="Search by invoice number or customer..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="field" style="min-width:180px;">
                <label>Status</label>
                <select name="status">
                    <option value="">All Statuses</option>
                    @foreach (var s in (IEnumerable<Portal.Infrastructure.Entities.InvoiceStatusType>)ViewBag.Statuses)
                    {
                        <option value="@s.Id" selected="@(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == s.Id ? "selected" : null)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="field" style="min-width:180px;">
                <label>Financial Status</label>
                <select name="financialStatus">
                    <option value="">All Financial Statuses</option>
                    @foreach (var fs in (IEnumerable<Portal.Infrastructure.Entities.InvoiceFinancialStatusType>)ViewBag.FinancialStatuses)
                    {
                        <option value="@fs.Id" selected="@(ViewBag.FinancialStatusFilter != null && (int)ViewBag.FinancialStatusFilter == fs.Id ? "selected" : null)">@FormatStatusName(fs.Name)</option>
                    }
                </select>
            </div>
            <div class="field" style="min-width:180px;">
                <label>Customer</label>
                <select name="customer">
                    <option value="">All Customers</option>
                    @foreach (var c in (IEnumerable<Portal.Infrastructure.Entities.Customer>)ViewBag.Customers)
                    {
                        <option value="@c.Id" selected="@(ViewBag.CustomerFilter != null && (int)ViewBag.CustomerFilter == c.Id ? "selected" : null)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="field" style="min-width:180px;">
                <label>VAT Period</label>
                <select name="vatPeriodId">
                    <option value="">All Periods</option>
                    @foreach (var period in (List<Portal.Infrastructure.Entities.VatSubmissionPeriod>)ViewBag.VatPeriods)
                    {
                        <option value="@period.Id" selected="@(ViewBag.VatPeriodFilter != null && (int)ViewBag.VatPeriodFilter == period.Id ? "selected" : null)">
                            @period.PeriodLabel (@period.PeriodStartDate.ToString("dd MMM yyyy") – @period.PeriodEndDate.ToString("dd MMM yyyy"))
                        </option>
                    }
                </select>
            </div>
            <div class="field" style="min-width:140px;">
                <label>From</label>
                <input type="date" name="dateFrom" id="invoiceDateFrom" value="@ViewBag.DateFrom" />
            </div>
            <div class="field" style="min-width:140px;">
                <label>To</label>
                <input type="date" name="dateTo" id="invoiceDateTo" value="@ViewBag.DateTo" />
            </div>
            <div style="padding-bottom:2px;">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </div>
        <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#5E7385;margin-right:4px;">Quick:</span>
            <button type="button" class="period-shortcut" onclick="setInvoicePeriod('this_month')">This Month</button>
            <button type="button" class="period-shortcut" onclick="setInvoicePeriod('last_month')">Last Month</button>
            <button type="button" class="period-shortcut" onclick="setInvoicePeriod('last_3')">Last 3 Months</button>
            <button type="button" class="period-shortcut" onclick="setInvoicePeriod('last_6')">Last 6 Months</button>
            <button type="button" class="period-shortcut" onclick="setInvoicePeriod('this_year')">This Year</button>
            <button type="button" class="period-shortcut" onclick="setInvoicePeriod('last_year')">Last Year</button>
            <button type="button" class="period-shortcut" onclick="setInvoicePeriod('all')">All Time</button>
        </div>
    </form>

    <div style="margin-top:18px;">
        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive index-table">
            <div class="scroll-hint">← Scroll horizontally →</div>
            <table>
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Customer</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Financial Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-href="@Url.Action("Detail", "Invoice", new { id = item.Id })">
                            <td>
                                <a asp-action="Detail" asp-controller="Invoice" asp-route-id="@item.Id" style="color:inherit;text-decoration:none;"><strong>@item.InvoiceNumber</strong></a>
                                @if (item.AcceptanceStatus == "accepted")
                                {
                                    <div style="font-size:11px;color:#129867;font-weight:600;margin-top:3px;">✓ Accepted</div>
                                }
                                else if (item.AcceptanceStatus == "awaiting")
                                {
                                    <div style="font-size:11px;color:#C8912E;font-weight:600;margin-top:3px;">⏳ Awaiting acceptance</div>
                                }
                            </td>
                            <td>@item.CustomerName</td>
                            <td data-mobile="hide">@item.InvoiceDate.ToString("yyyy-MM-dd")</td>
                            <td data-mobile="hide">@item.DueDate.ToString("yyyy-MM-dd")</td>
                            <td data-mobile="amount">@(ViewBag.CurrencySymbol)@item.TotalAmount.ToString("N2")</td>
                            <td data-mobile="status">
                                @{
                                    var statusPillClass = item.InvoiceStatusTypeId switch
                                    {
                                        1 => "pill-gold",
                                        2 => "pill-green",
                                        3 => "pill-red",
                                        _ => "pill-gold"
                                    };
                                }
                                <span class="pill @statusPillClass">@item.StatusName</span>
                            </td>
                            <td data-mobile="hide">
                                @{
                                    var financialPillClass = item.InvoiceFinancialStatusTypeId switch
                                    {
                                        1 => "pill-gold",
                                        2 => "pill-blue",
                                        3 => "pill-green",
                                        4 => "pill-red",
                                        5 => "pill-red",
                                        6 => "pill-amber",
                                        _ => "pill-gold"
                                    };
                                }
                                <span class="pill @financialPillClass">@FormatStatusName(item.FinancialStatusName)</span>
                            </td>
                            <td data-mobile="hide" style="white-space:nowrap;">
                                @await Component.InvokeAsync("AttachmentCount", new { entityType = "Invoice", entityId = item.Id })
                                <a asp-action="Detail" asp-controller="Invoice" asp-route-id="@item.Id" class="tbl-action tbl-action--primary">Detail</a>
                                @if (item.InvoiceStatusTypeId == 1)
                                {
                                    <a asp-action="Edit" asp-controller="Invoice" asp-route-id="@item.Id" class="tbl-action tbl-action--primary">Edit</a>
                                }
                                <a asp-action="Preview" asp-controller="Invoice" asp-route-id="@item.Id" target="_blank" class="tbl-action tbl-action--secondary">Preview</a>
                                <a href="javascript:void(0)" onclick="downloadInvoicePdf(@item.Id)" class="tbl-action tbl-action--secondary">PDF</a>
                                @if (item.InvoiceStatusTypeId == 1)
                                {
                                    <a href="javascript:void(0)" onclick="deleteInvoice(@item.Id)" class="tbl-action tbl-action--danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No invoices found. Create your first invoice or convert a quotation to get started.</p>
            </div>
        }
    </div>

    @{
        var pagedResult = (PagedResult<Portal.Infrastructure.Models.InvoiceListDto>)ViewBag.PagedResult;
    }
    @await Html.PartialAsync("_PagingControl", null, new ViewDataDictionary(ViewData) {
        { "CurrentPage", pagedResult.CurrentPage },
        { "TotalPages", pagedResult.TotalPages },
        { "TotalCount", pagedResult.TotalCount },
        { "PageSize", pagedResult.PageSize },
        { "HasPreviousPage", pagedResult.HasPreviousPage },
        { "HasNextPage", pagedResult.HasNextPage }
    })
</section>

<script>
        function setInvoicePeriod(preset) {
            var now = new Date();
            var from, to;
            switch (preset) {
                case 'this_month': from = new Date(now.getFullYear(), now.getMonth(), 1); to = now; break;
                case 'last_month': from = new Date(now.getFullYear(), now.getMonth() - 1, 1); to = new Date(now.getFullYear(), now.getMonth(), 0); break;
                case 'last_3': from = new Date(now.getFullYear(), now.getMonth() - 3, 1); to = now; break;
                case 'last_6': from = new Date(now.getFullYear(), now.getMonth() - 6, 1); to = now; break;
                case 'this_year': from = new Date(now.getFullYear(), 0, 1); to = now; break;
                case 'last_year': from = new Date(now.getFullYear() - 1, 0, 1); to = new Date(now.getFullYear() - 1, 11, 31); break;
                case 'all': from = null; to = null; break;
            }
            document.getElementById('invoiceDateFrom').value = from ? from.toISOString().slice(0, 10) : '';
            document.getElementById('invoiceDateTo').value = to ? to.toISOString().slice(0, 10) : '';
            document.querySelectorAll('.period-shortcut').forEach(function(b) { b.classList.remove('active'); });
            event.target.classList.add('active');
            document.querySelector('form').submit();
        }

        async function downloadInvoicePdf(invoiceId) {
            BlockUI.show('Generating PDF...');
            try {
                var response = await fetch('/Invoice/AxGetDownloadPdf/' + invoiceId);

                if (!response.ok || !response.headers.get('content-type')?.includes('application/pdf')) {
                    var data = await response.json();
                    BlockUI.hide();
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to generate PDF.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                    return;
                }

                var blob = await response.blob();
                var contentDisposition = response.headers.get('content-disposition');
                var filename = 'invoice.pdf';
                if (contentDisposition) {
                    var match = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (match && match[1]) {
                        filename = match[1].replace(/['"]/g, '');
                    }
                }
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                BlockUI.hide();
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function deleteInvoice(invoiceId) {
            const firstResult = await Swal.fire({
                title: 'Are you sure?',
                text: 'This invoice will be deleted.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it'
            });

            if (!firstResult.isConfirmed) return;

            const secondResult = await Swal.fire({
                title: 'Final Warning',
                text: 'This action cannot be easily undone. Are you sure you want to proceed?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete permanently'
            });

            if (!secondResult.isConfirmed) return;

            BlockUI.show('Deleting...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Invoice/SoftDelete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'id=' + invoiceId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Deleted!',
                        text: 'The invoice has been deleted.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }
    </script>


@functions {
    private string FormatStatusName(string name)
    {
        if (string.IsNullOrEmpty(name)) return name;
        // Insert a space before each uppercase letter that follows a lowercase letter
        var result = System.Text.RegularExpressions.Regex.Replace(name, "([a-z])([A-Z])", "$1 $2");
        return result;
    }
}
