@model List<Portal.Infrastructure.Models.InvoiceListDto>
@using Portal.Infrastructure.Models
@{
    ViewData["Title"] = "Invoices";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Invoices</div>
        <h1 class="topbar-heading">Invoice List</h1>
        <p class="topbar-subtitle">Filter, review, and manage invoices with full financial traceability.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn-primary" asp-action="Create" asp-controller="Invoice">Create Invoice</a>
        <a class="btn btn-secondary" href="/Invoice/ExportCsv?status=@ViewBag.StatusFilter&financialStatus=@ViewBag.FinancialStatusFilter&customer=@ViewBag.CustomerFilter&search=@ViewBag.SearchTerm&vatPeriodId=@ViewBag.VatPeriodFilter">Export CSV</a>
        <a class="btn btn-secondary" href="/Invoice/ExportPdf?status=@ViewBag.StatusFilter&financialStatus=@ViewBag.FinancialStatusFilter&customer=@ViewBag.CustomerFilter&search=@ViewBag.SearchTerm&vatPeriodId=@ViewBag.VatPeriodFilter">Export PDF</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:18px;">
        @TempData["Error"]
    </div>
}

<section class="glass card-pad">
    <form method="get" asp-action="Index" asp-controller="Invoice">
        <div class="form-grid">
            <div class="field">
                <label>Search</label>
                <input type="text" name="search" placeholder="Search by invoice number or customer..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="field">
                <label>Status</label>
                <select name="status">
                    <option value="">All Statuses</option>
                    @foreach (var s in (IEnumerable<Portal.Infrastructure.Entities.InvoiceStatusType>)ViewBag.Statuses)
                    {
                        <option value="@s.Id" selected="@(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == s.Id ? "selected" : null)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Financial Status</label>
                <select name="financialStatus">
                    <option value="">All Financial Statuses</option>
                    @foreach (var fs in (IEnumerable<Portal.Infrastructure.Entities.InvoiceFinancialStatusType>)ViewBag.FinancialStatuses)
                    {
                        <option value="@fs.Id" selected="@(ViewBag.FinancialStatusFilter != null && (int)ViewBag.FinancialStatusFilter == fs.Id ? "selected" : null)">@fs.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Customer</label>
                <select name="customer">
                    <option value="">All Customers</option>
                    @foreach (var c in (IEnumerable<Portal.Infrastructure.Entities.Customer>)ViewBag.Customers)
                    {
                        <option value="@c.Id" selected="@(ViewBag.CustomerFilter != null && (int)ViewBag.CustomerFilter == c.Id ? "selected" : null)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>VAT Period</label>
                <select name="vatPeriodId">
                    <option value="">All Periods</option>
                    @foreach (var period in (List<Portal.Infrastructure.Entities.VatSubmissionPeriod>)ViewBag.VatPeriods)
                    {
                        <option value="@period.Id" selected="@(ViewBag.VatPeriodFilter != null && (int)ViewBag.VatPeriodFilter == period.Id ? "selected" : null)">
                            @period.PeriodLabel (@period.PeriodStartDate.ToString("dd MMM yyyy") – @period.PeriodEndDate.ToString("dd MMM yyyy"))
                        </option>
                    }
                </select>
            </div>
        </div>
        <div style="margin-top:16px;">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    <div style="margin-top:18px;">
        @if (Model != null && Model.Count > 0)
        {
            <table>
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Customer</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Financial Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.InvoiceNumber</strong>
                                @if (item.AcceptanceStatus == "accepted")
                                {
                                    <div style="font-size:11px;color:#129867;font-weight:600;margin-top:3px;">✓ Accepted</div>
                                }
                                else if (item.AcceptanceStatus == "awaiting")
                                {
                                    <div style="font-size:11px;color:#C8912E;font-weight:600;margin-top:3px;">⏳ Awaiting acceptance</div>
                                }
                            </td>
                            <td>@item.CustomerName</td>
                            <td>@item.InvoiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
                            <td>@(ViewBag.CurrencySymbol)@item.TotalAmount.ToString("N2")</td>
                            <td>
                                @{
                                    var statusPillClass = item.InvoiceStatusTypeId switch
                                    {
                                        1 => "pill-gold",
                                        2 => "pill-green",
                                        3 => "pill-red",
                                        _ => "pill-gold"
                                    };
                                }
                                <span class="pill @statusPillClass">@item.StatusName</span>
                            </td>
                            <td>
                                @{
                                    var financialPillClass = item.InvoiceFinancialStatusTypeId switch
                                    {
                                        1 => "pill-gold",
                                        2 => "pill-blue",
                                        3 => "pill-green",
                                        4 => "pill-red",
                                        5 => "pill-red",
                                        _ => "pill-gold"
                                    };
                                }
                                <span class="pill @financialPillClass">@item.FinancialStatusName</span>
                            </td>
                            <td style="white-space:nowrap;">
                                <a asp-action="Detail" asp-controller="Invoice" asp-route-id="@item.Id" class="tbl-action tbl-action--primary">Detail</a>
                                @if (item.InvoiceStatusTypeId == 1)
                                {
                                    <a asp-action="Edit" asp-controller="Invoice" asp-route-id="@item.Id" class="tbl-action tbl-action--primary">Edit</a>
                                }
                                <a asp-action="Preview" asp-controller="Invoice" asp-route-id="@item.Id" target="_blank" class="tbl-action tbl-action--secondary">Preview</a>
                                <a href="javascript:void(0)" onclick="downloadInvoicePdf(@item.Id)" class="tbl-action tbl-action--secondary">PDF</a>
                                @if (item.InvoiceStatusTypeId == 1)
                                {
                                    <a href="javascript:void(0)" onclick="deleteInvoice(@item.Id)" class="tbl-action tbl-action--danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <p>No invoices found. Create your first invoice or convert a quotation to get started.</p>
            </div>
        }
    </div>

    @{
        var pagedResult = (PagedResult<Portal.Infrastructure.Models.InvoiceListDto>)ViewBag.PagedResult;
    }
    @await Html.PartialAsync("_PagingControl", null, new ViewDataDictionary(ViewData) {
        { "CurrentPage", pagedResult.CurrentPage },
        { "TotalPages", pagedResult.TotalPages },
        { "TotalCount", pagedResult.TotalCount },
        { "PageSize", pagedResult.PageSize },
        { "HasPreviousPage", pagedResult.HasPreviousPage },
        { "HasNextPage", pagedResult.HasNextPage }
    })
</section>

@section Scripts {
    <script>
        async function downloadInvoicePdf(invoiceId) {
            BlockUI.show('Generating PDF...');
            try {
                var response = await fetch('/Invoice/AxGetDownloadPdf/' + invoiceId);

                if (!response.ok || !response.headers.get('content-type')?.includes('application/pdf')) {
                    var data = await response.json();
                    BlockUI.hide();
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to generate PDF.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                    return;
                }

                var blob = await response.blob();
                var contentDisposition = response.headers.get('content-disposition');
                var filename = 'invoice.pdf';
                if (contentDisposition) {
                    var match = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (match && match[1]) {
                        filename = match[1].replace(/['"]/g, '');
                    }
                }
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                BlockUI.hide();
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function deleteInvoice(invoiceId) {
            const firstResult = await Swal.fire({
                title: 'Are you sure?',
                text: 'This invoice will be deleted.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it'
            });

            if (!firstResult.isConfirmed) return;

            const secondResult = await Swal.fire({
                title: 'Final Warning',
                text: 'This action cannot be easily undone. Are you sure you want to proceed?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete permanently'
            });

            if (!secondResult.isConfirmed) return;

            BlockUI.show('Deleting...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Invoice/SoftDelete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'id=' + invoiceId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Deleted!',
                        text: 'The invoice has been deleted.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }
    </script>
}
