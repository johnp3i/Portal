@using Portal.Infrastructure.Models
@{
    ViewData["Title"] = "Create Demo Invitation";
    var demoBusinesses = (List<DemoBusinessItem>)ViewBag.DemoBusinesses;

    var modules = new[] { "customer", "quotation", "invoice", "revenue", "purchase", "vat", "credit", "audit", "products" };
    var moduleLabels = new Dictionary<string, string>
    {
        { "customer", "Customers" },
        { "quotation", "Quotations" },
        { "invoice", "Invoices" },
        { "revenue", "Revenue" },
        { "purchase", "Purchases" },
        { "vat", "VAT" },
        { "credit", "Credit Notes" },
        { "audit", "Audit" },
        { "products", "Products" }
    };
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Administration</div>
        <h1 class="topbar-heading">Create Demo Invitation</h1>
        <p class="topbar-subtitle">Send a demo access invitation with configurable module permissions.</p>
    </div>
    <div>
        <a href="/Admin/DemoInvitations" class="btn btn-secondary">← Back to Invitations</a>
    </div>
</div>

<section class="glass card-pad">
    <form id="createDemoInvitationForm">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label for="businessId">Demo Business *</label>
                <select id="businessId" required>
                    <option value="">-- Select Demo Business --</option>
                    @foreach (var business in demoBusinesses)
                    {
                        <option value="@business.Id">@business.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="recipientEmail">Recipient Email *</label>
                <input type="email" id="recipientEmail" placeholder="prospect@example.com" required />
            </div>
            <div class="field">
                <label for="recipientName">Recipient Name</label>
                <input type="text" id="recipientName" placeholder="John Smith" />
            </div>
            <div class="field">
                <label for="expiresAtUtc">Expiry Date *</label>
                <input type="date" id="expiresAtUtc" required />
            </div>
        </div>

        <!-- Module Permissions Grid -->
        <div style="margin-top:28px;">
            <label style="font-weight:700;font-size:15px;color:#1a2b3c;display:block;margin-bottom:14px;">Module Permissions</label>
            <table class="permissions-grid">
                <thead>
                    <tr>
                        <th style="text-align:left;">Module</th>
                        <th>Full</th>
                        <th>Read Only</th>
                        <th>None</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var module in modules)
                    {
                        <tr>
                            <td style="font-weight:600;">@moduleLabels[module]</td>
                            <td style="text-align:center;">
                                <input type="radio" name="perm_@module" value="full" />
                            </td>
                            <td style="text-align:center;">
                                <input type="radio" name="perm_@module" value="readonly" />
                            </td>
                            <td style="text-align:center;">
                                <input type="radio" name="perm_@module" value="none" checked />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="margin-top:24px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary">Send Invitation</button>
            <a href="/Admin/DemoInvitations" class="btn btn-outline">← Back to Invitations</a>
        </div>
    </form>
</section>

<style>
    .permissions-grid {
        width: 100%;
        border-collapse: collapse;
    }
    .permissions-grid thead th {
        font-size: 13px;
        font-weight: 700;
        color: #5a6b7c;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 10px 16px;
        border-bottom: 2px solid #e2eaf2;
        text-align: center;
    }
    .permissions-grid thead th:first-child {
        text-align: left;
    }
    .permissions-grid tbody td {
        padding: 12px 16px;
        border-bottom: 1px solid #eef4f8;
        font-size: 14px;
        color: #1a2b3c;
    }
    .permissions-grid tbody tr:last-child td {
        border-bottom: none;
    }
    .permissions-grid input[type="radio"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #0D5EA6;
    }
</style>

@section Scripts {
<script>
(function() {
    // Set minimum expiry date to tomorrow
    var expiryInput = document.getElementById('expiresAtUtc');
    if (expiryInput) {
        var tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        expiryInput.min = tomorrow.toISOString().split('T')[0];
    }

    function getAntiForgeryToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    function getPermissions() {
        var modules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(modules));
        var permissions = [];
        for (var i = 0; i < modules.length; i++) {
            var selected = document.querySelector('input[name="perm_' + modules[i] + '"]:checked');
            if (selected) {
                permissions.push({ module: modules[i], accessLevel: selected.value });
            }
        }
        return permissions;
    }

    function validateForm() {
        var businessId = document.getElementById('businessId').value;
        var email = document.getElementById('recipientEmail').value.trim();
        var expiresAt = document.getElementById('expiresAtUtc').value;

        if (!businessId) {
            return 'Please select a demo business.';
        }
        if (!email) {
            return 'Recipient email is required.';
        }
        // Basic email format check
        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            return 'Please enter a valid email address.';
        }
        if (!expiresAt) {
            return 'Expiry date is required.';
        }
        // Check expiry is in the future
        var expiryDate = new Date(expiresAt + 'T23:59:59');
        if (expiryDate <= new Date()) {
            return 'Expiry date must be in the future.';
        }
        // Check at least one module with full or readonly
        var permissions = getPermissions();
        var hasGranted = permissions.some(function(p) { return p.accessLevel === 'full' || p.accessLevel === 'readonly'; });
        if (!hasGranted) {
            return 'At least one module must have Full or Read Only access.';
        }

        return null;
    }

    var form = document.getElementById('createDemoInvitationForm');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            var validationError = validateForm();
            if (validationError) {
                Swal.fire({ title: 'Validation', text: validationError, icon: 'warning', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var businessId = parseInt(document.getElementById('businessId').value);
            var email = document.getElementById('recipientEmail').value.trim();
            var name = document.getElementById('recipientName').value.trim() || null;
            var expiresAt = document.getElementById('expiresAtUtc').value;
            var permissions = getPermissions();

            var payload = {
                businessId: businessId,
                recipientEmail: email,
                recipientName: name,
                expiresAtUtc: expiresAt + 'T23:59:59Z',
                permissions: permissions
            };

            BlockUI.show('Sending invitation...');
            try {
                var response = await fetch('/Admin/DemoInvitations/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Invitation Sent!',
                        text: data.message || 'Demo invitation created successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.href = '/Admin/DemoInvitations';
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to create invitation.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        });
    }
})();
</script>
}
