@using Portal.Infrastructure.Models
@{
    ViewData["Title"] = "Create Demo Invitation";
    var demoBusinesses = (List<DemoBusinessItem>)ViewBag.DemoBusinesses;

    var moduleGroups = new[] {
        new { Title = "Core (Foundation)", Tier = "Found", TierClass = "perm-tier-foundation", Modules = new[] { "customer", "quotation", "invoice", "revenue", "purchase", "vat", "credit", "products", "audit" } },
        new { Title = "Intelligence (Professional)", Tier = "Pro", TierClass = "perm-tier-professional", Modules = new[] { "sales", "pnl", "cashflow", "expense_insights", "schedule_payments", "recurring_expense_validation" } },
        new { Title = "Automation (Professional)", Tier = "Pro", TierClass = "perm-tier-professional", Modules = new[] { "payment_link_manual", "payment_reminder_manual", "payment_link_auto", "payment_reminder_auto", "purchase_import", "zreport_import" } },
        new { Title = "Documents (Professional)", Tier = "Pro", TierClass = "perm-tier-professional", Modules = new[] { "attachments", "audit_log" } },
        new { Title = "Enterprise", Tier = "Ent", TierClass = "perm-tier-enterprise", Modules = new[] { "activity_timeline", "client_portal", "api", "webhooks", "multi_currency" } }
    };

    var moduleLabels = new Dictionary<string, string>
    {
        { "customer", "Customers" },
        { "quotation", "Quotations" },
        { "invoice", "Invoices" },
        { "revenue", "Revenue" },
        { "purchase", "Purchases" },
        { "vat", "VAT" },
        { "credit", "Credit Notes" },
        { "products", "Products" },
        { "audit", "Audit" },
        { "sales", "Opportunities" },
        { "pnl", "Profit & Loss" },
        { "cashflow", "Cash Flow" },
        { "expense_insights", "Expense Insights" },
        { "schedule_payments", "Payment Schedules" },
        { "recurring_expense_validation", "Recurring Expense Validation" },
        { "payment_link_manual", "Payment Links (Manual)" },
        { "payment_reminder_manual", "Payment Reminders (Manual)" },
        { "payment_link_auto", "Payment Links (Auto)" },
        { "payment_reminder_auto", "Payment Reminders (Auto)" },
        { "purchase_import", "Purchase Import" },
        { "zreport_import", "Sales Invoice Import" },
        { "attachments", "Attachments" },
        { "audit_log", "Activity Log" },
        { "activity_timeline", "Activity Timeline" },
        { "client_portal", "Client Portal" },
        { "api", "API Access" },
        { "webhooks", "Webhooks" },
        { "multi_currency", "Multi-Currency" }
    };

    // Flat list for JS serialization
    var allModules = moduleGroups.SelectMany(g => g.Modules).ToArray();
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Administration</div>
        <h1 class="topbar-heading">Create Demo Invitation</h1>
        <p class="topbar-subtitle">Send a demo access invitation with configurable module permissions.</p>
    </div>
    <div>
        <a href="/Admin/DemoInvitations" class="btn btn-secondary">← Back to Invitations</a>
    </div>
</div>

<section class="glass card-pad">
    <form id="createDemoInvitationForm">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label for="businessId">Demo Business *</label>
                <select id="businessId" required>
                    <option value="">-- Select Demo Business --</option>
                    @foreach (var business in demoBusinesses)
                    {
                        <option value="@business.Id">@business.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="recipientEmail">Recipient Email *</label>
                <input type="email" id="recipientEmail" placeholder="prospect@example.com" required />
            </div>
            <div class="field">
                <label for="recipientName">Recipient Name</label>
                <input type="text" id="recipientName" placeholder="John Smith" />
            </div>
            <div class="field">
                <label for="expiresAtUtc">Expiry Date *</label>
                <input type="date" id="expiresAtUtc" required />
            </div>
        </div>

        <!-- Module Permissions Grid -->
        <div style="margin-top:28px;">
            <label style="font-weight:700;font-size:15px;color:#1a2b3c;display:block;margin-bottom:10px;">Module Permissions</label>
            <div style="margin-bottom:16px;padding:10px 14px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.08);border-radius:10px;font-size:12px;color:#5E7385;line-height:1.6;">
                <strong>F</strong> = Full access &nbsp;|&nbsp; <strong>R</strong> = Read Only (view only, no editing) &nbsp;|&nbsp; <strong>N</strong> = None (hidden from menu)
            </div>
            <div class="perm-grid">
                @foreach (var group in moduleGroups)
                {
                    <div class="perm-section-title">@group.Title</div>
                    @foreach (var module in group.Modules)
                    {
                        <div class="perm-row">
                            <div class="perm-row-label">
                                <span>@moduleLabels[module]</span>
                                <span class="perm-tier-badge @group.TierClass">@group.Tier</span>
                            </div>
                            <div class="perm-radios">
                                <label><input type="radio" name="perm_@module" value="full" />F</label>
                                <label><input type="radio" name="perm_@module" value="readonly" />R</label>
                                <label><input type="radio" name="perm_@module" value="none" checked />N</label>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div style="margin-top:24px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary">Send Invitation</button>
            <a href="/Admin/DemoInvitations" class="btn btn-outline">← Back to Invitations</a>
        </div>
    </form>
</section>

<style>
    .perm-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 28px; }
    @@media (max-width:640px) { .perm-grid { grid-template-columns:1fr; } }
    .perm-section-title { grid-column:1/-1; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:#5a6b7c; padding:14px 0 6px; border-bottom:1px solid rgba(13,94,166,.08); margin-bottom:2px; }
    .perm-row { display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f4f7fa; }
    .perm-row-label { display:flex; align-items:center; gap:6px; font-weight:600; font-size:13px; color:#1a2b3c; }
    .perm-tier-badge { font-size:10px; font-weight:700; padding:2px 6px; border-radius:6px; letter-spacing:.03em; }
    .perm-tier-foundation { background:rgba(18,152,103,.08); color:#0C734B; }
    .perm-tier-professional { background:rgba(13,94,166,.08); color:#0D5EA6; }
    .perm-tier-enterprise { background:rgba(200,145,46,.1); color:#8B6914; }
    .perm-radios { display:flex; gap:12px; align-items:center; }
    .perm-radios label { display:flex; align-items:center; gap:3px; font-size:11px; color:#5a6b7c; cursor:pointer; }
    .perm-radios input[type="radio"] { width:15px; height:15px; accent-color:#0D5EA6; cursor:pointer; }
</style>

@section Scripts {
<script>
(function() {
    // Set minimum expiry date to tomorrow
    var expiryInput = document.getElementById('expiresAtUtc');
    if (expiryInput) {
        var tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        expiryInput.min = tomorrow.toISOString().split('T')[0];
    }

    function getAntiForgeryToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    function getPermissions() {
        var modules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allModules));
        var permissions = [];
        for (var i = 0; i < modules.length; i++) {
            var selected = document.querySelector('input[name="perm_' + modules[i] + '"]:checked');
            if (selected) {
                permissions.push({ module: modules[i], accessLevel: selected.value });
            }
        }
        return permissions;
    }

    function validateForm() {
        var businessId = document.getElementById('businessId').value;
        var email = document.getElementById('recipientEmail').value.trim();
        var expiresAt = document.getElementById('expiresAtUtc').value;

        if (!businessId) {
            return 'Please select a demo business.';
        }
        if (!email) {
            return 'Recipient email is required.';
        }
        // Basic email format check
        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            return 'Please enter a valid email address.';
        }
        if (!expiresAt) {
            return 'Expiry date is required.';
        }
        // Check expiry is in the future
        var expiryDate = new Date(expiresAt + 'T23:59:59');
        if (expiryDate <= new Date()) {
            return 'Expiry date must be in the future.';
        }
        // Check at least one module with full or readonly
        var permissions = getPermissions();
        var hasGranted = permissions.some(function(p) { return p.accessLevel === 'full' || p.accessLevel === 'readonly'; });
        if (!hasGranted) {
            return 'At least one module must have Full or Read Only access.';
        }

        return null;
    }

    var form = document.getElementById('createDemoInvitationForm');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            var validationError = validateForm();
            if (validationError) {
                Swal.fire({ title: 'Validation', text: validationError, icon: 'warning', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var businessId = parseInt(document.getElementById('businessId').value);
            var email = document.getElementById('recipientEmail').value.trim();
            var name = document.getElementById('recipientName').value.trim() || null;
            var expiresAt = document.getElementById('expiresAtUtc').value;
            var permissions = getPermissions();

            var payload = {
                businessId: businessId,
                recipientEmail: email,
                recipientName: name,
                expiresAtUtc: expiresAt + 'T23:59:59Z',
                permissions: permissions
            };

            BlockUI.show('Sending invitation...');
            try {
                var response = await fetch('/Admin/DemoInvitations/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Invitation Sent!',
                        text: data.message || 'Demo invitation created successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.href = '/Admin/DemoInvitations';
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to create invitation.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        });
    }
})();
</script>
}
