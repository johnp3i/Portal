@using Portal.Infrastructure.Models
@model PagedResult<DemoInvitationListItem>
@{
    ViewData["Title"] = "Demo Invitations";
    var totalSent = Model.Items?.Count(i => i.Status == "sent" || i.Status == "accessed" || i.Status == "converted") ?? 0;
    var totalAccessed = Model.Items?.Count(i => i.Status == "accessed" || i.Status == "converted") ?? 0;
    var totalConverted = Model.Items?.Count(i => i.Status == "converted") ?? 0;
    var conversionRate = totalAccessed > 0 ? Math.Round((double)totalConverted / totalAccessed * 100) : 0;
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Administration</div>
        <h1 class="topbar-heading">Demo Invitations</h1>
        <p class="topbar-subtitle">Create, manage, and track demo access invitations for prospects.</p>
    </div>
</div>

<!-- KPIs -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:16px;text-align:center;">
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0B1B28;">@Model.TotalCount</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Total Invitations</div>
        </div>
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#0D5EA6;">@totalAccessed</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Accessed</div>
        </div>
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#129867;">@totalConverted</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Converted</div>
        </div>
        <div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:@(conversionRate > 0 ? "#129867" : "#0B1B28");">@conversionRate%</div>
            <div style="font-size:12px;font-weight:600;color:#5E7385;margin-top:4px;">Conversion Rate</div>
        </div>
    </div>
</section>

<!-- Action Bar -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;justify-content:space-between;align-items:center;">
        <h3 style="margin:0;font-size:16px;font-weight:700;color:#1a2b3c;">Manage Invitations</h3>
        <a href="/Admin/DemoInvitations/Create" class="btn btn-primary" style="padding:10px 20px;font-size:13px;">
            Create Invitation
        </a>
    </div>
</section>

<!-- Demo Invitations Table -->
<section class="glass card-pad">
    @Html.AntiForgeryToken()

    @if (Model.Items != null && Model.Items.Count > 0)
    {
        <table id="demoInvitationsTable">
            <thead>
                <tr>
                    <th>Recipient Email</th>
                    <th>Name</th>
                    <th>Business</th>
                    <th>Status</th>
                    <th>Expiry</th>
                    <th>Access Count</th>
                    <th>First Accessed</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var isActive = item.Status == "sent" || item.Status == "accessed";
                    var isNotExpired = item.ExpiresAtUtc > DateTime.UtcNow;
                    var canRevoke = isActive;
                    var canResend = isActive && isNotExpired;

                    <tr>
                        <td>@item.RecipientEmail</td>
                        <td>@(item.RecipientName ?? "—")</td>
                        <td>@item.BusinessName</td>
                        <td>
                            @if (item.Status == "converted")
                            {
                                <span class="pill pill-green">Converted</span>
                            }
                            else if (item.Status == "sent")
                            {
                                <span class="pill pill-demo-sent">Sent</span>
                            }
                            else if (item.Status == "accessed")
                            {
                                <span class="pill pill-demo-accessed">Accessed</span>
                            }
                            else if (item.Status == "expired")
                            {
                                <span class="pill pill-demo-expired">Expired</span>
                            }
                            else if (item.Status == "revoked")
                            {
                                <span class="pill pill-demo-revoked">Revoked</span>
                            }
                        </td>
                        <td>@item.ExpiresAtUtc.ToString("dd MMM yyyy")</td>
                        <td>@item.AccessCount</td>
                        <td>@(item.FirstAccessedAtUtc.HasValue ? item.FirstAccessedAtUtc.Value.ToString("dd MMM yyyy HH:mm") : "—")</td>
                        <td>@item.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                        <td style="white-space:nowrap;">
                            <button type="button"
                                    class="tbl-action tbl-action--primary btn-permissions-invitation"
                                    data-id="@item.Id">
                                Permissions
                            </button>
                            <button type="button"
                                    class="tbl-action tbl-action--danger btn-revoke-invitation"
                                    data-id="@item.Id"
                                    @(canRevoke ? "" : "disabled")>
                                Revoke
                            </button>
                            <button type="button"
                                    class="tbl-action tbl-action--primary btn-resend-invitation"
                                    data-id="@item.Id"
                                    @(canResend ? "" : "disabled")>
                                Resend
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination Controls -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
            <div id="paginationInfo" style="font-size:14px;color:#5a6a7a;">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) of @Model.TotalCount
            </div>
            <div id="paginationControls" style="display:flex;gap:4px;align-items:center;">
                @if (Model.HasPreviousPage)
                {
                    <a href="/Admin/DemoInvitations?page=@(Model.CurrentPage - 1)" class="pagination-btn">Previous</a>
                }
                else
                {
                    <span class="pagination-btn" style="opacity:0.4;cursor:not-allowed;">Previous</span>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="pagination-btn active">@i</span>
                    }
                    else
                    {
                        <a href="/Admin/DemoInvitations?page=@i" class="pagination-btn">@i</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="/Admin/DemoInvitations?page=@(Model.CurrentPage + 1)" class="pagination-btn">Next</a>
                }
                else
                {
                    <span class="pagination-btn" style="opacity:0.4;cursor:not-allowed;">Next</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No demo invitations found. Create your first invitation to get started.</p>
        </div>
    }
</section>

<style>
    .pill-demo-sent {
        background: #0D5EA6;
        color: #fff;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    .pill-demo-accessed {
        background: #129867;
        color: #fff;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    .pill-demo-expired {
        background: #C8912E;
        color: #fff;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    .pill-demo-revoked {
        background: #C24A4A;
        color: #fff;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    .pagination-btn {
        padding: 6px 12px;
        border: 1px solid #d0d9e2;
        border-radius: 8px;
        background: #fff;
        color: #0D5EA6;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
        display: inline-block;
    }
    .pagination-btn:hover {
        background: #EEF4F8;
        border-color: #0D5EA6;
    }
    .pagination-btn.active {
        background: #0D5EA6;
        color: #fff;
        border-color: #0D5EA6;
    }
    .tbl-action:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

@section Scripts {
<!-- Permissions Modal -->
<div id="permissionsModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:32px;max-width:780px;width:92%;box-shadow:0 16px 48px rgba(0,0,0,0.15);max-height:85vh;display:flex;flex-direction:column;">
        <h3 style="margin:0 0 12px 0;font-size:18px;font-weight:700;color:#1a2b3c;flex-shrink:0;">Edit Module Permissions</h3>
        <div style="margin-bottom:16px;padding:10px 14px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.08);border-radius:10px;font-size:12px;color:#5E7385;line-height:1.6;flex-shrink:0;">
            <strong>F</strong> = Full access &nbsp;|&nbsp; <strong>R</strong> = Read Only (view only, no editing) &nbsp;|&nbsp; <strong>N</strong> = None (hidden from menu)
        </div>
        <div id="permissionsModalBody" style="overflow-y:auto;flex:1;min-height:0;padding-right:12px;"></div>
        <div style="margin-top:20px;display:flex;justify-content:flex-end;gap:12px;flex-shrink:0;">
            <button type="button" class="btn btn-secondary" onclick="closePermissionsModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="savePermissions()">Save Permissions</button>
        </div>
    </div>
</div>
<style>
    .perm-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 28px; }
    @@media (max-width:640px) { .perm-grid { grid-template-columns:1fr; } }
    .perm-section-title { grid-column:1/-1; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:#5a6b7c; padding:14px 0 6px; border-bottom:1px solid rgba(13,94,166,.08); margin-bottom:2px; }
    .perm-row { display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f4f7fa; }
    .perm-row-label { display:flex; align-items:center; gap:6px; font-weight:600; font-size:13px; color:#1a2b3c; }
    .perm-tier-badge { font-size:10px; font-weight:700; padding:2px 6px; border-radius:6px; letter-spacing:.03em; }
    .perm-tier-foundation { background:rgba(18,152,103,.08); color:#0C734B; }
    .perm-tier-professional { background:rgba(13,94,166,.08); color:#0D5EA6; }
    .perm-tier-enterprise { background:rgba(200,145,46,.1); color:#8B6914; }
    .perm-radios { display:flex; gap:12px; align-items:center; }
    .perm-radios label { display:flex; align-items:center; gap:3px; font-size:11px; color:#5a6b7c; cursor:pointer; }
    .perm-radios input[type="radio"] { width:15px; height:15px; accent-color:#0D5EA6; cursor:pointer; }
</style>

<script>
(function() {
    // =========================================================================
    // Helper: Get Antiforgery Token
    // =========================================================================
    function getAntiForgeryToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    // =========================================================================
    // Revoke Invitation — Confirmation + AJAX
    // =========================================================================
    document.querySelectorAll('.btn-revoke-invitation').forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var invitationId = parseInt(this.getAttribute('data-id'));

            var result = await Swal.fire({
                title: 'Revoke Invitation',
                text: 'Are you sure you want to revoke this invitation? The recipient will no longer be able to access the demo.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, revoke it'
            });

            if (!result.isConfirmed) return;

            BlockUI.show('Revoking invitation...');
            try {
                var response = await fetch('/Admin/DemoInvitations/Revoke', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ invitationId: invitationId })
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Revoked!',
                        text: data.message || 'Invitation has been revoked.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to revoke invitation.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        });
    });

    // =========================================================================
    // Resend Invitation Email — Confirmation + AJAX
    // =========================================================================
    document.querySelectorAll('.btn-resend-invitation').forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var invitationId = parseInt(this.getAttribute('data-id'));

            var result = await Swal.fire({
                title: 'Resend Invitation',
                text: 'Are you sure you want to resend the invitation email?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0D5EA6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, resend it'
            });

            if (!result.isConfirmed) return;

            BlockUI.show('Resending invitation email...');
            try {
                var response = await fetch('/Admin/DemoInvitations/Resend', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ invitationId: invitationId })
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({
                        title: 'Sent!',
                        text: data.message || 'Invitation email resent successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to resend invitation email.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        });
    });
    // =========================================================================
    // Permissions Modal — View + Edit
    // =========================================================================
    var currentPermissionsInvitationId = null;
    var moduleLabels = {
        customer: 'Customers', quotation: 'Quotations', invoice: 'Invoices',
        revenue: 'Revenue', purchase: 'Purchases & Suppliers', vat: 'VAT',
        credit: 'Credit Notes', audit: 'Audit', products: 'Products',
        sales: 'Opportunities', pnl: 'Profit & Loss', cashflow: 'Cash Flow',
        expense_insights: 'Expense Insights', schedule_payments: 'Payment Schedules',
        payment_link_manual: 'Payment Links (Manual)', payment_reminder_manual: 'Payment Reminders (Manual)',
        payment_link_auto: 'Payment Links (Auto)', payment_reminder_auto: 'Payment Reminders (Auto)',
        recurring_expense_validation: 'Recurring Expense Validation',
        purchase_import: 'Purchase Import', zreport_import: 'Sales Invoice Import',
        attachments: 'Attachments', audit_log: 'Activity Log',
        activity_timeline: 'Activity Timeline', client_portal: 'Client Portal',
        api: 'API Access', webhooks: 'Webhooks', multi_currency: 'Multi-Currency',
        stripe_connect: 'Card Payments (Stripe)', compliance: 'Compliance', payroll: 'Payroll'
    };
    var modules = ['customer', 'quotation', 'invoice', 'revenue', 'purchase', 'vat', 'credit', 'audit', 'products',
        'sales', 'pnl', 'cashflow', 'expense_insights', 'schedule_payments',
        'payment_link_manual', 'payment_reminder_manual', 'payment_link_auto', 'payment_reminder_auto',
        'recurring_expense_validation', 'purchase_import', 'zreport_import', 'attachments', 'audit_log',
        'activity_timeline', 'client_portal', 'api', 'webhooks', 'multi_currency',
        'stripe_connect', 'compliance', 'payroll'];

    var moduleGroups = [
        { title: 'Core (Foundation)', tier: 'foundation', modules: ['customer', 'quotation', 'invoice', 'revenue', 'purchase', 'vat', 'credit', 'products', 'audit'] },
        { title: 'Intelligence (Professional)', tier: 'professional', modules: ['sales', 'pnl', 'cashflow', 'expense_insights', 'schedule_payments', 'recurring_expense_validation'] },
        { title: 'Automation (Professional)', tier: 'professional', modules: ['payment_link_manual', 'payment_reminder_manual', 'payment_link_auto', 'payment_reminder_auto', 'purchase_import', 'zreport_import'] },
        { title: 'Documents (Professional)', tier: 'professional', modules: ['attachments', 'audit_log'] },
        { title: 'Enterprise', tier: 'enterprise', modules: ['activity_timeline', 'client_portal', 'api', 'webhooks', 'multi_currency', 'stripe_connect'] },
        { title: 'Operations', tier: 'professional', modules: ['compliance', 'payroll'] }
    ];

    var moduleTiers = {};
    moduleGroups.forEach(function(g) {
        g.modules.forEach(function(m) { moduleTiers[m] = g.tier; });
    });

    document.querySelectorAll('.btn-permissions-invitation').forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var invitationId = parseInt(this.getAttribute('data-id'));
            currentPermissionsInvitationId = invitationId;

            BlockUI.show('Loading permissions...');
            try {
                var response = await fetch('/Admin/DemoInvitations/Permissions/' + invitationId);
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    renderPermissionsModal(data.permissions);
                    document.getElementById('permissionsModal').style.display = 'flex';
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to load permissions.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        });
    });

    function renderPermissionsModal(permissions) {
        var container = document.getElementById('permissionsModalBody');
        var html = '<div class="perm-grid">';

        moduleGroups.forEach(function(group) {
            // Section header spans both columns
            html += '<div class="perm-section-title">' + group.title + '</div>';

            group.modules.forEach(function(m) {
                var level = permissions[m] || 'none';
                var tierClass = 'perm-tier-' + group.tier;
                var tierLabel = group.tier === 'foundation' ? 'Found' : (group.tier === 'professional' ? 'Pro' : 'Ent');

                html += '<div class="perm-row">'
                    + '<div class="perm-row-label">'
                    + '<span>' + moduleLabels[m] + '</span>'
                    + '<span class="perm-tier-badge ' + tierClass + '">' + tierLabel + '</span>'
                    + '</div>'
                    + '<div class="perm-radios">'
                    + '<label><input type="radio" name="modal_perm_' + m + '" value="full" ' + (level === 'full' ? 'checked' : '') + ' />F</label>'
                    + '<label><input type="radio" name="modal_perm_' + m + '" value="readonly" ' + (level === 'readonly' ? 'checked' : '') + ' />R</label>'
                    + '<label><input type="radio" name="modal_perm_' + m + '" value="none" ' + (level === 'none' ? 'checked' : '') + ' />N</label>'
                    + '</div></div>';
            });
        });

        html += '</div>';
        container.innerHTML = html;
    }

    window.closePermissionsModal = function() {
        document.getElementById('permissionsModal').style.display = 'none';
        currentPermissionsInvitationId = null;
    };

    window.savePermissions = async function() {
        if (!currentPermissionsInvitationId) return;

        var permissions = [];
        for (var i = 0; i < modules.length; i++) {
            var m = modules[i];
            var selected = document.querySelector('input[name="modal_perm_' + m + '"]:checked');
            if (selected) {
                permissions.push({ module: m, accessLevel: selected.value });
            }
        }

        var hasGranted = permissions.some(function(p) { return p.accessLevel === 'full' || p.accessLevel === 'readonly'; });
        if (!hasGranted) {
            Swal.fire({ title: 'Validation', text: 'At least one module must have Full or Read Only access.', icon: 'warning', confirmButtonColor: '#0D5EA6' });
            return;
        }

        BlockUI.show('Saving permissions...');
        try {
            var response = await fetch('/Admin/DemoInvitations/Permissions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ invitationId: currentPermissionsInvitationId, permissions: permissions })
            });
            var data = await response.json();
            BlockUI.hide();

            if (data.success) {
                closePermissionsModal();
                Swal.fire({ title: 'Updated!', text: data.message || 'Permissions updated successfully.', icon: 'success', confirmButtonColor: '#0D5EA6' });
            } else {
                Swal.fire({ title: 'Error', text: data.message || 'Failed to update permissions.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        } catch (e) {
            BlockUI.hide();
            Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
        }
    };

    // Close modal on overlay click
    document.getElementById('permissionsModal').addEventListener('click', function(e) {
        if (e.target === this) closePermissionsModal();
    });
})();
</script>
}
