@model List<Portal.Infrastructure.Models.SharedLinkViewModel>
@{
    ViewData["Title"] = "Shared Links";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Shared Links</div>
        <h1 class="topbar-heading">Shared Links</h1>
        <p class="topbar-subtitle">Manage all shared document links for quotations and invoices.</p>
    </div>
</div>

<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:240px;">
            <label for="linkSearch">Search</label>
            <input type="text" id="linkSearch" placeholder="Reference, email, or customer..." maxlength="200" />
        </div>
        <div class="field" style="min-width:200px;">
            <label for="customerFilter">Customer</label>
            <select id="customerFilter">
                <option value="">All Customers</option>
            </select>
        </div>
        <div style="padding-bottom:2px;">
            <button type="button" class="btn btn-primary" onclick="filterLinks()">Search</button>
            <button type="button" class="btn btn-secondary" onclick="clearLinkFilters()">Clear</button>
        </div>
    </div>
</section>

<section class="glass card-pad">
    @if (Model != null && Model.Count > 0)
    {
        <table id="sharedLinksTable">
            <thead>
                <tr>
                    <th>Document Type</th>
                    <th>Reference</th>
                    <th>Customer Email</th>
                    <th>Created</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var link in Model)
                {
                    <tr data-customer="@link.CustomerName" data-reference="@link.DocumentReference" data-email="@link.CustomerEmail">
                        <td>@link.DocumentType</td>
                        <td><strong>@link.DocumentReference</strong></td>
                        <td>@link.CustomerEmail</td>
                        <td>@link.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@link.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @{
                                var statusColor = link.Status switch
                                {
                                    "Active" => "#129867",
                                    "Expired" => "#C8912E",
                                    "Cancelled" => "#C24A4A",
                                    _ => "#6B7F8E"
                                };
                            }
                            <span style="display:inline-block;padding:4px 12px;border-radius:12px;font-size:12px;font-weight:700;color:#fff;background-color:@statusColor;">
                                @link.Status
                            </span>
                        </td>
                        <td>
                            @{
                                var previewUrl = link.DocumentType == "Quotation"
                                    ? $"/proposal/{link.ShareToken}"
                                    : $"/invoice-view/{link.ShareToken}";
                            }
                            <a href="@previewUrl" target="_blank" class="tbl-action tbl-action--secondary">Preview</a>
                            @if (link.Status == "Active")
                            {
                                if (link.DocumentType == "Quotation")
                                {
                                    <form method="post" asp-action="CancelProposal" asp-controller="SharedLinks" asp-route-id="@link.Id" style="display:inline;" id="cancel-form-@link.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="tbl-action tbl-action--danger" onclick="confirmCancel('@link.DocumentReference', 'cancel-form-@link.Id')">Cancel</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="CancelInvoice" asp-controller="SharedLinks" asp-route-id="@link.Id" style="display:inline;" id="cancel-form-@link.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="tbl-action tbl-action--danger" onclick="confirmCancel('@link.DocumentReference', 'cancel-form-@link.Id')">Cancel</button>
                                    </form>
                                }
                            }
                            else if (link.Status == "Cancelled")
                            {
                                if (link.DocumentType == "Quotation")
                                {
                                    <form method="post" asp-action="ReactivateProposal" asp-controller="SharedLinks" asp-route-id="@link.Id" style="display:inline;" id="reactivate-form-@link.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="tbl-action tbl-action--primary" onclick="confirmReactivate('@link.DocumentReference', 'reactivate-form-@link.Id')">Reactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="ReactivateInvoice" asp-controller="SharedLinks" asp-route-id="@link.Id" style="display:inline;" id="reactivate-form-@link.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="tbl-action tbl-action--primary" onclick="confirmReactivate('@link.DocumentReference', 'reactivate-form-@link.Id')">Reactivate</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <p>No shared links found. Share a quotation or invoice to see links here.</p>
        </div>
    }
</section>

@section Scripts {
    <script>
        function confirmCancel(reference, formId) {
            Swal.fire({
                title: 'Cancel this shared link?',
                text: 'The link for ' + reference + ' will be deactivated immediately. Recipients will no longer be able to view the document.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6B7F8E',
                confirmButtonText: 'Yes, cancel it',
                cancelButtonText: 'Keep it'
            }).then(function(result) {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }

        function confirmReactivate(reference, formId) {
            Swal.fire({
                title: 'Reactivate this shared link?',
                text: 'The link for ' + reference + ' will be made active again. Recipients will be able to view the document if it has not expired.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#129867',
                cancelButtonColor: '#6B7F8E',
                confirmButtonText: 'Yes, reactivate it',
                cancelButtonText: 'Never mind'
            }).then(function(result) {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }

        // Filter logic
        function filterLinks() {
            var query = document.getElementById('linkSearch').value.toLowerCase().trim();
            var customer = document.getElementById('customerFilter').value;
            var rows = document.querySelectorAll('#sharedLinksTable tbody tr');

            rows.forEach(function(row) {
                var ref = (row.getAttribute('data-reference') || '').toLowerCase();
                var email = (row.getAttribute('data-email') || '').toLowerCase();
                var cust = row.getAttribute('data-customer') || '';

                var matchesSearch = !query || ref.indexOf(query) !== -1 || email.indexOf(query) !== -1 || cust.toLowerCase().indexOf(query) !== -1;
                var matchesCustomer = !customer || cust === customer;

                row.style.display = (matchesSearch && matchesCustomer) ? '' : 'none';
            });
        }

        function clearLinkFilters() {
            document.getElementById('linkSearch').value = '';
            document.getElementById('customerFilter').value = '';
            filterLinks();
        }

        // Populate customer dropdown from table data
        (function() {
            var rows = document.querySelectorAll('#sharedLinksTable tbody tr');
            var customers = new Set();
            rows.forEach(function(row) {
                var cust = row.getAttribute('data-customer');
                if (cust) customers.add(cust);
            });
            var select = document.getElementById('customerFilter');
            Array.from(customers).sort().forEach(function(name) {
                var opt = document.createElement('option');
                opt.value = name;
                opt.textContent = name;
                select.appendChild(opt);
            });
        })();

        // Search on Enter key
        document.getElementById('linkSearch').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); filterLinks(); }
        });
    </script>
}
