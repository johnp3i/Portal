@{
    ViewData["Title"] = "Card Payments";
    var isConnected = (bool)ViewBag.IsStripeConnected;
    var sessions = ViewBag.Sessions as List<Portal.Infrastructure.Entities.StripeCheckoutSession> ?? new List<Portal.Infrastructure.Entities.StripeCheckoutSession>();
    var period = ViewBag.Period as string ?? "this_month";
    var totalGross = (decimal)(ViewBag.TotalGross ?? 0m);
    var totalFees = (decimal)(ViewBag.TotalFees ?? 0m);
    var totalNet = (decimal)(ViewBag.TotalNet ?? 0m);
    var transactionCount = (int)(ViewBag.TransactionCount ?? 0);
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Revenue Control</div>
        <h1 class="topbar-heading">Card Payments</h1>
        <p class="topbar-subtitle">Track all card payments received via Stripe, including fees and net amounts.</p>
    </div>
</div>

@if (!isConnected)
{
    <section class="glass card-pad">
        <div class="empty-state" style="text-align:center;padding:40px 20px;">
            <svg width="48" height="48" fill="none" stroke="#8a9bac" stroke-width="1.5" viewBox="0 0 24 24" style="margin-bottom:16px;"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            <h3 style="font-size:18px;font-weight:700;color:#1a2b3c;margin-bottom:8px;">Stripe Not Connected</h3>
            <p style="color:#5a6b7c;font-size:14px;margin-bottom:20px;">Connect your Stripe account to start accepting card payments from your customers.</p>
            <a href="@Url.Action("Index", "MyBusiness", new { tab = "automation" })" class="btn btn-primary">Go to Settings</a>
        </div>
    </section>
}
else
{
    <!-- Connected Status -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:22px;padding:14px 20px;background:#f8fdf9;border:1px solid #d4edda;border-radius:14px;">
        <div style="width:10px;height:10px;border-radius:50%;background:#129867;"></div>
        <div style="font-size:13px;color:#5a6b7c;">
            <strong style="color:#1a2b3c;">Stripe Connected</strong> — Payments are deposited directly to your bank account via Stripe.
        </div>
    </div>

    <!-- Summary Cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin-bottom:22px;">
        <div class="glass" style="padding:20px 22px;border-radius:16px;">
            <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;color:#8a9bac;">Total Received (Gross)</div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#1a2b3c;letter-spacing:-1px;margin-top:4px;">@totalGross.ToString("C2", new System.Globalization.CultureInfo("en-IE"))</div>
            <div style="font-size:13px;color:#5a6b7c;">@transactionCount transaction@(transactionCount != 1 ? "s" : "")</div>
        </div>
        <div class="glass" style="padding:20px 22px;border-radius:16px;">
            <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;color:#8a9bac;">Stripe Fees</div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#C24A4A;letter-spacing:-1px;margin-top:4px;">&minus;@totalFees.ToString("C2", new System.Globalization.CultureInfo("en-IE"))</div>
            @if (totalGross > 0)
            {
                <div style="font-size:13px;color:#5a6b7c;">Avg @((totalFees / totalGross * 100).ToString("F2"))% per transaction</div>
            }
        </div>
        <div class="glass" style="padding:20px 22px;border-radius:16px;">
            <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;color:#8a9bac;">Net Received</div>
            <div style="font-family:'Manrope',sans-serif;font-size:28px;font-weight:800;color:#129867;letter-spacing:-1px;margin-top:4px;">@totalNet.ToString("C2", new System.Globalization.CultureInfo("en-IE"))</div>
            <div style="font-size:13px;color:#5a6b7c;">Deposited to your bank</div>
        </div>
    </div>

    <!-- Filter Panel -->
    <section class="glass card-pad" style="margin-bottom:22px;">
        <form method="get" action="/Revenue/CardPayments">
            <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
                <div class="field" style="min-width:180px;">
                    <label for="period">Period</label>
                    @{
                        var optThisMonth = period == "this_month" ? "<option value=\"this_month\" selected>This Month</option>" : "<option value=\"this_month\">This Month</option>";
                        var optLastMonth = period == "last_month" ? "<option value=\"last_month\" selected>Last Month</option>" : "<option value=\"last_month\">Last Month</option>";
                        var optLast3 = period == "last_3" ? "<option value=\"last_3\" selected>Last 3 Months</option>" : "<option value=\"last_3\">Last 3 Months</option>";
                        var optThisYear = period == "this_year" ? "<option value=\"this_year\" selected>This Year</option>" : "<option value=\"this_year\">This Year</option>";
                        var optAll = period == "all" ? "<option value=\"all\" selected>All Time</option>" : "<option value=\"all\">All Time</option>";
                    }
                    @Html.Raw($"<select id=\"period\" name=\"period\">{optThisMonth}{optLastMonth}{optLast3}{optThisYear}{optAll}</select>")
                </div>
                <div style="padding-bottom:2px;">
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
                <div style="padding-bottom:2px;margin-left:auto;">
                    <button type="button" class="btn btn-secondary" onclick="exportCsv()" style="display:inline-flex;align-items:center;gap:6px;">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                        Export CSV
                    </button>
                </div>
            </div>
        </form>
    </section>

    <!-- Data Table -->
    <section class="glass card-pad">
        @if (sessions.Any())
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Invoice</th>
                            <th>Customer</th>
                            <th>Gross</th>
                            <th>Stripe Fee</th>
                            <th>Net</th>
                            <th>Charge ID</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in sessions)
                        {
                            <tr>
                                <td>@(s.CompletedAtUtc?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td><a href="/Revenue/InvoiceDetail/@s.InvoiceId" style="color:#0D5EA6;font-weight:600;text-decoration:none;">@(s.Invoice?.InvoiceNumber ?? $"INV-{s.InvoiceId}")</a></td>
                                <td>@(s.CustomerName ?? "—")</td>
                                <td style="font-weight:700;font-family:'Manrope',sans-serif;">@s.Amount.ToString("C2", new System.Globalization.CultureInfo("en-IE"))</td>
                                <td style="color:#C24A4A;font-weight:600;">@(s.StripeFeeAmount.HasValue ? $"−{s.StripeFeeAmount.Value.ToString("C2", new System.Globalization.CultureInfo("en-IE"))}" : "—")</td>
                                <td style="color:#129867;font-weight:700;">@((s.NetAmount ?? s.Amount).ToString("C2", new System.Globalization.CultureInfo("en-IE")))</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(s.StripeChargeId))
                                    {
                                        <span style="font-size:11px;color:#635bff;font-family:monospace;">@(s.StripeChargeId.Length > 14 ? s.StripeChargeId[..7] + "..." + s.StripeChargeId[^4..] : s.StripeChargeId)</span>
                                    }
                                    else
                                    {
                                        <span style="color:#8a9bac;">—</span>
                                    }
                                </td>
                                <td><span style="display:inline-block;padding:3px 10px;border-radius:10px;font-size:11px;font-weight:700;background:#e6f7f0;color:#129867;">Completed</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;">
                <div style="font-size:14px;color:#5a6a7a;">Showing @sessions.Count transaction@(sessions.Count != 1 ? "s" : "")</div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No card payments received in this period.</p>
            </div>
        }
    </section>
}

@section Scripts {
<script>
    function exportCsv() {
        var rows = [];
        rows.push(['Date', 'Invoice', 'Customer', 'Gross', 'Stripe Fee', 'Net', 'Charge ID']);

        document.querySelectorAll('.data-table tbody tr').forEach(function(tr) {
            var cells = tr.querySelectorAll('td');
            var row = [];
            cells.forEach(function(td, i) {
                if (i < 7) { // skip Status column
                    var text = td.innerText.replace(/[−\-]/g, '-').trim();
                    row.push('"' + text.replace(/"/g, '""') + '"');
                }
            });
            rows.push(row);
        });

        var csvContent = rows.map(function(r) { return r.join(','); }).join('\n');
        var blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'card-payments-export.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }
</script>
}
