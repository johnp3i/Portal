@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proposal Expired</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap');

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: #0B1B28;
            background: linear-gradient(180deg, #FBFDFF 0%, #EEF4F8 48%, #F7FAFC 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 520px;
            width: 100%;
            padding: 48px;
            background: rgba(255,255,255,.99);
            border: 1px solid rgba(13,94,166,.10);
            border-radius: 32px;
            box-shadow: 0 22px 56px rgba(13,94,166,.10);
            text-align: center;
        }

        .icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 24px;
            background: rgba(194,74,74,.08);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        h1 {
            font-family: Manrope, Inter, sans-serif;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -.03em;
            margin: 0 0 16px;
        }

        p {
            font-size: 16px;
            line-height: 1.7;
            color: #5E7385;
            margin: 0 0 24px;
        }

        .contact {
            padding: 20px;
            background: #F7FAFC;
            border-radius: 16px;
            border: 1px solid rgba(13,94,166,.08);
            font-size: 14px;
            color: #5E7385;
            line-height: 1.8;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="icon">
            <svg width="28" height="28" fill="none" stroke="#C24A4A" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
            </svg>
        </div>
        <h1>This proposal link has expired</h1>
        <p>The proposal you're trying to view is no longer available. Please contact the business that sent you this proposal to request a new link.</p>
        <div class="contact">
            If you need assistance, please reach out to the business that shared this proposal with you.
        </div>
    </div>
</body>
</html>
