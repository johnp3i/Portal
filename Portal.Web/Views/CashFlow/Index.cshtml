@{
    ViewData["Title"] = "Cash Flow Forecast";
}

@Html.AntiForgeryToken()

<style>
    .hero-card {
        background: #fff;
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(11,27,40,0.04);
        display: flex;
        gap: 20px;
        align-items: flex-start;
        border-left: 4px solid transparent;
    }
    .hero-healthy {
        border-left-color: var(--green);
        background: linear-gradient(135deg, #f0fdf7 0%, #fff 60%);
    }
    .hero-warning {
        border-left-color: #C8912E;
        background: linear-gradient(135deg, #fffbf0 0%, #fff 60%);
    }
    .hero-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .hero-healthy .hero-icon { background: #e6f9f0; }
    .hero-warning .hero-icon { background: #fef3e0; }
    .hero-content { flex: 1; }
    .hero-headline {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 12px;
        color: var(--text, #0B1B28);
        font-family: Manrope, sans-serif;
    }
    .hero-body {
        font-size: 16px;
        color: var(--text, #0B1B28);
        margin-bottom: 4px;
        line-height: 1.6;
    }
    .hero-amount {
        font-family: Manrope, sans-serif;
        font-size: 28px;
        font-weight: 800;
    }
    .hero-caution { color: #C8912E; font-weight: 600; }
    .period-selector {
        display: flex;
        gap: 8px;
        margin-top: 16px;
    }
    .period-btn {
        padding: 8px 18px;
        border-radius: 8px;
        border: 1.5px solid #E2EBF3;
        background: #fff;
        font-size: 13px;
        font-weight: 600;
        color: #5E7385;
        cursor: pointer;
        transition: all 0.15s;
    }
    .period-btn.active {
        background: #0D5EA6;
        color: #fff;
        border-color: #0D5EA6;
    }
    .period-btn:hover:not(.active) {
        border-color: #0D5EA6;
        color: #0D5EA6;
    }
    .kpi-strip {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .kpi-card {
        flex: 1;
        min-width: 160px;
        background: #fff;
        border-radius: 16px;
        padding: 20px 18px;
        box-shadow: 0 2px 12px rgba(11,27,40,0.04);
        border-left: 4px solid transparent;
    }
    .kpi-card .kpi-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #5E7385;
        margin-bottom: 6px;
    }
    .kpi-card .kpi-amount {
        font-family: Manrope, sans-serif;
        font-size: 22px;
        font-weight: 800;
        color: #0B1B28;
    }
    .tip-bar {
        background: #EEF4F8;
        border-radius: 12px;
        padding: 14px 20px;
        font-size: 13px;
        color: #5E7385;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        line-height: 1.5;
    }
    .tip-bar .tip-icon { font-size: 16px; flex-shrink: 0; }
    .flow-card {
        background: #fff;
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(11,27,40,0.04);
    }
    .flow-title {
        font-size: 18px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 24px;
        font-family: Manrope, sans-serif;
    }
    .flow-boxes {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        flex-wrap: wrap;
    }
    .flow-box {
        background: #EEF4F8;
        border-radius: 16px;
        padding: 28px 32px;
        text-align: center;
        min-width: 200px;
        flex: 1;
        max-width: 280px;
        border-top: 4px solid transparent;
    }
    .flow-box.incoming { border-top-color: #129867; }
    .flow-box.outgoing { border-top-color: #C8912E; }
    .flow-box-label {
        font-size: 14px;
        font-weight: 600;
        color: #5E7385;
        margin-bottom: 8px;
    }
    .flow-box-amount {
        font-family: Manrope, sans-serif;
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 6px;
    }
    .flow-box-desc { font-size: 13px; color: #5E7385; }
    .flow-arrow { font-size: 28px; color: #5E7385; flex-shrink: 0; }
    .flow-net {
        text-align: center;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #E2EBF3;
        font-size: 16px;
        font-weight: 600;
    }
    .flow-net.positive { color: #129867; }
    .flow-net.negative { color: #C24A4A; }
    .chart-card {
        background: #fff;
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(11,27,40,0.04);
    }
    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .chart-header h3 {
        font-size: 18px;
        font-family: Manrope, sans-serif;
        font-weight: 700;
    }
    .section-card {
        background: #fff;
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(11,27,40,0.04);
    }
    .section-heading {
        font-size: 20px;
        font-weight: 700;
        font-family: Manrope, sans-serif;
        margin-bottom: 4px;
    }
    .section-subheading {
        font-size: 14px;
        color: #5E7385;
        margin-bottom: 16px;
        line-height: 1.5;
    }
    .section-explainer {
        background: #EEF4F8;
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 13px;
        color: #5E7385;
        margin-bottom: 20px;
        line-height: 1.6;
        border-left: 3px solid #57B8E8;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .data-table th {
        text-align: left;
        padding: 10px 12px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #5E7385;
        border-bottom: 1.5px solid #E2EBF3;
        white-space: nowrap;
    }
    .data-table td {
        padding: 12px;
        border-bottom: 1px solid #E2EBF3;
        vertical-align: middle;
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table .excluded {
        background: #fafafa;
        opacity: 0.6;
    }
    .excluded-label {
        font-size: 11px;
        color: #C8912E;
        font-weight: 600;
        display: block;
        margin-top: 2px;
    }
    .toggle-switch {
        width: 36px;
        height: 20px;
        border-radius: 10px;
        background: #129867;
        position: relative;
        cursor: pointer;
        display: inline-block;
    }
    .toggle-switch::after {
        content: '';
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #fff;
        position: absolute;
        top: 2px;
        left: 18px;
        transition: left 0.15s;
    }
    .toggle-switch.off {
        background: #ccc;
    }
    .toggle-switch.off::after {
        left: 2px;
    }
    .pays-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
    }
    .pays-badge.ontime { background: #e6f9f0; color: #129867; }
    .pays-badge.late { background: #fef3e0; color: #C8912E; }
    .settings-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 16px;
    }
    .field-group label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #5E7385;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .field-group input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #E2EBF3;
        border-radius: 10px;
        font-size: 14px;
        font-family: Inter, sans-serif;
        color: #0B1B28;
        background: #F7FAFC;
    }
    .field-group input:focus {
        outline: none;
        border-color: #0D5EA6;
        box-shadow: 0 0 0 3px rgba(13,94,166,0.08);
    }
    .field-group .helper {
        font-size: 12px;
        color: #5E7385;
        margin-top: 4px;
    }
    .btn-save {
        margin-top: 20px;
        padding: 10px 28px;
        background: #0D5EA6;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-save:hover { background: #094a85; }
    .last-updated {
        font-size: 12px;
        color: #5E7385;
        margin-top: 12px;
    }
    .section-summary {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid #E2EBF3;
        font-size: 14px;
        line-height: 1.6;
    }
    .section-summary strong { font-weight: 700; }
    @@media (max-width: 640px) {
        .hero-card { flex-direction: column; gap: 12px; }
        .hero-amount { font-size: 24px; }
        .flow-boxes { flex-direction: column; }
        .flow-arrow { transform: rotate(90deg); }
        .settings-grid { grid-template-columns: 1fr; }
        .kpi-strip { flex-direction: column; }
        .period-selector { flex-wrap: wrap; }
    }
</style>

<!-- Topbar -->
<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Revenue Control</div>
        <h1 class="topbar-heading">Cash Flow Forecast</h1>
        <p class="topbar-subtitle">A clear picture of where your money is going — no accounting degree required.</p>
    </div>
</div>

<!-- Hero Card -->
<div id="heroCard" class="hero-card hero-healthy">
    <div class="hero-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#129867" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
    </div>
    <div class="hero-content">
        <h2 class="hero-headline">Loading projection...</h2>
        <p class="hero-body">Calculating your cash position.</p>
        <div class="period-selector">
            <button class="period-btn active" onclick="selectPeriod(30, this)">30 days</button>
            <button class="period-btn" onclick="selectPeriod(60, this)">60 days</button>
            <button class="period-btn" onclick="selectPeriod(90, this)">90 days</button>
        </div>
    </div>
</div>
<!-- KPI Summary Strip -->
<div class="kpi-strip">
    <div class="kpi-card" style="border-left-color:#0D5EA6;">
        <div style="display:flex;align-items:center;justify-content:space-between;">
            <div class="kpi-label">Starting Balance</div>
            <button onclick="showKpiInfo('starting')" style="width:20px;height:20px;border-radius:50%;border:1.5px solid #d0dbe5;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#5E7385;line-height:1;" title="What is this?">?</button>
        </div>
        <div class="kpi-amount" id="kpiStartingBalance">—</div>
    </div>
    <div class="kpi-card" style="border-left-color:#129867;">
        <div style="display:flex;align-items:center;justify-content:space-between;">
            <div class="kpi-label">Projected Inflows</div>
            <button onclick="showKpiInfo('inflows')" style="width:20px;height:20px;border-radius:50%;border:1.5px solid #d0dbe5;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#5E7385;line-height:1;" title="What is this?">?</button>
        </div>
        <div class="kpi-amount" id="kpiInflows">—</div>
    </div>
    <div class="kpi-card" style="border-left-color:#C8912E;">
        <div style="display:flex;align-items:center;justify-content:space-between;">
            <div class="kpi-label">Projected Outflows</div>
            <button onclick="showKpiInfo('outflows')" style="width:20px;height:20px;border-radius:50%;border:1.5px solid #d0dbe5;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#5E7385;line-height:1;" title="What is this?">?</button>
        </div>
        <div class="kpi-amount" id="kpiOutflows">—</div>
    </div>
    <div class="kpi-card" style="border-left-color:#57B8E8;">
        <div style="display:flex;align-items:center;justify-content:space-between;">
            <div class="kpi-label">Projected Balance</div>
            <button onclick="showKpiInfo('balance')" style="width:20px;height:20px;border-radius:50%;border:1.5px solid #d0dbe5;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#5E7385;line-height:1;" title="What is this?">?</button>
        </div>
        <div class="kpi-amount" id="kpiProjectedBalance">—</div>
    </div>
</div>

<!-- Tip Bar -->
<div class="tip-bar">
    <span class="tip-icon">&#128161;</span>
    <span><strong>Tip:</strong> Toggle invoices off in the "Money Coming In" section to see how your cash position changes if someone doesn't pay.</span>
</div>

<!-- Flow Visualization -->
<div class="flow-card">
    <h3 class="flow-title">Money In vs Money Out</h3>
    <div class="flow-boxes">
        <div class="flow-box incoming">
            <div class="flow-box-label">Coming In</div>
            <div class="flow-box-amount" id="flowInAmount">—</div>
            <div class="flow-box-desc" id="flowInDesc">from invoices</div>
        </div>
        <div class="flow-arrow">&rarr;</div>
        <div class="flow-box outgoing">
            <div class="flow-box-label">Going Out</div>
            <div class="flow-box-amount" id="flowOutAmount">—</div>
            <div class="flow-box-desc">monthly expenses</div>
        </div>
    </div>
    <div class="flow-net positive" id="flowNet">Net: calculating...</div>
</div>
<!-- Chart Card -->
<div class="chart-card">
    <div class="chart-header">
        <h3>Projected Balance Over Time</h3>
        <div class="period-selector">
            <button class="period-btn active" onclick="selectPeriod(30, this)">30 days</button>
            <button class="period-btn" onclick="selectPeriod(60, this)">60 days</button>
            <button class="period-btn" onclick="selectPeriod(90, this)">90 days</button>
        </div>
    </div>
    <div style="position:relative;height:240px;">
        <canvas id="cashFlowChart"></canvas>
    </div>
</div>

<!-- Inflow Breakdown Table -->
<div class="section-card">
    <h2 class="section-heading">Money Coming In</h2>
    <p class="section-subheading">These customers owe you money. Here's when we expect them to pay.</p>
    <div class="section-explainer">
        Expected payment dates are adjusted based on how quickly each customer usually pays. A customer who typically pays 4 days late will show a later expected date.
    </div>
    <div class="scroll-hint">&#8592; Scroll horizontally &#8594;</div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Who owes you</th>
                    <th>How much</th>
                    <th>Originally due</th>
                    <th>Expected payment</th>
                    <th>Typically pays</th>
                    <th>Include?</th>
                </tr>
            </thead>
            <tbody id="inflowTableBody">
                <tr><td colspan="6" style="text-align:center;color:#5E7385;padding:24px;">Loading...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="section-summary" id="inflowSummary"></div>
</div>
<!-- Outflow Breakdown Table -->
<div class="section-card">
    <h2 class="section-heading">Your Regular Expenses</h2>
    <p class="section-subheading">Based on what you've spent over the last 6 months, here's what we expect you'll spend.</p>
    <div class="section-explainer">
        These are averages. Your actual spending may vary — this gives you a realistic baseline.
    </div>
    <div class="scroll-hint">&#8592; Scroll horizontally &#8594;</div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>What you spend on</th>
                    <th>Typical monthly cost</th>
                    <th>Based on</th>
                </tr>
            </thead>
            <tbody id="outflowTableBody">
                <tr><td colspan="3" style="text-align:center;color:#5E7385;padding:24px;">Loading...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="section-summary" id="outflowSummary"></div>
</div>

<!-- Settings Card -->
<div class="section-card">
    <h2 class="section-heading">Your Starting Point</h2>
    <p class="section-subheading">Tell us your current bank balance so we can project forward accurately.</p>
    <div class="settings-grid">
        <div class="field-group">
            <label for="settingsStartingBalance">Current bank balance</label>
            <input type="number" id="settingsStartingBalance" min="0" step="0.01" value="0" />
        </div>
        <div class="field-group">
            <label for="settingsAlertThreshold">Warn me if balance drops below</label>
            <input type="number" id="settingsAlertThreshold" min="0" step="0.01" value="0" />
            <p class="helper">We'll highlight it on the chart so you can see it coming.</p>
        </div>
    </div>
    <button class="btn-save" onclick="saveSettings()">Save</button>
    <p class="last-updated" id="settingsLastUpdated"></p>
</div>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3"></script>
<script>
    var excludedInvoiceIds = new Set();
    var currentDaysAhead = 30;
    var cashFlowChart = null;
    var currencySymbol = '';

    // =========================================================================
    // Utility Functions
    // =========================================================================

    function formatCurrency(amount) {
        return currencySymbol + Number(amount).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        var d = new Date(dateStr);
        return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function getAntiForgeryToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }
    // =========================================================================
    // Period Selector
    // =========================================================================

    function selectPeriod(days, btn) {
        currentDaysAhead = days;
        document.querySelectorAll('.period-btn').forEach(function (b) { b.classList.remove('active'); });
        document.querySelectorAll('.period-btn').forEach(function (b) {
            if (b.textContent.trim() === days + ' days') b.classList.add('active');
        });
        loadProjection(days);
    }

    // =========================================================================
    // Toggle Invoice Exclusion
    // =========================================================================

    function toggleInvoiceExclusion(invoiceId) {
        if (excludedInvoiceIds.has(invoiceId)) {
            excludedInvoiceIds.delete(invoiceId);
        } else {
            excludedInvoiceIds.add(invoiceId);
        }
        loadProjection(currentDaysAhead);
    }
    // =========================================================================
    // Load Projection
    // =========================================================================

    async function loadProjection(daysAhead) {
        BlockUI.show('Loading projection...');
        try {
            var params = new URLSearchParams({ daysAhead: daysAhead });
            if (excludedInvoiceIds.size > 0) {
                params.append('excludedInvoiceIds', Array.from(excludedInvoiceIds).join(','));
            }

            var response = await fetch('/CashFlow/AxGetProjection?' + params.toString());
            var result = await response.json();
            BlockUI.hide();

            if (result.success) {
                var data = result.data;
                currencySymbol = '';
                renderHero(data);
                renderKpi(data);
                renderFlow(data);
                renderChart(data);
                renderInflows(data);
                renderOutflows(data);
            } else {
                Swal.fire({ title: 'Error', text: result.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        } catch (e) {
            BlockUI.hide();
            Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
        }
    }
    // =========================================================================
    // Render Hero Card
    // =========================================================================

    function renderHero(data) {
        var heroCard = document.getElementById('heroCard');
        var hasWarning = data.alertBreachDate != null;
        var projectedBalance = data.projectedBalance;
        var startingBalance = data.startingBalance;
        var alertThreshold = data.alertThreshold;

        var heroClass = hasWarning ? 'hero-card hero-warning' : 'hero-card hero-healthy';
        var iconSvg = hasWarning
            ? '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8912E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>'
            : '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#129867" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';

        var headline = '';
        var body = '';

        if (hasWarning) {
            var breachDate = formatDate(data.alertBreachDate);
            headline = 'Cash may run tight around ' + breachDate;
            body = '<p class="hero-body">You have <span class="hero-amount">' + formatCurrency(startingBalance) + '</span> today.</p>'
                + '<p class="hero-body">Your balance could drop below your <strong>' + formatCurrency(alertThreshold) + ' safety net</strong>.</p>';
        } else {
            headline = 'Your cash position looks healthy';
            body = '<p class="hero-body">You have <span class="hero-amount">' + formatCurrency(startingBalance) + '</span> today.</p>'
                + '<p class="hero-body">In ' + currentDaysAhead + ' days, you\'ll have around <span class="hero-amount">' + formatCurrency(projectedBalance) + '</span>.</p>';
        }

        heroCard.className = heroClass;
        heroCard.innerHTML = '<div class="hero-icon">' + iconSvg + '</div>'
            + '<div class="hero-content">'
            + '<h2 class="hero-headline">' + headline + '</h2>'
            + body
            + '<div class="period-selector">'
            + '<button class="period-btn' + (currentDaysAhead === 30 ? ' active' : '') + '" onclick="selectPeriod(30, this)">30 days</button>'
            + '<button class="period-btn' + (currentDaysAhead === 60 ? ' active' : '') + '" onclick="selectPeriod(60, this)">60 days</button>'
            + '<button class="period-btn' + (currentDaysAhead === 90 ? ' active' : '') + '" onclick="selectPeriod(90, this)">90 days</button>'
            + '</div></div>';
    }
    // =========================================================================
    // Render KPI Strip
    // =========================================================================

    function renderKpi(data) {
        document.getElementById('kpiStartingBalance').textContent = formatCurrency(data.startingBalance);
        document.getElementById('kpiInflows').textContent = formatCurrency(data.totalInflows);
        document.getElementById('kpiOutflows').textContent = formatCurrency(data.totalOutflows);
        document.getElementById('kpiProjectedBalance').textContent = formatCurrency(data.projectedBalance);
    }

    // =========================================================================
    // Render Flow Visualization
    // =========================================================================

    function renderFlow(data) {
        var inflowCount = data.inflows ? data.inflows.length : 0;
        document.getElementById('flowInAmount').textContent = formatCurrency(data.totalInflows);
        document.getElementById('flowInDesc').textContent = 'from ' + inflowCount + ' invoice' + (inflowCount !== 1 ? 's' : '');
        document.getElementById('flowOutAmount').textContent = formatCurrency(data.totalOutflows);

        var net = data.totalInflows - data.totalOutflows;
        var flowNetEl = document.getElementById('flowNet');
        if (net >= 0) {
            flowNetEl.className = 'flow-net positive';
            flowNetEl.textContent = 'Net: +' + formatCurrency(net) + ' more coming in than going out';
        } else {
            flowNetEl.className = 'flow-net negative';
            flowNetEl.textContent = 'Net: -' + formatCurrency(Math.abs(net)) + ' more going out than coming in';
        }
    }
    // =========================================================================
    // Render Chart
    // =========================================================================

    function renderChart(data) {
        var ctx = document.getElementById('cashFlowChart').getContext('2d');
        var dailyBalances = data.dailyBalances || [];
        var labels = dailyBalances.map(function (d) { return d.date; });
        var balances = dailyBalances.map(function (d) { return d.balance; });
        var alertThreshold = data.alertThreshold || 0;

        if (cashFlowChart) {
            cashFlowChart.destroy();
        }

        var annotations = {};
        if (alertThreshold > 0) {
            annotations.thresholdLine = {
                type: 'line',
                yMin: alertThreshold,
                yMax: alertThreshold,
                borderColor: '#C8912E',
                borderWidth: 2,
                borderDash: [6, 4],
                label: {
                    display: true,
                    content: 'Safety Net: ' + formatCurrency(alertThreshold),
                    position: 'end',
                    font: { size: 11, weight: '600' },
                    color: '#C8912E'
                }
            };
            annotations.dangerZone = {
                type: 'box',
                yMin: 0,
                yMax: alertThreshold,
                backgroundColor: 'rgba(194, 74, 74, 0.06)',
                borderWidth: 0
            };
        }

        cashFlowChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Projected Balance',
                    data: balances,
                    borderColor: '#0D5EA6',
                    backgroundColor: 'rgba(13, 94, 166, 0.05)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 0,
                    pointHoverRadius: 6,
                    borderWidth: 2.5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    annotation: { annotations: annotations }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            maxTicksLimit: 8,
                            font: { size: 11 },
                            color: '#5E7385'
                        }
                    },
                    y: {
                        beginAtZero: false,
                        ticks: {
                            callback: function (val) { return formatCurrency(val); },
                            font: { size: 11 },
                            color: '#5E7385'
                        },
                        grid: { color: 'rgba(226, 235, 243, 0.6)' }
                    }
                }
            }
        });
    }
    // =========================================================================
    // Render Inflows Table
    // =========================================================================

    function renderInflows(data) {
        var tbody = document.getElementById('inflowTableBody');
        var inflows = data.inflows || [];

        if (inflows.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#5E7385;padding:24px;">No outstanding invoices within this period.</td></tr>';
            document.getElementById('inflowSummary').innerHTML = '';
            return;
        }

        var html = '';
        var totalIncluded = 0;
        var excludedCount = 0;

        for (var i = 0; i < inflows.length; i++) {
            var item = inflows[i];
            var isExcluded = excludedInvoiceIds.has(item.invoiceId);
            var rowClass = isExcluded ? ' class="excluded"' : '';
            var toggleClass = isExcluded ? 'toggle-switch off' : 'toggle-switch';

            if (!isExcluded) {
                totalIncluded += item.outstandingAmount;
            } else {
                excludedCount++;
            }

            var paysBadge = item.daysLateAverage === 0
                ? '<span class="pays-badge ontime">on time</span>'
                : '<span class="pays-badge late">' + item.daysLateAverage + ' days late</span>';

            html += '<tr' + rowClass + '>'
                + '<td><strong>' + escapeHtml(item.customerName) + '</strong>'
                + (isExcluded ? '<span class="excluded-label">What if they don\'t pay?</span>' : '')
                + '</td>'
                + '<td>' + formatCurrency(item.outstandingAmount) + '</td>'
                + '<td>' + formatDate(item.originalDueDate) + '</td>'
                + '<td>' + formatDate(item.adjustedDueDate) + '</td>'
                + '<td>' + paysBadge + '</td>'
                + '<td><span class="' + toggleClass + '" onclick="toggleInvoiceExclusion(' + item.invoiceId + ')"></span></td>'
                + '</tr>';
        }

        tbody.innerHTML = html;

        var summaryText = 'You\'re expecting <strong>' + formatCurrency(totalIncluded) + '</strong> in the next ' + currentDaysAhead + ' days';
        if (excludedCount > 0) {
            summaryText += ' (you\'ve excluded ' + excludedCount + ' invoice' + (excludedCount > 1 ? 's' : '') + ' to see what happens)';
        }
        summaryText += '.';
        document.getElementById('inflowSummary').innerHTML = summaryText;
    }
    // =========================================================================
    // Render Outflows Table
    // =========================================================================

    function renderOutflows(data) {
        var tbody = document.getElementById('outflowTableBody');
        var outflows = data.outflows || [];

        if (outflows.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:#5E7385;padding:24px;">No expense data available yet.</td></tr>';
            document.getElementById('outflowSummary').innerHTML = '';
            return;
        }

        var html = '';
        var totalMonthly = 0;

        for (var i = 0; i < outflows.length; i++) {
            var item = outflows[i];
            totalMonthly += item.averageMonthlyAmount;
            html += '<tr>'
                + '<td><strong>' + escapeHtml(item.categoryName) + '</strong></td>'
                + '<td>' + formatCurrency(item.averageMonthlyAmount) + '</td>'
                + '<td>' + item.monthsOfData + ' months of data</td>'
                + '</tr>';
        }

        tbody.innerHTML = html;

        var dailyAvg = totalMonthly / 30;
        document.getElementById('outflowSummary').innerHTML =
            'Your typical monthly expenses total around <strong>' + formatCurrency(totalMonthly) + '</strong> — that\'s roughly <strong>' + formatCurrency(dailyAvg) + '/day</strong>.';
    }
    // =========================================================================
    // Load Settings
    // =========================================================================

    async function loadSettings() {
        try {
            var response = await fetch('/CashFlow/AxGetSettings');
            var result = await response.json();

            if (result.success && result.data) {
                document.getElementById('settingsStartingBalance').value = result.data.startingBalance || 0;
                document.getElementById('settingsAlertThreshold').value = result.data.alertThreshold || 0;
                if (result.data.updatedAtUtc) {
                    document.getElementById('settingsLastUpdated').textContent = 'Last updated: ' + formatDate(result.data.updatedAtUtc);
                }
            }
        } catch (e) {
            // Settings load failed silently — defaults shown
        }
    }

    // =========================================================================
    // Save Settings
    // =========================================================================

    async function saveSettings() {
        var startingBalance = parseFloat(document.getElementById('settingsStartingBalance').value);
        var alertThreshold = parseFloat(document.getElementById('settingsAlertThreshold').value);

        if (isNaN(startingBalance) || startingBalance < 0) {
            Swal.fire({ title: 'Validation', text: 'Starting balance must be a non-negative number.', icon: 'warning', confirmButtonColor: '#0D5EA6' });
            return;
        }
        if (isNaN(alertThreshold) || alertThreshold < 0) {
            Swal.fire({ title: 'Validation', text: 'Alert threshold must be a non-negative number.', icon: 'warning', confirmButtonColor: '#0D5EA6' });
            return;
        }

        BlockUI.show('Saving settings...');
        try {
            var formData = new FormData();
            formData.append('startingBalance', startingBalance);
            formData.append('alertThreshold', alertThreshold);

            var response = await fetch('/CashFlow/AxPostSaveSettings', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: formData
            });
            var result = await response.json();
            BlockUI.hide();

            if (result.success) {
                Swal.fire({ title: 'Saved', text: result.message, icon: 'success', confirmButtonColor: '#0D5EA6' });
                document.getElementById('settingsLastUpdated').textContent = 'Last updated: just now';
                loadProjection(currentDaysAhead);
            } else {
                Swal.fire({ title: 'Error', text: result.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        } catch (e) {
            BlockUI.hide();
            Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
        }
    }

    // =========================================================================
    // KPI Info Modals
    // =========================================================================

    function showKpiInfo(type) {
        var titles = {
            starting: 'Starting Balance',
            inflows: 'Projected Inflows',
            outflows: 'Projected Outflows',
            balance: 'Projected Balance'
        };

        var descriptions = {
            starting: 'This is the current bank balance you entered in the settings section below. It\'s the starting point for all projections — everything is calculated forward from this number.<br><br>Keep it updated whenever you check your actual bank balance to ensure projections stay accurate.',
            inflows: 'This is the total money you expect to receive from outstanding invoices within the selected time period.<br><br>It includes all unpaid, partially paid, and overdue invoices. Each invoice is positioned at its <strong>expected payment date</strong>, which is adjusted based on how quickly that customer typically pays.',
            outflows: 'This is your estimated spending for the selected period, calculated from your average monthly expenses over the last 6 months.<br><br>It\'s based on your actual purchase history grouped by expense category. Only categories with at least 2 months of data are included to avoid unreliable estimates.',
            balance: 'This is where your bank balance is projected to be at the end of the selected period.<br><br><strong>Formula:</strong> Starting Balance + Inflows − Outflows<br><br>If this number is below your safety net threshold, the chart will show a warning zone.'
        };

        Swal.fire({
            title: titles[type],
            html: '<div style="text-align:left;font-size:14px;color:#3D4F5F;line-height:1.7;">' + descriptions[type] + '</div>',
            icon: 'info',
            confirmButtonColor: '#0D5EA6',
            confirmButtonText: 'Got it'
        });
    }

    // =========================================================================
    // Init
    // =========================================================================

    document.addEventListener('DOMContentLoaded', function () {
        loadProjection(30);
        loadSettings();
    });
</script>
}
