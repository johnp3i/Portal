@model Portal.Web.Models.Stripe.BillingInvoicePdfModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice @Model.InvoiceNumber</title>
    <style>
        :root {
            --blue: #0D5EA6;
            --cyan: #57B8E8;
            --text: #1A2B3C;
            --muted: #6B7F8E;
            --bg: #F7FAFC;
            --border: rgba(13,94,166,.08);
            --success: #129867;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        @@page { size: A4; margin: 20mm 18mm; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background: #fff;
            font-size: 12px;
            line-height: 1.5;
            padding: 0;
        }
        .page {
            max-width: 100%;
            margin: 0 auto;
            padding: 32px 40px;
        }
        h1 {
            font-family: 'Manrope', sans-serif;
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--blue);
        }
        .invoice-number-header {
            font-family: 'Manrope', sans-serif;
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            margin-top: 4px;
            letter-spacing: 0.02em;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 20px;
            margin-bottom: 28px;
            border-bottom: 2px solid var(--blue);
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .header-left img {
            max-height: 48px;
            max-width: 150px;
        }
        .header-right {
            text-align: right;
            font-size: 11px;
            line-height: 1.6;
            color: var(--muted);
        }
        .company-name {
            font-weight: 700;
            font-size: 14px;
            color: var(--text);
            margin-bottom: 2px;
        }

        /* Parties Section */
        .parties {
            display: flex;
            justify-content: space-between;
            margin-bottom: 28px;
        }
        .party-block {
            max-width: 48%;
        }
        .party-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            margin-bottom: 6px;
        }
        .party-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 3px;
        }
        .party-detail {
            font-size: 11px;
            color: var(--muted);
            line-height: 1.6;
        }

        /* Invoice Meta */
        .invoice-meta {
            display: flex;
            gap: 32px;
            margin-bottom: 28px;
            padding: 14px 18px;
            background: var(--bg);
            border-radius: 10px;
            border: 1px solid var(--border);
        }
        .meta-item .meta-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            margin-bottom: 3px;
        }
        .meta-item .meta-value {
            font-size: 12px;
            font-weight: 600;
            color: var(--text);
        }

        /* Line Items Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
        }
        th {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            padding: 10px 12px;
            border-bottom: 2px solid var(--border);
            text-align: left;
        }
        th.right { text-align: right; }
        td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
            font-size: 12px;
        }
        td.right { text-align: right; }

        /* Totals */
        .totals {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 28px;
        }
        .totals-table {
            width: 280px;
        }
        .totals-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 12px;
            border-bottom: 1px solid var(--border);
        }
        .totals-row .totals-label {
            color: var(--muted);
            font-weight: 600;
        }
        .totals-row .totals-value {
            font-weight: 600;
        }
        .totals-row.total-final {
            border-bottom: none;
            border-top: 2px solid var(--blue);
            padding-top: 10px;
            margin-top: 4px;
        }
        .totals-row.total-final .totals-label {
            font-size: 14px;
            font-weight: 800;
            color: var(--text);
            font-family: 'Manrope', sans-serif;
        }
        .totals-row.total-final .totals-value {
            font-size: 14px;
            font-weight: 800;
            color: var(--blue);
            font-family: 'Manrope', sans-serif;
        }

        /* Reverse Charge Notice */
        .reverse-charge-notice {
            margin-bottom: 24px;
            padding: 12px 18px;
            background: #FFF8E6;
            border: 1px solid #F5DFA0;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            color: #7A5C00;
        }

        /* Payment Info */
        .payment-info {
            padding: 14px 18px;
            background: var(--bg);
            border-radius: 10px;
            border: 1px solid var(--border);
            margin-bottom: 28px;
        }
        .payment-info-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            margin-bottom: 8px;
        }
        .payment-info-row {
            display: flex;
            gap: 32px;
            font-size: 12px;
        }
        .payment-info-item .pi-label {
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 2px;
        }
        .payment-info-item .pi-value {
            font-weight: 600;
            color: var(--text);
        }
        .status-paid {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            background: #E6F7F0;
            color: var(--success);
        }

        /* Footer */
        .footer {
            margin-top: 32px;
            padding-top: 12px;
            border-top: 1px solid var(--border);
            font-size: 10px;
            color: var(--muted);
            text-align: center;
        }
        .footer-powered {
            margin-top: 8px;
            font-size: 9px;
            color: #b0bec5;
            text-align: center;
            letter-spacing: 0.03em;
        }

        @@media print {
            body { padding: 0; }
            .page { padding: 0; }
        }
    </style>
</head>
<body>
<div class="page">

    <!-- Company Header with Invoice Number -->
    <div class="header">
        <div class="header-left">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogoUrl))
            {
                <img src="@Model.CompanyLogoUrl" alt="@Model.CompanyName" />
            }
            <div>
                <h1>INVOICE</h1>
                <div class="invoice-number-header">@Model.InvoiceNumber</div>
            </div>
        </div>
        <div class="header-right">
            <div class="company-name">@Model.CompanyName</div>
            <div>@Model.CompanyAddress</div>
            <div>@Model.CompanyCountryCode</div>
            <div>VAT: @Model.CompanyVatNumber</div>
            <div>@Model.CompanyEmail</div>
        </div>
    </div>

    <!-- From / To Parties -->
    <div class="parties">
        <div class="party-block">
            <div class="party-label">From (Issuer)</div>
            <div class="party-name">@Model.CompanyName</div>
            <div class="party-detail">@Model.CompanyAddress</div>
            <div class="party-detail">@Model.CompanyCountryCode</div>
            <div class="party-detail">VAT: @Model.CompanyVatNumber</div>
            <div class="party-detail">@Model.CompanyEmail</div>
        </div>
        <div class="party-block" style="text-align:right;">
            <div class="party-label">Bill To (Subscriber)</div>
            <div class="party-name">@Model.BusinessName</div>
            @{
                var subscriberVat = Model.SubscriberVatNumber ?? Model.VatNumber;
            }
            @if (!string.IsNullOrWhiteSpace(subscriberVat))
            {
                <div class="party-detail">VAT: @subscriberVat</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.AddressLine1))
            {
                <div class="party-detail">@Model.AddressLine1</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
            {
                <div class="party-detail">@Model.AddressLine2</div>
            }
            @{
                var cityPostal = new List<string>();
                if (!string.IsNullOrWhiteSpace(Model.City)) { cityPostal.Add(Model.City); }
                if (!string.IsNullOrWhiteSpace(Model.PostalCode)) { cityPostal.Add(Model.PostalCode); }
            }
            @if (cityPostal.Any())
            {
                <div class="party-detail">@string.Join(", ", cityPostal)</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Country))
            {
                <div class="party-detail">@Model.Country</div>
            }
        </div>
    </div>

    <!-- Invoice Meta -->
    <div class="invoice-meta">
        <div class="meta-item">
            <div class="meta-label">Invoice Number</div>
            <div class="meta-value">@Model.InvoiceNumber</div>
        </div>
        <div class="meta-item">
            <div class="meta-label">Invoice Date</div>
            <div class="meta-value">@Model.InvoiceDate.ToString("dd MMM yyyy")</div>
        </div>
        <div class="meta-item">
            <div class="meta-label">Period Covered</div>
            <div class="meta-value">@Model.PeriodStart.ToString("dd MMM yyyy") — @Model.PeriodEnd.ToString("dd MMM yyyy")</div>
        </div>
        <div class="meta-item">
            <div class="meta-label">Status</div>
            <div class="meta-value">
                @if (Model.IsPartiallyPaid)
                {
                    <span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;background:#FFF8E6;color:#7A5C00;">Partially Paid</span>
                }
                else
                {
                    <span class="status-paid">Paid</span>
                }
            </div>
        </div>
    </div>

    <!-- Line Items -->
    <table>
        <thead>
            <tr>
                <th>Description</th>
                <th class="right" style="width:80px;">Qty</th>
                <th class="right" style="width:120px;">Unit Price</th>
                <th class="right" style="width:120px;">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.LineItems)
            {
                <tr>
                    <td>@item.Description</td>
                    <td class="right">@item.Quantity</td>
                    <td class="right">€@item.UnitPrice.ToString("F2")</td>
                    <td class="right">€@item.Total.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Totals -->
    <div class="totals">
        <div class="totals-table">
            <div class="totals-row">
                <span class="totals-label">Subtotal</span>
                <span class="totals-value">€@Model.Subtotal.ToString("F2")</span>
            </div>
            <div class="totals-row">
                <span class="totals-label">VAT (@Model.VatRate.ToString("0")%)</span>
                <span class="totals-value">€@Model.VatAmount.ToString("F2")</span>
            </div>
            <div class="totals-row total-final">
                <span class="totals-label">Total</span>
                <span class="totals-value">€@Model.Total.ToString("F2")</span>
            </div>
        </div>
    </div>

    <!-- Reverse Charge Notation -->
    @if (Model.IsReverseCharge && !string.IsNullOrWhiteSpace(Model.ReverseChargeNotation))
    {
        <div class="reverse-charge-notice">
            @Model.ReverseChargeNotation
        </div>
    }

    <!-- Payment Information -->
    @if (Model.Payments.Any())
    {
        <div class="payment-info">
            <div class="payment-info-title">Payment Information @(Model.Payments.Count > 1 ? $"({Model.Payments.Count} payments)" : "")</div>

            @if (Model.IsPartiallyPaid)
            {
                <div style="padding:6px 12px;background:#FFF8E6;border:1px solid #F5DFA0;border-radius:6px;font-size:11px;font-weight:600;color:#7A5C00;margin-bottom:10px;">
                    Status: Partially Paid — €@Model.AmountPaid.ToString("F2") of €@Model.Total.ToString("F2") received. Outstanding: €@Model.Outstanding.ToString("F2")
                </div>
            }

            @foreach (var p in Model.Payments)
            {
                var methodDisplay = p.Method switch
                {
                    "stripe" => "Stripe",
                    "bank_transfer" => "Bank Transfer",
                    "cheque" => "Cheque",
                    "cash" => "Cash",
                    _ => p.Method
                };
                <div class="payment-info-row" style="margin-bottom:6px;">
                    <div class="payment-info-item">
                        <div class="pi-label">Amount</div>
                        <div class="pi-value">€@p.Amount.ToString("F2")</div>
                    </div>
                    <div class="payment-info-item">
                        <div class="pi-label">Method</div>
                        <div class="pi-value">@methodDisplay</div>
                    </div>
                    <div class="payment-info-item">
                        <div class="pi-label">Date</div>
                        <div class="pi-value">@p.PaidAtUtc.ToString("dd MMM yyyy")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Reference))
                    {
                        <div class="payment-info-item">
                            <div class="pi-label">Reference</div>
                            <div class="pi-value">@p.Reference</div>
                        </div>
                    }
                </div>
            }

            @if (Model.Payments.Count > 1)
            {
                <div style="margin-top:8px;padding-top:6px;border-top:1.5px solid rgba(13,94,166,.08);display:flex;justify-content:space-between;font-weight:700;font-size:12px;">
                    <span>Total Paid</span>
                    <span style="color:var(--success);">€@Model.AmountPaid.ToString("F2")</span>
                </div>
            }
        </div>
    }
    else if (Model.PaymentDate.HasValue || !string.IsNullOrWhiteSpace(Model.PaymentMethod))
    {
        <!-- Fallback for legacy single-payment display -->
        <div class="payment-info">
            <div class="payment-info-title">Payment Information</div>
            <div class="payment-info-row">
                @if (!string.IsNullOrWhiteSpace(Model.PaymentMethod))
                {
                    <div class="payment-info-item">
                        <div class="pi-label">Payment Method</div>
                        <div class="pi-value">@Model.PaymentMethod</div>
                    </div>
                }
                @if (Model.PaymentDate.HasValue)
                {
                    <div class="payment-info-item">
                        <div class="pi-label">Payment Date</div>
                        <div class="pi-value">@Model.PaymentDate.Value.ToString("dd MMM yyyy")</div>
                    </div>
                }
                <div class="payment-info-item">
                    <div class="pi-label">Amount Paid</div>
                    <div class="pi-value">€@Model.Total.ToString("F2")</div>
                </div>
            </div>
        </div>
    }

    <!-- Footer -->
    <div class="footer">
        Invoice generated on @DateTime.UtcNow.ToString("dd MMM yyyy") | @Model.CompanyName
    </div>
    <div class="footer-powered">
        Powered by 3 Inventors — Operational Intelligence
    </div>

</div>
</body>
</html>
