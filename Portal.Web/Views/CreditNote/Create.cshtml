@using Portal.Infrastructure.Models
@using Portal.Infrastructure.Entities
@{
    ViewData["Title"] = "Create Credit Note";
    var eligibleInvoices = ViewBag.EligibleInvoices as List<EligibleInvoiceDto> ?? new List<EligibleInvoiceDto>();
    var vatPeriods = ViewBag.VatPeriods as List<VatSubmissionPeriod> ?? new List<VatSubmissionPeriod>();
    var defaultVatPeriodId = ViewBag.DefaultVatPeriodId as int?;
    var accountCreditEnabled = ViewBag.AccountCreditEnabled as bool? ?? false;
    var customers = ViewBag.Customers as List<Customer> ?? new List<Customer>();
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Credit Notes</div>
        <h1 class="topbar-heading">Create Credit Note</h1>
        <p class="topbar-subtitle">Issue a credit note against an existing invoice, or directly to a customer's account.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom:18px;">
            @TempData["Error"]
        </div>
    }

    <form method="post" asp-action="Create" asp-controller="CreditNote" asp-antiforgery="true" id="creditNoteForm">
        @if (accountCreditEnabled)
        {
            <!-- Mode switch: invoice-linked vs account-level credit note -->
            <div id="modeSwitch" style="display:inline-flex;background:var(--bg2);border:1px solid rgba(13,94,166,.10);border-radius:14px;padding:4px;margin-bottom:22px;gap:4px;">
                <button type="button" class="mode-opt active" id="modeInvoiceBtn" onclick="setCreditMode('invoice')"
                        style="padding:9px 18px;border-radius:10px;font-weight:700;font-size:13px;cursor:pointer;border:none;background:#fff;color:#0D5EA6;box-shadow:0 1px 4px rgba(13,94,166,.12);">
                    Against an invoice
                </button>
                <button type="button" class="mode-opt" id="modeAccountBtn" onclick="setCreditMode('account')"
                        style="padding:9px 18px;border-radius:10px;font-weight:700;font-size:13px;cursor:pointer;border:none;background:transparent;color:#5E7385;">
                    To customer account
                </button>
            </div>
        }

        <!-- Credit Note Header -->
        <div class="form-grid">
            <div class="field" id="invoiceField" style="position:relative;">
                <label for="invoiceSearch">Source Invoice *</label>
                <input type="text" id="invoiceSearch" placeholder="Search by invoice number or customer..." autocomplete="off"
                       style="width:100%;" />
                <div id="invoiceDropdown" style="display:none;position:absolute;top:100%;left:0;right:0;z-index:100;max-height:280px;overflow-y:auto;background:#fff;border:1px solid rgba(13,94,166,.15);border-radius:12px;box-shadow:0 8px 24px rgba(13,94,166,.12);margin-top:4px;">
                </div>
                <select name="invoiceId" id="invoiceId" style="display:none;">
                    <option value="">-- Select Invoice --</option>
                    @foreach (var invoice in eligibleInvoices)
                    {
                        <option value="@invoice.Id"
                                data-customer-name="@invoice.CustomerName"
                                data-customer-id="@invoice.CustomerId"
                                data-outstanding="@invoice.OutstandingBalance"
                                data-total-amount="@invoice.TotalAmount">
                            @invoice.InvoiceNumber — @invoice.CustomerName
                        </option>
                    }
                </select>
            </div>

            @if (accountCreditEnabled)
            {
                <!-- Account mode: direct customer picker (hidden until account mode selected) -->
                <div class="field" id="customerPickField" style="display:none;">
                    <label for="customerId">Customer *</label>
                    <select name="customerId" id="customerId">
                        <option value="">-- Select customer --</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="field">
                <label for="customerName">Customer</label>
                <input type="text" id="customerName" readonly placeholder="Selected automatically" style="background:#f0f4f8;cursor:not-allowed;" />
            </div>
            <div class="field">
                <label for="issueDate">Issue Date *</label>
                <input type="date" name="issueDate" id="issueDate" required />
            </div>
            <div class="field">
                <label for="vatSubmissionPeriodId">VAT Period *</label>
                <select name="vatSubmissionPeriodId" id="vatSubmissionPeriodId" required>
                    <option value="">-- Select VAT Period --</option>
                    @foreach (var period in vatPeriods)
                    {
                        if (period.Id == defaultVatPeriodId)
                        {
                            <option value="@period.Id" selected>
                                @period.PeriodLabel (@period.PeriodStartDate.ToString("dd MMM yyyy") – @period.PeriodEndDate.ToString("dd MMM yyyy"))
                            </option>
                        }
                        else
                        {
                            <option value="@period.Id">
                                @period.PeriodLabel (@period.PeriodStartDate.ToString("dd MMM yyyy") – @period.PeriodEndDate.ToString("dd MMM yyyy"))
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="field" style="grid-column:1 / -1;">
                <label for="reason">Reason *</label>
                <textarea name="reason" id="reason" required maxlength="1000" placeholder="Explain why this credit note is being issued (max 1000 characters)" rows="3"></textarea>
                <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;align-items:center;">
                    <span style="font-size:12px;color:#5a6a7a;">Quick fill:</span>
                    <button type="button" class="reason-chip" onclick="fillReason('Overcharge on original invoice.')">Overcharge</button>
                    <button type="button" class="reason-chip" onclick="fillReason('Goods returned by customer.')">Returned goods</button>
                    <button type="button" class="reason-chip" onclick="fillReason('Post-invoice discount agreed with customer.')">Post-invoice discount</button>
                    <button type="button" class="reason-chip" onclick="fillReason('Goodwill credit.')">Goodwill credit</button>
                    <button type="button" class="reason-chip" onclick="fillReason('Deposit / retainer credit.')">Deposit / retainer</button>
                </div>
                <small id="reasonCharCount" style="color:#5a6a7a;font-size:12px;">0 / 1000 characters</small>
            </div>
        </div>

        <!-- Invoice Amount & Outstanding Balance Display -->
        <div id="balanceDisplay" style="display:none;margin-top:18px;padding:14px 18px;border-radius:12px;background:rgba(18,152,103,.06);border:1px solid rgba(18,152,103,.15);">
            <div style="display:flex;gap:24px;flex-wrap:wrap;">
                <div>
                    <span style="font-weight:600;color:#0D5EA6;">Invoice Amount:</span>
                    <span id="invoiceAmountValue" style="font-weight:700;font-size:16px;margin-left:8px;">@(ViewBag.CurrencySymbol)<span id="invoiceAmountNumber"></span></span>
                </div>
                <div>
                    <span style="font-weight:600;color:#129867;">Outstanding Balance:</span>
                    <span id="balanceValue" style="font-weight:700;font-size:16px;margin-left:8px;">@(ViewBag.CurrencySymbol)<span id="balanceNumber"></span></span>
                </div>
            </div>
        </div>

        <!-- Account-mode explanatory note -->
        <div id="accountNote" style="display:none;margin-top:18px;padding:14px 18px;border-radius:12px;background:rgba(87,184,232,.1);border:1px solid rgba(87,184,232,.25);font-size:13px;color:#1f6f99;">
            <strong>Account credit.</strong> No source invoice. On issue, this records a credit on the customer's account that you can apply to their outstanding invoices later. VAT is recognised now, on issue.
        </div>

        <!-- Line Items Section -->
        <div style="margin-top:32px;border-top:1px solid rgba(13,94,166,.08);padding-top:24px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div class="label">Line Items</div>
                    <h2 style="margin-top:8px;font-size:24px;">Credit note lines</h2>
                </div>
                <button type="button" class="btn btn-primary" id="addLineBtn" onclick="addLineItem()">+ Add Line</button>
            </div>

            <div id="lineItemsContainer" style="margin-top:18px;">
                <!-- Line items will be added here dynamically -->
            </div>
        </div>

        <!-- Running Totals -->
        <div style="margin-top:24px;border-top:1px solid rgba(13,94,166,.08);padding-top:20px;">
            <div style="display:flex;justify-content:flex-end;">
                <div style="min-width:280px;">
                    <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:14px;">
                        <span style="color:#5a6a7a;">Subtotal</span>
                        <span id="runningSubtotal" style="font-weight:600;">0.00</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:14px;">
                        <span style="color:#5a6a7a;">VAT Amount</span>
                        <span id="runningVat" style="font-weight:600;">0.00</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:10px 0;font-size:16px;border-top:2px solid rgba(13,94,166,.12);margin-top:4px;">
                        <span style="font-weight:700;">Total</span>
                        <span id="runningTotal" style="font-weight:700;color:#C24A4A;">0.00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit -->
        <div style="margin-top:32px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary" id="submitBtn">Create Credit Note</button>
            <a asp-action="Index" asp-controller="CreditNote" class="btn btn-outline">&larr; Back to Credit Notes</a>
        </div>
    </form>
</section>

@section Scripts {
    <style>
        .reason-chip {
            padding: 5px 12px; border-radius: 20px; border: 1px solid rgba(13,94,166,.10);
            background: #fff; font-size: 12px; font-weight: 600; color: #0D5EA6; cursor: pointer;
        }
        .reason-chip:hover { background: rgba(13,94,166,.06); }
    </style>
    <script>
        var lineIndex = 0;
        // 'invoice' (default) or 'account'. Account mode is only available when the capability is on.
        var creditMode = 'invoice';

        // Set today's date as default
        document.addEventListener('DOMContentLoaded', function () {
            var today = new Date().toISOString().split('T')[0];
            document.getElementById('issueDate').value = today;
            addLineItem();
            initSearchableInvoiceDropdown();
        });

        // Switch between invoice-linked and account-level modes.
        function setCreditMode(mode) {
            creditMode = mode;
            var invoice = mode === 'invoice';

            var invoiceBtn = document.getElementById('modeInvoiceBtn');
            var accountBtn = document.getElementById('modeAccountBtn');
            if (invoiceBtn && accountBtn) {
                invoiceBtn.style.background = invoice ? '#fff' : 'transparent';
                invoiceBtn.style.color = invoice ? '#0D5EA6' : '#5E7385';
                invoiceBtn.style.boxShadow = invoice ? '0 1px 4px rgba(13,94,166,.12)' : 'none';
                accountBtn.style.background = invoice ? 'transparent' : '#fff';
                accountBtn.style.color = invoice ? '#5E7385' : '#0D5EA6';
                accountBtn.style.boxShadow = invoice ? 'none' : '0 1px 4px rgba(13,94,166,.12)';
            }

            var invoiceField = document.getElementById('invoiceField');
            var customerPickField = document.getElementById('customerPickField');
            var balanceDisplay = document.getElementById('balanceDisplay');
            var accountNote = document.getElementById('accountNote');
            var customerReadout = document.getElementById('customerName');
            var invoiceHidden = document.getElementById('invoiceId');
            var customerSelect = document.getElementById('customerId');

            if (invoiceField) invoiceField.style.display = invoice ? '' : 'none';
            if (customerPickField) customerPickField.style.display = invoice ? 'none' : '';
            if (accountNote) accountNote.style.display = invoice ? 'none' : 'block';
            if (!invoice && balanceDisplay) balanceDisplay.style.display = 'none';

            // Reset the opposite mode's inputs so stale values aren't posted.
            if (invoice) {
                if (customerSelect) customerSelect.value = '';
            } else {
                if (invoiceHidden) invoiceHidden.value = '';
                var invoiceSearch = document.getElementById('invoiceSearch');
                if (invoiceSearch) invoiceSearch.value = '';
                if (customerReadout) customerReadout.value = '';
                window.selectedInvoiceTotalAmount = 0;
            }
        }

        // Account-mode customer picker → mirror into the read-only customer readout.
        (function () {
            var customerSelect = document.getElementById('customerId');
            if (customerSelect) {
                customerSelect.addEventListener('change', function () {
                    var readout = document.getElementById('customerName');
                    if (readout) readout.value = this.options[this.selectedIndex].text || '';
                });
            }
        })();

        // Reason quick-fill
        function fillReason(text) {
            var reason = document.getElementById('reason');
            reason.value = text;
            document.getElementById('reasonCharCount').textContent = text.length + ' / 1000 characters';
        }

        // Searchable invoice dropdown
        function initSearchableInvoiceDropdown() {
            var searchInput = document.getElementById('invoiceSearch');
            var dropdown = document.getElementById('invoiceDropdown');
            var hiddenSelect = document.getElementById('invoiceId');
            var options = Array.from(hiddenSelect.querySelectorAll('option')).filter(function(o) { return o.value; });

            function renderDropdown(filter) {
                var filtered = options.filter(function(o) {
                    if (!filter) return true;
                    return o.textContent.toLowerCase().indexOf(filter.toLowerCase()) !== -1;
                });

                if (filtered.length === 0) {
                    dropdown.innerHTML = '<div style="padding:12px 16px;font-size:13px;color:#5a6a7a;">No invoices found</div>';
                } else {
                    dropdown.innerHTML = filtered.map(function(o) {
                        return '<div class="invoice-search-item" data-value="' + o.value + '" style="padding:10px 16px;font-size:13px;cursor:pointer;border-bottom:1px solid rgba(13,94,166,.06);transition:background .15s;"'
                            + ' onmouseenter="this.style.background=\'rgba(13,94,166,.06)\'"'
                            + ' onmouseleave="this.style.background=\'transparent\'">'
                            + o.textContent.trim()
                            + '</div>';
                    }).join('');
                }

                dropdown.style.display = 'block';
            }

            searchInput.addEventListener('focus', function() {
                renderDropdown(searchInput.value);
            });

            searchInput.addEventListener('input', function() {
                renderDropdown(searchInput.value);
            });

            dropdown.addEventListener('click', function(e) {
                var item = e.target.closest('.invoice-search-item');
                if (!item) return;

                var value = item.getAttribute('data-value');
                hiddenSelect.value = value;
                searchInput.value = item.textContent.trim();
                dropdown.style.display = 'none';

                // Trigger the change event on the hidden select
                hiddenSelect.dispatchEvent(new Event('change'));
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#invoiceSearch') && !e.target.closest('#invoiceDropdown')) {
                    dropdown.style.display = 'none';
                }
            });

            // Allow clearing
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    dropdown.style.display = 'none';
                }
            });
        }

        // Invoice selection handler
        document.getElementById('invoiceId').addEventListener('change', function () {
            var select = this;
            var option = select.options[select.selectedIndex];
            var customerNameField = document.getElementById('customerName');
            var balanceDisplay = document.getElementById('balanceDisplay');

            if (!select.value) {
                customerNameField.value = '';
                balanceDisplay.style.display = 'none';
                window.selectedInvoiceTotalAmount = 0;
                return;
            }

            var customerName = option.getAttribute('data-customer-name');
            customerNameField.value = customerName || '';

            // Show invoice total amount from data attribute
            var totalAmount = parseFloat(option.getAttribute('data-total-amount')) || 0;
            window.selectedInvoiceTotalAmount = totalAmount;
            document.getElementById('invoiceAmountNumber').textContent = totalAmount.toFixed(2);

            // Fetch outstanding balance via AJAX
            BlockUI.show('Loading invoice details...');
            fetch('/CreditNote/GetInvoiceBalance?invoiceId=' + select.value)
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    BlockUI.hide();
                    if (data.balance !== undefined) {
                        document.getElementById('balanceNumber').textContent = parseFloat(data.balance).toFixed(2);
                        balanceDisplay.style.display = 'block';
                    }
                })
                .catch(function () {
                    BlockUI.hide();
                    balanceDisplay.style.display = 'none';
                });
        });

        // Reason character counter
        document.getElementById('reason').addEventListener('input', function () {
            document.getElementById('reasonCharCount').textContent = this.value.length + ' / 1000 characters';
        });

        // Add line item
        function addLineItem() {
            var container = document.getElementById('lineItemsContainer');
            var idx = lineIndex;
            var html = '<div class="surface card-pad" style="margin-bottom:16px;position:relative;" id="line-' + idx + '">'
                + '<button type="button" class="btn btn-danger" style="position:absolute;top:12px;right:12px;padding:4px 10px;font-size:12px;" onclick="removeLineItem(' + idx + ')">Remove</button>'
                + '<div class="form-grid">'
                + '<div class="field" style="grid-column:1 / -1;">'
                + '<label>Description *</label>'
                + '<input type="text" name="lines[' + idx + '].Description" required maxlength="250" placeholder="Line item description (max 250 chars)" oninput="recalcTotals()" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Quantity *</label>'
                + '<input type="number" name="lines[' + idx + '].Quantity" step="0.0001" min="0.0001" max="999999" required value="1" oninput="recalcTotals()" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Unit Price *</label>'
                + '<input type="number" name="lines[' + idx + '].UnitPrice" step="0.01" min="0.01" max="999999999.99" required value="0" oninput="recalcTotals()" />'
                + '</div>'
                + '<div class="field">'
                + '<label>VAT Rate (%)</label>'
                + '<input type="number" name="lines[' + idx + '].VatRate" step="0.01" min="0" max="100" value="0" oninput="recalcTotals()" />'
                + '</div>'
                + '<div class="field">'
                + '<label>Line Total</label>'
                + '<input type="text" id="lineTotal-' + idx + '" readonly style="background:#f0f4f8;cursor:not-allowed;font-weight:600;" value="0.00" />'
                + '</div>'
                + '</div>'
                + '</div>';

            container.insertAdjacentHTML('beforeend', html);
            lineIndex++;
            recalcTotals();
        }

        // Remove line item
        function removeLineItem(idx) {
            var el = document.getElementById('line-' + idx);
            if (el) el.remove();
            recalcTotals();
        }

        // Recalculate running totals
        function recalcTotals() {
            var subtotal = 0;
            var vatAmount = 0;

            var container = document.getElementById('lineItemsContainer');
            var lineCards = container.querySelectorAll('[id^="line-"]');

            lineCards.forEach(function (card) {
                var idx = card.id.replace('line-', '');
                var qty = parseFloat(card.querySelector('[name="lines[' + idx + '].Quantity"]').value) || 0;
                var price = parseFloat(card.querySelector('[name="lines[' + idx + '].UnitPrice"]').value) || 0;
                var vatRate = parseFloat(card.querySelector('[name="lines[' + idx + '].VatRate"]').value) || 0;

                var lineTotal = qty * price;
                var lineVat = lineTotal * vatRate / 100;

                subtotal += lineTotal;
                vatAmount += lineVat;

                var lineTotalField = document.getElementById('lineTotal-' + idx);
                if (lineTotalField) {
                    lineTotalField.value = lineTotal.toFixed(2);
                }
            });

            var total = subtotal + vatAmount;

            document.getElementById('runningSubtotal').textContent = subtotal.toFixed(2);
            document.getElementById('runningVat').textContent = vatAmount.toFixed(2);
            document.getElementById('runningTotal').textContent = total.toFixed(2);
        }

        // Client-side validation
        function validateForm() {
            var errors = [];
            var container = document.getElementById('lineItemsContainer');
            var lineCards = container.querySelectorAll('[id^="line-"]');

            // Check at least one line item exists
            if (lineCards.length === 0) {
                errors.push('At least one line item is required.');
            }

            // Validate each line item
            lineCards.forEach(function (card, i) {
                var idx = card.id.replace('line-', '');
                var lineNum = i + 1;
                var desc = card.querySelector('[name="lines[' + idx + '].Description"]');
                var qty = card.querySelector('[name="lines[' + idx + '].Quantity"]');
                var price = card.querySelector('[name="lines[' + idx + '].UnitPrice"]');
                var vatRate = card.querySelector('[name="lines[' + idx + '].VatRate"]');

                // Description required
                if (!desc.value || !desc.value.trim()) {
                    errors.push('Line ' + lineNum + ': Description is required.');
                }

                // Quantity range
                var qtyVal = parseFloat(qty.value);
                if (isNaN(qtyVal) || qtyVal < 0.0001 || qtyVal > 999999) {
                    errors.push('Line ' + lineNum + ': Quantity must be between 0.0001 and 999,999.');
                }

                // Unit price range
                var priceVal = parseFloat(price.value);
                if (isNaN(priceVal) || priceVal < 0.01 || priceVal > 999999999.99) {
                    errors.push('Line ' + lineNum + ': Unit price must be between 0.01 and 999,999,999.99.');
                }

                // VAT rate range
                var vatVal = parseFloat(vatRate.value);
                if (isNaN(vatVal) || vatVal < 0 || vatVal > 100) {
                    errors.push('Line ' + lineNum + ': VAT rate must be between 0 and 100.');
                }
            });

            // Validate reason
            var reason = document.getElementById('reason');
            if (!reason.value || !reason.value.trim()) {
                errors.push('A reason is required.');
            }

            if (creditMode === 'account') {
                // Account mode: a customer is required; no invoice, no invoice-total cap.
                var customerSelect = document.getElementById('customerId');
                if (!customerSelect || !customerSelect.value) {
                    errors.push('Please select a customer.');
                }
            } else {
                // Invoice mode: a source invoice is required and the credit cannot exceed it.
                var invoiceId = document.getElementById('invoiceId');
                if (!invoiceId.value) {
                    errors.push('Please select a source invoice.');
                }

                var creditTotal = parseFloat(document.getElementById('runningTotal').textContent) || 0;
                var invoiceAmount = window.selectedInvoiceTotalAmount || 0;
                if (invoiceId.value && invoiceAmount > 0 && creditTotal > invoiceAmount) {
                    errors.push('Credit note total (' + creditTotal.toFixed(2) + ') cannot exceed the invoice amount (' + invoiceAmount.toFixed(2) + ').');
                }
            }

            return errors;
        }

        // Form submission with validation
        document.getElementById('creditNoteForm').addEventListener('submit', function (e) {
            var errors = validateForm();
            if (errors.length > 0) {
                e.preventDefault();
                Swal.fire({
                    title: 'Validation',
                    html: '<ul style="text-align:left;font-size:13px;margin:0;padding-left:18px;">' + errors.map(function (err) { return '<li>' + err + '</li>'; }).join('') + '</ul>',
                    icon: 'warning',
                    confirmButtonColor: '#0D5EA6'
                });
            }
        });
    </script>
}
