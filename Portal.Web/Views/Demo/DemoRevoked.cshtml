@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Demo Link Revoked";
    ViewData["NoIndex"] = true;
}

<div style="text-align:center;">
    <div style="margin-bottom:20px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C24A4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            <line x1="12" y1="15" x2="12" y2="19"></line>
        </svg>
    </div>
    <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#ffffff;margin-bottom:12px;">Demo Link Revoked</h2>
    <p style="color:rgba(255,255,255,0.75);font-size:15px;line-height:1.5;margin-bottom:28px;">
        This demo link has been revoked.
    </p>
    <a href="/"
       style="display:inline-block;padding:14px 32px;background:#0D5EA6;color:#ffffff;border-radius:12px;text-decoration:none;font-weight:700;font-size:15px;">
        Go to Home
    </a>
</div>
