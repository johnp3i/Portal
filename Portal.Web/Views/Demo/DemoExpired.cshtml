@{
    Layout = "~/Views/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Demo Link Expired";
    ViewData["NoIndex"] = true;
}

<div style="text-align:center;">
    <div style="margin-bottom:20px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C8912E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
    </div>
    <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#ffffff;margin-bottom:12px;">Demo Link Expired</h2>
    <p style="color:rgba(255,255,255,0.75);font-size:15px;line-height:1.5;margin-bottom:28px;">
        This demo link has expired.
    </p>
    <a href="/"
       style="display:inline-block;padding:14px 32px;background:#0D5EA6;color:#ffffff;border-radius:12px;text-decoration:none;font-weight:700;font-size:15px;">
        Go to Home
    </a>
</div>
