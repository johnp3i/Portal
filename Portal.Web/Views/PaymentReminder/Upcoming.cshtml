@{
    ViewData["Title"] = "Payment Reminders — Upcoming";
}

@Html.AntiForgeryToken()

<!-- Topbar -->
<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Payment Reminders</div>
        <h1 class="topbar-heading">Upcoming Reminders</h1>
        <p class="topbar-subtitle">Preview which reminders are scheduled to be sent in the coming days.</p>
        <div style="margin-top:12px;display:inline-flex;align-items:center;gap:8px;padding:8px 14px;background:#EEF4F8;border-radius:8px;">
            <svg width="16" height="16" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span style="font-size:13px;color:#3D4F5F;">Daily send time: <strong id="localScheduledTime">@ViewBag.ScheduledTimeUtc UTC</strong></span>
        </div>
    </div>
</div>

<!-- Help Section -->
<details style="margin-bottom:22px;background:#fff;border-radius:20px;box-shadow:0 2px 12px rgba(13,94,166,0.06);overflow:hidden;">
    <summary style="padding:20px 32px;cursor:pointer;font-family:'Manrope',sans-serif;font-size:15px;font-weight:700;color:#0D5EA6;list-style:none;display:flex;align-items:center;gap:10px;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        How are upcoming reminders calculated?
    </summary>
    <div style="padding:0 32px 24px;font-size:14px;color:#3D4F5F;line-height:1.8;">
        <p style="margin:0 0 12px;">This page shows a <strong>preview</strong> of which reminders will be sent in the coming days. No emails are sent from this page.</p>
        <p style="margin:0 0 12px;">Each projection is calculated using:</p>
        <div style="background:#F7FAFC;border-radius:10px;padding:16px 20px;margin-bottom:14px;font-family:monospace;font-size:13px;color:#0B1B28;">
            Trigger Date = Invoice Due Date + Tier Days Offset
        </div>
        <p style="margin:0 0 12px;">An invoice appears here when <strong>all</strong> of these conditions are met:</p>
        <ul style="margin:0 0 14px;padding-left:20px;">
            <li>Invoice is <strong>unpaid, partially paid, or overdue</strong></li>
            <li>Invoice is not deleted and not disputed</li>
            <li>Customer has an email address on file</li>
            <li>Customer has <strong>not</strong> opted out of reminders</li>
            <li>The trigger date falls within the selected preview window</li>
            <li>No partial payment received within the suppression window</li>
            <li>Max reminders for that tier haven't been reached</li>
            <li>Min interval since the last same-tier reminder has elapsed</li>
        </ul>
        <p style="margin:0;">The background service sends these reminders automatically at <strong>06:00 UTC daily</strong>. You can adjust the schedule in <a href="/PaymentReminder/Settings" style="color:#0D5EA6;font-weight:600;">Settings</a>.</p>
    </div>
</details>

<!-- Filter Card -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:180px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Period</label>
            <select id="filterPeriod" style="width:100%;">
                <option value="7">Next 7 days</option>
                <option value="14" selected>Next 14 days</option>
                <option value="30">Next 30 days</option>
            </select>
        </div>
        <div class="field" style="min-width:180px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Tier</label>
            <select id="filterTier" style="width:100%;">
                <option value="All" selected>All Tiers</option>
                <option value="Friendly">Friendly</option>
                <option value="Firm">Firm</option>
                <option value="Formal">Formal</option>
            </select>
        </div>
        <div style="padding-bottom:2px;">
            <button type="button" class="btn btn-primary" onclick="loadUpcoming()">Filter</button>
            <button type="button" class="btn btn-secondary" style="margin-left:8px;" onclick="clearFilters()">Clear</button>
        </div>
    </div>
</section>

<!-- Data Table Card -->
<section class="glass card-pad">
    <table id="upcomingTable" style="width:100%;border-collapse:collapse;">
        <thead>
            <tr>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Date</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Customer</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Invoice</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Amount Due</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Tier</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Due Date</th>
            </tr>
        </thead>
        <tbody id="upcomingTableBody">
        </tbody>
    </table>

    <!-- Summary text -->
    <p id="summaryText" style="font-size:14px;color:var(--muted);margin-top:18px;display:none;"></p>

    <!-- Empty state -->
    <div id="emptyState" style="display:none;text-align:center;padding:40px 20px;">
        <p style="font-size:15px;color:var(--muted);font-style:italic;">No upcoming reminders projected.</p>
    </div>
</section>

@section Scripts {
    <script>
        (function() {
            var utcTimeStr = '@(ViewBag.ScheduledTimeUtc ?? "06:00")';
            if (!utcTimeStr || utcTimeStr.indexOf(':') === -1) utcTimeStr = '06:00';
            var parts = utcTimeStr.split(':');
            var hours = parseInt(parts[0], 10);
            var minutes = parseInt(parts[1], 10);
            if (isNaN(hours)) hours = 6;
            if (isNaN(minutes)) minutes = 0;
            var now = new Date();
            var utcDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), hours, minutes));
            var localHours = String(utcDate.getHours()).padStart(2, '0');
            var localMinutes = String(utcDate.getMinutes()).padStart(2, '0');
            var tzName = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            var el = document.getElementById('localScheduledTime');
            if (el) el.textContent = localHours + ':' + localMinutes + ' (' + tzName + ')';
        })();
    </script>
    <style>
        @@media (max-width: 768px) {
            #upcomingTable { display: block; overflow-x: auto; }
            .topbar-heading { font-size: 28px !important; }
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', loadUpcoming);

        async function loadUpcoming() {
            var daysAhead = document.getElementById('filterPeriod').value;
            var tier = document.getElementById('filterTier').value;
            var params = new URLSearchParams();
            params.append('daysAhead', daysAhead);
            if (tier && tier !== 'All') params.append('tier', tier);

            BlockUI.show('Loading upcoming reminders...');
            try {
                var response = await fetch('/PaymentReminder/AxGetUpcomingReminders?' + params.toString());
                var result = await response.json();
                BlockUI.hide();

                if (!result.success) {
                    Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#0D5EA6' });
                    return;
                }

                renderTable(result.data, daysAhead);
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load upcoming reminders.', confirmButtonColor: '#0D5EA6' });
            }
        }

        function renderTable(data, daysAhead) {
            var tbody = document.getElementById('upcomingTableBody');
            var summaryText = document.getElementById('summaryText');
            var emptyState = document.getElementById('emptyState');

            tbody.innerHTML = '';

            if (!data || data.length === 0) {
                summaryText.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            emptyState.style.display = 'none';
            summaryText.style.display = 'block';
            summaryText.textContent = data.length + ' reminder' + (data.length !== 1 ? 's' : '') + ' projected in the next ' + daysAhead + ' days';

            data.forEach(function (item) {
                var row = document.createElement('tr');
                row.innerHTML =
                    '<td style="padding:14px 12px;font-size:14px;vertical-align:middle;border-bottom:1px solid rgba(13,94,166,0.06);">' + formatDate(item.scheduledDate) + '</td>' +
                    '<td style="padding:14px 12px;font-size:14px;vertical-align:middle;border-bottom:1px solid rgba(13,94,166,0.06);">' + escapeHtml(item.customerName) + '</td>' +
                    '<td style="padding:14px 12px;font-size:14px;vertical-align:middle;border-bottom:1px solid rgba(13,94,166,0.06);">' + escapeHtml(item.invoiceNumber) + '</td>' +
                    '<td style="padding:14px 12px;font-size:14px;vertical-align:middle;border-bottom:1px solid rgba(13,94,166,0.06);">&euro;' + formatAmount(item.outstandingAmount) + '</td>' +
                    '<td style="padding:14px 12px;font-size:14px;vertical-align:middle;border-bottom:1px solid rgba(13,94,166,0.06);">' + tierBadge(item.escalationTier) + '</td>' +
                    '<td style="padding:14px 12px;font-size:14px;vertical-align:middle;border-bottom:1px solid rgba(13,94,166,0.06);">' + formatDate(item.dueDate) + '</td>';
                tbody.appendChild(row);
            });
        }

        function tierBadge(tier) {
            var colors = {
                'Friendly': { bg: 'rgba(18,152,103,0.1)', text: '#129867' },
                'Firm': { bg: 'rgba(200,145,46,0.1)', text: '#C8912E' },
                'Formal': { bg: 'rgba(194,74,74,0.1)', text: '#C24A4A' }
            };
            var c = colors[tier] || { bg: '#EEF4F8', text: '#5E7385' };
            return '<span style="display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;background:' + c.bg + ';color:' + c.text + ';">' + escapeHtml(tier) + '</span>';
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var day = String(date.getDate()).padStart(2, '0');
            var month = months[date.getMonth()];
            var year = date.getFullYear();
            return day + ' ' + month + ' ' + year;
        }

        function formatAmount(amount) {
            if (amount === null || amount === undefined) return '0.00';
            return Number(amount).toLocaleString('en-IE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function escapeHtml(str) {
            if (!str) return '';
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }

        function clearFilters() {
            document.getElementById('filterPeriod').value = '14';
            document.getElementById('filterTier').value = 'All';
            loadUpcoming();
        }
    </script>
}
