@{
    ViewData["Title"] = "Payment Reminders — History";
}

@Html.AntiForgeryToken()

<!-- Topbar -->
<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Payment Reminders</div>
        <h1 class="topbar-heading">Reminder History</h1>
        <p class="topbar-subtitle">Review all payment reminders sent across your invoices.</p>
    </div>
</div>

<!-- Help Section -->
<details style="margin-bottom:22px;background:#fff;border-radius:20px;box-shadow:0 2px 12px rgba(13,94,166,0.06);overflow:hidden;">
    <summary style="padding:20px 32px;cursor:pointer;font-family:'Manrope',sans-serif;font-size:15px;font-weight:700;color:#0D5EA6;list-style:none;display:flex;align-items:center;gap:10px;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        What does this page show?
    </summary>
    <div style="padding:0 32px 24px;font-size:14px;color:#3D4F5F;line-height:1.8;">
        <p style="margin:0 0 12px;">This page displays a <strong>complete log</strong> of all payment reminders sent by your business — both automated and manual.</p>
        <p style="margin:0 0 12px;">Each row includes:</p>
        <ul style="margin:0 0 14px;padding-left:20px;">
            <li><strong>Date</strong> — when the reminder was sent</li>
            <li><strong>Invoice</strong> — click to view the invoice detail</li>
            <li><strong>Customer</strong> — the customer name</li>
            <li><strong>Tier</strong> — Friendly, Firm, or Formal escalation level</li>
            <li><strong>Recipient</strong> — the email address it was sent to</li>
            <li><strong>Method</strong> — Auto (scheduled), Manual (you clicked send), or Test (preview send)</li>
            <li><strong>Status</strong> — whether the email was delivered successfully</li>
            <li><strong>Opened</strong> — whether the recipient opened the email (tracked via pixel)</li>
        </ul>
        <p style="margin:0;">Use the filters above the table to narrow down results by tier, status, method, date range, or customer name.</p>
    </div>
</details>

<!-- Filter Card -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:160px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Tier</label>
            <select id="filterTier" style="width:100%;">
                <option value="All" selected>All Tiers</option>
                <option value="Friendly">Friendly</option>
                <option value="Firm">Firm</option>
                <option value="Formal">Formal</option>
            </select>
        </div>
        <div class="field" style="min-width:140px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Status</label>
            <select id="filterStatus" style="width:100%;">
                <option value="All" selected>All</option>
                <option value="Sent">Sent</option>
                <option value="Failed">Failed</option>
            </select>
        </div>
        <div class="field" style="min-width:140px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Method</label>
            <select id="filterMethod" style="width:100%;">
                <option value="All" selected>All</option>
                <option value="Auto">Auto</option>
                <option value="Manual">Manual</option>
                <option value="Test">Test</option>
            </select>
        </div>
        <div class="field" style="min-width:150px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">From</label>
            <input type="date" id="filterDateFrom" style="width:100%;" />
        </div>
        <div class="field" style="min-width:150px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">To</label>
            <input type="date" id="filterDateTo" style="width:100%;" />
        </div>
        <div class="field" style="min-width:180px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Customer</label>
            <input type="text" id="filterCustomer" placeholder="Search by name..." style="width:100%;" />
        </div>
        <div style="padding-bottom:2px;">
            <button type="button" class="btn btn-primary" onclick="loadHistory(1)">Filter</button>
            <button type="button" class="btn btn-secondary" style="margin-left:8px;" onclick="clearFilters()">Clear</button>
        </div>
    </div>
</section>

<!-- Data Table Card -->
<section class="glass card-pad">
    <table id="historyTable" style="width:100%;border-collapse:collapse;">
        <thead>
            <tr>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Date</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Invoice</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Customer</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Tier</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Recipient</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Method</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Status</th>
                <th style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;padding:10px 12px;text-align:left;border-bottom:1.5px solid var(--line);">Opened</th>
            </tr>
        </thead>
        <tbody id="historyTableBody"></tbody>
    </table>

    <!-- Pagination -->
    <div id="paginationRow" style="display:none;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
        <div id="paginationInfo" style="font-size:14px;color:#5a6a7a;"></div>
        <div id="paginationControls"></div>
    </div>

    <!-- Empty state -->
    <div id="emptyState" style="display:none;text-align:center;padding:40px 20px;">
        <p style="font-size:15px;color:var(--muted);font-style:italic;">No reminders found matching your filters.</p>
    </div>
</section>

@section Scripts {
    <style>
        @@media (max-width: 768px) {
            #historyTable { display: block; overflow-x: auto; }
            .topbar-heading { font-size: 28px !important; }
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function() { loadHistory(1); });

        async function loadHistory(page) {
            var params = new URLSearchParams();
            params.append('page', page);
            params.append('pageSize', 20);

            var tier = document.getElementById('filterTier').value;
            if (tier && tier !== 'All') params.append('tier', tier);

            var status = document.getElementById('filterStatus').value;
            if (status && status !== 'All') params.append('status', status);

            var method = document.getElementById('filterMethod').value;
            if (method && method !== 'All') params.append('method', method);

            var dateFrom = document.getElementById('filterDateFrom').value;
            if (dateFrom) params.append('dateFrom', dateFrom);

            var dateTo = document.getElementById('filterDateTo').value;
            if (dateTo) params.append('dateTo', dateTo);

            var customer = document.getElementById('filterCustomer').value.trim();
            if (customer) params.append('customer', customer);

            BlockUI.show('Loading reminder history...');
            try {
                var response = await fetch('/PaymentReminder/AxGetAllReminderHistory?' + params.toString());
                var result = await response.json();
                BlockUI.hide();

                if (!result.success) {
                    Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#0D5EA6' });
                    return;
                }

                renderTable(result.data);
                renderPagination(result.totalCount, result.page, result.pageSize);
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load reminder history.', confirmButtonColor: '#0D5EA6' });
            }
        }

        function renderTable(data) {
            var tbody = document.getElementById('historyTableBody');
            var table = document.getElementById('historyTable');
            var emptyState = document.getElementById('emptyState');
            var paginationRow = document.getElementById('paginationRow');

            tbody.innerHTML = '';

            if (!data || data.length === 0) {
                table.style.display = 'none';
                paginationRow.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            table.style.display = 'table';
            emptyState.style.display = 'none';
            paginationRow.style.display = 'flex';

            data.forEach(function(item) {
                var row = document.createElement('tr');
                row.innerHTML =
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);white-space:nowrap;">' + formatDate(item.sentAtUtc) + '</td>' +
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);"><a href="/Invoice/Detail/' + item.invoiceId + '" style="color:#0D5EA6;font-weight:600;text-decoration:none;">' + escapeHtml(item.invoiceNumber) + '</a></td>' +
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);">' + escapeHtml(item.customerName) + '</td>' +
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);">' + tierBadge(item.escalationTier) + '</td>' +
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);">' + escapeHtml(item.recipientEmail) + '</td>' +
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);">' + methodBadge(item.isManualTrigger, item.isTestSend) + '</td>' +
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);">' + statusBadge(item.isSentSuccessfully) + '</td>' +
                    '<td style="padding:12px;font-size:14px;border-bottom:1px solid rgba(13,94,166,0.06);">' + openedBadge(item.isOpened, item.isSentSuccessfully) + '</td>';
                tbody.appendChild(row);
            });
        }

        function renderPagination(totalCount, page, pageSize) {
            var info = document.getElementById('paginationInfo');
            var controls = document.getElementById('paginationControls');

            var totalPages = Math.ceil(totalCount / pageSize);
            var start = (page - 1) * pageSize + 1;
            var end = Math.min(page * pageSize, totalCount);

            info.textContent = 'Showing ' + start + '\u2013' + end + ' of ' + totalCount;

            var html = '';
            if (page > 1) {
                html += '<button onclick="loadHistory(' + (page - 1) + ')" style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;border:1.5px solid #d0dbe5;background:#fff;color:#0B1B28;cursor:pointer;margin-right:4px;">&laquo; Prev</button>';
            }

            var startPage = Math.max(1, page - 2);
            var endPage = Math.min(totalPages, page + 2);

            for (var i = startPage; i <= endPage; i++) {
                if (i === page) {
                    html += '<button style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;border:none;background:#0D5EA6;color:#fff;cursor:default;margin-right:4px;">' + i + '</button>';
                } else {
                    html += '<button onclick="loadHistory(' + i + ')" style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;border:1.5px solid #d0dbe5;background:#fff;color:#0B1B28;cursor:pointer;margin-right:4px;">' + i + '</button>';
                }
            }

            if (page < totalPages) {
                html += '<button onclick="loadHistory(' + (page + 1) + ')" style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;border:1.5px solid #d0dbe5;background:#fff;color:#0B1B28;cursor:pointer;">Next &raquo;</button>';
            }

            controls.innerHTML = html;
        }

        function tierBadge(tier) {
            var colors = {
                'Friendly': { bg: 'rgba(18,152,103,0.1)', text: '#129867' },
                'Firm': { bg: 'rgba(200,145,46,0.1)', text: '#C8912E' },
                'Formal': { bg: 'rgba(194,74,74,0.1)', text: '#C24A4A' }
            };
            var c = colors[tier] || { bg: '#EEF4F8', text: '#5E7385' };
            return '<span style="display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;background:' + c.bg + ';color:' + c.text + ';">' + escapeHtml(tier) + '</span>';
        }

        function methodBadge(isManualTrigger, isTestSend) {
            if (isTestSend) return '<span style="background:#F0E6FF;color:#7C3AED;display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;">Test</span>';
            if (isManualTrigger) return '<span style="background:#E8F1FB;color:#0D5EA6;display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;">Manual</span>';
            return '<span style="background:#EEF4F8;color:#5E7385;display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;">Auto</span>';
        }

        function statusBadge(isSentSuccessfully) {
            if (isSentSuccessfully) return '<span style="background:#E6F7EF;color:#129867;display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;">Sent</span>';
            return '<span style="background:#FDEAEA;color:#C24A4A;display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;">Failed</span>';
        }

        function openedBadge(isOpened, isSentSuccessfully) {
            if (!isSentSuccessfully) return '<span style="color:#5a6a7a;font-size:13px;">&mdash;</span>';
            if (isOpened) return '<span style="background:#E6F7EF;color:#129867;display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;">Opened</span>';
            return '<span style="font-style:italic;color:#5a6a7a;font-size:12px;">Not opened</span>';
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var d = new Date(dateStr);
            var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            return String(d.getDate()).padStart(2,'0') + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
        }

        function escapeHtml(str) {
            if (!str) return '';
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }

        function clearFilters() {
            document.getElementById('filterTier').value = 'All';
            document.getElementById('filterStatus').value = 'All';
            document.getElementById('filterMethod').value = 'All';
            document.getElementById('filterDateFrom').value = '';
            document.getElementById('filterDateTo').value = '';
            document.getElementById('filterCustomer').value = '';
            loadHistory(1);
        }
    </script>
}
