@model Portal.Infrastructure.Entities.BusinessProfile
@{
    ViewData["Title"] = "My Business";
    var activeTab = ViewBag.ActiveTab as string ?? "profile";
    var logos = ViewBag.Logos as List<Portal.Infrastructure.Entities.BusinessLogo> ?? new List<Portal.Infrastructure.Entities.BusinessLogo>();
    var businessName = ViewBag.BusinessName as string ?? "Business";
    var isReadOnly = (bool)(ViewBag.IsReadOnly ?? false);
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Business Settings</div>
        <h1 class="topbar-heading">@businessName</h1>
        <p class="topbar-subtitle">Manage your business profile and branding assets.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-error">@TempData["Error"]</div>
}

<!-- Tabs -->
<div style="display:flex;gap:0;border-bottom:2px solid rgba(13,94,166,.08);margin-bottom:24px;">
    <a href="@Url.Action("Index", "MyBusiness", new { tab = "profile" })"
       style="padding:12px 24px;font-size:14px;font-weight:700;text-decoration:none;border-bottom:2px solid @(activeTab == "profile" ? "#0D5EA6" : "transparent");margin-bottom:-2px;color:@(activeTab == "profile" ? "#0D5EA6" : "#5E7385");">
        Profile
    </a>
    <a href="@Url.Action("Index", "MyBusiness", new { tab = "logos" })"
       style="padding:12px 24px;font-size:14px;font-weight:700;text-decoration:none;border-bottom:2px solid @(activeTab == "logos" ? "#0D5EA6" : "transparent");margin-bottom:-2px;color:@(activeTab == "logos" ? "#0D5EA6" : "#5E7385");">
        Logos (@logos.Count/20)
    </a>
    <a href="@Url.Action("Index", "MyBusiness", new { tab = "payment" })"
       style="padding:12px 24px;font-size:14px;font-weight:700;text-decoration:none;border-bottom:2px solid @(activeTab == "payment" ? "#0D5EA6" : "transparent");margin-bottom:-2px;color:@(activeTab == "payment" ? "#0D5EA6" : "#5E7385");">
        Payment Details
    </a>
    <a href="@Url.Action("Index", "MyBusiness", new { tab = "automation" })"
       style="padding:12px 24px;font-size:14px;font-weight:700;text-decoration:none;border-bottom:2px solid @(activeTab == "automation" ? "#0D5EA6" : "transparent");margin-bottom:-2px;color:@(activeTab == "automation" ? "#0D5EA6" : "#5E7385");">
        Automation
    </a>
</div>

@{
    var paymentDetails = ViewBag.PaymentDetails as List<Portal.Infrastructure.Entities.BusinessPaymentDetail> ?? new List<Portal.Infrastructure.Entities.BusinessPaymentDetail>();
}

@if (activeTab == "profile")
{
    <!-- PROFILE TAB -->
    <section class="glass card-pad">
        <div class="label">Business Profile</div>
        <h2 style="margin-top:8px;font-size:24px;">Company information</h2>

        <form method="post" asp-action="SaveProfile" asp-controller="MyBusiness" style="margin-top:18px;">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BusinessId" />

            <div class="form-grid">
                <div class="field" style="grid-column:1/-1;">
                    <label for="BusinessName">Business Name *</label>
                    <input type="text" id="BusinessName" name="BusinessName" value="@businessName" placeholder="Your business name" required maxlength="200" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="CompanyRegistrationNumber">Company Registration *</label>
                    <input asp-for="CompanyRegistrationNumber" placeholder="e.g. HE123456" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="VatRegistrationNumber">VAT Registration *</label>
                    <input asp-for="VatRegistrationNumber" placeholder="e.g. CY12345678X" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="VatRegistrationDate">VAT Registration Date *</label>
                    <input asp-for="VatRegistrationDate" type="date" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="VatPeriodLengthInMonths">VAT Period (months) *</label>
                    <select asp-for="VatPeriodLengthInMonths" disabled="@isReadOnly">
                        <option value="1">1 month</option>
                        <option value="2">2 months</option>
                        <option value="3">3 months (quarterly)</option>
                        <option value="4">4 months</option>
                        <option value="6">6 months</option>
                        <option value="12">12 months (annual)</option>
                    </select>
                </div>
            </div>

            <div class="form-grid" style="margin-top:18px;">
                <div class="field" style="grid-column:1 / -1;">
                    <label asp-for="AddressLine1">Address Line 1 *</label>
                    <input asp-for="AddressLine1" placeholder="Street address" disabled="@isReadOnly" />
                </div>
                <div class="field" style="grid-column:1 / -1;">
                    <label asp-for="AddressLine2">Address Line 2</label>
                    <input asp-for="AddressLine2" placeholder="Apartment, suite, etc." disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="City">City *</label>
                    <input asp-for="City" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="PostalCode">Postal Code *</label>
                    <input asp-for="PostalCode" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="Country">Country *</label>
                    <input asp-for="Country" disabled="@isReadOnly" />
                </div>
            </div>

            <div class="form-grid" style="margin-top:18px;">
                <div class="field">
                    <label asp-for="TelephoneNumber">Telephone</label>
                    <input asp-for="TelephoneNumber" placeholder="+357 ..." disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="MobileNumber">Mobile</label>
                    <input asp-for="MobileNumber" placeholder="+357 ..." disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="Email">Email *</label>
                    <input asp-for="Email" type="email" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="Website">Website</label>
                    <input asp-for="Website" type="url" placeholder="https://www.example.com" disabled="@isReadOnly" />
                </div>
                <div class="field">
                    <label asp-for="CurrencySymbol">Currency Symbol *</label>
                    <select asp-for="CurrencySymbol" disabled="@isReadOnly">
                        <option value="€">€ Euro</option>
                        <option value="$">$ Dollar</option>
                        <option value="£">£ Pound</option>
                        <option value="CHF">CHF Franc</option>
                        <option value="¥">¥ Yen</option>
                        <option value="kr">kr Krone</option>
                        <option value="zł">zł Zloty</option>
                        <option value="₹">₹ Rupee</option>
                    </select>
                </div>
            </div>

            <div style="margin-top:24px;">
                @if (!isReadOnly)
                {
                    <button type="submit" class="btn btn-primary">Save Profile</button>
                }
            </div>
        </form>
    </section>
}
else if (activeTab == "logos")
{
    <!-- LOGOS TAB -->
    <div class="grid-2">
        @if (!isReadOnly)
        {
        <section class="glass card-pad">
            <div class="label">Upload Logo</div>
            <h2 style="margin-top:8px;font-size:24px;">Add a new logo</h2>

            <form method="post" asp-action="UploadLogo" asp-controller="MyBusiness" enctype="multipart/form-data" style="margin-top:18px;">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="field">
                        <label for="displayName">Display Name *</label>
                        <input type="text" id="displayName" name="displayName" placeholder="Logo name" required />
                    </div>
                    <div class="field">
                        <label for="file">Logo File *</label>
                        <input type="file" id="file" name="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" required />
                        <small class="muted">PNG, JPG, SVG, or WebP. Max 2MB.</small>
                    </div>
                </div>
                <div style="margin-top:18px;">
                    <button type="submit" class="btn btn-primary">Upload Logo</button>
                </div>
            </form>
        </section>
        }

        <section class="glass card-pad">
            <div class="label">Your Logos</div>
            <h2 style="margin-top:8px;font-size:24px;">Uploaded logos</h2>

            <div style="margin-top:18px;display:grid;gap:14px;">
                @if (logos.Any())
                {
                    @foreach (var logo in logos)
                    {
                        <div style="display:flex;align-items:center;gap:16px;padding:12px;border:1px solid @(logo.IsPrimary ? "rgba(13,94,166,.24)" : "rgba(13,94,166,.08)");border-radius:12px;@(logo.IsPrimary ? "background:rgba(13,94,166,.03);" : "")">
                            <img src="@logo.PublicUrl" alt="@logo.DisplayName" style="max-height:48px;max-width:80px;object-fit:contain;" />
                            <div style="flex:1;">
                                <div style="font-weight:700;font-size:14px;">
                                    @logo.DisplayName
                                    @if (logo.IsPrimary)
                                    {
                                        <span style="display:inline-block;margin-left:8px;padding:2px 8px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:#0D5EA6;color:#fff;border-radius:4px;">Primary</span>
                                    }
                                </div>
                                <div class="muted" style="font-size:12px;">@logo.ContentType · @((logo.FileSizeBytes / 1024.0).ToString("N0")) KB</div>
                            </div>
                            @if (!isReadOnly)
                            {
                            <div style="display:flex;gap:6px;">
                                @if (!logo.IsPrimary)
                                {
                                    <form method="post" asp-action="SetPrimaryLogo" asp-controller="MyBusiness" asp-route-id="@logo.Id" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-secondary" style="padding:8px 12px;font-size:12px;">Set Primary</button>
                                    </form>
                                }
                                <form method="post" asp-action="DeleteLogo" asp-controller="MyBusiness" asp-route-id="@logo.Id" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary" style="padding:8px 12px;font-size:12px;color:var(--red);">Delete</button>
                                </form>
                            </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="muted" style="font-size:14px;">No logos uploaded yet.</p>
                }
            </div>
        </section>
    </div>
}
else if (activeTab == "payment")
{
    <!-- PAYMENT DETAILS TAB -->
    <div class="grid-2">
        @if (!isReadOnly)
        {
        <section class="glass card-pad">
            <div class="label">Add Payment Detail</div>
            <h2 style="margin-top:8px;font-size:24px;">New bank account</h2>

            <form method="post" asp-action="AddPaymentDetail" asp-controller="MyBusiness" style="margin-top:18px;">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="field">
                        <label for="label">Label *</label>
                        <input type="text" id="label" name="label" placeholder="e.g. Hellenic Bank" required />
                    </div>
                    <div class="field">
                        <label for="bankName">Bank Name *</label>
                        <input type="text" id="bankName" name="bankName" placeholder="e.g. Hellenic Bank" required />
                    </div>
                    <div class="field" style="grid-column:1 / -1;">
                        <label for="iban">IBAN *</label>
                        <input type="text" id="iban" name="iban" placeholder="e.g. CY45 0050 0109 0001 0901 9832 7801" required />
                    </div>
                    <div class="field">
                        <label for="swiftBic">SWIFT/BIC</label>
                        <input type="text" id="swiftBic" name="swiftBic" placeholder="e.g. VALLMTMT" maxlength="11" />
                    </div>
                    <div class="field">
                        <label for="payeeName">Payee Name *</label>
                        <input type="text" id="payeeName" name="payeeName" placeholder="e.g. 3 Inventors Limited" required />
                    </div>
                </div>
                <div style="margin-top:18px;">
                    <button type="submit" class="btn btn-primary">Add Payment Detail</button>
                </div>
            </form>
        </section>
        }

        <section class="glass card-pad">
            <div class="label">Your Payment Details</div>
            <h2 style="margin-top:8px;font-size:24px;">Bank accounts</h2>

            <div style="margin-top:18px;display:grid;gap:14px;">
                @if (paymentDetails.Any())
                {
                    @foreach (var pd in paymentDetails)
                    {
                        <div style="padding:14px;border:1px solid rgba(13,94,166,.08);border-radius:12px;margin-bottom:14px;">
                            <div id="pd-display-@pd.Id" style="display:flex;align-items:center;gap:16px;">
                                <div style="flex:1;">
                                    <div style="font-weight:700;font-size:14px;">@pd.Label</div>
                                    <div class="muted" style="font-size:13px;">@pd.BankName</div>
                                    <div style="font-size:12px;font-family:monospace;margin-top:4px;">@pd.Iban</div>
                                    @if (!string.IsNullOrEmpty(pd.SwiftBic))
                                    {
                                        <div class="muted" style="font-size:12px;margin-top:2px;">SWIFT/BIC: @pd.SwiftBic</div>
                                    }
                                    <div class="muted" style="font-size:12px;font-style:italic;margin-top:2px;">Payee: @pd.PayeeName</div>
                                </div>
                                @if (!isReadOnly)
                                {
                                <div style="display:flex;gap:6px;">
                                    <button type="button" class="btn btn-secondary" style="padding:8px 12px;font-size:12px;" onclick="document.getElementById('pd-display-@pd.Id').style.display='none';document.getElementById('pd-edit-@pd.Id').style.display='block';">Edit</button>
                                    <form method="post" asp-action="DeletePaymentDetail" asp-controller="MyBusiness" asp-route-id="@pd.Id" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-secondary" style="padding:8px 12px;font-size:12px;color:var(--red);">Delete</button>
                                    </form>
                                </div>
                                }
                            </div>
                            @if (!isReadOnly)
                            {
                            <div id="pd-edit-@pd.Id" style="display:none;">
                                <form method="post" asp-action="UpdatePaymentDetail" asp-controller="MyBusiness">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pd.Id" />
                                    <div class="form-grid" style="margin-top:8px;">
                                        <div class="field">
                                            <label>Label *</label>
                                            <input type="text" name="label" value="@pd.Label" required />
                                        </div>
                                        <div class="field">
                                            <label>Bank Name *</label>
                                            <input type="text" name="bankName" value="@pd.BankName" required />
                                        </div>
                                        <div class="field" style="grid-column:1 / -1;">
                                            <label>IBAN *</label>
                                            <input type="text" name="iban" value="@pd.Iban" required />
                                        </div>
                                        <div class="field">
                                            <label>SWIFT/BIC</label>
                                            <input type="text" name="swiftBic" value="@(pd.SwiftBic)" maxlength="11" placeholder="e.g. VALLMTMT" />
                                        </div>
                                        <div class="field">
                                            <label>Payee Name *</label>
                                            <input type="text" name="payeeName" value="@pd.PayeeName" required />
                                        </div>
                                    </div>
                                    <div style="margin-top:12px;display:flex;gap:12px;">
                                        <button type="submit" class="btn btn-primary" style="padding:8px 16px;font-size:13px;">Save</button>
                                        <button type="button" class="btn btn-secondary" style="padding:8px 16px;font-size:13px;" onclick="document.getElementById('pd-edit-@pd.Id').style.display='none';document.getElementById('pd-display-@pd.Id').style.display='flex';">Cancel</button>
                                    </div>
                                </form>
                            </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="muted" style="font-size:14px;">No payment details added yet. Add your bank accounts to display them on invoices.</p>
                }
            </div>
        </section>
    </div>
}

<!-- ═══ AUTOMATION TAB ═══ -->
@if (activeTab == "automation")
{
    <div>
        <section class="glass card-pad">
            <h3 style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;margin-bottom:20px;">Document & Payment Automation</h3>

            <!-- Payment Instructions Toggle -->
            <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;">
                <div>
                    <div style="font-size:14px;font-weight:600;color:#0B1B28;">Show bank transfer payment option on shared invoices</div>
                    <p style="font-size:13px;color:#5E7385;margin-top:4px;">When enabled, customers viewing shared invoices will see a "Pay by Bank Transfer" button.</p>
                    @if (!paymentDetails.Any())
                    {
                        <p style="font-size:12px;color:#C8912E;margin-top:6px;">Add bank details in your payment details section before enabling this option.</p>
                    }
                </div>
                <label class="reminder-toggle" style="position:relative;display:inline-block;width:48px;height:26px;cursor:pointer;">
                    <input type="checkbox" id="paymentInstructionsToggle" @(ViewBag.IsPaymentInstructionsEnabled == true ? "checked" : "") @(!paymentDetails.Any() ? "disabled" : "") onchange="togglePaymentInstructions(this.checked)" style="opacity:0;width:0;height:0;position:absolute;" />
                    <span style="position:absolute;cursor:pointer;inset:0;background:@(ViewBag.IsPaymentInstructionsEnabled == true ? "#129867" : "#d0dbe5");border-radius:13px;transition:background 0.2s;"></span>
                    <span style="position:absolute;top:3px;left:@(ViewBag.IsPaymentInstructionsEnabled == true ? "25px" : "3px");width:20px;height:20px;background:#fff;border-radius:50%;transition:left 0.2s;box-shadow:0 1px 3px rgba(0,0,0,.15);"></span>
                </label>
            </div>

            <!-- Auto-Receipt Toggle -->
            <div style="margin-top:24px;padding-top:20px;border-top:1px solid #f0f4f7;display:flex;align-items:center;justify-content:space-between;gap:14px;">
                <div>
                    <div style="font-size:14px;font-weight:600;color:#0B1B28;">Auto-generate payment receipts</div>
                    <p style="font-size:13px;color:#5E7385;margin-top:4px;">When enabled, a receipt is automatically generated every time a payment is recorded.</p>
                </div>
                <label class="reminder-toggle" style="position:relative;display:inline-block;width:48px;height:26px;cursor:pointer;">
                    <input type="checkbox" id="autoReceiptToggle" @(ViewBag.IsAutoReceiptEnabled == true ? "checked" : "") onchange="toggleAutoReceipt(this.checked)" style="opacity:0;width:0;height:0;position:absolute;" />
                    <span style="position:absolute;cursor:pointer;inset:0;background:@(ViewBag.IsAutoReceiptEnabled == true ? "#129867" : "#d0dbe5");border-radius:13px;transition:background 0.2s;"></span>
                    <span style="position:absolute;top:3px;left:@(ViewBag.IsAutoReceiptEnabled == true ? "25px" : "3px");width:20px;height:20px;background:#fff;border-radius:50%;transition:left 0.2s;box-shadow:0 1px 3px rgba(0,0,0,.15);"></span>
                </label>
            </div>

            <!-- Auto-Signature on Invoices Toggle -->
            <div style="margin-top:24px;padding-top:20px;border-top:1px solid #f0f4f7;display:flex;align-items:center;justify-content:space-between;gap:14px;">
                <div>
                    <div style="font-size:14px;font-weight:600;color:#0B1B28;">Auto-sign invoices with default signature</div>
                    <p style="font-size:13px;color:#5E7385;margin-top:4px;">When enabled, the default signature is automatically shown on invoice PDFs and shared links.</p>
                </div>
                <label class="reminder-toggle" style="position:relative;display:inline-block;width:48px;height:26px;cursor:pointer;">
                    <input type="checkbox" id="autoInvoiceSigToggle" @(ViewBag.IsAutoInvoiceSignatureEnabled == true ? "checked" : "") onchange="toggleAutoInvoiceSignature(this.checked)" style="opacity:0;width:0;height:0;position:absolute;" />
                    <span style="position:absolute;cursor:pointer;inset:0;background:@(ViewBag.IsAutoInvoiceSignatureEnabled == true ? "#129867" : "#d0dbe5");border-radius:13px;transition:background 0.2s;"></span>
                    <span style="position:absolute;top:3px;left:@(ViewBag.IsAutoInvoiceSignatureEnabled == true ? "25px" : "3px");width:20px;height:20px;background:#fff;border-radius:50%;transition:left 0.2s;box-shadow:0 1px 3px rgba(0,0,0,.15);"></span>
                </label>
            </div>

            <!-- Z-Report Entry Toggle -->
            <div style="margin-top:24px;padding-top:20px;border-top:1px solid #f0f4f7;display:flex;align-items:center;justify-content:space-between;gap:14px;">
                <div>
                    <div style="font-size:14px;font-weight:600;color:#0B1B28;">Enable Z-Report entry (POS revenue recording)</div>
                    <p style="font-size:13px;color:#5E7385;margin-top:4px;">When enabled, you can record Z-Reports from your POS systems for VAT reporting and revenue tracking.</p>
                </div>
                <label class="reminder-toggle" style="position:relative;display:inline-block;width:48px;height:26px;cursor:pointer;">
                    <input type="checkbox" id="zReportToggle" @(ViewBag.IsZReportEnabled == true ? "checked" : "") onchange="toggleZReport(this.checked)" style="opacity:0;width:0;height:0;position:absolute;" />
                    <span style="position:absolute;cursor:pointer;inset:0;background:@(ViewBag.IsZReportEnabled == true ? "#129867" : "#d0dbe5");border-radius:13px;transition:background 0.2s;"></span>
                    <span style="position:absolute;top:3px;left:@(ViewBag.IsZReportEnabled == true ? "25px" : "3px");width:20px;height:20px;background:#fff;border-radius:50%;transition:left 0.2s;box-shadow:0 1px 3px rgba(0,0,0,.15);"></span>
                </label>
            </div>
        </section>
    </div>
}

@section Scripts {
    <script>
        async function togglePaymentInstructions(enabled) {
            BlockUI.show('Updating...');
            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/MyBusiness/AxPostTogglePaymentInstructions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: 'enabled=' + enabled
                });
                var result = await response.json();
                BlockUI.hide();
                if (result.success) {
                    location.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#0D5EA6' });
                    document.getElementById('paymentInstructionsToggle').checked = !enabled;
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
                document.getElementById('paymentInstructionsToggle').checked = !enabled;
            }
        }

        async function toggleAutoReceipt(enabled) {
            BlockUI.show('Updating...');
            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/MyBusiness/AxPostToggleAutoReceipt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: 'enabled=' + enabled
                });
                var result = await response.json();
                BlockUI.hide();
                if (result.success) {
                    var toggle = document.getElementById('autoReceiptToggle');
                    var track = toggle.nextElementSibling;
                    var knob = track.nextElementSibling;
                    track.style.background = enabled ? '#129867' : '#d0dbe5';
                    knob.style.left = enabled ? '25px' : '3px';
                    Swal.fire({ icon: 'success', title: 'Updated', text: result.message, confirmButtonColor: '#0D5EA6' });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#0D5EA6' });
                    document.getElementById('autoReceiptToggle').checked = !enabled;
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
                document.getElementById('autoReceiptToggle').checked = !enabled;
            }
        }

        async function toggleAutoInvoiceSignature(enabled) {
            if (enabled) {
                var confirm = await Swal.fire({
                    title: 'Important',
                    html: '<p style="text-align:left;line-height:1.7;">Enabling auto-signature will attach your default signature to <strong>new invoice shares and PDFs</strong> generated from now on.</p>' +
                        '<p style="text-align:left;line-height:1.7;margin-top:12px;color:#5E7385;">Previously shared invoices will <strong>not</strong> be updated — their snapshots are permanent records of what the customer received. To include the signature on an existing shared invoice, deactivate and re-share it.</p>',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Enable',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#0D5EA6'
                });
                if (!confirm.isConfirmed) {
                    document.getElementById('autoInvoiceSigToggle').checked = false;
                    return;
                }
            }

            BlockUI.show('Updating...');
            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/MyBusiness/AxPostToggleAutoInvoiceSignature', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: 'enabled=' + enabled
                });
                var result = await response.json();
                BlockUI.hide();
                if (result.success) {
                    var toggle = document.getElementById('autoInvoiceSigToggle');
                    var track = toggle.nextElementSibling;
                    var knob = track.nextElementSibling;
                    track.style.background = enabled ? '#129867' : '#d0dbe5';
                    knob.style.left = enabled ? '25px' : '3px';
                    Swal.fire({ icon: 'success', title: 'Updated', text: result.message, confirmButtonColor: '#0D5EA6' });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#0D5EA6' });
                    document.getElementById('autoInvoiceSigToggle').checked = !enabled;
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
                document.getElementById('autoInvoiceSigToggle').checked = !enabled;
            }
        }

