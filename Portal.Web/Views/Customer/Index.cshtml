@model Portal.Web.Models.CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Customers</div>
        <h1 style="margin-top:14px;font-size:42px;">Customer Registry</h1>
        <p class="muted" style="margin-top:10px;font-size:18px;line-height:1.8;">Search, create, and manage your customer base.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn-primary" asp-action="Create" asp-controller="Customer">New Customer</a>
    </div>
</div>

<section class="glass card-pad">
    <form method="get" asp-action="Index" asp-controller="Customer">
        <div class="form-grid">
            <div class="field">
                <label>Search</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by name..." />
            </div>
            <div class="field">
                <label>Status</label>
                <select name="isActive">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.IsActiveFilter == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(Model.IsActiveFilter == false ? "selected" : null)">Inactive</option>
                </select>
            </div>
        </div>
        <div style="margin-top:16px;">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    <div style="margin-top:18px;">
        @if (Model.Customers != null && Model.Customers.Count > 0)
        {
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Telephone</th>
                        <th>City</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td><strong>@customer.Name</strong></td>
                            <td>@customer.Email</td>
                            <td>@customer.TelephoneNumber</td>
                            <td>@customer.City</td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="pill pill-green">Active</span>
                                }
                                else
                                {
                                    <span class="pill pill-red">Inactive</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex;gap:12px;align-items:center;">
                                    <a asp-action="Edit" asp-controller="Customer" asp-route-id="@customer.Id" style="color:var(--blue);font-weight:700;font-size:13px;">Edit</a>
                                    <a href="/Statement?customerId=@customer.Id" style="color:var(--blue);font-weight:700;font-size:13px;">Statement</a>
                                    @if (customer.IsActive)
                                    {
                                        <form method="post" asp-action="Deactivate" asp-controller="Customer" asp-route-id="@customer.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-secondary" style="padding:8px 12px;font-size:12px;color:var(--red);" onclick="return confirm('Are you sure you want to deactivate this customer?')">Deactivate</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.TotalPages > 1)
            {
                var firstRecord = (Model.CurrentPage - 1) * Model.PageSize + 1;
                var lastRecord = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);

                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
                    <div id="paginationInfo" style="font-size:14px;color:#5a6a7a;">
                        Showing @firstRecord-@lastRecord of @Model.TotalCount
                    </div>
                    <div id="paginationControls" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                        @{
                            var baseUrl = "/Customer?";
                            var queryParams = new List<string>();
                            if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                queryParams.Add($"searchTerm={Uri.EscapeDataString(Model.SearchTerm)}");
                            }
                            if (Model.IsActiveFilter.HasValue)
                            {
                                queryParams.Add($"isActive={Model.IsActiveFilter.Value.ToString().ToLower()}");
                            }
                            var queryString = queryParams.Count > 0 ? string.Join("&", queryParams) + "&" : "";
                        }

                        @if (Model.HasPreviousPage)
                        {
                            <a href="@(baseUrl + queryString)page=@(Model.CurrentPage - 1)"
                               style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:#0D5EA6;border:1px solid #d0d9e2;">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;color:#a0aab4;border:1px solid #e2e8f0;cursor:not-allowed;">
                                Previous
                            </span>
                        }

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                            if (startPage > 1)
                            {
                                <a href="@(baseUrl + queryString)page=1"
                                   style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:#0D5EA6;border:1px solid #d0d9e2;">
                                    1
                                </a>
                                if (startPage > 2)
                                {
                                    <span style="padding:6px 8px;font-size:13px;color:#5a6a7a;">…</span>
                                }
                            }

                            for (var i = startPage; i <= endPage; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <span style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;background:#0D5EA6;color:#fff;border:1px solid #0D5EA6;">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="@(baseUrl + queryString)page=@i"
                                       style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:#0D5EA6;border:1px solid #d0d9e2;">
                                        @i
                                    </a>
                                }
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span style="padding:6px 8px;font-size:13px;color:#5a6a7a;">…</span>
                                }
                                <a href="@(baseUrl + queryString)page=@Model.TotalPages"
                                   style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:#0D5EA6;border:1px solid #d0d9e2;">
                                    @Model.TotalPages
                                </a>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@(baseUrl + queryString)page=@(Model.CurrentPage + 1)"
                               style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:#0D5EA6;border:1px solid #d0d9e2;">
                                Next
                            </a>
                        }
                        else
                        {
                            <span style="padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;color:#a0aab4;border:1px solid #e2e8f0;cursor:not-allowed;">
                                Next
                            </span>
                        }
                    </div>
                </div>
            }
            else if (Model.TotalCount > 0)
            {
                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
                    <div id="paginationInfo" style="font-size:14px;color:#5a6a7a;">
                        Showing 1-@Model.TotalCount of @Model.TotalCount
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>No customers found. Create your first customer to get started.</p>
            </div>
        }
    </div>
</section>
