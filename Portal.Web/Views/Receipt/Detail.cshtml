@model Portal.Infrastructure.Models.Receipt.ReceiptViewModel
@{
    ViewData["Title"] = "Receipt " + Model.ReceiptNumber;
    var cs = Model.CurrencySymbol ?? "€";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Finance › Receipts</div>
        <h1 class="topbar-heading">@Model.ReceiptNumber</h1>
        <p class="topbar-subtitle">@Model.PaymentType — @Model.ReceiptDate.ToString("dd MMM yyyy")</p>
    </div>
</div>

@if (Model.IsVoided)
{
    <div style="background:#fdeaea;border:1px solid #C24A4A;border-radius:12px;padding:14px 20px;margin-bottom:22px;color:#C24A4A;font-weight:600;">
        This receipt has been voided.
    </div>
}

@if (!string.IsNullOrEmpty(Model.SignatureLabel))
{
    <div style="background:rgba(18,152,103,.06);border:1px solid rgba(18,152,103,.15);border-radius:12px;padding:14px 20px;margin-bottom:22px;display:flex;align-items:center;gap:12px;">
        <svg width="18" height="18" fill="none" stroke="#129867" stroke-width="2" viewBox="0 0 24 24"><path d="M17 3a2.83 2.83 0 114 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
        <span style="font-size:14px;font-weight:600;color:#129867;">Signed by @Model.SignatureLabel</span>
    </div>
}

<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:30px;">
        <!-- Business Info -->
        <div>
            <h4 style="margin-bottom:8px;color:var(--primary);">From</h4>
            <p style="font-weight:700;margin-bottom:4px;">@Model.BusinessName</p>
            @if (!string.IsNullOrEmpty(Model.BusinessAddress))
            {
                <p style="font-size:13px;color:var(--muted);">@Model.BusinessAddress</p>
            }
            @if (!string.IsNullOrEmpty(Model.BusinessVatNumber))
            {
                <p style="font-size:13px;color:var(--muted);">VAT: @Model.BusinessVatNumber</p>
            }
        </div>
        <!-- Customer Info -->
        <div style="text-align:right;">
            <h4 style="margin-bottom:8px;color:var(--primary);">To</h4>
            <p style="font-weight:700;margin-bottom:4px;">@Model.CustomerName</p>
            @if (!string.IsNullOrEmpty(Model.CustomerAddress))
            {
                <p style="font-size:13px;color:var(--muted);">@Model.CustomerAddress</p>
            }
            @if (!string.IsNullOrEmpty(Model.CustomerEmail))
            {
                <p style="font-size:13px;color:var(--muted);">@Model.CustomerEmail</p>
            }
        </div>
    </div>
</section>

<section class="glass card-pad" style="margin-bottom:22px;">
    <h3 style="margin-bottom:16px;">Payment Details</h3>
    <table>
        <thead>
            <tr>
                <th>Invoice</th>
                <th style="text-align:right;">Invoice Total</th>
                <th style="text-align:right;">Outstanding Before</th>
                <th style="text-align:right;">Amount Received</th>
                <th style="text-align:right;">Outstanding After</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td><strong>@line.InvoiceNumber</strong></td>
                    <td style="text-align:right;">@cs@line.InvoiceTotal.ToString("N2")</td>
                    <td style="text-align:right;">@cs@line.InvoiceOutstandingBefore.ToString("N2")</td>
                    <td style="text-align:right;font-weight:700;color:var(--green);">@cs@line.Amount.ToString("N2")</td>
                    <td style="text-align:right;">@cs@line.InvoiceOutstandingAfter.ToString("N2")</td>
                    <td>
                        @if (line.IsFullPayment)
                        {
                            <span class="pill pill-green">Paid in Full</span>
                        }
                        else
                        {
                            <span class="pill pill-gold">Partial</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="font-weight:700;border-top:2px solid var(--primary);">
                <td colspan="3" style="text-align:right;">Total Received</td>
                <td style="text-align:right;color:var(--green);">@cs@Model.TotalAmountReceived.ToString("N2")</td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>

    @if (Model.CreditAmount.HasValue && Model.CreditAmount.Value > 0)
    {
        <div style="margin-top:14px;padding:10px 16px;background:#EEF4F8;border-radius:10px;font-size:13px;">
            <strong>Credit held on account:</strong> @cs@Model.CreditAmount.Value.ToString("N2")
        </div>
    }
</section>

<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:20px;">
        <div>
            <p style="font-size:13px;color:var(--muted);margin-bottom:4px;">Payment Method</p>
            <p style="font-weight:600;">@Model.PaymentMethodName</p>
            @if (!string.IsNullOrEmpty(Model.PaymentReference))
            {
                <p style="font-size:13px;color:var(--muted);margin-top:8px;">Reference</p>
                <p style="font-weight:600;">@Model.PaymentReference</p>
            }
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <p style="font-size:13px;color:var(--muted);margin-top:8px;">Notes</p>
                <p>@Model.Notes</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.SignatureLabel))
        {
            <div style="text-align:center;">
                <img src="/Signature/GetImage?id=@(Model.Id)" alt="Signature" style="max-height:60px;margin-bottom:6px;" />
                <p style="font-size:12px;color:var(--muted);">@Model.SignatureLabel</p>
            </div>
        }
    </div>
</section>

@if (!Model.IsVoided)
{
    <section class="glass card-pad">
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a href="javascript:void(0)" onclick="downloadReceiptPdf(@Model.Id)" class="btn btn-primary" style="padding:10px 20px;">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:-2px;"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download PDF
            </a>
            <button class="btn" style="padding:10px 20px;background:#fdeaea;color:#C24A4A;border:1.5px solid #C24A4A;" onclick="voidReceipt(@Model.Id)">Void Receipt</button>
        </div>
    </section>
}

@section Scripts {
<script>
    function voidReceipt(id) {
        Swal.fire({
            title: 'Void Receipt?',
            text: 'This receipt will be marked as voided and share links deactivated.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, void it',
            confirmButtonColor: '#C24A4A',
            cancelButtonText: 'Cancel'
        }).then(async function(result) {
            if (result.isConfirmed) {
                BlockUI.show('Voiding...');
                try {
                    var response = await fetch('/Receipt/AxPostVoid?id=' + id, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                    });
                    var data = await response.json();
                    BlockUI.hide();
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: 'Voided', text: data.message, confirmButtonColor: '#0D5EA6' }).then(function() {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                    }
                } catch (e) {
                    BlockUI.hide();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
                }
            }
        });
    }

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    async function downloadReceiptPdf(receiptId) {
        BlockUI.show('Generating PDF...');
        try {
            var response = await fetch('/Receipt/AxGetDownloadPdf?id=' + receiptId);
            if (!response.ok) {
                var data = await response.json();
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: data.message || 'Failed to generate PDF.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                return;
            }
            var blob = await response.blob();
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'receipt.pdf';
            var disposition = response.headers.get('content-disposition');
            if (disposition) {
                var match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                if (match && match[1]) a.download = match[1].replace(/['"]/g, '');
            }
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            BlockUI.hide();
        } catch (e) {
            BlockUI.hide();
            Swal.fire({ title: 'Error', text: 'Failed to download PDF.', icon: 'error', confirmButtonColor: '#0D5EA6' });
        }
    }
</script>
}
