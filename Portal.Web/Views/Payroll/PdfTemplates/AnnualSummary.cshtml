@model Portal.Infrastructure.Models.Payroll.AnnualSummaryPdfViewModel
@{
    Layout = null;
    var monthNames = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Annual Summary — @Model.BusinessName — @Model.Year</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            font-size: 13px;
            color: #1a2332;
            background: #ffffff;
            display: flex;
            justify-content: center;
            padding: 0;
        }

        .page {
            width: 210mm;
            min-height: 297mm;
            background: #ffffff;
            padding: 48px 52px;
            position: relative;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 36px;
            padding-bottom: 24px;
            border-bottom: 2px solid #0D5EA6;
        }

        .company-details h1 {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 18px;
            color: #0D5EA6;
            margin-bottom: 4px;
        }

        .document-title {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 22px;
            color: #0D5EA6;
            letter-spacing: 0.5px;
            text-align: right;
        }

        .document-subtitle {
            font-size: 12px;
            color: #5a6a7a;
            text-align: right;
            margin-top: 4px;
        }

        /* Employee Details */
        .employee-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 40px;
            margin-bottom: 32px;
            padding: 18px 22px;
            background: #F7FAFC;
            border-radius: 6px;
            border: 1px solid #e8eef4;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
        }

        .detail-label {
            font-size: 12px;
            color: #5a6a7a;
            font-weight: 500;
        }

        .detail-value {
            font-size: 13px;
            font-weight: 600;
            color: #1a2332;
        }

        /* Section Titles */
        .section-title {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 13px;
            color: #0D5EA6;
            margin-bottom: 8px;
            margin-top: 28px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .section-title:first-of-type {
            margin-top: 0;
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
            font-size: 12.5px;
        }

        thead th {
            background: #0D5EA6;
            color: #ffffff;
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 9px 12px;
            text-align: left;
            border: none;
        }

        thead th.text-right {
            text-align: right;
        }

        thead th.text-center {
            text-align: center;
        }

        tbody td {
            padding: 8px 12px;
            border-bottom: 1px solid #eef2f6;
            color: #2d3a4a;
        }

        tbody tr:nth-child(even) {
            background: #f9fbfd;
        }

        tbody td.text-right {
            text-align: right;
        }

        tbody td.text-center {
            text-align: center;
        }

        .total-row td {
            background: #eef5fc !important;
            font-weight: 700;
            color: #0D5EA6;
            border-top: 2px solid #0D5EA6;
            border-bottom: none;
            padding: 10px 12px;
        }

        /* Footer */
        .footer {
            position: absolute;
            bottom: 36px;
            left: 52px;
            right: 52px;
            text-align: center;
            font-size: 11px;
            color: #8a96a4;
            padding-top: 16px;
            border-top: 1px solid #e8eef4;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }

            .page {
                box-shadow: none;
                border: none;
                border-radius: 0;
                padding: 30px 40px;
                min-height: auto;
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <!-- Header -->
        <div class="header">
            <div class="company-details">
                <h1>@Model.BusinessName</h1>
            </div>
            <div>
                <div class="document-title">ANNUAL SUMMARY</div>
                <div class="document-subtitle">Calendar Year @Model.Year</div>
            </div>
        </div>

        <!-- Employee Details -->
        <div class="employee-details">
            <div class="detail-row">
                <span class="detail-label">Employee Name</span>
                <span class="detail-value">@Model.EmployeeName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Social Insurance No</span>
                <span class="detail-value">@(Model.EmployeeSin ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Year</span>
                <span class="detail-value">@Model.Year</span>
            </div>
        </div>

        <!-- Monthly Breakdown Table -->
        <div class="section-title">Monthly Breakdown</div>
        <table>
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="text-right">Gross</th>
                    <th class="text-right">Deductions</th>
                    <th class="text-right">Net</th>
                    <th class="text-right">Contributions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.MonthlyBreakdown)
                {
                    var name = (row.Month >= 1 && row.Month <= 12) ? monthNames[row.Month - 1] : "Unknown";
                    <tr>
                        <td>@name</td>
                        <td class="text-right">&euro;@row.Gross.ToString("N2")</td>
                        <td class="text-right">&euro;@row.Deductions.ToString("N2")</td>
                        <td class="text-right">&euro;@row.Net.ToString("N2")</td>
                        <td class="text-right">&euro;@row.Contributions.ToString("N2")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td><strong>Total</strong></td>
                    <td class="text-right">&euro;@Model.TotalGross.ToString("N2")</td>
                    <td class="text-right">&euro;@Model.TotalDeductions.ToString("N2")</td>
                    <td class="text-right">&euro;@Model.TotalNet.ToString("N2")</td>
                    <td class="text-right">&euro;@Model.TotalContributions.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- Deductions Breakdown Table -->
        <div class="section-title">Employee Deductions Breakdown</div>
        <table>
            <thead>
                <tr>
                    <th>Deduction Name</th>
                    <th class="text-right">Rate</th>
                    <th class="text-center">Months Applied</th>
                    <th class="text-right">Annual Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.DeductionBreakdown)
                {
                    <tr>
                        <td>@row.DeductionName</td>
                        <td class="text-right">@row.Rate.ToString("0.00")%</td>
                        <td class="text-center">@row.MonthsApplied</td>
                        <td class="text-right">&euro;@row.TotalAmount.ToString("N2")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td><strong>Total</strong></td>
                    <td></td>
                    <td></td>
                    <td class="text-right">&euro;@Model.TotalDeductions.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- Employer Contributions Breakdown Table -->
        <div class="section-title">Employer Contributions Breakdown</div>
        <table>
            <thead>
                <tr>
                    <th>Contribution Name</th>
                    <th class="text-right">Rate</th>
                    <th class="text-center">Months Applied</th>
                    <th class="text-right">Annual Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.ContributionBreakdown)
                {
                    <tr>
                        <td>@row.DeductionName</td>
                        <td class="text-right">@row.Rate.ToString("0.00")%</td>
                        <td class="text-center">@row.MonthsApplied</td>
                        <td class="text-right">&euro;@row.TotalAmount.ToString("N2")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td><strong>Total</strong></td>
                    <td></td>
                    <td></td>
                    <td class="text-right">&euro;@Model.TotalContributions.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- Footer -->
        <div class="footer">
            Generated by 3 Inventors Portal &bull; Confidential
        </div>
    </div>
</body>
</html>
