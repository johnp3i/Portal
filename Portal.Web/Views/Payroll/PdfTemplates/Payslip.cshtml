@model Portal.Infrastructure.Models.Payroll.PayslipPdfViewModel
@{
    Layout = null;
    var monthNames = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    var monthName = (Model.Payslip.Month >= 1 && Model.Payslip.Month <= 12) ? monthNames[Model.Payslip.Month - 1] : "Unknown";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payslip — @Model.BusinessName — @monthName @Model.Payslip.Year</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            font-size: 13px;
            color: #1a2332;
            background: #ffffff;
            display: flex;
            justify-content: center;
            padding: 0;
        }

        .page {
            width: 210mm;
            min-height: 297mm;
            background: #ffffff;
            padding: 48px 52px;
            position: relative;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 36px;
            padding-bottom: 24px;
            border-bottom: 2px solid #0D5EA6;
        }

        .company-info {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .logo-img {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .logo-circle {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #0D5EA6;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 16px;
            letter-spacing: 0.5px;
            flex-shrink: 0;
        }

        .company-details h1 {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 18px;
            color: #0D5EA6;
            margin-bottom: 4px;
        }

        .company-details p {
            font-size: 12px;
            color: #5a6a7a;
            line-height: 1.4;
        }

        .payslip-title {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 24px;
            color: #0D5EA6;
            letter-spacing: 1px;
            text-align: right;
        }

        /* Employee Details */
        .employee-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 40px;
            margin-bottom: 32px;
            padding: 18px 22px;
            background: #F7FAFC;
            border-radius: 6px;
            border: 1px solid #e8eef4;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
        }

        .detail-label {
            font-size: 12px;
            color: #5a6a7a;
            font-weight: 500;
        }

        .detail-value {
            font-size: 13px;
            font-weight: 600;
            color: #1a2332;
        }

        /* Section Titles */
        .section-title {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 13px;
            color: #0D5EA6;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
            font-size: 12.5px;
        }

        thead th {
            background: #0D5EA6;
            color: #ffffff;
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 9px 12px;
            text-align: left;
            border: none;
        }

        thead th:last-child {
            text-align: right;
        }

        tbody td {
            padding: 8px 12px;
            border-bottom: 1px solid #eef2f6;
            color: #2d3a4a;
        }

        tbody tr:nth-child(even) {
            background: #f9fbfd;
        }

        tbody td:last-child {
            text-align: right;
            font-weight: 500;
        }

        tbody td.center {
            text-align: center;
        }

        .total-row td {
            background: #eef5fc !important;
            font-weight: 700;
            color: #0D5EA6;
            border-top: 2px solid #0D5EA6;
            border-bottom: none;
            padding: 10px 12px;
        }

        /* Net Salary */
        .net-salary-section {
            margin-bottom: 24px;
        }

        .net-salary-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #0D5EA6;
            color: #ffffff;
            padding: 14px 22px;
            border-radius: 6px;
        }

        .net-salary-box .label {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 15px;
            letter-spacing: 0.3px;
        }

        .net-salary-box .amount {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 20px;
        }

        /* Summary Box */
        .summary-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #F7FAFC;
            border: 1px solid #57B8E8;
            border-left: 4px solid #57B8E8;
            padding: 14px 22px;
            border-radius: 6px;
            margin-bottom: 24px;
        }

        .summary-box .label {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 13px;
            color: #1a2332;
        }

        .summary-box .amount {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 17px;
            color: #0D5EA6;
        }

        /* Manager Notes */
        .manager-notes {
            margin-bottom: 32px;
            padding: 12px 18px;
            background: #fffdf5;
            border: 1px solid #e8ddb8;
            border-left: 4px solid #C8912E;
            border-radius: 4px;
        }

        .manager-notes .notes-title {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #C8912E;
            margin-bottom: 4px;
        }

        .manager-notes p {
            font-size: 12px;
            color: #5a5040;
            font-style: italic;
        }

        /* Footer */
        .footer {
            position: absolute;
            bottom: 36px;
            left: 52px;
            right: 52px;
            text-align: center;
            font-size: 11px;
            color: #8a96a4;
            padding-top: 16px;
            border-top: 1px solid #e8eef4;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }

            .page {
                box-shadow: none;
                border: none;
                border-radius: 0;
                padding: 30px 40px;
                min-height: auto;
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <!-- Header -->
        <div class="header">
            <div class="company-info">
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="Logo" class="logo-img" />
                }
                else
                {
                    <div class="logo-circle">@(Model.BusinessName.Length >= 2 ? Model.BusinessName.Substring(0, 2).ToUpper() : Model.BusinessName.ToUpper())</div>
                }
                <div class="company-details">
                    <h1>@Model.BusinessName</h1>
                    @if (!string.IsNullOrEmpty(Model.BusinessAddress))
                    {
                        <p>@Model.BusinessAddress</p>
                    }
                </div>
            </div>
            <div class="payslip-title">PAYSLIP</div>
        </div>

        <!-- Employee Details -->
        <div class="employee-details">
            <div class="detail-row">
                <span class="detail-label">Employee Name</span>
                <span class="detail-value">@Model.Payslip.EmployeeName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Position</span>
                <span class="detail-value">@(Model.Payslip.EmployeePosition ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Social Insurance No</span>
                <span class="detail-value">@(Model.Payslip.SocialInsuranceNumber ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">ID Number</span>
                <span class="detail-value">@(Model.Payslip.IdNumber ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Pay Period</span>
                <span class="detail-value">@monthName @Model.Payslip.Year</span>
            </div>
        </div>

        <!-- Earnings Table -->
        <div class="section-title">Earnings</div>
        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th style="text-align:center;">Hours</th>
                    <th style="text-align:center;">Multiplier</th>
                    <th style="text-align:right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Payslip.EarningLines)
                {
                    <tr>
                        <td>@(!string.IsNullOrEmpty(line.Description) ? line.Description : line.EarningTypeName)</td>
                        <td class="center">@(line.OvertimeHours.HasValue ? line.OvertimeHours.Value.ToString("0.##") : "—")</td>
                        <td class="center">@(line.OvertimeMultiplier.HasValue ? $"x{line.OvertimeMultiplier.Value:0.##}" : "—")</td>
                        <td>&euro;@line.Amount.ToString("N2")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td>Total Earnings</td>
                    <td></td>
                    <td></td>
                    <td>&euro;@Model.Payslip.TotalEarnings.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- Employee Deductions Table -->
        <div class="section-title">Employee Deductions</div>
        <table>
            <thead>
                <tr>
                    <th>Deduction</th>
                    <th style="text-align:center;">Rate</th>
                    <th style="text-align:right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Payslip.EmployeeDeductions)
                {
                    <tr>
                        <td>@line.DeductionTypeName</td>
                        <td class="center">@line.Rate.ToString("0.00")%</td>
                        <td>&euro;@line.CalculatedAmount.ToString("N2")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td>Total Employee Deductions</td>
                    <td></td>
                    <td>&euro;@Model.Payslip.TotalEmployeeDeductions.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- Net Salary -->
        <div class="net-salary-section">
            <div class="net-salary-box">
                <span class="label">Net Salary</span>
                <span class="amount">&euro;@Model.Payslip.NetSalary.ToString("N2")</span>
            </div>
        </div>

        <!-- Employer Contributions Table -->
        <div class="section-title">Employer Contributions</div>
        <table>
            <thead>
                <tr>
                    <th>Contribution</th>
                    <th style="text-align:center;">Rate</th>
                    <th style="text-align:right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Payslip.EmployerContributions)
                {
                    <tr>
                        <td>@line.DeductionTypeName</td>
                        <td class="center">@line.Rate.ToString("0.00")%</td>
                        <td>&euro;@line.CalculatedAmount.ToString("N2")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td>Total Employer Contributions</td>
                    <td></td>
                    <td>&euro;@Model.Payslip.TotalEmployerContributions.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- Summary Box -->
        <div class="summary-box">
            <span class="label">Total Cost to Business</span>
            <span class="amount">&euro;@Model.Payslip.TotalCostToBusiness.ToString("N2")</span>
        </div>

        <!-- Manager Notes -->
        @if (!string.IsNullOrEmpty(Model.Payslip.ManagerNotes))
        {
            <div class="manager-notes">
                <div class="notes-title">Manager Notes</div>
                <p>@Model.Payslip.ManagerNotes</p>
            </div>
        }

        <!-- Footer -->
        <div class="footer">
            Generated by 3 Inventors Portal &bull; Confidential
        </div>
    </div>
</body>
</html>
