@model List<Portal.Infrastructure.Models.Payroll.PayslipPeriodDto>
@{
    ViewData["Title"] = "Payslip Periods";

    var monthNames = new[] { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Payroll</div>
        <h1 class="topbar-heading">Payslip Periods</h1>
        <p class="topbar-subtitle">Manage monthly payroll cycles</p>
    </div>
    <div class="topbar-actions">
        <button class="btn btn-primary" onclick="toggleCreateForm()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            Create Period
        </button>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- About Payslip Periods -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <button type="button" onclick="var el=this.nextElementSibling;el.style.display=el.style.display==='none'?'block':'none';this.querySelector('svg').style.transform=el.style.display==='none'?'':'rotate(180deg)';" style="display:flex;align-items:center;gap:8px;background:none;border:none;cursor:pointer;font-size:14px;font-weight:700;color:#0D5EA6;padding:0;font-family:inherit;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"/></svg>
        About Payslip Periods
    </button>
    <div style="display:none;margin-top:14px;">
        <p style="font-size:13px;color:#5a6a7a;line-height:1.7;margin-bottom:10px;">
            Each month follows this cycle:
        </p>
        <ol style="font-size:13px;color:#5a6a7a;line-height:2;margin:0 0 0 18px;padding:0;">
            <li><strong>Create Period</strong> — Click "+ Create Period" and select the month/year</li>
            <li><strong>Generate Payslips</strong> — The system calculates earnings, deductions, and net salary for each employee</li>
            <li><strong>Review</strong> — Check individual payslips, edit earning lines if needed</li>
            <li><strong>Finalise</strong> — Lock the period (payslips become read-only)</li>
            <li><strong>Email</strong> — Send payslips to employees as PDF attachments</li>
        </ol>
        <p style="font-size:13px;color:#5a6a7a;line-height:1.7;margin-top:10px;">
            Statuses: <span style="color:#6b7280;font-weight:600;">Draft</span> → <span style="color:#0D5EA6;font-weight:600;">Preview</span> → <span style="color:#129867;font-weight:600;">Finalised</span>. Once finalised, a period can be unlocked by the business owner if corrections are needed.
        </p>
    </div>
</section>

<!-- Create Period Form (toggle) -->
<section id="createPeriodSection" class="glass card-pad" style="margin-bottom:22px;display:none;">
    <div id="createPeriodForm" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="margin-bottom:0;min-width:120px;">
            <label>Year</label>
            <select id="periodYear">
                @for (int y = DateTime.Now.Year + 1; y >= DateTime.Now.Year - 2; y--)
                {
                    if (y == DateTime.Now.Year)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </div>
        <div class="field" style="margin-bottom:0;min-width:140px;">
            <label>Month</label>
            <select id="periodMonth">
                @for (int m = 1; m <= 12; m++)
                {
                    if (m == DateTime.Now.Month)
                    {
                        <option value="@m" selected>@monthNames[m]</option>
                    }
                    else
                    {
                        <option value="@m">@monthNames[m]</option>
                    }
                }
            </select>
        </div>
        <button class="btn btn-primary btn-sm" onclick="createPeriod()">Create</button>
    </div>
</section>

<!-- Periods Table -->
<section class="glass card-pad">
    @if (Model != null && Model.Count > 0)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Status</th>
                    <th data-mobile="hide">Employees</th>
                    <th class="text-right" data-mobile="hide">Total Net</th>
                    <th data-mobile="hide">Processed</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var period in Model)
                {
                    <tr>
                        <td><strong>@monthNames[period.Month] @period.Year</strong></td>
                        <td>
                            @if (period.Status == "Draft")
                            {
                                <span class="pill pill-grey">Draft</span>
                            }
                            else if (period.Status == "Preview")
                            {
                                <span class="pill pill-blue">Preview</span>
                            }
                            else if (period.Status == "Finalised")
                            {
                                <span class="pill pill-green">Finalised</span>
                            }
                        </td>
                        <td data-mobile="hide">@(period.PayslipCount > 0 ? period.PayslipCount.ToString() : "—")</td>
                        <td class="text-right" data-mobile="hide">@(period.PayslipCount > 0 ? $"€{period.TotalNetSalary:N2}" : "—")</td>
                        <td data-mobile="hide">@(period.ProcessedAtUtc.HasValue ? period.ProcessedAtUtc.Value.ToString("dd MMM yyyy") : "—")</td>
                        <td class="table-actions">
                            @if (period.Status == "Draft" && period.PayslipCount == 0)
                            {
                                <a class="btn btn-sm btn-primary" asp-action="BatchGenerate" asp-controller="Payroll" asp-route-periodId="@period.Id">Generate Payslips</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-secondary" asp-action="PeriodDetail" asp-controller="Payroll" asp-route-id="@period.Id">View</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <p>No payslip periods found. Create your first period to get started.</p>
        </div>
    }
</section>

<script>
    function getAntiForgeryToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    function toggleCreateForm() {
        var section = document.getElementById('createPeriodSection');
        section.style.display = section.style.display === 'none' ? 'block' : 'none';
    }

    async function createPeriod() {
        var year = parseInt(document.getElementById('periodYear').value);
        var month = parseInt(document.getElementById('periodMonth').value);

        BlockUI.show('Creating period...');
        try {
            var response = await fetch('/Payroll/AxPostCreatePeriod', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ year: year, month: month })
            });
            var data = await response.json();
            BlockUI.hide();

            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Done', text: data.message, confirmButtonColor: '#0D5EA6' }).then(function () {
                    window.location.reload();
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
            }
        } catch (e) {
            BlockUI.hide();
            Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
        }
    }
</script>
