@model Portal.Infrastructure.Models.Compliance.BusinessApplicationDetailDto
@{
    ViewData["Title"] = Model.ApplicationName;
}

@Html.AntiForgeryToken()

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Compliance</div>
        <h1 class="topbar-heading">@Model.ApplicationName</h1>
        <p class="topbar-subtitle">@Model.CategoryName &middot; @Model.Frequency</p>
    </div>
    <div>
        <a asp-action="Index" asp-controller="Compliance" class="btn btn-secondary">Back to Applications</a>
    </div>
</div>

@if (Model.DueStatus == "overdue")
{
    <div class="overdue-banner">
        This filing is overdue. Due date was @Model.DueDate.ToString("dd MMM yyyy").
    </div>
}

<!-- Status & Transitions -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
        <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:14px;font-weight:600;color:#5a6a7a;">Status:</span>
            @{
                var statusBadgeClass = Model.Status switch
                {
                    "Pending" => "pill pill-grey",
                    "InProgress" => "pill pill-blue",
                    "Submitted" => "pill pill-amber",
                    "Approved" => "pill pill-green",
                    "Rejected" => "pill pill-red",
                    _ => "pill pill-grey"
                };
            }
            <span class="@statusBadgeClass" style="font-size:14px;padding:6px 16px;">@(Model.Status == "InProgress" ? "In Progress" : Model.Status)</span>
        </div>

        @if (Model.AllowedTransitions.Length > 0)
        {
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                @foreach (var transition in Model.AllowedTransitions)
                {
                    var btnClass = transition switch
                    {
                        "InProgress" => "btn btn-transition btn-transition-blue",
                        "Submitted" => "btn btn-transition btn-transition-amber",
                        "Approved" => "btn btn-transition btn-transition-green",
                        "Rejected" => "btn btn-transition btn-transition-red",
                        _ => "btn btn-secondary"
                    };
                    var btnLabel = transition switch
                    {
                        "InProgress" => "Mark In Progress",
                        "Submitted" => "Mark Submitted",
                        "Approved" => "Approve",
                        "Rejected" => "Reject",
                        _ => transition
                    };

                    <button type="button" class="@btnClass" onclick="updateStatus('@transition')">@btnLabel</button>
                }
            </div>
        }
    </div>
</section>

<!-- Detail Fields -->
<section class="glass card-pad">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div class="field">
            <label>Due Date</label>
            @{
                var dueDateClass = Model.DueStatus switch
                {
                    "overdue" => "due-overdue",
                    "urgent" => "due-urgent",
                    "warning" => "due-warning",
                    _ => ""
                };
            }
            <div class="field-readonly @dueDateClass">@Model.DueDate.ToString("dd MMM yyyy")</div>
        </div>
        <div class="field">
            <label for="referenceNumber">Reference Number</label>
            <input type="text" id="referenceNumber" value="@Model.ReferenceNumber" placeholder="Enter reference number..." />
        </div>
    </div>

    <div class="field" style="margin-top:16px;">
        <label for="notes">Notes</label>
        <textarea id="notes" rows="4" placeholder="Add notes about this filing...">@Model.Notes</textarea>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:16px;">
        <div class="field">
            <label>Submitted At</label>
            <div class="field-readonly">@(Model.SubmittedAtUtc.HasValue ? Model.SubmittedAtUtc.Value.ToString("dd MMM yyyy HH:mm") : "—")</div>
        </div>
        <div class="field">
            <label>Approved At</label>
            <div class="field-readonly">@(Model.ApprovedAtUtc.HasValue ? Model.ApprovedAtUtc.Value.ToString("dd MMM yyyy HH:mm") : "—")</div>
        </div>
    </div>

    <div style="margin-top:20px;">
        <button type="button" class="btn btn-primary" onclick="saveDetails()">Save Details</button>
    </div>
</section>

<!-- Attachments -->
<section class="glass card-pad" style="margin-top:24px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
        <h3 style="margin:0;font-size:16px;font-weight:700;color:#1a2b3c;">Attachments (@Model.Attachments.Count/3)</h3>
        @if (Model.Attachments.Count < 3)
        {
            <label for="fileUpload" class="btn btn-primary" style="cursor:pointer;font-size:13px;padding:8px 16px;">Upload PDF</label>
        }
        else
        {
            <button type="button" class="btn btn-secondary" disabled style="font-size:13px;padding:8px 16px;opacity:0.5;cursor:not-allowed;">Upload PDF (Max reached)</button>
        }
    </div>

    <input type="file" id="fileUpload" accept=".pdf" style="display:none;" onchange="uploadAttachment(this)" />

    @if (Model.Attachments.Count > 0)
    {
        <div style="display:flex;flex-direction:column;gap:10px;">
            @foreach (var attachment in Model.Attachments)
            {
                var fileSize = attachment.FileSizeBytes < 1024 * 1024
                    ? $"{attachment.FileSizeBytes / 1024.0:F1} KB"
                    : $"{attachment.FileSizeBytes / (1024.0 * 1024.0):F1} MB";

                <div class="attachment-item">
                    <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;">
                        <span class="attachment-icon">PDF</span>
                        <div style="min-width:0;">
                            <div class="attachment-name">@attachment.OriginalFileName</div>
                            <div class="attachment-meta">@fileSize &middot; @attachment.CreatedAtUtc.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;">
                        <a href="/Compliance/DownloadAttachment?attachmentId=@attachment.Id" class="btn btn-secondary" style="font-size:12px;padding:6px 12px;">Download</a>
                        <button type="button" class="btn btn-danger" style="font-size:12px;padding:6px 12px;" onclick="deleteAttachment(@attachment.Id, '@Html.Raw(attachment.OriginalFileName.Replace("'", "\\'"))')">Delete</button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align:center;padding:20px;color:#7a8a9a;font-size:14px;">
            No attachments yet. Upload a PDF file to attach to this filing.
        </div>
    }
</section>

<style>
    .overdue-banner {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #C24A4A;
        font-weight: 600;
        font-size: 14px;
        padding: 12px 20px;
        border-radius: 10px;
        margin-bottom: 22px;
    }
    .field-readonly {
        padding: 10px 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 14px;
        color: #1a2b3c;
    }
    .due-overdue { color: #C24A4A; font-weight: 700; }
    .due-urgent { color: #C24A4A; font-weight: 600; }
    .due-warning { color: #C8912E; font-weight: 600; }
    .btn-transition {
        font-size: 13px;
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-transition-blue { background: #dbeafe; color: #1d4ed8; }
    .btn-transition-blue:hover { background: #bfdbfe; }
    .btn-transition-amber { background: #fef3c7; color: #92400e; }
    .btn-transition-amber:hover { background: #fde68a; }
    .btn-transition-green { background: #d1fae5; color: #065f46; }
    .btn-transition-green:hover { background: #a7f3d0; }
    .btn-transition-red { background: #fee2e2; color: #991b1b; }
    .btn-transition-red:hover { background: #fecaca; }
    .btn-danger {
        background: #fee2e2;
        color: #C24A4A;
        border: 1px solid #fecaca;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-danger:hover { background: #fecaca; }
    .attachment-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        transition: all 0.15s ease;
    }
    .attachment-item:hover { border-color: #0D5EA6; background: #EEF4F8; }
    .attachment-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: #fee2e2;
        color: #C24A4A;
        font-size: 11px;
        font-weight: 800;
        border-radius: 8px;
        flex-shrink: 0;
    }
    .attachment-name {
        font-size: 14px;
        font-weight: 600;
        color: #1a2b3c;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .attachment-meta {
        font-size: 12px;
        color: #7a8a9a;
        margin-top: 2px;
    }
    @@media (max-width: 576px) {
        section .glass.card-pad div[style*="grid-template-columns"] {
            grid-template-columns: 1fr !important;
        }
        .attachment-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
        .btn-transition, .btn-danger, .btn-primary, .btn-secondary {
            min-height: 44px;
        }
    }
</style>

<script>
    (function () {
        var applicationId = @Model.Id;

        function getAntiForgeryToken() {
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        window.updateStatus = async function (newStatus) {
            BlockUI.show('Updating status...');

            try {
                var formData = new FormData();
                formData.append('id', applicationId);
                formData.append('newStatus', newStatus);

                var response = await fetch('/Compliance/AxPostUpdateStatus', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: formData
                });

                var result = await response.json();
                BlockUI.hide();

                if (result.success) {
                    await Swal.fire({
                        title: 'Status Updated',
                        text: result.message || 'Filing status has been updated.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: result.message || 'Failed to update status.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (ex) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred. Please try again.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            }
        };

        window.saveDetails = async function () {
            var referenceNumber = document.getElementById('referenceNumber').value;
            var notes = document.getElementById('notes').value;

            BlockUI.show('Saving details...');

            try {
                var formData = new FormData();
                formData.append('id', applicationId);
                formData.append('referenceNumber', referenceNumber);
                formData.append('notes', notes);

                var response = await fetch('/Compliance/AxPostUpdateDetails', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: formData
                });

                var result = await response.json();
                BlockUI.hide();

                if (result.success) {
                    Swal.fire({
                        title: 'Saved',
                        text: result.message || 'Details have been saved.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: result.message || 'Failed to save details.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (ex) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred. Please try again.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            }
        };

        window.uploadAttachment = async function (input) {
            if (!input.files || !input.files[0]) return;

            var file = input.files[0];

            if (!file.name.toLowerCase().endsWith('.pdf')) {
                Swal.fire({
                    title: 'Invalid File',
                    text: 'Only PDF files are allowed.',
                    icon: 'warning',
                    confirmButtonColor: '#0D5EA6'
                });
                input.value = '';
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({
                    title: 'File Too Large',
                    text: 'Maximum file size is 5 MB.',
                    icon: 'warning',
                    confirmButtonColor: '#0D5EA6'
                });
                input.value = '';
                return;
            }

            BlockUI.show('Uploading attachment...');

            try {
                var formData = new FormData();
                formData.append('id', applicationId);
                formData.append('file', file);

                var response = await fetch('/Compliance/AxPostUploadAttachment', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: formData
                });

                var result = await response.json();
                BlockUI.hide();

                if (result.success) {
                    await Swal.fire({
                        title: 'Uploaded',
                        text: result.message || 'Attachment uploaded successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({
                        title: 'Upload Failed',
                        text: result.message || 'Failed to upload attachment.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (ex) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred. Please try again.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            }

            input.value = '';
        };

        window.deleteAttachment = async function (attachmentId, fileName) {
            var confirmResult = await Swal.fire({
                title: 'Delete Attachment?',
                text: 'Are you sure you want to delete "' + fileName + '"? This cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#C24A4A'
            });

            if (!confirmResult.isConfirmed) return;

            BlockUI.show('Deleting attachment...');

            try {
                var formData = new FormData();
                formData.append('attachmentId', attachmentId);

                var response = await fetch('/Compliance/AxPostDeleteAttachment', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: formData
                });

                var result = await response.json();
                BlockUI.hide();

                if (result.success) {
                    await Swal.fire({
                        title: 'Deleted',
                        text: result.message || 'Attachment has been deleted.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: result.message || 'Failed to delete attachment.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (ex) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred. Please try again.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            }
        };
    })();
</script>
