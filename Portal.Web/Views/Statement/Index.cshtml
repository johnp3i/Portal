@using Portal.Infrastructure.Entities
@{
    ViewData["Title"] = "Statement of Account";

    var customers = (List<Customer>)ViewBag.Customers;
    var selectedCustomerId = (int?)ViewBag.SelectedCustomerId;
}

@Html.AntiForgeryToken()

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Statement of Account</div>
        <h1 class="topbar-heading">Customer Statement</h1>
        <p class="topbar-subtitle">Generate a financial summary showing invoices, payments, and running balance for a selected customer and period.</p>
    </div>
</div>

<!-- Filter Panel -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <button type="button" class="filter-toggle active" aria-expanded="true" aria-controls="statementFilterPanel">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 4h18M7 9h10M10 14h4"/></svg>
        Filters
    </button>
    <div class="filter-panel expanded" id="statementFilterPanel" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:180px;">
            <label>Customer</label>
            <select id="customerSelect" onchange="onCustomerChanged()" aria-label="Customer">
                <option value="">Select a customer...</option>
                @foreach (var customer in customers)
                {
                    <option value="@customer.Id" selected="@(selectedCustomerId.HasValue && selectedCustomerId.Value == customer.Id ? "selected" : null)">@customer.Name</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:180px;">
            <label>From Date</label>
            <input type="date" id="fromDate" placeholder="From date" aria-label="From Date" />
        </div>
        <div class="field" style="min-width:180px;">
            <label>To Date</label>
            <input type="date" id="toDate" placeholder="To date" aria-label="To Date" />
        </div>
        <div style="padding-bottom:2px;">
            <button class="btn btn-primary" onclick="generateStatement()">Generate</button>
        </div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#5E7385;margin-right:4px;">Quick:</span>
        <button type="button" class="period-shortcut" onclick="setPeriod('this_month')">This Month</button>
        <button type="button" class="period-shortcut" onclick="setPeriod('last_month')">Last Month</button>
        <button type="button" class="period-shortcut" onclick="setPeriod('last_3')">Last 3 Months</button>
        <button type="button" class="period-shortcut" onclick="setPeriod('last_6')">Last 6 Months</button>
        <button type="button" class="period-shortcut" onclick="setPeriod('this_year')">This Year</button>
        <button type="button" class="period-shortcut" onclick="setPeriod('last_year')">Last Year</button>
        <button type="button" class="period-shortcut" onclick="setPeriod('all')">All Time</button>
    </div>
</section>

<!-- Statement Results (initially hidden) -->
<div id="statementResults" style="display:none;">

    <!-- Customer Header Section -->
    <section class="glass card-pad" style="margin-bottom:22px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px;">
            <div>
                <h3 id="customerName" style="font-family:'Manrope',sans-serif;font-size:20px;font-weight:700;color:#1a2b3c;margin:0 0 8px 0;"></h3>
                <p id="customerAddress" style="font-size:14px;color:#5a6a7a;margin:0 0 4px 0;"></p>
                <p id="customerContact" style="font-size:14px;color:#5a6a7a;margin:0;"></p>
            </div>
            <div style="text-align:right;">
                <p style="font-size:13px;color:#5a6a7a;margin:0 0 4px 0;">Statement Period</p>
                <p id="statementPeriod" style="font-family:'Manrope',sans-serif;font-size:15px;font-weight:700;color:#1a2b3c;margin:0;"></p>
                <button type="button" id="btnRecordGlobalPayment" class="btn btn-primary" style="margin-top:12px;font-size:13px;padding:8px 18px;" onclick="openGlobalPaymentModal()">Record Payment</button>
            </div>
        </div>
    </section>

    <!-- KPI Cards -->
    <section class="gauge-row" style="display:flex;gap:22px;margin-bottom:22px;flex-wrap:wrap;">
        <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #0D5EA6;">
            <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Opening Balance</p>
            <h2 id="openingBalance" style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#0D5EA6;margin:0 0 4px 0;">€0.00</h2>
            <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">Balance brought forward</p>
        </div>
        <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #C8912E;">
            <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Total Invoiced</p>
            <h2 id="totalInvoiced" style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#C8912E;margin:0 0 4px 0;">€0.00</h2>
            <p id="invoiceCount" style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">0 invoices</p>
        </div>
        <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #129867;">
            <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Total Paid</p>
            <h2 id="totalPaid" style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#129867;margin:0 0 4px 0;">€0.00</h2>
            <p id="paymentCount" style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">0 payments</p>
        </div>
        <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #C24A4A;" id="closingBalanceCard">
            <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Closing Balance</p>
            <h2 id="closingBalance" style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#C24A4A;margin:0 0 4px 0;">€0.00</h2>
            <p id="closingBalanceLabel" style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">Balance carried forward</p>
        </div>
    </section>

    <!-- Transaction Table -->
    <section class="glass card-pad" id="transactionTableSection">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:14px;">
            <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0;color:#1a2b3c;">Transaction History</h3>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <button class="btn btn-primary" onclick="downloadPdf()" id="btnDownloadPdf">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:middle;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Download PDF
                </button>
                <button class="btn btn-secondary" onclick="emailStatement()" id="btnEmailStatement">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:middle;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Email Statement
                </button>
            </div>
        </div>
        <div class="scroll-hint">← Scroll horizontally →</div>
        <div class="table-responsive" style="padding-right:2px;">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th style="text-align:right;">Debit (Invoiced)</th>
                    <th style="text-align:right;">Credit (Paid)</th>
                    <th style="text-align:right;">Running Balance</th>
                    <th style="text-align:center;width:60px;"></th>
                </tr>
            </thead>
            <tbody id="transactionTableBody">
            </tbody>
            <tfoot id="transactionTableFooter">
            </tfoot>
        </table>
        </div>
    </section>
</div>

<!-- Email History (shown independently when customer is selected) -->
<section class="glass card-pad" style="margin-top:24px;display:none;" id="emailHistorySection">
    <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 6px 0;color:#1a2b3c;">Statements' Email History</h3>
    <p style="font-size:12px;color:#8a9bab;margin:0 0 14px 0;font-style:italic;">Note: Viewing a previously sent statement regenerates it from current data. Possible changes to invoices or payments since the original send date may affect the displayed figures.</p>
    <div id="emailHistoryContent">
        <p style="font-size:14px;color:#5a6a7a;">No statements have been emailed for this customer.</p>
    </div>
</section>

<!-- Global Payment Modal -->
<div id="globalPaymentModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.4);backdrop-filter:blur(2px);align-items:flex-start;justify-content:center;overflow-y:auto;padding:24px 0;">
    <div style="background:#fff;border-radius:24px;padding:32px;width:100%;max-width:520px;box-shadow:0 20px 60px rgba(13,94,166,.18);margin:auto;flex-shrink:0;">
        <h2 style="font-size:22px;margin-bottom:6px;">Record Payment</h2>
        <p class="muted" style="font-size:14px;margin-bottom:24px;">Record a customer-level payment and allocate across outstanding invoices.</p>
        <div style="padding:12px 16px;border-radius:10px;background:rgba(13,94,166,.04);border:1px solid rgba(13,94,166,.08);margin-bottom:18px;">
            <div style="font-size:12px;font-weight:700;color:#5a6a7a;text-transform:uppercase;">Customer</div>
            <div id="gpCustomerName" style="font-size:15px;font-weight:700;color:#1a2b3c;margin-top:4px;"></div>
            <div id="gpOutstandingInfo" style="font-size:13px;color:#5a6a7a;margin-top:4px;"></div>
            <button type="button" id="btnApplyCredit" class="btn btn-green" style="display:none;margin-top:10px;font-size:12px;padding:6px 14px;background:#129867;color:#fff;border:none;border-radius:8px;cursor:pointer;" onclick="applyCredit()">Apply Credit</button>
        </div>
        <form id="globalPaymentForm" onsubmit="return false;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="field">
                    <label>Amount *</label>
                    <input type="number" id="gpAmount" step="0.01" min="0.01" required placeholder="0.00" />
                </div>
                <div class="field">
                    <label>Payment Date *</label>
                    <input type="date" id="gpDate" required />
                </div>
                <div class="field">
                    <label>Payment Method *</label>
                    <select id="gpMethod" required>
                        <option value="1">Bank Transfer</option>
                        <option value="2">Cash</option>
                        <option value="3">Credit Card</option>
                        <option value="4">Cheque</option>
                        <option value="5">Online</option>
                    </select>
                </div>
                <div class="field">
                    <label>Reference</label>
                    <input type="text" id="gpReference" placeholder="e.g. TXN-12345" maxlength="200" />
                </div>
            </div>
            <div class="field" style="margin-top:14px;">
                <label>Notes</label>
                <input type="text" id="gpNotes" placeholder="Optional notes" />
            </div>
            <div class="field" style="margin-top:14px;">
                <label>Allocation Mode</label>
                <select id="gpMode">
                    <option value="fifo">Auto (FIFO — oldest invoice first)</option>
                    <option value="manual">Manual (select invoices)</option>
                </select>
            </div>
            <div id="gpManualSection" style="display:none;margin-top:14px;max-height:200px;overflow-y:auto;border:1px solid #e2e8f0;border-radius:10px;padding:12px;">
                <div id="gpInvoiceList"></div>
            </div>
            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:24px;">
                <button type="button" class="btn btn-secondary" onclick="closeGlobalPaymentModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitGlobalPayment()">Record Payment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        .period-shortcut {
            padding: 5px 12px;
            border-radius: 8px;
            border: 1.5px solid rgba(13,94,166,.12);
            background: #fff;
            font-size: 12px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            color: #5E7385;
            cursor: pointer;
            transition: all .15s;
        }
        .period-shortcut:hover {
            background: rgba(13,94,166,.06);
            border-color: rgba(13,94,166,.25);
            color: #0D5EA6;
        }
        .period-shortcut.active {
            background: rgba(13,94,166,.08);
            border-color: #0D5EA6;
            color: #0D5EA6;
        }
    </style>
    <script>
        function setPeriod(preset) {
            var now = new Date();
            var from, to;

            switch (preset) {
                case 'this_month':
                    from = new Date(now.getFullYear(), now.getMonth(), 1);
                    to = now;
                    break;
                case 'last_month':
                    from = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    to = new Date(now.getFullYear(), now.getMonth(), 0);
                    break;
                case 'last_3':
                    from = new Date(now.getFullYear(), now.getMonth() - 3, 1);
                    to = now;
                    break;
                case 'last_6':
                    from = new Date(now.getFullYear(), now.getMonth() - 6, 1);
                    to = now;
                    break;
                case 'this_year':
                    from = new Date(now.getFullYear(), 0, 1);
                    to = now;
                    break;
                case 'last_year':
                    from = new Date(now.getFullYear() - 1, 0, 1);
                    to = new Date(now.getFullYear() - 1, 11, 31);
                    break;
                case 'all':
                    from = null;
                    to = null;
                    break;
            }

            document.getElementById('fromDate').value = from ? formatDate(from) : '';
            document.getElementById('toDate').value = to ? formatDate(to) : '';

            // Highlight active shortcut
            document.querySelectorAll('.period-shortcut').forEach(function(btn) { btn.classList.remove('active'); });
            event.target.classList.add('active');
        }

        function formatDate(d) {
            var year = d.getFullYear();
            var month = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return year + '-' + month + '-' + day;
        }

        var selectedCustomerId = @(selectedCustomerId.HasValue ? selectedCustomerId.Value.ToString() : "null");

        // Restore filters from localStorage
        (function restoreFilters() {
            var saved = localStorage.getItem('statementFilters');
            if (saved) {
                try {
                    var filters = JSON.parse(saved);
                    if (filters.customerId) document.getElementById('customerSelect').value = filters.customerId;
                    if (filters.fromDate) document.getElementById('fromDate').value = filters.fromDate;
                    if (filters.toDate) document.getElementById('toDate').value = filters.toDate;
                } catch (e) {}
            }
        })();

        // Auto-generate if filters are restored (or pre-selected)
        var restoredCustomerId = document.getElementById('customerSelect').value;
        var restoredFrom = document.getElementById('fromDate').value;
        var restoredTo = document.getElementById('toDate').value;

        if (restoredCustomerId && restoredFrom && restoredTo) {
            document.addEventListener('DOMContentLoaded', function () {
                generateStatement();
                loadEmailHistory(restoredCustomerId);
            });
        } else if (selectedCustomerId) {
            document.addEventListener('DOMContentLoaded', function () {
                loadEmailHistory(selectedCustomerId);
            });
        }

        function onCustomerChanged() {
            var customerId = document.getElementById('customerSelect').value;
            if (customerId) {
                loadEmailHistory(customerId);
            } else {
                document.getElementById('emailHistorySection').style.display = 'none';
            }
        }

        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        var currencySymbol = '€';

        async function generateStatement() {
            var customerId = document.getElementById('customerSelect').value;
            var fromDate = document.getElementById('fromDate').value;
            var toDate = document.getElementById('toDate').value;

            // Persist filters to localStorage
            localStorage.setItem('statementFilters', JSON.stringify({ customerId: customerId, fromDate: fromDate, toDate: toDate }));

            BlockUI.show('Generating statement...');
            try {
                var response = await fetch('/Statement/Generate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: 'customerId=' + encodeURIComponent(customerId) + '&fromDate=' + encodeURIComponent(fromDate) + '&toDate=' + encodeURIComponent(toDate)
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    renderStatement(data);
                    loadEmailHistory(customerId);
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        function renderStatement(data) {
            // Store customer email for the email dialog
            window._lastCustomerEmail = data.customerEmail || '';

            // Show results section
            document.getElementById('statementResults').style.display = 'block';

            // Populate customer header
            var customerSelect = document.getElementById('customerSelect');
            var customerName = customerSelect.options[customerSelect.selectedIndex].text;
            document.getElementById('customerName').textContent = customerName;

            var fromDate = document.getElementById('fromDate').value;
            var toDate = document.getElementById('toDate').value;
            document.getElementById('statementPeriod').textContent = fromDate + ' to ' + toDate;

            // Populate KPI cards
            document.getElementById('openingBalance').textContent = '€' + formatCurrency(data.openingBalance);
            document.getElementById('totalInvoiced').textContent = '€' + formatCurrency(data.totalInvoiced);
            document.getElementById('totalPaid').textContent = '€' + formatCurrency(data.totalPaid);
            document.getElementById('closingBalance').textContent = '€' + formatCurrency(data.closingBalance);
            document.getElementById('invoiceCount').textContent = data.invoiceCount + ' invoice' + (data.invoiceCount !== 1 ? 's' : '');
            document.getElementById('paymentCount').textContent = data.paymentCount + ' payment' + (data.paymentCount !== 1 ? 's' : '');

            // Style closing balance: red if > 0 (outstanding), green if = 0 (settled)
            var closingBalanceEl = document.getElementById('closingBalance');
            var closingBalanceCard = document.getElementById('closingBalanceCard');
            if (data.closingBalance > 0) {
                closingBalanceEl.style.color = '#C24A4A';
                closingBalanceCard.style.borderLeftColor = '#C24A4A';
                document.getElementById('closingBalanceLabel').textContent = 'Outstanding';
            } else {
                closingBalanceEl.style.color = '#129867';
                closingBalanceCard.style.borderLeftColor = '#129867';
                document.getElementById('closingBalanceLabel').textContent = 'Settled';
            }

            // Render transaction table
            renderTransactionTable(data.lines, data.closingBalance);
        }

        function renderTransactionTable(lines, closingBalance) {
            var tbody = document.getElementById('transactionTableBody');
            tbody.innerHTML = '';

            var totalDebit = 0;
            var totalCredit = 0;

            lines.forEach(function (line) {
                var tr = document.createElement('tr');

                // Date
                var tdDate = document.createElement('td');
                tdDate.textContent = line.date;
                tr.appendChild(tdDate);

                // Type pill
                var tdType = document.createElement('td');
                var pillClass = 'pill-blue';
                if (line.type === 'Invoice') pillClass = 'pill-gold';
                else if (line.type === 'Payment') pillClass = 'pill-green';
                else if (line.type === 'Closing') pillClass = 'pill-red';
                tdType.innerHTML = '<span class="pill ' + pillClass + '">' + line.type + '</span>';
                tr.appendChild(tdType);

                // Reference — styled based on line type
                var tdRef = document.createElement('td');
                if (line.type === 'Invoice') {
                    tdRef.innerHTML = '<strong style="color:#0D5EA6;">' + escapeHtml(line.reference) + '</strong>';
                } else if (line.type === 'Payment') {
                    // Split reference: highlight invoice number, mute the rest
                    var refText = line.reference || '';
                    var invoiceMatch = refText.match(/(INV-\d+-\d+)/);
                    if (invoiceMatch) {
                        var parts = refText.split(invoiceMatch[1]);
                        tdRef.innerHTML = '<span style="color:#5a6a7a;">' + escapeHtml(parts[0]) + '</span>' +
                            '<strong style="color:#0D5EA6;">' + invoiceMatch[1] + '</strong>' +
                            '<span style="color:#94a3b8;font-size:12px;">' + escapeHtml(parts[1] || '') + '</span>';
                    } else {
                        tdRef.innerHTML = '<span style="color:#5a6a7a;">' + escapeHtml(refText) + '</span>';
                    }
                } else {
                    tdRef.textContent = line.reference;
                    tdRef.style.color = '#5a6a7a';
                }
                tr.appendChild(tdRef);

                // Debit
                var tdDebit = document.createElement('td');
                tdDebit.style.textAlign = 'right';
                if (line.debit > 0) {
                    tdDebit.textContent = '€' + formatCurrency(line.debit);
                    totalDebit += line.debit;
                }
                tr.appendChild(tdDebit);

                // Credit
                var tdCredit = document.createElement('td');
                tdCredit.style.textAlign = 'right';
                if (line.credit > 0) {
                    tdCredit.textContent = '€' + formatCurrency(line.credit);
                    totalCredit += line.credit;
                }
                tr.appendChild(tdCredit);

                // Running Balance
                var tdBalance = document.createElement('td');
                tdBalance.style.textAlign = 'right';
                tdBalance.style.fontWeight = '700';
                tdBalance.textContent = '€' + formatCurrency(line.runningBalance);
                tr.appendChild(tdBalance);

                // Actions (Void + Receipt buttons for payments)
                var tdActions = document.createElement('td');
                tdActions.style.textAlign = 'center';
                tdActions.style.whiteSpace = 'nowrap';
                if (line.type === 'Payment' && line.paymentId && !line.isVoided) {
                    var receiptBtn = document.createElement('button');
                    receiptBtn.textContent = 'Receipt';
                    receiptBtn.className = 'tbl-action tbl-action--primary';
                    receiptBtn.onclick = function() { generateReceiptFromStatement(line.paymentId); };
                    tdActions.appendChild(receiptBtn);

                    var voidBtn = document.createElement('button');
                    voidBtn.textContent = 'Void';
                    voidBtn.className = 'tbl-action tbl-action--danger';
                    voidBtn.style.marginLeft = '6px';
                    voidBtn.setAttribute('data-payment-id', line.paymentId);
                    voidBtn.onclick = function() { voidPaymentFromStatement(line.paymentId, line.credit); };
                    tdActions.appendChild(voidBtn);
                } else if (line.type === 'Payment' && line.isVoided) {
                    tdActions.innerHTML = '<span style="font-size:10px;font-weight:700;color:#C24A4A;background:rgba(194,74,74,.08);padding:2px 8px;border-radius:12px;">Voided</span>';
                }
                tr.appendChild(tdActions);

                tbody.appendChild(tr);
            });

            // Render footer totals
            var tfoot = document.getElementById('transactionTableFooter');
            tfoot.innerHTML = '<tr style="font-weight:700;border-top:2px solid #0D5EA6;">' +
                '<td colspan="3" style="text-align:right;">Period Totals</td>' +
                '<td style="text-align:right;">€' + formatCurrency(totalDebit) + '</td>' +
                '<td style="text-align:right;">€' + formatCurrency(totalCredit) + '</td>' +
                '<td style="text-align:right;padding-right:4px;color:' + (closingBalance > 0 ? '#C24A4A' : '#129867') + ';">€' + formatCurrency(closingBalance) + '</td>' +
                '</tr>';
        }

        function formatCurrency(value) {
            return parseFloat(value).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        async function downloadPdf() {
            var customerId = document.getElementById('customerSelect').value;
            var fromDate = document.getElementById('fromDate').value;
            var toDate = document.getElementById('toDate').value;

            if (!customerId || !fromDate || !toDate) {
                Swal.fire({ title: 'Error', text: 'Please generate a statement first.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                return;
            }

            BlockUI.show('Generating PDF...');
            try {
                var response = await fetch('/Statement/DownloadPdf', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: 'customerId=' + encodeURIComponent(customerId) + '&fromDate=' + encodeURIComponent(fromDate) + '&toDate=' + encodeURIComponent(toDate)
                });

                var contentType = response.headers.get('content-type') || '';

                if (contentType.indexOf('application/pdf') !== -1) {
                    var blob = await response.blob();
                    var disposition = response.headers.get('content-disposition');
                    var filename = 'Statement.pdf';
                    if (disposition) {
                        var match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                        if (match && match[1]) {
                            filename = match[1].replace(/['"]/g, '');
                        }
                    }

                    var url = window.URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);
                    BlockUI.hide();
                } else {
                    var data = await response.json();
                    BlockUI.hide();
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to generate PDF.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function emailStatement() {
            var customerId = document.getElementById('customerSelect').value;
            var fromDate = document.getElementById('fromDate').value;
            var toDate = document.getElementById('toDate').value;

            if (!customerId || !fromDate || !toDate) {
                Swal.fire({ title: 'Error', text: 'Please generate a statement first.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                return;
            }

            // Get the selected customer's name for the dialog
            var customerSelect = document.getElementById('customerSelect');
            var customerName = customerSelect.options[customerSelect.selectedIndex].text;

            // Show email input dialog pre-filled with customer's registered email (if available)
            var defaultEmail = window._lastCustomerEmail || '';
            var { value: recipientEmail } = await Swal.fire({
                title: 'Email Statement',
                html: '<div style="text-align:center;">Send statement for<br><strong>' + customerName + '</strong> to:</div>',
                input: 'email',
                inputValue: defaultEmail,
                inputPlaceholder: 'Enter email address',
                showCancelButton: true,
                confirmButtonText: 'Send',
                confirmButtonColor: '#0D5EA6',
                inputValidator: function (value) {
                    if (!value) return 'Please enter an email address.';
                    if (!value.includes('@@') || !value.includes('.')) return 'Please enter a valid email address.';
                }
            });

            if (!recipientEmail) return; // User cancelled

            BlockUI.show('Sending statement email...');
            try {
                var response = await fetch('/Statement/EmailStatement', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: 'customerId=' + encodeURIComponent(customerId) + '&fromDate=' + encodeURIComponent(fromDate) + '&toDate=' + encodeURIComponent(toDate) + '&recipientEmail=' + encodeURIComponent(recipientEmail)
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({ title: 'Email Sent', html: '<p>' + (data.message || 'Statement emailed successfully.') + '</p><p style="font-size:12px;color:#8a9bab;margin-top:10px;font-style:italic;">Please note: the email may be delivered to the recipient\'s junk or spam folder.</p>', icon: 'success', confirmButtonColor: '#0D5EA6' });
                    loadEmailHistory(customerId);
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function loadEmailHistory(customerId) {
            if (!customerId) return;

            document.getElementById('emailHistorySection').style.display = 'block';
            BlockUI.show('Loading email history...');
            try {
                var response = await fetch('/Statement/GetEmailHistory?customerId=' + encodeURIComponent(customerId));
                var data = await response.json();
                BlockUI.hide();

                var container = document.getElementById('emailHistoryContent');

                if (data.success && data.records && data.records.length > 0) {
                    var html = '<div class="scroll-hint">\u2190 Scroll horizontally \u2192</div>' +
                        '<div class="table-responsive">' +
                        '<table><thead><tr>' +
                        '<th>Date Sent</th>' +
                        '<th>Statement Period</th>' +
                        '<th>Recipient Email</th>' +
                        '<th>Sent By</th>' +
                        '<th>Actions</th>' +
                        '</tr></thead><tbody>';

                    data.records.forEach(function (record) {
                        html += '<tr>' +
                            '<td>' + formatDateTime(record.sentAtUtc) + '</td>' +
                            '<td>' + record.fromDate + ' \u2013 ' + record.toDate + '</td>' +
                            '<td>' + escapeHtml(record.recipientEmail) + '</td>' +
                            '<td>' + escapeHtml(record.sentByDisplayName) + '</td>' +
                            '<td><a href="javascript:void(0)" onclick="viewHistoryStatement(\'' + record.fromDate + '\', \'' + record.toDate + '\')" style="color:var(--blue);font-weight:700;font-size:13px;">View</a></td>' +
                            '</tr>';
                    });

                    html += '</tbody></table></div>';
                    container.innerHTML = html;
                } else if (data.success) {
                    container.innerHTML = '<p style="font-size:14px;color:#5a6a7a;">No statements have been emailed for this customer.</p>';
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to load email history.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred while loading email history.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        function viewHistoryStatement(fromDate, toDate) {
            document.getElementById('fromDate').value = fromDate;
            document.getElementById('toDate').value = toDate;
            generateStatement();
        }

        function formatDateTime(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleDateString() + ' ' + date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // =========================================================================
        // Global Payment Recording
        // =========================================================================
        function openGlobalPaymentModal() {
            var customerId = document.getElementById('customerSelect').value;
            if (!customerId) return;

            var customerName = document.getElementById('customerSelect').selectedOptions[0].text;
            document.getElementById('gpCustomerName').textContent = customerName;
            document.getElementById('gpOutstandingInfo').textContent = 'Loading outstanding balance...';
            document.getElementById('gpDate').value = new Date().toISOString().split('T')[0];
            document.getElementById('gpAmount').value = '';
            document.getElementById('gpReference').value = '';
            document.getElementById('gpNotes').value = '';
            document.getElementById('gpMode').value = 'fifo';
            document.getElementById('gpManualSection').style.display = 'none';

            // Load outstanding invoices
            fetch('/Revenue/AxGetOutstandingInvoicesForCustomer?customerId=' + customerId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        var invoices = Array.isArray(data.data) ? data.data : [];
                        var total = invoices.reduce(function(s, i) { return s + i.outstandingBalance; }, 0);
                        var info = 'Total outstanding: ' + currencySymbol + total.toFixed(2) + ' across ' + invoices.length + ' invoice(s)';
                        if (data.creditBalance > 0) {
                            info += '<br/><strong style="color:#129867;">Available credit: ' + currencySymbol + data.creditBalance.toFixed(2) + '</strong>';
                        }
                        document.getElementById('gpOutstandingInfo').innerHTML = info;
                        window._gpInvoices = invoices;
                        window._gpCreditBalance = data.creditBalance || 0;
                        renderManualInvoices(invoices);

                        // Show/hide Apply Credit button
                        var applyCreditBtn = document.getElementById('btnApplyCredit');
                        if (data.creditBalance > 0 && invoices.length > 0) {
                            applyCreditBtn.style.display = 'inline-flex';
                            applyCreditBtn.textContent = 'Apply ' + currencySymbol + data.creditBalance.toFixed(2) + ' Credit';
                        } else {
                            applyCreditBtn.style.display = 'none';
                        }
                    } else {
                        document.getElementById('gpOutstandingInfo').textContent = 'Error: ' + (data.message || 'Could not load invoices');
                    }
                })
                .catch(function(err) {
                    document.getElementById('gpOutstandingInfo').textContent = 'Failed to load outstanding invoices. Check console.';
                    console.error('Outstanding invoices fetch error:', err);
                });

            document.getElementById('globalPaymentModal').style.display = 'flex';
        }

        function closeGlobalPaymentModal() {
            document.getElementById('globalPaymentModal').style.display = 'none';
        }

        async function voidPaymentFromStatement(paymentId, amount) {
            var result = await Swal.fire({
                title: 'Void this payment?',
                html: 'This will reverse the <strong>' + currencySymbol + amount.toFixed(2) + '</strong> payment. The affected invoice will be recalculated.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, void it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#64748b'
            });

            if (!result.isConfirmed) return;

            BlockUI.show('Voiding payment...');
            try {
                var response = await fetch('/Revenue/AxPostVoidPaymentSmart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: 'paymentId=' + paymentId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Voided', text: data.message, confirmButtonColor: '#0D5EA6' })
                        .then(function() { generateStatement(); });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function generateReceiptFromStatement(paymentId) {
            BlockUI.show('Checking receipt...');
            try {
                var checkResponse = await fetch('/Receipt/AxGetHasReceipt?paymentId=' + paymentId);
                var checkData = await checkResponse.json();
                BlockUI.hide();

                if (checkData.success && checkData.hasReceipt) {
                    window.location.href = '/Receipt/Detail/' + checkData.receiptId;
                    return;
                }

                openReceiptModal(paymentId);
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to check receipt status.', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function applyCredit() {
            var customerId = parseInt(document.getElementById('customerSelect').value);
            if (!customerId) return;

            var result = await Swal.fire({
                title: 'Apply Credit?',
                html: 'Apply available credit of <strong>' + currencySymbol + window._gpCreditBalance.toFixed(2) + '</strong> to outstanding invoices (oldest first)?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, apply',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#129867'
            });

            if (!result.isConfirmed) return;

            BlockUI.show('Applying credit...');
            try {
                var response = await fetch('/Revenue/AxPostApplyCredit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: 'customerId=' + customerId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    closeGlobalPaymentModal();
                    var msg = 'Credit applied to ' + data.allocatedCount + ' invoice(s). Total: ' + currencySymbol + data.totalAllocated.toFixed(2);
                    if (data.remainingCredit > 0) msg += '. Remaining credit: ' + currencySymbol + data.remainingCredit.toFixed(2);
                    Swal.fire({ icon: 'success', title: 'Credit Applied', text: msg, confirmButtonColor: '#0D5EA6' })
                        .then(function() { generateStatement(); });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        }

        document.getElementById('gpMode').addEventListener('change', function() {
            document.getElementById('gpManualSection').style.display = this.value === 'manual' ? 'block' : 'none';
        });

        function renderManualInvoices(invoices) {
            var html = '';
            invoices.forEach(function(inv) {
                html += '<div style="display:flex;gap:10px;align-items:center;margin-bottom:8px;">';
                html += '<div style="flex:1;font-size:13px;"><strong>' + inv.invoiceNumber + '</strong> — ' + inv.invoiceDate + ' — Outstanding: ' + currencySymbol + inv.outstandingBalance.toFixed(2) + '</div>';
                html += '<input type="number" step="0.01" min="0" max="' + inv.outstandingBalance + '" placeholder="0.00" style="width:100px;padding:6px;border-radius:6px;border:1px solid #d0d9e2;font-size:12px;" data-invoice-id="' + inv.invoiceId + '" class="gp-manual-amount" />';
                html += '</div>';
            });
            document.getElementById('gpInvoiceList').innerHTML = html || '<p style="font-size:13px;color:#5a6a7a;">No outstanding invoices.</p>';
        }

        async function submitGlobalPayment() {
            var customerId = parseInt(document.getElementById('customerSelect').value);
            var amount = parseFloat(document.getElementById('gpAmount').value);
            var date = document.getElementById('gpDate').value;
            var method = parseInt(document.getElementById('gpMethod').value);
            var reference = document.getElementById('gpReference').value;
            var notes = document.getElementById('gpNotes').value;
            var mode = document.getElementById('gpMode').value;

            if (!amount || amount <= 0) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Amount must be greater than zero.', confirmButtonColor: '#0D5EA6' });
                return;
            }

            if (!date) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Payment date is required.', confirmButtonColor: '#0D5EA6' });
                return;
            }

            // Check overpayment
            if (window._gpInvoices) {
                var totalOutstanding = window._gpInvoices.reduce(function(s, i) { return s + i.outstandingBalance; }, 0);
                if (amount > totalOutstanding) {
                    var result = await Swal.fire({
                        title: 'Overpayment Detected',
                        html: 'This payment exceeds the total outstanding by <strong>' + currencySymbol + (amount - totalOutstanding).toFixed(2) + '</strong>. The excess will be recorded as a credit.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Proceed',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#0D5EA6'
                    });
                    if (!result.isConfirmed) return;
                }
            }

            var payload = {
                customerId: customerId,
                amount: amount,
                paymentDateUtc: date + 'T00:00:00Z',
                paymentMethodTypeId: method,
                reference: reference || null,
                notes: notes || null,
                allocationMode: mode,
                manualAllocations: null
            };

            if (mode === 'manual') {
                var manualItems = [];
                document.querySelectorAll('.gp-manual-amount').forEach(function(input) {
                    var val = parseFloat(input.value);
                    if (val > 0) {
                        manualItems.push({ invoiceId: parseInt(input.dataset.invoiceId), amount: val });
                    }
                });
                payload.manualAllocations = manualItems;
            }

            BlockUI.show('Recording payment...');
            try {
                var response = await fetch('/Revenue/AxPostRecordGlobalPayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    BlockUI.hide();
                    var errorText = await response.text();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Server returned ' + response.status + ': ' + (errorText.substring(0, 200) || 'Unknown error'), confirmButtonColor: '#0D5EA6' });
                    return;
                }

                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    closeGlobalPaymentModal();
                    var msg = data.message || (data.allocationCount + ' invoice(s) allocated.');
                    if (data.creditAmount > 0) msg += '\nCredit: ' + currencySymbol + data.creditAmount.toFixed(2);
                    Swal.fire({ icon: 'success', title: 'Payment Recorded', text: msg, confirmButtonColor: '#0D5EA6' })
                        .then(function() { generateStatement(); });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                console.error('submitGlobalPayment error:', e);
                Swal.fire({ icon: 'error', title: 'Error', text: 'Error: ' + (e.message || 'An unexpected error occurred.'), confirmButtonColor: '#0D5EA6' });
            }
        }
    </script>
}

