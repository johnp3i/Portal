@{
    var paymentMethods = ViewBag.PaymentMethods as List<Portal.Infrastructure.Entities.PaymentMethodType> ?? new List<Portal.Infrastructure.Entities.PaymentMethodType>();
    var currencySymbol = ViewBag.CurrencySymbol as string ?? "E";
}

<div id="globalPaymentModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.4);backdrop-filter:blur(2px);align-items:flex-start;justify-content:center;overflow-y:auto;padding:24px 0;">
    <div style="background:#fff;border-radius:24px;padding:32px;width:100%;max-width:620px;box-shadow:0 20px 60px rgba(13,94,166,.18);margin:auto;flex-shrink:0;">
        <h2 style="font-size:22px;margin-bottom:6px;">Record Global Payment</h2>
        <p class="muted" style="font-size:14px;margin-bottom:24px;">Allocate a payment across multiple outstanding invoices for this customer.</p>

        <div id="gpModalContext" style="background:var(--bg-secondary, #EEF4F8);border-radius:12px;padding:14px 18px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;">
            <div>
                <div style="font-size:12px;color:var(--muted, #5a6a7a);font-weight:700;">CUSTOMER</div>
                <div style="font-weight:700;margin-top:2px;" id="gpCustomerName">-</div>
            </div>
            <div style="text-align:right;">
                <div style="font-size:12px;color:var(--muted, #5a6a7a);font-weight:700;">TOTAL OUTSTANDING</div>
                <div style="font-weight:700;color:var(--red, #C24A4A);margin-top:2px;" id="gpTotalOutstanding">-</div>
            </div>
        </div>

        <form id="globalPaymentForm" onsubmit="return false;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="gpCustomerId" value="" />

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="field">
                    <label for="gpPaymentDate">Payment Date *</label>
                    <input type="date" id="gpPaymentDate" required />
                </div>
                <div class="field">
                    <label for="gpAmount">Amount *</label>
                    <input type="number" id="gpAmount" step="0.01" min="0.01" placeholder="0.00" required />
                </div>
                <div class="field">
                    <label for="gpPaymentMethod">Payment Method *</label>
                    <select id="gpPaymentMethod" required>
                        <option value="">-- Select Method --</option>
                        @foreach (var method in paymentMethods)
                        {
                            <option value="@method.Id">@method.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="gpReference">Reference</label>
                    <input type="text" id="gpReference" placeholder="e.g. TXN-12345" />
                </div>
            </div>

            <div class="field" style="margin-top:16px;">
                <label for="gpNotes">Notes</label>
                <textarea id="gpNotes" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(13,94,166,.12);font:inherit;font-size:14px;resize:vertical;min-height:60px;" placeholder="Optional notes..."></textarea>
            </div>

            <div style="margin-top:20px;padding:14px 18px;background:var(--bg-secondary, #EEF4F8);border-radius:12px;">
                <label style="font-size:13px;font-weight:700;color:#1a2b3c;margin-bottom:8px;display:block;">Allocation Mode</label>
                <div style="display:flex;gap:12px;">
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:14px;">
                        <input type="radio" name="gpAllocationMode" value="fifo" checked onchange="toggleManualAllocation()" /> Auto (FIFO)
                    </label>
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:14px;">
                        <input type="radio" name="gpAllocationMode" value="manual" onchange="toggleManualAllocation()" /> Manual
                    </label>
                </div>
            </div>

            <div id="gpManualSection" style="display:none;margin-top:16px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                    <label style="font-size:13px;font-weight:700;">Select invoices to allocate:</label>
                    <span style="font-size:12px;color:var(--muted);" id="gpManualSum">Allocated: E0.00</span>
                </div>
                <div id="gpInvoiceList" style="max-height:200px;overflow-y:auto;border:1px solid rgba(13,94,166,.1);border-radius:12px;padding:8px;">
                    <p class="muted" style="font-size:13px;text-align:center;">Loading invoices...</p>
                </div>
            </div>

            <div id="gpValidationError" style="display:none;margin-top:12px;padding:10px 14px;border-radius:10px;background:rgba(194,74,74,.08);color:#C24A4A;font-size:13px;font-weight:600;"></div>

            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:24px;">
                <button type="button" class="btn btn-secondary" onclick="closeGlobalPaymentModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitGlobalPayment()">Record Payment</button>
            </div>
        </form>
    </div>
</div>
