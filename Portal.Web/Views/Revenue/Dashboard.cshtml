@using Portal.Infrastructure.Models
@{
    ViewData["Title"] = "Revenue Dashboard";

    var kpi = (DashboardKpiDto)ViewBag.KpiData;
    var revenueCollected = (List<MonthlyRevenueDto>)ViewBag.RevenueCollected;
    var invoicedVsCollected = (List<InvoicedVsCollectedDto>)ViewBag.InvoicedVsCollected;
    var collectionRate = (decimal)ViewBag.CollectionRate;
    var vatSummary = (VatSummaryDto)ViewBag.VatSummary;
    var vatLiability = (List<VatPeriodLiabilityDto>)ViewBag.VatLiability;
    var overdueInvoices = (PagedResult<OverdueInvoiceDto>)ViewBag.OverdueInvoices;
    var recentPayments = (PagedResult<RecentPaymentDto>)ViewBag.RecentPayments;
    var currency = (string)ViewBag.CurrencySymbol;
}

<!-- Topbar -->
<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Revenue Control</div>
        <h1 class="topbar-heading">Revenue Dashboard</h1>
        <p class="topbar-subtitle">Track outstanding receivables, overdue invoices, and payment activity.</p>
    </div>
    <div class="topbar-actions" style="display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn-outline" asp-action="Receivables" asp-controller="Revenue">View Receivables</a>
        <a class="btn btn-outline" asp-action="Index" asp-controller="Statement">Customer Statement</a>
        <a href="javascript:void(0)" class="btn btn-primary" onclick="openPaymentModalWithSelector()">Record Payment</a>
    </div>
</div>

<!-- Row 1: KPI Cards -->
<section class="gauge-row revenue-kpi-row" style="display:flex;gap:22px;margin-bottom:22px;flex-wrap:wrap;">
    <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #0D5EA6;">
        <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Outstanding Receivables</p>
        <h2 style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#0D5EA6;margin:0 0 4px 0;">@currency@kpi.OutstandingReceivables.ToString("N2")</h2>
        <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">@kpi.OutstandingInvoiceCount invoices awaiting payment</p>
    </div>
    <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #C24A4A;">
        <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Overdue Amount</p>
        <h2 style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#C24A4A;margin:0 0 4px 0;">@currency@kpi.OverdueAmount.ToString("N2")</h2>
        <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">@kpi.OverdueInvoiceCount invoices past due date</p>
    </div>
    <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #129867;">
        <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Paid This Month</p>
        <h2 style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#129867;margin:0 0 4px 0;">@currency@kpi.PaidThisMonth.ToString("N2")</h2>
        <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">@kpi.PaidThisMonthCount payments received</p>
    </div>
    <div class="glass card-pad" style="flex:1;min-width:180px;border-left:4px solid #C8912E;">
        <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;">Partially Paid</p>
        <h2 style="font-family:'Manrope',sans-serif;font-size:26px;font-weight:700;color:#C8912E;margin:0 0 4px 0;">@currency@kpi.PartiallyPaidAmount.ToString("N2")</h2>
        <p style="font-family:'Inter',sans-serif;font-size:12px;color:#8a9bab;margin:0;">@kpi.PartiallyPaidCount invoices with partial payments</p>
    </div>
</section>

<!-- Row 2: Revenue Collected, Invoiced vs Collected, Collection Rate -->
<section class="charts-row" style="display:flex;gap:22px;margin-bottom:22px;flex-wrap:wrap;">
    <div class="glass card-pad" style="flex:2;min-width:300px;">
        <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 14px 0;color:#1a2b3c;">Revenue Collected (Last 12 Months)</h3>
        <div style="position:relative;height:220px;max-width:100%;">
            <canvas id="revenueLineChart"></canvas>
        </div>
    </div>
    <div class="glass card-pad" style="flex:2;min-width:300px;">
        <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 14px 0;color:#1a2b3c;">Invoiced vs Collected</h3>
        <div style="position:relative;height:220px;max-width:100%;">
            <canvas id="invoicedVsCollectedChart"></canvas>
        </div>
    </div>
    <div class="glass card-pad" style="flex:1;min-width:200px;display:flex;flex-direction:column;justify-content:center;align-items:center;">
        <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 14px 0;color:#1a2b3c;">Collection Rate</h3>
        <div style="font-family:'Manrope',sans-serif;font-size:52px;font-weight:800;color:var(--green);">@collectionRate.ToString("0")%</div>
        <div style="font-size:13px;color:var(--muted);margin-top:6px;text-align:center;">of invoiced amount collected within 30 days</div>
        <div style="margin-top:14px;width:100%;height:10px;border-radius:8px;background:#e2e8f0;overflow:hidden;">
            <div style="height:100%;width:@collectionRate.ToString("0")%;background:linear-gradient(90deg, var(--green), #57E8A8);border-radius:8px;"></div>
        </div>
    </div>
</section>

<!-- Row 3: VAT Section — Dark Scoreboard (left) + VAT Liability chart (right) -->
<section class="grid-2 vat-section" style="display:grid;grid-template-columns:240px 1fr;gap:22px;margin-bottom:22px;">
    <!-- Left: Dark Scoreboard Panel -->
    <div style="background:linear-gradient(180deg,#0D5EA6 0%,#094A85 100%);border-radius:16px;padding:22px 20px;color:#fff;">
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;opacity:0.7;margin-bottom:18px;">VAT Summary · @vatSummary.PeriodLabel</div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.1);">
            <span style="font-size:13px;opacity:0.85;">Output VAT</span>
            <span style="font-family:'Manrope',sans-serif;font-size:17px;font-weight:800;color:#7EECC4;">@currency@vatSummary.TotalOutputVat.ToString("N2")</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.1);">
            <span style="font-size:13px;opacity:0.85;">Input VAT</span>
            <span style="font-family:'Manrope',sans-serif;font-size:17px;font-weight:800;color:#FFD580;">@currency@vatSummary.TotalInputVat.ToString("N2")</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.1);">
            <span style="font-size:13px;opacity:0.85;">Net Payable</span>
            <span style="font-family:'Manrope',sans-serif;font-size:17px;font-weight:800;color:#FF9B9B;">@currency@vatSummary.NetVatPayable.ToString("N2")</span>
        </div>
        <div style="margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.15);">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;opacity:0.7;margin-bottom:12px;">Revenue Insights</div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.1);">
                <span style="font-size:13px;opacity:0.85;">Paid This Month</span>
                <span style="font-family:'Manrope',sans-serif;font-size:15px;font-weight:800;color:#7EECC4;">@currency@kpi.PaidThisMonth.ToString("N0")</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.1);">
                <span style="font-size:13px;opacity:0.85;">Outstanding</span>
                <span style="font-family:'Manrope',sans-serif;font-size:15px;font-weight:800;color:#FF9B9B;">@currency@kpi.OutstandingReceivables.ToString("N0")</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;">
                <span style="font-size:13px;opacity:0.85;">Collection Rate</span>
                <span style="font-family:'Manrope',sans-serif;font-size:15px;font-weight:800;color:#fff;">@collectionRate.ToString("0")%</span>
            </div>
        </div>
    </div>
    <!-- Right: VAT Liability by Period chart -->
    <div class="glass card-pad">
        <h3 style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:700;margin:0 0 14px 0;color:#1a2b3c;">VAT Liability by Period</h3>
        <div style="position:relative;height:260px;max-width:100%;">
            <canvas id="vatLiabilityChart"></canvas>
        </div>
    </div>
</section>

<!-- Overdue Invoices Table -->
<section class="glass card-pad rev-table-card" style="margin-bottom:22px;">
    <div class="table-head-row" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 style="font-size:16px;color:var(--red);margin:0;">⚠ Overdue Invoices</h3>
        <div class="table-search" style="display:flex;gap:12px;align-items:flex-end;">
            <input type="text" id="overdueSearch" placeholder="Search invoice # or customer..." style="padding:8px 14px;border-radius:10px;border:1px solid rgba(13,94,166,.12);font:inherit;font-size:13px;min-width:220px;" />
            <button class="btn btn-primary" onclick="searchOverdueInvoices()">Search</button>
        </div>
    </div>
    <div class="scroll-hint">← Scroll horizontally →</div>
    <div class="table-responsive">
    <table id="overdueTable">
        <thead>
            <tr>
                <th>Invoice #</th>
                <th>Customer</th>
                <th>Due Date</th>
                <th>Days Overdue</th>
                <th style="text-align:right;">Outstanding</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="overdueTableBody">
            @foreach (var item in overdueInvoices.Items)
            {
                <tr>
                    <td data-mobile="invoice"><strong>@item.InvoiceNumber</strong></td>
                    <td data-mobile="customer">@item.CustomerName</td>
                    <td data-mobile="due">@item.DueDate.ToString("yyyy-MM-dd")</td>
                    <td data-mobile="days"><span class="pill pill-red">@item.DaysOverdue days</span></td>
                    <td data-mobile="amount" style="text-align:right;font-weight:700;color:var(--red);">@currency@item.OutstandingBalance.ToString("N2")</td>
                    <td data-mobile="action"><a asp-action="InvoiceDetail" asp-controller="Revenue" asp-route-id="@item.Id" class="tbl-action tbl-action--primary">View</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <!-- Pagination -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
        <div id="overduePaginationInfo" style="font-size:14px;color:var(--muted);">
            @{
                var overdueStart = overdueInvoices.TotalCount > 0 ? ((overdueInvoices.CurrentPage - 1) * overdueInvoices.PageSize) + 1 : 0;
                var overdueEnd = Math.Min(overdueInvoices.CurrentPage * overdueInvoices.PageSize, overdueInvoices.TotalCount);
            }
            Showing @overdueStart–@overdueEnd of @overdueInvoices.TotalCount overdue invoices
        </div>
        <div id="overduePaginationControls" style="display:flex;gap:8px;"></div>
    </div>
</section>

<!-- Recent Payments Table -->
<section class="glass card-pad rev-table-card">
    <div class="table-head-row" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 style="font-size:16px;color:var(--green);margin:0;">✓ Recent Payments</h3>
        <div class="table-search" style="display:flex;gap:12px;align-items:flex-end;">
            <input type="text" id="paymentsSearch" placeholder="Search invoice # or customer..." style="padding:8px 14px;border-radius:10px;border:1px solid rgba(13,94,166,.12);font:inherit;font-size:13px;min-width:220px;" />
            <button class="btn btn-primary" onclick="searchRecentPayments()">Search</button>
        </div>
    </div>
    <div class="scroll-hint">← Scroll horizontally →</div>
    <div class="table-responsive">
    <table id="paymentsTable">
        <thead>
            <tr>
                <th>Date</th>
                <th>Invoice #</th>
                <th>Customer</th>
                <th>Method</th>
                <th style="text-align:right;">Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="paymentsTableBody">
            @foreach (var item in recentPayments.Items)
            {
                <tr style="vertical-align:middle;@(item.IsVoided ? "opacity:0.5;text-decoration:line-through;" : "")">
                    <td data-mobile="date">
                        @item.PaymentDateUtc.ToString("yyyy-MM-dd")
                        @if (item.IsUpcoming)
                        {
                            <span style="display:inline-block;margin-left:6px;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;background:#FEF3CD;color:#8A6D3B;">Upcoming</span>
                        }
                    </td>
                    <td data-mobile="invoice"><strong>@item.InvoiceNumber</strong></td>
                    <td data-mobile="customer">@item.CustomerName</td>
                    <td data-mobile="method">
                        @if (item.PaymentMethodName == "Card")
                        {
                            <span style="display:inline-flex;align-items:center;gap:5px;">
                                <svg width="16" height="16" fill="none" stroke="#635bff" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                                <span style="font-size:12px;font-weight:600;color:#635bff;">Stripe</span>
                            </span>
                        }
                        else
                        {
                            @item.PaymentMethodName
                        }
                        @if (!string.IsNullOrEmpty(item.Reference))
                        {
                            <div style="font-size:11px;color:#5a6a7a;margin-top:3px;font-family:monospace;">@(item.Reference.Length > 20 ? item.Reference[..10] + "…" + item.Reference[^6..] : item.Reference)</div>
                        }
                    </td>
                    <td data-mobile="amount" style="text-align:right;font-weight:700;color:@(item.IsVoided ? "#999" : item.IsFullPayment ? "var(--green)" : "var(--gold)");">@currency@item.Amount.ToString("N2")</td>
                    <td data-mobile="status">
                        @if (item.IsVoided)
                        {
                            <span class="pill" style="background:#fdeaea;color:#C24A4A;font-weight:700;">Voided</span>
                        }
                        else if (item.IsFullPayment)
                        {
                            <span class="pill pill-green">Full Payment</span>
                        }
                        else
                        {
                            <span class="pill pill-gold">Partial</span>
                        }
                        @if (item.IsScheduled && !item.IsVoided)
                        {
                            <span class="pill" style="background:rgba(13,94,166,.08);color:#0D5EA6;font-weight:700;margin-left:4px;">Scheduled</span>
                        }
                    </td>
                    <td data-mobile="action" style="white-space:nowrap;">
                        @if (!item.IsVoided)
                        {
                            <button type="button" class="tbl-action tbl-action--primary js-edit-payment"
                                    data-payment-id="@item.PaymentId"
                                    data-method-id="@item.PaymentMethodTypeId"
                                    data-reference="@(item.Reference ?? "")"
                                    data-customer="@item.CustomerName"
                                    data-invoice="@item.InvoiceNumber"
                                    data-amount="@currency@item.Amount.ToString("N2")"
                                    data-date="@item.PaymentDateUtc.ToString("yyyy-MM-dd")"
                                    onclick="editPaymentFromButton(this)">Edit</button>
                            <button type="button" class="tbl-action tbl-action--primary" onclick="generateReceiptFromDashboard(@item.PaymentId)">Receipt</button>
                            <button type="button" class="tbl-action tbl-action--danger" onclick="voidPayment(@item.PaymentId)">Void</button>
                        }
                        else
                        {
                            <span style="font-size:10px;font-weight:700;color:#C24A4A;">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <!-- Pagination -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
        <div id="paymentsPaginationInfo" style="font-size:14px;color:var(--muted);">
            @{
                var paymentsStart = recentPayments.TotalCount > 0 ? ((recentPayments.CurrentPage - 1) * recentPayments.PageSize) + 1 : 0;
                var paymentsEnd = Math.Min(recentPayments.CurrentPage * recentPayments.PageSize, recentPayments.TotalCount);
            }
            Showing @paymentsStart–@paymentsEnd of @recentPayments.TotalCount payments
        </div>
        <div id="paymentsPaginationControls" style="display:flex;gap:8px;"></div>
    </div>
</section>

<!-- Payment Reminder Teaser (shown for Starter users without payment_reminder_auto access) -->
@if (ViewBag.ShowPaymentReminderTeaser == true)
{
<section class="glass card-pad" style="margin-top:24px;opacity:0.85;position:relative;overflow:hidden;cursor:pointer;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.85'">
    <a href="/PaymentReminder/Settings" style="text-decoration:none;display:block;">
        <div style="display:flex;align-items:center;gap:16px;">
            <div style="width:48px;height:48px;border-radius:12px;background:#EEF4F8;display:flex;align-items:center;justify-content:center;">
                <svg width="22" height="22" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </div>
            <div style="flex:1;">
                <h3 style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;color:#1a2b3c;margin:0 0 4px;">Automated Payment Reminders</h3>
                <p style="font-size:14px;color:#5a6a7a;margin:0;">Automatically send escalating reminders for overdue invoices. Schedule friendly, firm, and formal follow-ups with full tracking.</p>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                <span style="font-size:11px;font-weight:600;color:#0D5EA6;background:rgba(13,94,166,.08);padding:3px 10px;border-radius:50px;">Upgrade</span>
                <span class="btn btn-primary" style="min-width:120px;text-align:center;">Learn More</span>
            </div>
        </div>
    </a>
</section>
}

<!-- Cash Flow Teaser (shown for Starter users without cashflow access) -->
@if (ViewBag.ShowCashFlowTeaser == true)
{
<section class="glass card-pad" style="margin-top:24px;opacity:0.85;position:relative;overflow:hidden;cursor:pointer;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.85'">
    <a href="/CashFlow" style="text-decoration:none;display:block;">
        <div style="display:flex;align-items:center;gap:16px;">
            <div style="width:48px;height:48px;border-radius:12px;background:#EEF4F8;display:flex;align-items:center;justify-content:center;">
                <svg width="22" height="22" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><path d="M2.25 18L9 11.25l4.306 4.306a11.95 11.95 0 015.814-5.518l2.74-1.22"/><path d="M16.5 6h5.25v5.25"/></svg>
            </div>
            <div style="flex:1;">
                <h3 style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;color:#1a2b3c;margin:0 0 4px;">Cash Flow Forecasting</h3>
                <p style="font-size:14px;color:#5a6a7a;margin:0;">Project your future cash position with confidence-weighted inflow projections and historical expense analysis.</p>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                <span style="font-size:11px;font-weight:600;color:#0D5EA6;background:rgba(13,94,166,.08);padding:3px 10px;border-radius:50px;">Upgrade</span>
                <span class="btn btn-primary" style="min-width:120px;text-align:center;">Learn More</span>
            </div>
        </div>
    </a>
</section>
}

<!-- Bottom spacer for smaller screens -->
<div style="height:60px;"></div>

<!-- Payment Modal Partial -->
@await Html.PartialAsync("_PaymentModal")

<!-- Generate Receipt Modal -->
@await Html.PartialAsync("_GenerateReceiptModal")

<!-- Edit Payment Modal -->
@await Html.PartialAsync("_EditPaymentModal")

@section Scripts {
    <style>
        /* ══ Revenue Dashboard — mobile responsiveness (≤768px) ═══════════════════
           Four fixes layered on top of the shared mobile.css:
             1. Row 3 VAT section (inline 240px 1fr grid) → single column.
             2. Row 2 charts + collection rate → full-width stack (the generic
                2-col rule squeezes 220px charts too small).
             3. Overdue + Recent Payments tables → native stacked cards (the
                generic .dashboard-card nth-child map doesn't fit 6/7 columns, so
                these are positioned explicitly by data-mobile).
             4. Table header rows → title over a full-width search. */
        @@media (max-width: 768px) {
            /* 1 — VAT section: inline grid-template-columns:240px 1fr needs an
               !important override to collapse (inline style beats the class). */
            .vat-section {
                grid-template-columns: 1fr !important;
            }

            /* 2 — Charts row: stack each card full-width instead of the generic
               2-column squeeze so the canvases keep a readable height. The
               selector is deliberately high-specificity (element + two
               attribute/class hooks) to beat the shared rule
               section[style*="display:flex"][style*="gap: 22px"] which otherwise
               forces a cramped 1fr 1fr grid. */
            section.charts-row[style*="gap: 22px"] {
                display: flex !important;
                flex-direction: column !important;
                gap: 14px !important;
                grid-template-columns: none !important;
            }
            section.charts-row[style*="gap: 22px"] > .glass.card-pad {
                flex: 1 1 100% !important;
                min-width: 0 !important;
                width: 100% !important;
            }

            /* 4 — Table header: title on its own line, search full-width below. */
            .rev-table-card .table-head-row {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 12px !important;
            }
            .rev-table-card .table-search {
                flex-direction: row !important;
                gap: 8px !important;
            }
            .rev-table-card .table-search input {
                flex: 1 1 auto !important;
                min-width: 0 !important;
            }

            /* 3 — Card-list transform for both revenue tables. Scoped to the two
               table bodies; cells positioned by data-mobile. */
            .rev-table-card .scroll-hint { display: none !important; }
            .rev-table-card .table-responsive {
                overflow-x: visible !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            #overdueTable,
            #overdueTable tbody,
            #paymentsTable,
            #paymentsTable tbody {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
            }
            #overdueTable thead,
            #paymentsTable thead { display: none !important; }

            #overdueTable tbody td,
            #paymentsTable tbody td {
                white-space: normal !important;
                min-width: 0 !important;
                overflow-wrap: anywhere;
                border: none !important;
                padding: 0;
            }

            /* The card */
            #overdueTable tbody tr,
            #paymentsTable tbody tr {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) auto;
                gap: 2px 12px;
                align-items: start;
                width: 100%;
                max-width: 100%;
                box-sizing: border-box;
                padding: 16px !important;
                margin-bottom: 12px;
                border: 1px solid rgba(13, 94, 166, 0.10) !important;
                border-radius: 16px;
                background: #fff !important;
                box-shadow: 0 1px 3px rgba(11, 27, 40, 0.05);
            }

            /* ── Overdue card ─────────────────────────────────────────────── */
            /* Row 1: Invoice # (left) + Days-overdue pill (right) */
            #overdueTable tbody td[data-mobile="invoice"] {
                grid-row: 1; grid-column: 1;
                font-weight: 700; font-size: 15px; line-height: 1.25;
            }
            #overdueTable tbody td[data-mobile="days"] {
                grid-row: 1; grid-column: 2; justify-self: end;
            }
            /* Row 2: Customer, full width */
            #overdueTable tbody td[data-mobile="customer"] {
                grid-row: 2; grid-column: 1 / -1;
                margin-top: 8px; font-size: 13.5px; color: #334155;
            }
            /* Row 3: Due date (left) + Outstanding amount (right) */
            #overdueTable tbody td[data-mobile="due"] {
                grid-row: 3; grid-column: 1;
                margin-top: 8px; font-size: 12px; color: #73889a; font-weight: 700;
            }
            #overdueTable tbody td[data-mobile="due"]::before {
                content: "Due "; opacity: .7;
            }
            #overdueTable tbody td[data-mobile="amount"] {
                grid-row: 3; grid-column: 2; justify-self: end;
                margin-top: 8px; font-size: 15px;
            }
            /* Footer: View action, full-width */
            #overdueTable tbody td[data-mobile="action"] {
                grid-row: 4; grid-column: 1 / -1;
                text-align: center !important;
                margin-top: 14px; padding-top: 14px !important;
                border-top: 1px solid rgba(13, 94, 166, 0.08) !important;
            }
            #overdueTable tbody td[data-mobile="action"] .tbl-action {
                display: block; width: 100%; box-sizing: border-box;
                padding: 11px 12px; font-size: 13.5px;
            }

            /* ── Recent Payments card ─────────────────────────────────────── */
            /* Row 1: Invoice # (left) + Amount (right) */
            #paymentsTable tbody td[data-mobile="invoice"] {
                grid-row: 1; grid-column: 1;
                font-weight: 700; font-size: 15px; line-height: 1.25;
            }
            #paymentsTable tbody td[data-mobile="amount"] {
                grid-row: 1; grid-column: 2; justify-self: end;
                font-size: 15px; font-weight: 700;
            }
            /* Row 2: Customer, full width */
            #paymentsTable tbody td[data-mobile="customer"] {
                grid-row: 2; grid-column: 1 / -1;
                margin-top: 8px; font-size: 13.5px; color: #334155;
            }
            /* Row 3: Date (left) + Method (right) */
            #paymentsTable tbody td[data-mobile="date"] {
                grid-row: 3; grid-column: 1;
                margin-top: 8px; font-size: 12px; color: #73889a; font-weight: 700;
            }
            #paymentsTable tbody td[data-mobile="method"] {
                grid-row: 3; grid-column: 2; justify-self: end;
                margin-top: 8px; font-size: 12.5px;
            }
            /* Row 4: Status pills, full width */
            #paymentsTable tbody td[data-mobile="status"] {
                grid-row: 4; grid-column: 1 / -1;
                margin-top: 10px;
            }
            /* Footer: Receipt / Void actions, side by side full-width */
            #paymentsTable tbody td[data-mobile="action"] {
                grid-row: 5; grid-column: 1 / -1;
                margin-top: 14px; padding-top: 14px !important;
                border-top: 1px solid rgba(13, 94, 166, 0.08) !important;
                display: flex; gap: 8px;
                white-space: normal !important;
            }
            #paymentsTable tbody td[data-mobile="action"] .tbl-action {
                flex: 1; text-align: center;
                padding: 11px 12px; font-size: 13.5px;
            }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        // Chart data from server
        var revenueCollectedData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueCollected.Select(r => r.Label))),
            amounts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueCollected.Select(r => r.Amount)))
        };
        var invoicedVsCollectedData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(invoicedVsCollected.Select(r => r.Label))),
            invoiced: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(invoicedVsCollected.Select(r => r.InvoicedAmount))),
            collected: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(invoicedVsCollected.Select(r => r.CollectedAmount)))
        };
        var vatLiabilityData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vatLiability.Select(v => v.PeriodLabel))),
            output: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vatLiability.Select(v => v.OutputVat))),
            input: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vatLiability.Select(v => v.InputVat))),
            net: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vatLiability.Select(v => v.NetPayable)))
        };
        var currencySymbol = '@Html.Raw(currency)';
        var overdueCurrentPage = @overdueInvoices.CurrentPage;
        var overdueTotalPages = @overdueInvoices.TotalPages;
        var paymentsCurrentPage = @recentPayments.CurrentPage;
        var paymentsTotalPages = @recentPayments.TotalPages;
    </script>
    <script src="/js/revenue-dashboard.js?v=3"></script>
    <script src="/js/revenue-payment.js?v=2"></script>
}
