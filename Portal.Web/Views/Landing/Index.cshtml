@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>3 Inventors Portal — Business Management Platform</title>
    <meta name="description" content="Run your business with structure, clarity, and control. Manage quotations, invoices, customers, VAT, purchases, and revenue from one operational workspace." />
    <meta name="theme-color" content="#0D5EA6" />
    <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon-180x180.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/images/favicon/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/images/favicon/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/images/favicon/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/images/favicon/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="57x57" href="/images/favicon/apple-touch-icon-57x57.png" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="msapplication-TileImage" content="/images/favicon/ms-icon-144x144.png" />
    <meta name="msapplication-TileColor" content="#0D5EA6" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        :root{
            --blue:#0D5EA6;--blue-dark:#0B4E89;--cyan:#57B8E8;--green:#129867;
            --warning:#C8912E;--danger:#C24A4A;--text:#0B1B28;--muted:#5E7385;
            --bg:#F7FAFC;--bg2:#EEF4F8;--line:rgba(13,94,166,.11);
            --shadow:0 24px 70px rgba(13,94,166,.11);--radius:28px;
        }
        html{scroll-behavior:smooth}
        body{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text);background:radial-gradient(circle at 12% 0%,rgba(13,94,166,.09),transparent 27%),radial-gradient(circle at 88% 8%,rgba(87,184,232,.09),transparent 24%),linear-gradient(180deg,#FBFDFF 0%,var(--bg2) 48%,var(--bg) 100%);line-height:1.6;-webkit-font-smoothing:antialiased}
        h1,h2,h3{font-family:Manrope,Inter,sans-serif;letter-spacing:-.035em;line-height:1.05}
        a{color:inherit;text-decoration:none}
        .container{max-width:1180px;margin:0 auto;padding:0 28px}
        .nav{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.84);backdrop-filter:blur(14px);border-bottom:1px solid rgba(13,94,166,.08);padding:15px 0px}
        .nav-inner{height:76px;display:flex;align-items:center;justify-content:space-between}
        .brand{display:flex;align-items:center;gap:13px;text-decoration:none;color:var(--text)}
        .brand-block{display:flex;flex-direction:column;align-items:flex-start;gap:4px}
        .brand-logo{height:32px;width:auto;margin-left:-6px}
        .brand-sub{font-size:10px;font-weight:800;color:#6f8394;letter-spacing:.22em;text-transform:uppercase}
        .nav-links{display:flex;align-items:center;gap:28px}
        .nav-links a{font-size:14px;font-weight:700;color:var(--muted);text-decoration:none}
        .nav-links a.btn-primary{color:#fff}
        .nav-links a:hover{color:var(--blue)}
        .nav-links a.btn-primary:hover{color:#fff}
        .btn{display:inline-flex;align-items:center;justify-content:center;border-radius:15px;padding:13px 21px;font-weight:800;text-decoration:none;transition:.18s ease;border:1px solid transparent}
        .btn-primary{background:linear-gradient(180deg,#1B6FBA,var(--blue));color:#fff;box-shadow:0 16px 34px rgba(13,94,166,.24)}
        .btn-primary:hover{transform:translateY(-1px);background:linear-gradient(180deg,#227AC8,#0B4E89)}
        .btn-secondary{background:rgba(255,255,255,.78);border-color:rgba(13,94,166,.15);color:var(--blue-dark)}
        .btn-secondary:hover{background:#fff;border-color:rgba(13,94,166,.28)}
        .hero{padding:90px 0 72px}
        .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
        .hero-content{text-align:left}
        .eyebrow{display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(13,94,166,.12);background:rgba(255,255,255,.86);border-radius:999px;padding:10px 15px;font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:var(--blue-dark);box-shadow:0 10px 25px rgba(13,94,166,.06)}
        .dot{width:10px;height:10px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 8px rgba(87,184,232,.12)}
        h1{margin:24px 0 0;font-size:clamp(42px,5vw,58px);max-width:620px;line-height:.97;font-weight:800}
        .highlight{background:linear-gradient(135deg,var(--blue),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
        .hero p{max-width:540px;margin:22px 0 0;color:var(--muted);font-size:18px;line-height:1.75}
        .hero-cta{margin-top:32px;display:flex;gap:14px;flex-wrap:wrap}
        .product-card{position:relative;background:linear-gradient(180deg,rgba(255,255,255,.99),rgba(244,249,253,.97));border:1px solid rgba(13,94,166,.09);border-radius:28px;padding:22px;box-shadow:0 32px 80px rgba(13,94,166,.13),0 8px 20px rgba(13,94,166,.06);overflow:hidden}
        .product-card::before{content:"";position:absolute;inset:-1px;border-radius:29px;background:linear-gradient(160deg,rgba(87,184,232,.25),rgba(13,94,166,.08),transparent 60%);z-index:0;pointer-events:none}
        .product-card::after{content:"";position:absolute;right:-70px;top:-70px;width:200px;height:200px;border-radius:999px;background:rgba(87,184,232,.10)}
        .screen{position:relative;z-index:1;border-radius:20px;background:#fff;border:1px solid rgba(13,94,166,.08);overflow:hidden;box-shadow:0 12px 32px rgba(13,94,166,.08)}
        .screen-top{height:42px;background:#F2F8FC;border-bottom:1px solid rgba(13,94,166,.08);display:flex;align-items:center;gap:7px;padding:0 16px}
        .mini-dot{width:9px;height:9px;border-radius:50%;background:#d7e4ee}
        .screen-body{padding:18px}
        .kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
        .kpi{border-radius:14px;background:#F7FAFC;border:1px solid rgba(13,94,166,.08);padding:14px}
        .kpi label{display:block;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#60778c}
        .kpi strong{display:block;margin-top:4px;font-size:20px;color:var(--blue-dark)}
        .bar{height:10px;border-radius:999px;background:#e8f0f6;overflow:hidden;margin-top:6px}
        .bar span{display:block;height:100%;background:var(--green);border-radius:999px}
        .bar.blue span{background:var(--blue)}
        .table{margin-top:14px;border:1px solid rgba(13,94,166,.08);border-radius:14px;overflow:hidden}
        .row{display:grid;grid-template-columns:1fr .7fr .6fr;padding:10px 12px;border-top:1px solid rgba(13,94,166,.06);font-size:12px}
        .row:first-child{border-top:0;background:#F2F8FC;font-weight:900;color:#314b62;text-transform:uppercase;font-size:10px;letter-spacing:.08em}
        .pill{display:inline-flex;justify-content:center;border-radius:999px;padding:3px 9px;font-size:10px;font-weight:900;font-style:normal;background:rgba(18,152,103,.12);color:var(--green)}
        .section{padding:74px 0}
        .center{text-align:center;max-width:780px;margin:0 auto}
        .section h2{font-size:44px}
        .section .lead{margin-top:18px;color:var(--muted);font-size:18px;line-height:1.8}
        .feature-grid{margin-top:42px;display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
        .feature-grid.cols-3{grid-template-columns:repeat(3,1fr)}
        .card{background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(244,249,253,.98));border:1px solid var(--line);border-radius:26px;padding:28px;box-shadow:0 16px 38px rgba(13,94,166,.07)}
        .card small{display:block;font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-dark);margin-bottom:10px}
        .icon{width:48px;height:48px;border-radius:16px;display:flex;align-items:center;justify-content:center;background:rgba(13,94,166,.08);margin-bottom:18px}
        .card h3{font-size:22px}
        .card p{margin-top:12px;color:var(--muted);font-size:15px;line-height:1.75}
        .split{display:grid;grid-template-columns:.9fr 1.1fr;gap:36px;align-items:start}
        .quote{background:#071B2A;color:#fff;border-radius:34px;padding:40px;box-shadow:var(--shadow);position:relative;overflow:hidden}
        .quote::after{content:"";position:absolute;right:-100px;bottom:-120px;width:280px;height:280px;border-radius:50%;background:rgba(87,184,232,.16)}
        .quote h2{font-size:40px;color:#fff}
        .quote p{margin-top:18px;color:#b8c9d6;font-size:17px;line-height:1.8}
        .stack{display:grid;gap:16px}
        .mini-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:22px;box-shadow:0 12px 28px rgba(13,94,166,.06)}
        .mini-card strong{font-family:Manrope;font-size:20px}
        .mini-card p{margin-top:7px;color:var(--muted)}
        .pricing-wrap{display:grid;grid-template-columns:1fr 1fr 1fr;gap:28px;align-items:stretch}
        .pricing-card{position:relative;overflow:hidden;background:#fff;border:1px solid rgba(13,94,166,.14);border-radius:32px;padding:38px;box-shadow:var(--shadow)}
        .pricing-card::after{content:"";position:absolute;right:-90px;top:-90px;width:240px;height:240px;border-radius:999px;background:rgba(87,184,232,.12)}
        .pricing-card>*{position:relative;z-index:1}
        .badge{display:inline-flex;padding:7px 12px;border-radius:999px;background:rgba(18,152,103,.10);color:#0C734B;border:1px solid rgba(18,152,103,.16);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}
        .price{margin-top:22px;font-family:Manrope,Inter,sans-serif;font-size:62px;line-height:1;font-weight:800;letter-spacing:-.04em}
        .price span{font-size:18px;color:var(--muted);font-weight:700;letter-spacing:0}
        .per-day{margin-top:12px;display:inline-flex;padding:10px 14px;border-radius:999px;background:rgba(13,94,166,.07);color:var(--blue-dark);font-weight:800}
        .billing-note{margin-top:10px;color:var(--muted);font-size:14px}
        .features{columns:2;list-style:none;margin-top:28px;column-gap:32px}
        .features li{break-inside:avoid;padding:8px 0 8px 28px;position:relative;font-size:15px;color:#20384d}
        .features li::before{content:"✓";position:absolute;left:0;color:var(--green);font-weight:900}
        .contact-card{background:linear-gradient(180deg,rgba(13,94,166,.08),rgba(87,184,232,.05));border:1px solid rgba(13,94,166,.12);border-radius:32px;padding:34px}
        .contact-card h3{font-size:30px;line-height:1.12}
        .contact-card p{margin-top:16px;color:var(--muted)}
        .contact-list{margin-top:22px;display:grid;gap:12px}
        .contact-list div{background:rgba(255,255,255,.76);border:1px solid rgba(13,94,166,.08);border-radius:16px;padding:14px;font-weight:700;color:#20384d}
        .faq{padding:74px 0}
        .faq-grid{margin-top:42px;display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
        .faq-item{background:#fff;border:1px solid var(--line);border-radius:22px;padding:26px;box-shadow:0 8px 22px rgba(13,94,166,.05)}
        .faq-item h3{font-size:17px;line-height:1.3;color:var(--blue-dark)}
        .faq-item p{margin-top:10px;color:var(--muted);font-size:15px;line-height:1.7}
        .cta-strip{padding:78px 0}
        .cta-box{background:linear-gradient(135deg,#0B4E89,#0D5EA6 58%,#1683CF);border-radius:34px;padding:48px;color:#fff;display:flex;justify-content:space-between;gap:28px;align-items:center;box-shadow:0 30px 80px rgba(13,94,166,.25)}
        .cta-box h2{font-size:40px;color:#fff}
        .cta-box p{margin-top:12px;color:#d8e9f6;font-size:17px;max-width:620px}
        .cta-box .btn{background:#fff;color:var(--blue-dark);white-space:nowrap}
        .footer{padding:0;border-top:1px solid var(--line);background:rgba(255,255,255,.6);position:relative;z-index:10}
        .footer .container{max-width:1180px;padding:0 28px}
        .footer-cards{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;padding:64px 0}
        .footer-card-left{display:flex;flex-direction:column;gap:24px}
        .footer-heading{font-size:24px;font-weight:800;letter-spacing:-.02em;color:var(--text)}
        .footer-desc{max-width:440px;font-size:16px;line-height:1.7;color:var(--muted)}
        .footer-note{font-size:14px;font-weight:600;color:var(--blue)}
        .footer-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding-top:8px}
        .footer-right-col{display:flex;flex-direction:column;gap:24px}
        .footer-card-right{background:rgba(255,255,255,.76);border:1px solid var(--line);border-radius:16px;padding:24px}
        .footer-powered{font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
        .footer-logo{height:5rem;width:auto;margin-left:-10px;margin-bottom:8px}
        .footer-location{font-size:14px;color:var(--muted);margin-top:4px}
        .footer-contact-link{font-size:14px;margin-top:8px}
        .footer-contact-link a{color:var(--blue);text-decoration:none;transition:.18s ease}
        .footer-contact-link a:hover{opacity:.8}
        .footer-social{display:flex;align-items:center;gap:12px}
        .footer-social a{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--blue);transition:.18s ease}
        .footer-social a:hover{opacity:.8}
        .footer-bottom{border-top:1px solid var(--line);padding:24px 0;display:flex;flex-direction:row;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:14px;color:var(--muted);max-width:1180px;margin:0 auto;padding-left:28px;padding-right:28px}
        .footer-links{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
        .footer-links a{color:var(--muted);text-decoration:none;font-size:14px;transition:.18s ease}
        .footer-links a:hover{opacity:.8}
        .grecaptcha-badge{visibility:hidden !important}
        .features li.section-label::before{content:none !important}
        @@media(max-width:980px){
            .hero-grid{grid-template-columns:1fr}
            .hero-content{text-align:center}
            .hero-content h1{max-width:100%}
            .hero-content p{max-width:100%;margin-left:auto;margin-right:auto}
            .hero-cta{justify-content:center}
            .split{grid-template-columns:1fr}
            .feature-grid{grid-template-columns:1fr 1fr}
            .feature-grid.cols-3{grid-template-columns:1fr 1fr}
            .faq-grid{grid-template-columns:1fr 1fr}
            .pricing-wrap{grid-template-columns:1fr}
            .nav-links a:not(.btn){display:none}
            h1{font-size:46px}
            .section h2{font-size:36px}
            .cta-box{flex-direction:column;align-items:flex-start}
            .features{columns:1}
            .product-card{max-width:100%}
            .footer-cards{grid-template-columns:1fr}
        }
        @@media(max-width:640px){
            html,body{overflow-x:hidden}
            .container{padding:0 20px}
            .nav .container{padding:0 1.5rem}
            .nav-inner{height:auto;padding:1.25rem 0;gap:8px;align-items:center}
            .brand{flex-shrink:1;min-width:0}
            .brand-logo{height:28px;margin-left:-5px}
            .brand-sub{display:block;font-size:8px}
            .nav-links{gap:8px;flex-shrink:0}
            .nav-links .btn{padding:9px 13px;font-size:12px;white-space:nowrap}
            .hero{padding:48px 0 40px}
            .hero-content{padding:0}
            .hero-cta{flex-direction:column;align-items:stretch}
            .hero-cta .btn{width:100%}
            .cta-box{align-items:stretch;flex-direction:column}
            .feature-grid{grid-template-columns:1fr}
            .feature-grid.cols-3{grid-template-columns:1fr}
            .faq-grid{grid-template-columns:1fr}
            .kpis{grid-template-columns:repeat(2,1fr)}
            h1{font-size:36px}
            .section{padding:52px 0}
            .product-card,.quote,.cta-box{border-radius:22px;padding:16px;overflow:hidden}
            .product-card{max-width:92%;margin:0 auto}
            .screen-body{padding:12px}
            .kpi{padding:10px}
            .kpi strong{font-size:16px}
            .kpi label{font-size:8px}
            .bar{height:8px}
            .pricing-card{overflow:hidden}
            .pricing-card,.contact-card{padding:24px;border-radius:24px}
            .pricing-card h3{font-size:24px}
            .price{font-size:50px}
            .footer-bottom{flex-direction:column;align-items:flex-start}
        }
    </style>
</head>
<body>
    <nav class="nav">
        <div class="container nav-inner">
            <a class="brand" href="#top" aria-label="3 Inventors Portal">
                <div class="brand-block">
                    <img src="/images/logo_blue_web_toolbar.png" alt="3 Inventors Portal" class="brand-logo" />
                    <div class="brand-sub">Business Management Platform</div>
                </div>
            </a>
            <div class="nav-links">
                <a href="#features">Features</a>
                <a href="#how-it-works">How It Works</a>
                <a href="#pricing">Pricing</a>
                <a href="#faq">FAQ</a>
                <a href="/Account/Login" class="btn btn-secondary">Sign In</a>
                <a href="javascript:void(0)" data-inquiry-type="Free Trial" class="btn btn-primary">Start Free Trial</a>
            </div>
        </div>
    </nav>

    <main id="top">
        <section class="hero">
            <div class="container hero-grid">
                <div class="hero-content">
                    <div class="eyebrow"><span class="dot"></span> Business Management Platform</div>
                    <h1>Run your business with <span class="highlight">structure, clarity, and control.</span></h1>
                    <p>One workspace to quote, invoice, collect, and control your business finances — structured from day one, not pieced together over time.</p>
                    <div class="hero-cta">
                        <a class="btn btn-primary" href="javascript:void(0)" data-inquiry-type="Free Trial">Request Free Trial</a>
                        <a class="btn btn-secondary" href="#pricing">See Pricing</a>
                    </div>
                    <p style="margin-top:12px;font-size:13px;color:var(--muted);">21 days full Professional access. No credit card required.</p>
                </div>
                <div class="product-card" aria-label="Portal dashboard preview">
                    <div class="screen">
                        <div class="screen-top"><span class="mini-dot"></span><span class="mini-dot"></span><span class="mini-dot"></span></div>
                        <div class="screen-body">
                            <div class="kpis">
                                <div class="kpi"><label>Revenue</label><strong>€12,480</strong><div class="bar"><span style="width:78%"></span></div></div>
                                <div class="kpi"><label>Outstanding</label><strong>€1,260</strong><div class="bar blue"><span style="width:34%"></span></div></div>
                                <div class="kpi"><label>VAT Net</label><strong>€840</strong><div class="bar"><span style="width:55%"></span></div></div>
                                <div class="kpi"><label>Expenses</label><strong>€3,120</strong><div class="bar blue"><span style="width:62%"></span></div></div>
                            </div>
                            <div class="table">
                                <div class="row"><span>Invoice</span><span>Status</span><span>Amount</span></div>
                                <div class="row"><span>INV-00089</span><span><em class="pill">Paid</em></span><span>€420</span></div>
                                <div class="row"><span>INV-00090</span><span><em class="pill">Issued</em></span><span>€1,180</span></div>
                                <div class="row"><span>INV-00091</span><span><em class="pill">Draft</em></span><span>€760</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" id="features">
            <div class="container">
                <div class="center">
                    <h2>What the platform does.</h2>
                    <p class="lead">From your first quotation to monthly VAT submission — every step is structured, traceable, and under your control.</p>
                </div>
                <div class="feature-grid" style="grid-template-columns:repeat(3,1fr);">
                    <div class="card">
                        <div class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0D5EA6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></div>
                        <small>Sales</small>
                        <h3>Quotations &amp; Invoicing</h3>
                        <p>Create professional quotations, convert them to invoices in one click, issue credit notes, and share documents through secure links — with full PDF generation and digital signatures.</p>
                    </div>
                    <div class="card">
                        <div class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><text x="12" y="17" text-anchor="middle" font-family="Inter, sans-serif" font-size="18" font-weight="700" fill="#0D5EA6">€</text></svg></div>
                        <small>Finance</small>
                        <h3>Revenue &amp; Payments</h3>
                        <p>Record payments, allocate credit, track outstanding balances, generate payment receipts, and give customers the ability to pay by card via Stripe — all from one clear revenue dashboard.</p>
                    </div>
                    <div class="card">
