@model Portal.Web.Models.QuotationCreateViewModel
@{
    ViewData["Title"] = "Create Quotation";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Create Quotation</div>
        <h1 class="topbar-heading">Build a new quotation</h1>
        <p class="topbar-subtitle">Create a structured proposal with customer details and controlled totals.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form method="post" asp-action="Create" asp-controller="Quotation" asp-antiforgery="true">
        <input type="hidden" asp-for="LeadRequestId" />
        <div class="form-grid">
            <div class="field">
                <label asp-for="CustomerId">Customer *</label>
                <div style="display:flex;gap:10px;align-items:flex-end;">
                    <select asp-for="CustomerId" style="flex:1;">
                        <option value="">-- Select Customer --</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-secondary" onclick="openCustomerModal('CustomerId')">+ Add New</button>
                </div>
                <span asp-validation-for="CustomerId" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="ValidUntil">Valid Until</label>
                <input asp-for="ValidUntil" type="date" />
                <span asp-validation-for="ValidUntil" class="field-validation-error"></span>
            </div>
            <div class="field" style="grid-column:1 / -1;position:relative;">
                <button type="button" onclick="var t=this.parentElement.querySelector('textarea');var svg=this.querySelector('svg');if(t.style.display==='none'){t.style.display='';svg.style.transform='rotate(180deg)';}else{t.style.display='none';svg.style.transform='rotate(0deg)';}" style="position:absolute;top:0;right:0;background:rgba(13,94,166,.06);border:1.5px solid rgba(13,94,166,.12);border-radius:10px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5E7385" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <label asp-for="Notes">Notes</label>
                <textarea asp-for="Notes" placeholder="Optional notes for this quotation" style="display:none;margin-top:8px;"></textarea>
                <span asp-validation-for="Notes" class="field-validation-error"></span>
            </div>
        </div>

        <div style="margin-top:22px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary">Create Quotation</button>
            <a asp-action="Index" asp-controller="Quotation" class="btn btn-outline">&larr; Back to Quotations</a>
        </div>
    </form>
</section>

@await Html.PartialAsync("_CustomerModal")

@section Scripts {
    <script src="~/js/customer-modal.js"></script>
}
