@model Portal.Web.Models.QuotationCreateViewModel
@{
    ViewData["Title"] = "Create Quotation";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Create Quotation</div>
        <h1 class="topbar-heading">Build a new quotation</h1>
        <p class="topbar-subtitle">Create a structured proposal with customer details and controlled totals.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form method="post" asp-action="Create" asp-controller="Quotation" asp-antiforgery="true">
        <input type="hidden" asp-for="LeadRequestId" />
        <div class="form-grid">
            <div class="field">
                <label asp-for="CustomerId">Customer *</label>
                <div style="display:flex;gap:10px;align-items:flex-end;">
                    <select asp-for="CustomerId" style="flex:1;">
                        <option value="">-- Select Customer --</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-secondary" onclick="openCustomerModal('CustomerId')">+ Add New</button>
                </div>
                <span asp-validation-for="CustomerId" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="ValidUntil">Valid Until</label>
                <input asp-for="ValidUntil" type="date" />
                <span asp-validation-for="ValidUntil" class="field-validation-error"></span>
            </div>
            <div class="field" style="grid-column:1 / -1;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
                    <label asp-for="Notes" style="margin:0;">Notes</label>
                    <button type="button" aria-label="Toggle notes" onclick="var t=this.closest('.field').querySelector('textarea');var svg=this.querySelector('svg');if(t.style.display==='none'){t.style.display='';svg.style.transform='rotate(180deg)';}else{t.style.display='none';svg.style.transform='rotate(0deg)';}" style="background:rgba(13,94,166,.06);border:1.5px solid rgba(13,94,166,.12);border-radius:10px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;flex-shrink:0;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#5E7385" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                </div>
                <textarea asp-for="Notes" placeholder="Optional notes for this quotation" style="display:none;margin-top:8px;"></textarea>
                <span asp-validation-for="Notes" class="field-validation-error"></span>
            </div>
        </div>

        <!-- Brand logos help (collapsed by default) -->
        <section style="margin-top:22px;border:1px solid rgba(13,94,166,.12);border-radius:12px;overflow:hidden;">
            <button type="button" aria-expanded="false" aria-controls="logoHelpBody"
                    onclick="var b=document.getElementById('logoHelpBody');var svg=this.querySelector('svg');var open=b.style.display!=='none';b.style.display=open?'none':'block';this.setAttribute('aria-expanded',(!open).toString());svg.style.transform=open?'rotate(0deg)':'rotate(180deg)';"
                    style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;background:rgba(13,94,166,.03);border:none;cursor:pointer;text-align:left;">
                <span style="display:flex;align-items:center;gap:10px;">
                    <svg width="18" height="18" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                    <span style="font-size:14px;font-weight:700;color:#0D5EA6;">How to add brand logos to this proposal</span>
                </span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5E7385" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="logoHelpBody" style="display:none;padding:16px;font-size:13px;color:#5E7385;line-height:1.7;">
                <p style="margin:0 0 10px;">Logos are not part of the quotation itself &mdash; they are applied when you <strong>preview, download, or share</strong> the proposal, so you can tailor branding per send.</p>
                <ol style="margin:0 0 10px;padding-left:20px;">
                    <li>Upload your logos once in <a href="/MyBusiness?tab=logos" style="color:var(--blue);font-weight:700;">My Business &rarr; Logos</a>. Mark one as <strong>primary</strong> to have it used automatically.</li>
                    <li>Save this quotation and open its <strong>Detail</strong> page.</li>
                    <li>In <strong>Share with customer</strong>, pick your <strong>Hero logos</strong> (shown prominently at the top of the proposal) and a <strong>Metadata logo</strong> (the small logo beside your business name).</li>
                    <li><strong>Preview Proposal</strong> or <strong>Download PDF</strong> use your primary logo automatically if you don&rsquo;t choose any.</li>
                </ol>
                <p style="margin:0;">Logos are drawn from your business profile, so they stay consistent across every quotation and proposal.</p>
            </div>
        </section>

        <div style="margin-top:22px;display:flex;align-items:center;justify-content:space-between;">
            <button type="submit" class="btn btn-primary">Create Quotation</button>
            <a asp-action="Index" asp-controller="Quotation" class="btn btn-outline">&larr; Back to Quotations</a>
        </div>
    </form>
</section>

@await Html.PartialAsync("_CustomerModal")

@section Scripts {
    <script src="~/js/customer-modal.js"></script>
}
