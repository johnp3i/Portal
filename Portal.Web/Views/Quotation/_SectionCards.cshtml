@model Portal.Web.Models.QuotationEditViewModel
@{
    var sectionList = Model.Sections.OrderBy(s => s.SortOrder).ToList();
    var defaultLines = Model.Lines.Where(l => l.ProposalSectionId == null).OrderBy(l => l.SortOrder).ToList();
}

<!-- Section Management Controls -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
    <div>
        <div class="label">Sections</div>
        <h2 style="margin-top:8px;font-size:24px;">Equipment and services</h2>
    </div>
    <button type="button" class="btn btn-primary" onclick="showAddSectionModal()" style="padding:10px 18px;font-size:13px;">
        + Add Section
    </button>
</div>

<!-- Default Section Card (lines with no section) -->
<div class="glass card-pad section-card" data-section-id="" style="margin-bottom:20px;background:rgba(13,94,166,.04);border:2px dashed rgba(13,94,166,.25);box-shadow:0 4px 16px rgba(13,94,166,.08);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <h3 style="font-size:18px;font-weight:700;color:var(--muted2);">General</h3>
    </div>

    <div style="display:grid;gap:16px;">
        @if (defaultLines.Count > 0)
        {
            @foreach (var line in defaultLines)
            {
                <div class="line-card" data-line-id="@line.Id" data-section-id="" style="padding:16px;border:1px solid rgba(13,94,166,.08);border-radius:14px;position:relative;">
                    <form method="post" asp-action="UpdateLine" asp-controller="Quotation" asp-route-quotationId="@Model.Id" asp-route-lineId="@line.Id">
                        @Html.AntiForgeryToken()
                        <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin-bottom:12px;">
                            <div class="field">
                                <label>Description</label>
                                <input type="text" name="Description" value="@line.Description" required />
                            </div>
                            <div class="field">
                                <label>Subtitle</label>
                                <input type="text" name="Subtitle" value="@line.Subtitle" placeholder="Optional" />
                            </div>
                            <div class="field">
                                <label>Reference URL</label>
                                <input type="url" name="ReferenceUrl" value="@line.ReferenceUrl" placeholder="https://..." />
                            </div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 80px 1fr auto;gap:12px;align-items:end;">
                            <div class="field">
                                <label>Qty</label>
                                <input type="number" name="Quantity" value="@line.Quantity.ToString("G")" step="0.0001" min="0.0001" required />
                            </div>
                            <div class="field">
                                <label>Unit Price</label>
                                <input type="number" name="UnitPrice" value="@line.UnitPrice.ToString("G")" step="0.01" min="0" required />
                            </div>
                            <div class="field">
                                <label>VAT %</label>
                                <input type="number" name="VatRate" value="@line.VatRate.ToString("G")" step="0.01" min="0" max="100" required />
                            </div>
                            <div class="field">
                                <label>Discount</label>
                                <input type="number" name="Discount" value="@line.Discount.ToString("G")" step="0.01" min="0" />
                            </div>
                            <div class="field">
                                <label>Type</label>
                                <select name="DiscountType">
                                    <option value="Percentage" selected="@(line.DiscountType == "Percentage" ? "selected" : null)">%</option>
                                    <option value="Fixed" selected="@(line.DiscountType == "Fixed" ? "selected" : null)">Fixed</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Cost Price</label>
                                <input type="number" name="CostPrice" value="@(line.CostPrice?.ToString("G") ?? "")" step="0.01" min="0" placeholder="Optional" />
                            </div>
                            <button type="submit" class="btn btn-primary" style="padding:12px 24px;font-size:13px;font-weight:700;">Save</button>
                        </div>
                    </form>
                    <div style="display:flex;align-items:center;gap:8px;margin-top:10px;">
                        <button type="button" class="btn btn-secondary" onclick="reorderLine(@line.Id, 'up', null)" style="padding:6px 10px;font-size:11px;" title="Move up">&#8593;</button>
                        <button type="button" class="btn btn-secondary" onclick="reorderLine(@line.Id, 'down', null)" style="padding:6px 10px;font-size:11px;" title="Move down">&#8595;</button>
                        <form method="post" asp-action="RemoveLine" asp-controller="Quotation" asp-route-quotationId="@Model.Id" asp-route-lineId="@line.Id" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-secondary" style="padding:6px 12px;font-size:11px;color:var(--red);">Remove</button>
                        </form>
                        @if (sectionList.Count > 0)
                        {
                            <select onchange="moveLineToSection(@line.Id, this.value)" style="padding:6px 10px;border-radius:10px;border:1px solid rgba(13,94,166,.12);font-size:11px;font-weight:700;color:var(--blue);">
                                <option value="">Move to section...</option>
                                @foreach (var s in sectionList)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        }
                    </div>
                    @if (line.CostPrice != null)
                    {
                        var unitMargin = line.UnitPrice - line.CostPrice.Value;
                        var lineMargin = line.LineTotal - (line.CostPrice.Value * line.Quantity);
                        <div style="margin-top:10px;padding:8px 12px;background:rgba(13,94,166,.03);border-radius:8px;display:flex;gap:24px;align-items:center;">
                            <span style="font-size:12px;color:var(--muted);font-weight:600;">Unit Margin: <span style="color:var(--blue);font-weight:700;">@unitMargin.ToString("N2")</span></span>
                            <span style="font-size:12px;color:var(--muted);font-weight:600;">Line Margin: <span style="color:var(--blue);font-weight:700;">@lineMargin.ToString("N2")</span></span>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p class="muted" style="font-size:14px;">No unassigned line items.</p>
        }
    </div>

    <!-- Add Line Form for Default Section -->
    <div style="margin-top:18px;padding:18px;border:1px solid rgba(18,152,103,.2);background:rgba(18,152,103,.04);border-radius:14px;">
        <div class="label" style="margin-bottom:12px;">Add Line Item</div>
        <form method="post" asp-action="AddLine" asp-controller="Quotation" asp-route-quotationId="@Model.Id">
            @Html.AntiForgeryToken()
            <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin-bottom:12px;">
                <div class="field">
                    <label>Description</label>
                    <input type="text" name="Description" placeholder="Item description" required />
                </div>
                <div class="field">
                    <label>Subtitle</label>
                    <input type="text" name="Subtitle" placeholder="Optional" />
                </div>
                <div class="field">
                    <label>Reference URL</label>
                    <input type="url" name="ReferenceUrl" placeholder="https://..." />
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 80px 1fr auto;gap:12px;align-items:end;">
                <div class="field">
                    <label>Qty</label>
                    <input type="number" name="Quantity" placeholder="1" step="0.0001" min="0.0001" required />
                </div>
                <div class="field">
                    <label>Unit Price</label>
                    <input type="number" name="UnitPrice" placeholder="0.00" step="0.01" min="0" required />
                </div>
                <div class="field">
                    <label>VAT %</label>
                    <input type="number" name="VatRate" placeholder="0" step="0.01" min="0" max="100" required />
                </div>
                <div class="field">
                    <label>Discount</label>
                    <input type="number" name="Discount" placeholder="0" step="0.01" min="0" value="0" />
                </div>
                <div class="field">
                    <label>Type</label>
                    <select name="DiscountType">
                        <option value="Percentage">%</option>
                        <option value="Fixed">Fixed</option>
                    </select>
                </div>
                <div class="field">
                    <label>Cost Price</label>
                    <input type="number" name="CostPrice" placeholder="Optional" step="0.01" min="0" />
                </div>
                <button type="submit" class="btn btn-green" style="padding:12px 24px;font-size:13px;font-weight:700;">Add Line</button>
            </div>
        </form>
    </div>
</div>

<!-- Named Section Cards -->
@for (var i = 0; i < sectionList.Count; i++)
{
    var sect = sectionList[i];
    var sectionLines = Model.Lines.Where(l => l.ProposalSectionId == sect.Id).OrderBy(l => l.SortOrder).ToList();

    <div class="glass card-pad section-card" data-section-id="@sect.Id" style="margin-bottom:20px;">
        <!-- Section Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
            <div style="display:flex;align-items:center;gap:10px;">
                <h3 style="font-size:18px;font-weight:700;">@sect.Name</h3>
                @if (sect.SectionType == "Narrative")
                {
                    <span style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);background:rgba(13,94,166,.06);padding:3px 8px;border-radius:6px;">Narrative</span>
                }
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                @if (i > 0)
                {
                    <button type="button" class="btn btn-secondary" onclick="reorderSection(@sect.Id, 'up')" style="padding:6px 10px;font-size:11px;" title="Move up">&#8593;</button>
                }
                @if (i < sectionList.Count - 1)
                {
                    <button type="button" class="btn btn-secondary" onclick="reorderSection(@sect.Id, 'down')" style="padding:6px 10px;font-size:11px;" title="Move down">&#8595;</button>
                }
                <button type="button" class="btn btn-secondary" data-section-id="@sect.Id" data-name="@sect.Name" data-description="@(sect.Description ?? "")" data-notes="@(sect.Notes ?? "")" data-column-config="@sect.ColumnConfiguration" data-section-type="@sect.SectionType" data-is-emphasized="@(sect.IsEmphasized ? "true" : "false")" data-accent-color="@(sect.AccentColor ?? "")" data-label="@(sect.Label ?? "")" data-is-totals-table-shown="@(sect.IsTotalsTableShown ? "true" : "false")" onclick="showEditSectionModalFromData(this)" style="padding:6px 10px;font-size:11px;">Edit</button>
                <button type="button" class="btn btn-secondary" onclick="removeSection(@sect.Id)" style="padding:6px 10px;font-size:11px;color:var(--red);">Remove</button>
            </div>
        </div>

        <!-- Section Description -->
        @if (sect.SectionType == "Narrative")
        {
            <!-- Inline rich text editor for Narrative sections -->
            <div style="margin-top:14px;">
                <div class="field" style="margin-bottom:14px;">
                    <label>Content (Description)</label>
                    <div class="rte-toolbar" style="display:flex;gap:4px;margin-bottom:6px;">
                        <button type="button" onclick="rteCmd('bold')" style="padding:4px 10px;font-size:12px;font-weight:700;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Bold"><b>B</b></button>
                        <button type="button" onclick="rteCmd('italic')" style="padding:4px 10px;font-size:12px;font-style:italic;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Italic"><i>I</i></button>
                        <button type="button" onclick="rteCmd('underline')" style="padding:4px 10px;font-size:12px;text-decoration:underline;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Underline"><u>U</u></button>
                        <button type="button" onclick="rteCmd('insertUnorderedList')" style="padding:4px 10px;font-size:12px;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Bullet List">• List</button>
                    </div>
                    <div id="narrativeDesc_@sect.Id" contenteditable="true" style="min-height:120px;padding:12px;border:1px solid rgba(13,94,166,.15);border-radius:10px;font-size:14px;line-height:1.7;outline:none;background:#fff;overflow-y:auto;max-height:300px;">@Html.Raw(sect.Description ?? "")</div>
                </div>
                <div class="field" style="margin-bottom:14px;">
                    <label>Notes</label>
                    <textarea id="narrativeNotes_@sect.Id" rows="3" placeholder="Optional notes" style="resize:vertical;width:100%;">@sect.Notes</textarea>
                </div>
                <button type="button" class="btn btn-primary" onclick="saveNarrativeSection(@sect.Id)" style="padding:10px 20px;font-size:13px;font-weight:700;">Save Section</button>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(sect.Description))
            {
                <p class="muted" style="font-size:13px;margin-bottom:14px;line-height:1.6;">@sect.Description</p>
            }
        }

        @if (sect.SectionType != "Narrative")
        {
        <!-- Section Line Items -->
        <div style="display:grid;gap:16px;margin-top:14px;">
            @if (sectionLines.Count > 0)
            {
                @foreach (var line in sectionLines)
                {
                    <div class="line-card" data-line-id="@line.Id" data-section-id="@sect.Id" style="padding:16px;border:1px solid rgba(13,94,166,.08);border-radius:14px;position:relative;">
                        <form method="post" asp-action="UpdateLine" asp-controller="Quotation" asp-route-quotationId="@Model.Id" asp-route-lineId="@line.Id">
                            @Html.AntiForgeryToken()
                            <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin-bottom:12px;">
                                <div class="field">
                                    <label>Description</label>
                                    <input type="text" name="Description" value="@line.Description" required />
                                </div>
                                <div class="field">
                                    <label>Subtitle</label>
                                    <input type="text" name="Subtitle" value="@line.Subtitle" placeholder="Optional" />
                                </div>
                                <div class="field">
                                    <label>Reference URL</label>
                                    <input type="url" name="ReferenceUrl" value="@line.ReferenceUrl" placeholder="https://..." />
                                </div>
                            </div>
                            <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 80px 1fr auto;gap:12px;align-items:end;">
                                <div class="field">
                                    <label>Qty</label>
                                    <input type="number" name="Quantity" value="@line.Quantity.ToString("G")" step="0.0001" min="0.0001" required />
                                </div>
                                <div class="field">
                                    <label>Unit Price</label>
                                    <input type="number" name="UnitPrice" value="@line.UnitPrice.ToString("G")" step="0.01" min="0" required />
                                </div>
                                <div class="field">
                                    <label>VAT %</label>
                                    <input type="number" name="VatRate" value="@line.VatRate.ToString("G")" step="0.01" min="0" max="100" required />
                                </div>
                                <div class="field">
                                    <label>Discount</label>
                                    <input type="number" name="Discount" value="@line.Discount.ToString("G")" step="0.01" min="0" />
                                </div>
                                <div class="field">
                                    <label>Type</label>
                                    <select name="DiscountType">
                                        <option value="Percentage" selected="@(line.DiscountType == "Percentage" ? "selected" : null)">%</option>
                                        <option value="Fixed" selected="@(line.DiscountType == "Fixed" ? "selected" : null)">Fixed</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Cost Price</label>
                                    <input type="number" name="CostPrice" value="@(line.CostPrice?.ToString("G") ?? "")" step="0.01" min="0" placeholder="Optional" />
                                </div>
                                <button type="submit" class="btn btn-primary" style="padding:12px 24px;font-size:13px;font-weight:700;">Save</button>
                            </div>
                        </form>
                        <div style="display:flex;align-items:center;gap:8px;margin-top:10px;">
                            <button type="button" class="btn btn-secondary" onclick="reorderLine(@line.Id, 'up', @sect.Id)" style="padding:6px 10px;font-size:11px;" title="Move up">&#8593;</button>
                            <button type="button" class="btn btn-secondary" onclick="reorderLine(@line.Id, 'down', @sect.Id)" style="padding:6px 10px;font-size:11px;" title="Move down">&#8595;</button>
                            <form method="post" asp-action="RemoveLine" asp-controller="Quotation" asp-route-quotationId="@Model.Id" asp-route-lineId="@line.Id" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-secondary" style="padding:6px 12px;font-size:11px;color:var(--red);">Remove</button>
                            </form>
                            <select onchange="moveLineToSection(@line.Id, this.value === '' ? null : parseInt(this.value))" style="padding:6px 10px;border-radius:10px;border:1px solid rgba(13,94,166,.12);font-size:11px;font-weight:700;color:var(--blue);">
                                <option value="@sect.Id">Move to section...</option>
                                <option value="">General (Default)</option>
                                @foreach (var s in sectionList.Where(s => s.Id != sect.Id))
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        @if (line.CostPrice != null)
                        {
                            var unitMargin = line.UnitPrice - line.CostPrice.Value;
                            var lineMargin = line.LineTotal - (line.CostPrice.Value * line.Quantity);
                            <div style="margin-top:10px;padding:8px 12px;background:rgba(13,94,166,.03);border-radius:8px;display:flex;gap:24px;align-items:center;">
                                <span style="font-size:12px;color:var(--muted);font-weight:600;">Unit Margin: <span style="color:var(--blue);font-weight:700;">@unitMargin.ToString("N2")</span></span>
                                <span style="font-size:12px;color:var(--muted);font-weight:600;">Line Margin: <span style="color:var(--blue);font-weight:700;">@lineMargin.ToString("N2")</span></span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="muted" style="font-size:14px;">No line items in this section.</p>
            }
        </div>
        }

        <!-- Section Notes -->
        @if (!string.IsNullOrWhiteSpace(sect.Notes))
        {
            <div style="margin-top:14px;padding-top:14px;border-top:1px solid rgba(13,94,166,.08);">
                <div class="label" style="margin-bottom:6px;">Notes</div>
                <p class="muted" style="font-size:13px;line-height:1.6;white-space:pre-wrap;">@sect.Notes</p>
            </div>
        }

        @if (sect.SectionType != "Narrative")
        {
        <!-- Add Line Form for this Section -->
        <div style="margin-top:18px;padding:18px;border:1px solid rgba(18,152,103,.2);background:rgba(18,152,103,.04);border-radius:14px;">
            <div class="label" style="margin-bottom:12px;">Add Line Item to @sect.Name</div>
            <form method="post" asp-action="AddLine" asp-controller="Quotation" asp-route-quotationId="@Model.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProposalSectionId" value="@sect.Id" />
                <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin-bottom:12px;">
                    <div class="field">
                        <label>Description</label>
                        <input type="text" name="Description" placeholder="Item description" required />
                    </div>
                    <div class="field">
                        <label>Subtitle</label>
                        <input type="text" name="Subtitle" placeholder="Optional" />
                    </div>
                    <div class="field">
                        <label>Reference URL</label>
                        <input type="url" name="ReferenceUrl" placeholder="https://..." />
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 80px 1fr auto;gap:12px;align-items:end;">
                    <div class="field">
                        <label>Qty</label>
                        <input type="number" name="Quantity" placeholder="1" step="0.0001" min="0.0001" required />
                    </div>
                    <div class="field">
                        <label>Unit Price</label>
                        <input type="number" name="UnitPrice" placeholder="0.00" step="0.01" min="0" required />
                    </div>
                    <div class="field">
                        <label>VAT %</label>
                        <input type="number" name="VatRate" placeholder="0" step="0.01" min="0" max="100" required />
                    </div>
                    <div class="field">
                        <label>Discount</label>
                        <input type="number" name="Discount" placeholder="0" step="0.01" min="0" value="0" />
                    </div>
                    <div class="field">
                        <label>Type</label>
                        <select name="DiscountType">
                            <option value="Percentage">%</option>
                            <option value="Fixed">Fixed</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Cost Price</label>
                        <input type="number" name="CostPrice" placeholder="Optional" step="0.01" min="0" />
                    </div>
                    <button type="submit" class="btn btn-green" style="padding:12px 24px;font-size:13px;font-weight:700;">Add Line</button>
                </div>
            </form>
        </div>
        }
    </div>
}

<!-- Add Section Modal -->
<div id="addSectionModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.4);align-items:center;justify-content:center;">
    <div class="glass card-pad" style="width:100%;max-width:480px;margin:24px;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:18px;">Add Section</h3>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionName">Section Name *</label>
            <input type="text" id="newSectionName" placeholder="e.g. Hardware Cost" required />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionLabel">Section Label (optional eyebrow text)</label>
            <input type="text" id="newSectionLabel" placeholder="e.g. Content, Overview, Included" maxlength="50" />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionDescription">Description</label>
            <textarea id="newSectionDescription" rows="3" placeholder="Optional description" style="resize:vertical;"></textarea>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionType">Section Type</label>
            <select id="newSectionType">
                <option value="LineItems">Line Items (priced table)</option>
                <option value="Narrative">Narrative (rich text content)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionColumnConfig">Column Type</label>
            <select id="newSectionColumnConfig">
                <option value="OneTime">One Time (Qty / Unit Price / Final Price)</option>
                <option value="Subscription">Subscription (Monthly / Daily / Annual)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="newSectionIsEmphasized" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Emphasize section (left border accent)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="newSectionIsTotalsTableShown" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Show totals breakdown (subtotal, discount, VAT, total)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionAccentColor">Accent Color (optional)</label>
            <input type="text" id="newSectionAccentColor" placeholder="#0D5EA6" maxlength="20" />
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button type="button" class="btn btn-secondary" onclick="hideAddSectionModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="addSection()">Add Section</button>
        </div>
    </div>
</div>

<!-- Edit Section Modal -->
<div id="editSectionModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.4);align-items:center;justify-content:center;">
    <div class="glass card-pad" style="width:100%;max-width:480px;margin:24px;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:18px;">Edit Section</h3>
        <input type="hidden" id="editSectionId" />
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionName">Section Name *</label>
            <input type="text" id="editSectionName" required />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionLabel">Section Label (optional eyebrow text)</label>
            <input type="text" id="editSectionLabel" placeholder="e.g. Content, Overview, Included" maxlength="50" />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionDescription">Description</label>
            <textarea id="editSectionDescription" rows="3" style="resize:vertical;"></textarea>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionNotes">Notes</label>
            <textarea id="editSectionNotes" rows="3" placeholder="Displayed below line items" style="resize:vertical;"></textarea>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionType">Section Type</label>
            <select id="editSectionType">
                <option value="LineItems">Line Items (priced table)</option>
                <option value="Narrative">Narrative (rich text content)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionColumnConfig">Column Type</label>
            <select id="editSectionColumnConfig">
                <option value="OneTime">One Time (Qty / Unit Price / Final Price)</option>
                <option value="Subscription">Subscription (Monthly / Daily / Annual)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="editSectionIsEmphasized" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Emphasize section (left border accent)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="editSectionIsTotalsTableShown" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Show totals breakdown (subtotal, discount, VAT, total)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionAccentColor">Accent Color (optional)</label>
            <input type="text" id="editSectionAccentColor" placeholder="#0D5EA6" maxlength="20" />
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button type="button" class="btn btn-secondary" onclick="hideEditSectionModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="updateSection()">Save Changes</button>
        </div>
    </div>
</div>
