@model Portal.Web.Models.QuotationEditViewModel
@{
    var sectionList = Model.Sections.OrderBy(s => s.SortOrder).ToList();
    var defaultDisplayLines = Model.DisplayLines.Where(dl => dl.Line.ProposalSectionId == null).OrderBy(dl => dl.Line.SortOrder).ToList();
}

<!-- Section Management Controls -->
<div class="section-controls" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
    <div>
        <div class="label">Sections</div>
        <h2 style="margin-top:8px;font-size:24px;">Equipment and services</h2>
    </div>
    <button type="button" class="btn btn-primary btn-add-section" onclick="showAddSectionModal()" style="padding:10px 18px;font-size:13px;">
        + Add Section
    </button>
</div>

<!-- Named Section Cards -->
@for (var i = 0; i < sectionList.Count; i++)
{
    var sect = sectionList[i];
    var sectionLines = Model.DisplayLines.Where(dl => dl.Line.ProposalSectionId == sect.Id).OrderBy(dl => dl.Line.SortOrder).ToList();
    var sectionSubtotal = sectionLines.Sum(dl => dl.Line.LineTotal);
    var sectionCount = sectionLines.Count;

    <div class="glass card-pad section-card" data-section-id="@sect.Id" style="margin-bottom:20px;">
        <!-- Section Header -->
        <div class="section-header">
            <div>
                <div style="display:flex;align-items:center;gap:10px;">
                    <h3>@sect.Name</h3>
                    @if (sect.SectionType == "Narrative")
                    {
                        <span style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);background:rgba(13,94,166,.06);padding:3px 8px;border-radius:6px;">Narrative</span>
                    }
                </div>
                @if (sect.SectionType != "Narrative")
                {
                    <span class="section-summary">@sectionCount item@(sectionCount != 1 ? "s" : "") · Subtotal €@sectionSubtotal.ToString("N2")</span>
                }
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                @if (i > 0)
                {
                    <button type="button" class="btn btn-secondary" onclick="reorderSection(@sect.Id, 'up')" style="padding:6px 10px;font-size:11px;" title="Move up">&#8593;</button>
                }
                @if (i < sectionList.Count - 1)
                {
                    <button type="button" class="btn btn-secondary" onclick="reorderSection(@sect.Id, 'down')" style="padding:6px 10px;font-size:11px;" title="Move down">&#8595;</button>
                }
                <button type="button" class="btn btn-secondary" data-section-id="@sect.Id" data-name="@sect.Name" data-description="@(sect.Description ?? "")" data-notes="@(sect.Notes ?? "")" data-column-config="@sect.ColumnConfiguration" data-section-type="@sect.SectionType" data-is-emphasized="@(sect.IsEmphasized ? "true" : "false")" data-accent-color="@(sect.AccentColor ?? "")" data-label="@(sect.Label ?? "")" data-is-totals-table-shown="@(sect.IsTotalsTableShown ? "true" : "false")" data-is-half-width="@(sect.IsHalfWidth ? "true" : "false")" onclick="showEditSectionModalFromData(this)" style="padding:6px 10px;font-size:11px;">Edit</button>
                <button type="button" class="btn btn-secondary" onclick="removeSection(@sect.Id)" style="padding:6px 10px;font-size:11px;color:var(--red);">Remove</button>
            </div>
        </div>

        @if (sect.SectionType == "Narrative")
        {
            <!-- Inline rich text editor for Narrative sections -->
            <div style="margin-top:14px;">
                <div class="field" style="margin-bottom:14px;">
                    <label>Content (Description)</label>
                    <div class="rte-toolbar" style="display:flex;gap:4px;margin-bottom:6px;">
                        <button type="button" onclick="rteCmd('bold')" style="padding:4px 10px;font-size:12px;font-weight:700;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Bold"><b>B</b></button>
                        <button type="button" onclick="rteCmd('italic')" style="padding:4px 10px;font-size:12px;font-style:italic;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Italic"><i>I</i></button>
                        <button type="button" onclick="rteCmd('underline')" style="padding:4px 10px;font-size:12px;text-decoration:underline;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Underline"><u>U</u></button>
                        <button type="button" onclick="rteCmd('insertUnorderedList')" style="padding:4px 10px;font-size:12px;border:1px solid rgba(13,94,166,.15);border-radius:6px;background:#fff;cursor:pointer;" title="Bullet List">• List</button>
                    </div>
                    <div id="narrativeDesc_@sect.Id" contenteditable="true" style="min-height:120px;padding:12px;border:1px solid rgba(13,94,166,.15);border-radius:10px;font-size:14px;line-height:1.7;outline:none;background:#fff;overflow-y:auto;max-height:300px;">@Html.Raw(sect.Description ?? "")</div>
                </div>
                <div class="field" style="margin-bottom:14px;">
                    <label>Notes</label>
                    <textarea id="narrativeNotes_@sect.Id" rows="3" placeholder="Optional notes" style="resize:vertical;width:100%;">@sect.Notes</textarea>
                </div>
                <button type="button" class="btn btn-primary" onclick="saveNarrativeSection(@sect.Id)" style="padding:10px 20px;font-size:13px;font-weight:700;">Save Section</button>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(sect.Description))
            {
                <p class="muted" style="font-size:13px;margin-bottom:14px;line-height:1.6;">@sect.Description</p>
            }

            @if (sectionLines.Count > 0)
            {
                <div class="scroll-hint">← Scroll horizontally →</div>
                <div class="table-responsive">
                    <table class="line-item-table">
                        <thead>
                            <tr>
                                <th class="col-row-num">#</th>
                                <th class="col-description">Description</th>
                                <th class="col-qty">Qty</th>
                                <th class="col-unit-price">Unit Price</th>
                                <th class="col-discount">Discount</th>
                                <th class="col-total">Total</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var j = 0; j < sectionLines.Count; j++)
                            {
                                var displayLine = sectionLines[j];
                                var line = displayLine.Line;
                                var discountAmount = line.DiscountType == "Percentage"
                                    ? line.UnitPrice * line.Quantity * (line.Discount / 100)
                                    : line.Discount;
                                <tr data-line-id="@line.Id"
                                    data-description="@line.Description"
                                    data-subtitle="@(line.Subtitle ?? "")"
                                    data-reference-url="@(line.ReferenceUrl ?? "")"
                                    data-quantity="@line.Quantity.ToString("G")"
                                    data-unit-price="@line.UnitPrice.ToString("G")"
                                    data-vat-rate="@line.VatRate.ToString("G")"
                                    data-discount="@line.Discount.ToString("G")"
                                    data-discount-type="@line.DiscountType"
                                    data-cost-price="@(line.CostPrice?.ToString("G") ?? "")"
                                    data-is-reverse-charge="@(line.IsReverseCharge ? "true" : "false")"
                                    data-product-code="@(line.ProductCode ?? "")"
                                    data-section-id="@(line.ProposalSectionId?.ToString() ?? "")">
                                    <td class="col-row-num">@(j + 1)</td>
                                    <td class="col-description">
                                        <span class="line-desc">@line.Description</span>
                                        @if (!string.IsNullOrWhiteSpace(line.Subtitle))
                                        {
                                            <span class="line-subtitle">@line.Subtitle</span>
                                        }
                                    </td>
                                    <td class="col-qty">@line.Quantity.ToString("G")</td>
                                    <td class="col-unit-price">€@line.UnitPrice.ToString("N2")</td>
                                    <td class="col-discount">
                                        @if (discountAmount == 0)
                                        {
                                            <span>-</span>
                                        }
                                        else
                                        {
                                            <span class="discount-green">-€@discountAmount.ToString("N2")</span>
                                        }
                                    </td>
                                    <td class="col-total">€@line.LineTotal.ToString("N2")</td>
                                    <td class="col-actions">
                                        <button type="button" class="btn-edit" onclick="showEditLineModal(@line.Id, @(line.ProposalSectionId?.ToString() ?? "null"))">Edit</button>
                                        <button type="button" class="btn-remove" onclick="confirmRemoveLine(@Model.Id, @line.Id)">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="muted" style="font-size:14px;">No line items in this section.</p>
            }

            <button type="button" class="btn-add-line" onclick="showAddLineModal(@sect.Id)">+ Add Line Item</button>
        }

        <!-- Section Notes -->
        @if (!string.IsNullOrWhiteSpace(sect.Notes))
        {
            <div style="margin-top:14px;padding-top:14px;border-top:1px solid rgba(13,94,166,.08);">
                <div class="label" style="margin-bottom:6px;">Notes</div>
                <p class="muted" style="font-size:13px;line-height:1.6;white-space:pre-wrap;">@sect.Notes</p>
            </div>
        }
    </div>
}

<!-- General Section Card (lines with no section) -->
@{
    var generalSubtotal = defaultDisplayLines.Sum(dl => dl.Line.LineTotal);
    var generalCount = defaultDisplayLines.Count;
}
<div class="glass card-pad section-card section-card--general" data-section-id="" style="margin-bottom:20px;">
    <!-- Section Header -->
    <div class="section-header">
        <div>
            <h3>General</h3>
            <span class="section-summary">@generalCount item@(generalCount != 1 ? "s" : "") · Subtotal €@generalSubtotal.ToString("N2")</span>
        </div>
    </div>

    <!-- Info Banner -->
    <div class="info-banner">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <span>The General section always appears at the bottom. Create a named section and move items to reorder.</span>
    </div>

    @if (defaultDisplayLines.Count > 0)
    {
        <div class="scroll-hint">← Scroll horizontally →</div>
        <div class="table-responsive">
            <table class="line-item-table">
                <thead>
                    <tr>
                        <th class="col-row-num">#</th>
                        <th class="col-description">Description</th>
                        <th class="col-qty">Qty</th>
                        <th class="col-unit-price">Unit Price</th>
                        <th class="col-discount">Discount</th>
                        <th class="col-total">Total</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var j = 0; j < defaultDisplayLines.Count; j++)
                    {
                        var displayLine = defaultDisplayLines[j];
                        var line = displayLine.Line;
                        var discountAmount = line.DiscountType == "Percentage"
                            ? line.UnitPrice * line.Quantity * (line.Discount / 100)
                            : line.Discount;
                        <tr data-line-id="@line.Id"
                            data-description="@line.Description"
                            data-subtitle="@(line.Subtitle ?? "")"
                            data-reference-url="@(line.ReferenceUrl ?? "")"
                            data-quantity="@line.Quantity.ToString("G")"
                            data-unit-price="@line.UnitPrice.ToString("G")"
                            data-vat-rate="@line.VatRate.ToString("G")"
                            data-discount="@line.Discount.ToString("G")"
                            data-discount-type="@line.DiscountType"
                            data-cost-price="@(line.CostPrice?.ToString("G") ?? "")"
                            data-is-reverse-charge="@(line.IsReverseCharge ? "true" : "false")"
                            data-product-code="@(line.ProductCode ?? "")"
                            data-section-id="">
                            <td class="col-row-num">@(j + 1)</td>
                            <td class="col-description">
                                <span class="line-desc">@line.Description</span>
                                @if (!string.IsNullOrWhiteSpace(line.Subtitle))
                                {
                                    <span class="line-subtitle">@line.Subtitle</span>
                                }
                            </td>
                            <td class="col-qty">@line.Quantity.ToString("G")</td>
                            <td class="col-unit-price">€@line.UnitPrice.ToString("N2")</td>
                            <td class="col-discount">
                                @if (discountAmount == 0)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <span class="discount-green">-€@discountAmount.ToString("N2")</span>
                                }
                            </td>
                            <td class="col-total">€@line.LineTotal.ToString("N2")</td>
                            <td class="col-actions">
                                <button type="button" class="btn-edit" onclick="showEditLineModal(@line.Id, null)">Edit</button>
                                <button type="button" class="btn-remove" onclick="confirmRemoveLine(@Model.Id, @line.Id)">×</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="muted" style="font-size:14px;">No line items in this section.</p>
    }

    <button type="button" class="btn-add-line" onclick="showAddLineModal(null)">+ Add Line Item</button>
</div>

<!-- Add Section Modal -->
<div id="addSectionModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.4);align-items:flex-start;justify-content:center;overflow-y:auto;padding:24px 0;">
    <div class="glass card-pad" style="width:100%;max-width:480px;margin:24px auto;flex-shrink:0;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:18px;">Add Section</h3>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionName">Section Name *</label>
            <input type="text" id="newSectionName" placeholder="e.g. Hardware Cost" required />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionLabel">Section Label (optional eyebrow text)</label>
            <input type="text" id="newSectionLabel" placeholder="e.g. Content, Overview, Included" maxlength="50" />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionDescription">Description</label>
            <textarea id="newSectionDescription" rows="3" placeholder="Optional description" style="resize:vertical;"></textarea>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionType">Section Type</label>
            <select id="newSectionType">
                <option value="LineItems">Line Items (priced table)</option>
                <option value="Narrative">Narrative (rich text content)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionColumnConfig">Column Type</label>
            <select id="newSectionColumnConfig">
                <option value="OneTime">One Time (Qty / Unit Price / Final Price)</option>
                <option value="Subscription">Subscription (Monthly / Daily / Annual)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="newSectionIsEmphasized" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Emphasize section (left border accent)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="newSectionIsTotalsTableShown" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Show totals breakdown (subtotal, discount, VAT, total)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="newSectionIsHalfWidth" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Half-width layout (narrative sections sit side by side)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="newSectionAccentColor">Accent Color (optional)</label>
            <input type="text" id="newSectionAccentColor" placeholder="#0D5EA6" maxlength="20" />
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button type="button" class="btn btn-secondary" onclick="hideAddSectionModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="addSection()">Add Section</button>
        </div>
    </div>
</div>

<!-- Edit Section Modal -->
<div id="editSectionModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.4);align-items:flex-start;justify-content:center;overflow-y:auto;padding:24px 0;">
    <div class="glass card-pad" style="width:100%;max-width:480px;margin:24px auto;flex-shrink:0;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:18px;">Edit Section</h3>
        <input type="hidden" id="editSectionId" />
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionName">Section Name *</label>
            <input type="text" id="editSectionName" required />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionLabel">Section Label (optional eyebrow text)</label>
            <input type="text" id="editSectionLabel" placeholder="e.g. Content, Overview, Included" maxlength="50" />
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionDescription">Description</label>
            <textarea id="editSectionDescription" rows="3" style="resize:vertical;"></textarea>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionNotes">Notes</label>
            <textarea id="editSectionNotes" rows="3" placeholder="Displayed below line items" style="resize:vertical;"></textarea>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionType">Section Type</label>
            <select id="editSectionType">
                <option value="LineItems">Line Items (priced table)</option>
                <option value="Narrative">Narrative (rich text content)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionColumnConfig">Column Type</label>
            <select id="editSectionColumnConfig">
                <option value="OneTime">One Time (Qty / Unit Price / Final Price)</option>
                <option value="Subscription">Subscription (Monthly / Daily / Annual)</option>
            </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="editSectionIsEmphasized" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Emphasize section (left border accent)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="editSectionIsTotalsTableShown" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Show totals breakdown (subtotal, discount, VAT, total)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;">
                <input type="checkbox" id="editSectionIsHalfWidth" style="margin:3px 0 0 0;flex-shrink:0;" />
                <span>Half-width layout (narrative sections sit side by side)</span>
            </label>
        </div>
        <div class="field" style="margin-bottom:14px;">
            <label for="editSectionAccentColor">Accent Color (optional)</label>
            <input type="text" id="editSectionAccentColor" placeholder="#0D5EA6" maxlength="20" />
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button type="button" class="btn btn-secondary" onclick="hideEditSectionModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="updateSection()">Save Changes</button>
        </div>
    </div>
</div>
