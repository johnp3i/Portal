@model Portal.Web.Models.QuotationListViewModel
@{
    ViewData["Title"] = "Quotations";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Quotations</div>
        <h1 class="topbar-heading">Quotation List</h1>
        <p class="topbar-subtitle">Filter, review, and manage quotations with full commercial traceability.</p>
    </div>
    <div class="topbar-actions" style="display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn-primary" asp-action="Create" asp-controller="Quotation">Create Quotation</a>
    </div>
</div>

<section class="glass card-pad">
    <form method="get" asp-action="Index" asp-controller="Quotation">
        <button type="button" class="filter-toggle" aria-expanded="false" aria-controls="quotationFilterPanel">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 4h18M7 9h10M10 14h4"/></svg>
            Filters
        </button>
        <div class="filter-panel" id="quotationFilterPanel" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
            <div class="field" style="min-width:180px;">
                <label>Search</label>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by reference or customer..." />
            </div>
            <div class="field" style="min-width:180px;">
                <label>Status</label>
                <select name="statusFilter">
                    <option value="">All Statuses</option>
                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@status.Id" selected="@(Model.StatusFilter == status.Id ? "selected" : null)">@status.Name</option>
                    }
                </select>
            </div>
            <div class="field" style="min-width:180px;">
                <label>Customer</label>
                <select name="customerFilter">
                    <option value="">All Customers</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id" selected="@(Model.CustomerFilter == customer.Id ? "selected" : null)">@customer.Name</option>
                    }
                </select>
            </div>
            <div class="field" style="min-width:180px;">
                <label>From</label>
                <input type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="field" style="min-width:180px;">
                <label>To</label>
                <input type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
            </div>
            <div style="padding-bottom:2px;">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </div>
    </form>

    <div style="margin-top:18px;">
        @if (Model.PagedQuotations.Items != null && Model.PagedQuotations.Items.Count > 0)
        {
            <div class="table-responsive index-table">
            <div class="scroll-hint">← Scroll horizontally →</div>
                <table>
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Valid Until</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quotation in Model.PagedQuotations.Items)
                        {
                            <tr data-href="@Url.Action("Detail", "Quotation", new { id = quotation.Id })">
                                <td>
                                    <a asp-action="Detail" asp-controller="Quotation" asp-route-id="@quotation.Id" style="color:inherit;text-decoration:none;"><strong>@quotation.Reference</strong></a>
                                    @if (quotation.AcceptanceStatus == "accepted")
                                    {
                                        <div style="font-size:11px;color:#129867;font-weight:600;margin-top:3px;">✓ Accepted</div>
                                    }
                                    else if (quotation.AcceptanceStatus == "awaiting")
                                    {
                                        <div style="font-size:11px;color:#C8912E;font-weight:600;margin-top:3px;">⏳ Awaiting acceptance</div>
                                    }
                                </td>
                                <td>@quotation.CustomerName</td>
                                <td data-mobile="status">
                                    @{
                                        var pillClass = quotation.QuotationStatusTypeId switch
                                        {
                                            1 => "pill-gold",
                                            2 => "pill-blue",
                                            3 => "pill-green",
                                            4 => "pill-blue",
                                            5 => "pill-red",
                                            _ => "pill-gold"
                                        };
                                    }
                                    <span class="pill @pillClass">@quotation.StatusName</span>
                                </td>
                                <td data-mobile="hide">
                                    @if (quotation.ValidUntil.HasValue)
                                    {
                                        if (quotation.IsExpired)
                                        {
                                            <span class="expired-date">@quotation.ValidUntil.Value.ToString("yyyy-MM-dd")</span>
                                        }
                                        else
                                        {
                                            @quotation.ValidUntil.Value.ToString("yyyy-MM-dd")
                                        }
                                    }
                                </td>
                                <td data-mobile="amount">@(ViewBag.CurrencySymbol)@quotation.TotalAmount.ToString("N2")</td>
                                <td data-mobile="hide" style="white-space:nowrap;">
                                    <a asp-action="Detail" asp-controller="Quotation" asp-route-id="@quotation.Id" class="tbl-action tbl-action--primary">Detail</a>
                                    <a asp-action="Edit" asp-controller="Quotation" asp-route-id="@quotation.Id" class="tbl-action tbl-action--primary">Edit</a>
                                    <a asp-action="Preview" asp-controller="Quotation" asp-route-id="@quotation.Id" target="_blank" class="tbl-action tbl-action--secondary">Preview</a>
                                    <a href="javascript:void(0)" onclick="downloadQuotationPdf(@quotation.Id)" class="tbl-action tbl-action--secondary">PDF</a>
                                    @if (quotation.QuotationStatusTypeId == 1)
                                    {
                                        <a href="javascript:void(0)" onclick="deleteQuotation(@quotation.Id, '@Html.Raw(quotation.Reference)')" class="tbl-action tbl-action--danger">Delete</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No quotations found. Create your first quotation to get started.</p>
            </div>
        }
    </div>

    @await Html.PartialAsync("_PagingControl", null, new ViewDataDictionary(ViewData) {
        { "CurrentPage", Model.PagedQuotations.CurrentPage },
        { "TotalPages", Model.PagedQuotations.TotalPages },
        { "TotalCount", Model.PagedQuotations.TotalCount },
        { "PageSize", Model.PagedQuotations.PageSize },
        { "HasPreviousPage", Model.PagedQuotations.HasPreviousPage },
        { "HasNextPage", Model.PagedQuotations.HasNextPage }
    })
</section>

@section Scripts {
    <script>
        async function downloadQuotationPdf(quotationId) {
            BlockUI.show('Generating PDF...');
            try {
                var response = await fetch('/Quotation/AxGetDownloadPdf/' + quotationId);

                if (!response.ok || !response.headers.get('content-type')?.includes('application/pdf')) {
                    var data = await response.json();
                    BlockUI.hide();
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to generate PDF.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                    return;
                }

                var blob = await response.blob();
                var contentDisposition = response.headers.get('content-disposition');
                var filename = 'quotation.pdf';
                if (contentDisposition) {
                    var match = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (match && match[1]) {
                        filename = match[1].replace(/['"]/g, '');
                    }
                }
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                BlockUI.hide();
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'Could not complete download due to a connection problem.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function deleteQuotation(quotationId, reference) {
            const firstResult = await Swal.fire({
                title: 'Are you sure?',
                text: `Quotation ${reference} will be deleted.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it'
            });

            if (!firstResult.isConfirmed) return;

            const secondResult = await Swal.fire({
                title: 'Final Warning',
                text: 'This action cannot be easily undone. Are you sure you want to proceed?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete permanently'
            });

            if (!secondResult.isConfirmed) return;

            BlockUI.show('Deleting...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Quotation/SoftDelete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'id=' + quotationId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Deleted!',
                        text: 'The quotation has been deleted.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }
    </script>
}
