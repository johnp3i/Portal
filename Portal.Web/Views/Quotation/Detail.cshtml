@model Portal.Web.Models.QuotationDetailViewModel
@{
    ViewData["Title"] = "Quotation Detail";
    var logos = ViewBag.Logos as List<Portal.Infrastructure.Entities.BusinessLogo> ?? new List<Portal.Infrastructure.Entities.BusinessLogo>();
    var quotationId = (int)ViewBag.QuotationId;
    var defaultExpiration = (DateTimeOffset)ViewBag.DefaultExpiration;
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Quotation Detail</div>
        <h1 class="topbar-heading">@Model.Quotation.Reference &middot; @Model.CustomerName</h1>
        <p class="topbar-subtitle">Review status, pricing structure, and conversion readiness.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        @if (Model.Quotation.QuotationStatusTypeId == 1 || Model.Quotation.QuotationStatusTypeId == 2)
        {
            <a class="btn btn-secondary" asp-action="Edit" asp-controller="Quotation" asp-route-id="@Model.Quotation.Id">Edit</a>
        }

        @if (Model.AvailableTransitions.Contains(3))
        {
            <form method="post" asp-action="TransitionStatus" asp-controller="Quotation" asp-route-id="@Model.Quotation.Id" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="newStatusId" value="3" />
                <button type="submit" class="btn btn-green">Mark Accepted</button>
            </form>
        }

        @if (Model.AvailableTransitions.Contains(5))
        {
            <form method="post" asp-action="TransitionStatus" asp-controller="Quotation" asp-route-id="@Model.Quotation.Id" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="newStatusId" value="5" />
                <button type="submit" class="btn btn-secondary">Archive</button>
            </form>
        }

        @if (Model.AvailableTransitions.Contains(1))
        {
            <form method="post" asp-action="TransitionStatus" asp-controller="Quotation" asp-route-id="@Model.Quotation.Id" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="newStatusId" value="1" />
                <button type="submit" class="btn btn-primary">Unarchive</button>
            </form>
        }

        <a href="@Url.Action("Preview", "Quotation", new { id = Model.Quotation.Id })" target="_blank" class="btn btn-secondary">Preview Proposal</a>

        @if (Model.AvailableTransitions.Contains(2))
        {
            <form method="post" asp-action="TransitionStatus" asp-controller="Quotation" asp-route-id="@Model.Quotation.Id" style="display:inline;" id="sendQuotationForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="newStatusId" value="2" />
                <button type="button" class="btn btn-primary" onclick="confirmSendQuotation()">Send Quotation</button>
            </form>
        }
        @if (Model.Quotation.QuotationStatusTypeId != 4 && Model.Quotation.QuotationStatusTypeId != 5)
        {
            <form method="post" asp-action="ConvertToInvoice" asp-controller="Quotation" style="display:inline;" id="convertToInvoiceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="quotationId" value="@Model.Quotation.Id" />
                <button type="button" class="btn btn-green" onclick="confirmConvertToInvoice()">Convert to Invoice</button>
            </form>
        }
        <button type="button" class="btn btn-secondary" onclick="downloadQuotationPdf(@Model.Quotation.Id)">Download PDF</button>
        <button type="button" class="btn btn-secondary" onclick="duplicateQuotation(@Model.Quotation.Id)">Duplicate</button>
        @if (Model.Quotation.QuotationStatusTypeId == 1)
        {
            <button type="button" class="btn btn-danger" onclick="deleteQuotation(@Model.Quotation.Id, '@Html.Raw(Model.Quotation.Reference)')">Delete</button>
        }
    </div>
</div>

<!-- Quotation Overview (full width) -->
<section class="glass card-pad">
    <div style="display:flex;justify-content:space-between;align-items:start;gap:24px;flex-wrap:wrap;">
        <div>
            <div class="label">Status</div>
            <div style="margin-top:10px;">
                @{
                    var pillClass = Model.Quotation.QuotationStatusTypeId switch
                    {
                        1 => "pill-gold",
                        2 => "pill-blue",
                        3 => "pill-green",
                        4 => "pill-blue",
                        5 => "pill-red",
                        _ => "pill-gold"
                    };
                }
                <span class="pill @pillClass">@Model.StatusName</span>
                @if (Model.IsExpired)
                {
                    <span class="pill pill-gold" style="margin-left:8px;">Expired</span>
                }
            </div>
        </div>
        <div style="display:flex;gap:32px;flex-wrap:wrap;">
            <div>
                <div class="label">Customer</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">@Model.CustomerName</div>
            </div>
            <div>
                <div class="label">Reference</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">@Model.Quotation.Reference</div>
            </div>
            @if (Model.Quotation.ValidUntil.HasValue)
            {
                <div>
                    <div class="label">Valid Until</div>
                    <div style="margin-top:6px;font-size:15px;font-weight:700;">
                        @Model.Quotation.ValidUntil.Value.ToString("yyyy-MM-dd")
                        @if (Model.IsExpired)
                        {
                            <span style="color:var(--gold);font-size:11px;font-weight:800;margin-left:6px;">EXPIRED</span>
                        }
                    </div>
                </div>
            }
            <div>
                <div class="label">Created</div>
                <div style="margin-top:6px;font-size:15px;font-weight:700;">@Model.Quotation.CreatedAtUtc.ToString("yyyy-MM-dd")</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Quotation.Notes))
    {
        <div style="margin-top:18px;padding-top:18px;border-top:1px solid rgba(13,94,166,.08);">
            <div class="label">Notes</div>
            <div style="margin-top:6px;font-size:14px;color:var(--muted);line-height:1.7;white-space:pre-wrap;">@Model.Quotation.Notes</div>
        </div>
    }
</section>

<!-- Line Items (full width) -->
<section class="glass card-pad" style="margin-top:24px;">
    <div class="label">Line Items</div>
    <h2 style="margin-top:8px;font-size:24px;">Pricing breakdown</h2>

    <div style="margin-top:18px;">
        @if (Model.Lines != null && Model.Lines.Count > 0)
        {
            var sections = ViewBag.Sections as List<Portal.Infrastructure.Entities.ProposalSection> ?? new List<Portal.Infrastructure.Entities.ProposalSection>();
            var subscriptionSectionIds = new HashSet<int>(sections.Where(s => s.ColumnConfiguration == "Subscription").Select(s => s.Id));
            var subscriptionLines = Model.Lines.Where(l => l.ProposalSectionId.HasValue && subscriptionSectionIds.Contains(l.ProposalSectionId.Value)).ToList();
            var oneTimeLines = Model.Lines.Where(l => !l.ProposalSectionId.HasValue || !subscriptionSectionIds.Contains(l.ProposalSectionId.Value)).ToList();

            @if (subscriptionLines.Count > 0)
            {
                <div class="label" style="margin-bottom:8px;font-size:11px;color:var(--muted);">Subscription Items (Monthly)</div>
                <table style="table-layout:fixed;">
                    <colgroup>
                        <col style="width:40%;" />
                        <col style="width:12%;" />
                        <col style="width:18%;" />
                        <col style="width:12%;" />
                        <col style="width:18%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Months</th>
                            <th>Monthly Price</th>
                            <th>VAT %</th>
                            <th>Annual Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in subscriptionLines)
                        {
                            <tr>
                                <td>
                                    <strong>@line.Description</strong>
                                    @if (!string.IsNullOrWhiteSpace(line.ReferenceUrl))
                                    {
                                        <a href="@line.ReferenceUrl" target="_blank" style="margin-left:8px;font-size:11px;color:var(--blue);">&#x2197; ref</a>
                                    }
                                </td>
                                <td>12</td>
                                <td>@(ViewBag.CurrencySymbol)@line.LineTotal.ToString("N2")/mo</td>
                                <td>@line.VatRate.ToString("G29")%</td>
                                <td><strong>@(ViewBag.CurrencySymbol)@((line.LineTotal * 12).ToString("N2"))</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (oneTimeLines.Count > 0)
            {
                if (subscriptionLines.Count > 0)
                {
                    <div class="label" style="margin-top:24px;margin-bottom:8px;font-size:11px;color:var(--muted);">One-Time Items</div>
                }
                <table style="table-layout:fixed;">
                    <colgroup>
                        <col style="width:40%;" />
                        <col style="width:12%;" />
                        <col style="width:18%;" />
                        <col style="width:12%;" />
                        <col style="width:18%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>VAT %</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in oneTimeLines)
                        {
                            <tr>
                                <td>
                                    <strong>@line.Description</strong>
                                    @if (!string.IsNullOrWhiteSpace(line.ReferenceUrl))
                                    {
                                        <a href="@line.ReferenceUrl" target="_blank" style="margin-left:8px;font-size:11px;color:var(--blue);">&#x2197; ref</a>
                                    }
                                </td>
                                <td>@line.Quantity.ToString("G29")</td>
                                <td>@(ViewBag.CurrencySymbol)@line.UnitPrice.ToString("N2")</td>
                                <td>@line.VatRate.ToString("G29")%</td>
                                <td><strong>@(ViewBag.CurrencySymbol)@line.LineTotal.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            <p class="muted" style="font-size:14px;">No line items on this quotation.</p>
        }
    </div>

    <div class="surface card-pad totals" style="margin-top:18px;">
        <div class="row"><span class="muted">Subtotal</span><strong>@(ViewBag.CurrencySymbol)@Model.Quotation.Subtotal.ToString("N2")</strong></div>
        <div class="row"><span class="muted">Tax</span><strong>@(ViewBag.CurrencySymbol)@Model.Quotation.TaxAmount.ToString("N2")</strong></div>
        <div class="row"><span>Grand Total</span><span class="big-total">@(ViewBag.CurrencySymbol)@Model.Quotation.TotalAmount.ToString("N2")</span></div>
    </div>
</section>

<!-- Share Proposal (full width) -->
<section class="glass card-pad" style="margin-top:24px;">
    <div class="label">Proposal Sharing</div>
    <h2 style="margin-top:8px;font-size:24px;">Share with customer</h2>
    <p class="muted" style="margin-top:8px;font-size:14px;">Generate a branded proposal and send a secure link to your customer.</p>

    <form id="shareProposalForm" method="post" asp-action="Share" asp-controller="Quotation" asp-route-id="@quotationId" style="margin-top:24px;">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label for="RecipientEmail">Recipient Email</label>
                <input type="email" id="RecipientEmail" name="RecipientEmail"
                       value="@(ViewBag.CustomerEmail ?? "")" />
                <small class="muted">Pre-filled with customer email. Change to send to an alternative address.</small>
            </div>
            <div class="field">
                <label for="ExpiresAtUtc">Link Expiration</label>
                <input type="datetime-local" id="ExpiresAtUtc" name="ExpiresAtUtc"
                       value="@defaultExpiration.ToString("yyyy-MM-ddTHH:mm")" required />
                <small class="muted">Must be at least 1 day in the future.</small>
            </div>
            <div class="field" style="grid-column:1 / -1;">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input type="checkbox" name="SendEmail" value="true" checked style="width:16px;height:16px;" />
                    <span style="font-size:14px;font-weight:500;color:#334155;">Send email notification to recipient</span>
                </label>
            </div>
        </div>

        @if (logos.Any())
        {
            <div style="margin-top:24px;padding-top:24px;border-top:1px solid rgba(13,94,166,.08);">
                <div class="label" style="margin-bottom:12px;">Hero Logos</div>
                <p class="muted" style="font-size:13px;margin-bottom:12px;">Select logos to display prominently at the top of the proposal.</p>
                <div style="display:flex;gap:16px;flex-wrap:wrap;">
                    @foreach (var logo in logos)
                    {
                        <label style="display:flex;align-items:center;gap:10px;padding:10px 16px;border:1.5px solid rgba(13,94,166,.10);border-radius:12px;cursor:pointer;transition:border-color .2s;">
                            <input type="checkbox" name="HeroLogoIds" value="@logo.Id" style="width:16px;height:16px;" @(logo.IsPrimary ? "checked" : "") />
                            <img src="@logo.PublicUrl" alt="@logo.DisplayName" style="max-height:36px;max-width:72px;object-fit:contain;" />
                            <span style="font-size:13px;font-weight:600;color:#334155;">@logo.DisplayName</span>
                            @if (logo.IsPrimary)
                            {
                                <span style="font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#0D5EA6;">Primary</span>
                            }
                        </label>
                    }
                </div>
            </div>

            <div style="margin-top:24px;padding-top:24px;border-top:1px solid rgba(13,94,166,.08);">
                <div class="label" style="margin-bottom:12px;">Metadata Logo</div>
                <p class="muted" style="font-size:13px;margin-bottom:12px;">Small logo displayed next to the business name in the proposal header.</p>
                <div style="display:flex;gap:16px;flex-wrap:wrap;">
                    <label style="display:flex;align-items:center;gap:10px;padding:10px 16px;border:1.5px solid rgba(13,94,166,.10);border-radius:12px;cursor:pointer;">
                        <input type="radio" name="MetaLogoId" value="" @(!logos.Any(l => l.IsPrimary) ? "checked" : "") style="width:16px;height:16px;" />
                        <span style="font-size:13px;font-weight:600;color:#5E7385;">None</span>
                    </label>
                    @foreach (var logo in logos)
                    {
                        <label style="display:flex;align-items:center;gap:10px;padding:10px 16px;border:1.5px solid rgba(13,94,166,.10);border-radius:12px;cursor:pointer;">
                            <input type="radio" name="MetaLogoId" value="@logo.Id" @(logo.IsPrimary ? "checked" : "") style="width:16px;height:16px;" />
                            <img src="@logo.PublicUrl" alt="@logo.DisplayName" style="max-height:28px;max-width:56px;object-fit:contain;" />
                            <span style="font-size:13px;font-weight:600;color:#334155;">@logo.DisplayName</span>
                        </label>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="margin-top:18px;padding:16px;background:rgba(13,94,166,.03);border-radius:12px;border:1px solid rgba(13,94,166,.08);">
                <p class="muted" style="font-size:14px;margin:0;">No logos uploaded yet. <a href="@Url.Action("Index", "MyBusiness", new { tab = "logos" })" style="color:var(--blue);font-weight:700;">Upload logos</a> in My Business to include them in proposals.</p>
            </div>
        }

        <div style="margin-top:24px;padding-top:24px;border-top:1px solid rgba(13,94,166,.08);display:flex;gap:12px;">
            <button type="button" id="btnShareProposal" class="btn btn-primary">Share Proposal</button>
            <button type="button" id="btnPreviewProposal" class="btn btn-secondary">Preview First</button>
        </div>
    </form>
</section>

<!-- Acceptance Status -->
@if (ViewBag.AcceptanceStatus != null)
{
    <section class="glass card-pad" style="margin-top:24px;">
        <div class="label">Customer Acceptance</div>
        <div style="margin-top:10px;">
            @if (ViewBag.AcceptanceStatus == "accepted")
            {
                <span style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;background:#e6f7f1;border:1px solid #129867;border-radius:10px;color:#129867;font-size:14px;font-weight:700;">
                    &#x2713; Accepted on @(((DateTimeOffset)ViewBag.AcceptedAtUtc).ToString("dd MMM yyyy"))
                </span>
            }
            else if (ViewBag.AcceptanceStatus == "awaiting")
            {
                <span style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;background:#fef7ec;border:1px solid #C8912E;border-radius:10px;color:#C8912E;font-size:14px;font-weight:700;">
                    &#x23F3; Awaiting acceptance
                </span>
            }
        </div>
    </section>
}

<!-- Back link -->
<div style="margin-top:24px;display:flex;justify-content:flex-end;">
    <a asp-action="Index" asp-controller="Quotation" class="btn btn-outline">&larr; Back to Quotations</a>
</div>

@section Scripts {
    <script>
        async function confirmSendQuotation() {
            var result = await Swal.fire({
                title: 'Mark as Sent?',
                html: '<div style="text-align:left;font-size:14px;line-height:1.8;color:#334155;">' +
                      '<p style="margin-bottom:12px;">This marks the quotation as <strong>Sent</strong> in your system for tracking purposes.</p>' +
                      '<p style="margin-bottom:12px;color:#5a6a7a;">This does <strong>not</strong> send an email to the customer.</p>' +
                      '<p style="margin-bottom:0;"><strong>To share with your customer:</strong> use the <em>Share Proposal</em> section below to generate a branded link and send it via email.</p>' +
                      '</div>',
                icon: 'info',
                showCancelButton: true,
                confirmButtonText: 'Mark as Sent',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#0D5EA6'
            });
            if (result.isConfirmed) {
                document.getElementById('sendQuotationForm').submit();
            }
        }

        async function confirmConvertToInvoice() {
            var result = await Swal.fire({
                title: 'Convert to Invoice?',
                text: 'This will create an invoice from this quotation. The quotation status will change to Converted.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, convert it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#129867'
            });
            if (result.isConfirmed) {
                document.getElementById('convertToInvoiceForm').submit();
            }
        }

        async function duplicateQuotation(quotationId) {
            var result = await Swal.fire({
                title: 'Duplicate Quotation',
                text: 'Are you sure you want to duplicate this quotation?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0D5EA6',
                confirmButtonText: 'Yes, duplicate it'
            });

            if (!result.isConfirmed) return;

            BlockUI.show('Duplicating...');
            try {
                var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('/Quotation/Duplicate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'id=' + quotationId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    window.location = data.redirectUrl;
                } else {
                    Swal.fire({ title: 'Error', text: data.message, icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function deleteQuotation(quotationId, reference) {
            // Step 1: First confirmation
            const firstResult = await Swal.fire({
                title: 'Are you sure?',
                text: `Quotation ${reference} will be deleted.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it'
            });

            if (!firstResult.isConfirmed) return;

            // Step 2: Second confirmation
            const secondResult = await Swal.fire({
                title: 'Final Warning',
                text: 'This action cannot be easily undone. Are you sure you want to proceed?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete permanently'
            });

            if (!secondResult.isConfirmed) return;

            // Step 3: Execute deletion
            BlockUI.show('Deleting...');
            try {
                var response = await fetch('/Quotation/SoftDelete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: `id=${quotationId}`
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    await Swal.fire({
                        title: 'Deleted!',
                        text: 'The quotation has been deleted.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                    window.location.href = '/Quotation';
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message,
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            }
        }

        document.getElementById('btnShareProposal').addEventListener('click', async function() {
            var btn = this;

            var confirmation = await Swal.fire({
                title: 'Share this proposal?',
                text: 'The proposal will be sent to the recipient. This will generate a secure link.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, share it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#0D5EA6'
            });

            if (!confirmation.isConfirmed) return;

            btn.disabled = true;
            BlockUI.show('Sharing proposal...');

            var form = document.getElementById('shareProposalForm');
            var formData = new FormData(form);

            try {
                var response = await fetch(form.action, {
                    method: 'POST',
                    body: formData
                });
                var data = await response.json();

                BlockUI.hide();

                if (data.success) {
                    var fullUrl = window.location.origin + data.shareUrl;
                    await Swal.fire({
                        title: 'Proposal Shared!',
                        html: '<p style="margin-bottom:12px;">Your proposal has been shared successfully.</p>' +
                              '<div style="display:flex;align-items:center;gap:8px;padding:10px;background:#F7FAFC;border-radius:8px;border:1px solid rgba(13,94,166,.12);">' +
                              '<input type="text" value="' + fullUrl + '" readonly style="flex:1;border:none;background:transparent;font-size:13px;color:#334155;" id="swalShareUrl" />' +
                              '<button type="button" onclick="navigator.clipboard.writeText(\'' + fullUrl + '\');this.textContent=\'Copied!\';setTimeout(()=>this.textContent=\'Copy\',2000);" style="padding:6px 12px;background:#0D5EA6;color:#fff;border:none;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;">Copy</button>' +
                              '</div>',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6',
                        confirmButtonText: 'Done'
                    });
                    window.location.reload();
                } else {
                    Swal.fire({
                        title: 'Sharing Failed',
                        text: data.message || 'An error occurred while sharing the proposal.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred while sharing the proposal.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            } finally {
                btn.disabled = false;
            }
        });

        async function downloadQuotationPdf(quotationId) {
            BlockUI.show('Generating PDF...');
            try {
                var response = await fetch('/Quotation/AxGetDownloadPdf/' + quotationId);

                if (!response.ok || !response.headers.get('content-type')?.includes('application/pdf')) {
                    var data = await response.json();
                    BlockUI.hide();
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to generate PDF.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                    return;
                }

                var blob = await response.blob();
                var contentDisposition = response.headers.get('content-disposition');
                var filename = 'quotation.pdf';
                if (contentDisposition) {
                    var match = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (match && match[1]) {
                        filename = match[1].replace(/['"]/g, '');
                    }
                }
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                BlockUI.hide();
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'Could not complete download due to a connection problem.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        document.getElementById('btnPreviewProposal').addEventListener('click', function() {
            var form = document.getElementById('shareProposalForm');
            var formData = new FormData(form);

            // Build a hidden form that submits to Preview in a new tab
            var previewForm = document.createElement('form');
            previewForm.method = 'POST';
            previewForm.action = '@Url.Action("Preview", "Quotation", new { id = Model.Quotation.Id })';
            previewForm.target = '_blank';
            previewForm.style.display = 'none';

            // Add antiforgery token
            var token = form.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                var tokenClone = document.createElement('input');
                tokenClone.type = 'hidden';
                tokenClone.name = '__RequestVerificationToken';
                tokenClone.value = token.value;
                previewForm.appendChild(tokenClone);
            }

            // Add selected HeroLogoIds
            var heroCheckboxes = form.querySelectorAll('input[name="HeroLogoIds"]:checked');
            heroCheckboxes.forEach(function(cb) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'HeroLogoIds';
                input.value = cb.value;
                previewForm.appendChild(input);
            });

            // Add MetaLogoId
            var metaRadio = form.querySelector('input[name="MetaLogoId"]:checked');
            if (metaRadio && metaRadio.value) {
                var metaInput = document.createElement('input');
                metaInput.type = 'hidden';
                metaInput.name = 'MetaLogoId';
                metaInput.value = metaRadio.value;
                previewForm.appendChild(metaInput);
            }

            document.body.appendChild(previewForm);
            previewForm.submit();
            document.body.removeChild(previewForm);
        });
    </script>
}
