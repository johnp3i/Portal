@model Portal.Web.Models.CreateFirstPeriodViewModel
@{
    ViewData["Title"] = "Create First VAT Period";

    var currentYear = DateTime.UtcNow.Year;
    var startYear = 2018;
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> VAT</div>
        <h1 class="topbar-heading">Create First VAT Period</h1>
        <p class="topbar-subtitle">
            Define your first VAT filing period. This is typically assigned by the tax authority based on your business sector.
            Subsequent periods will be generated automatically based on your configured VAT period length.
        </p>
    </div>
</div>

<section class="glass card-pad">
    <form asp-action="CreateFirstPeriod" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="margin-bottom:16px;padding:12px 16px;background:rgba(194,74,74,0.06);border:1px solid rgba(194,74,74,0.25);border-radius:12px;display:flex;align-items:center;gap:10px;">
                <span style="color:#C24A4A;font-size:18px;">⚠</span>
                <span style="color:#C24A4A;font-size:14px;font-weight:600;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        @error.ErrorMessage
                    }
                </span>
            </div>
        }

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;max-width:640px;">
            <!-- Start Period -->
            <div>
                <div class="label" style="margin-bottom:12px;font-weight:700;">Period Start</div>
                <div style="display:flex;gap:12px;">
                    <div class="field" style="flex:1;">
                        <label>Month</label>
                        <select asp-for="StartMonth">
                            <option value="">Month</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <div class="field" style="flex:1;">
                        <label>Year</label>
                        <select asp-for="StartYear">
                            <option value="">Year</option>
                            @for (var y = currentYear; y >= startYear; y--)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- End Period -->
            <div>
                <div class="label" style="margin-bottom:12px;font-weight:700;">Period End</div>
                <div style="display:flex;gap:12px;">
                    <div class="field" style="flex:1;">
                        <label>Month</label>
                        <select asp-for="EndMonth">
                            <option value="">Month</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <div class="field" style="flex:1;">
                        <label>Year</label>
                        <select asp-for="EndYear">
                            <option value="">Year</option>
                            @for (var y = currentYear; y >= startYear; y--)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top:16px;padding:12px 16px;background:rgba(13,94,166,0.05);border-radius:12px;border:1px solid rgba(13,94,166,0.12);">
            <p class="muted" style="font-size:13px;margin:0;">
                <strong>Example:</strong> If your tax authority assigned you a first period of November 2022 to February 2023,
                select Start: November 2022, End: February 2023. All subsequent periods will follow your configured VAT period length automatically.
            </p>
        </div>

        <div style="margin-top:24px;display:flex;gap:12px;">
            <button type="submit" class="btn btn-primary">Create Period</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</section>
