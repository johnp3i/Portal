@model Portal.Web.Models.VatPeriodReportViewModel
@{
    Layout = null;

    var netLabel = Model.TaxOwed > 0 ? "Tax Owed" :
                   Model.TaxOwed < 0 ? "Refund Due" : "No Payment Due";

    var netColor = Model.TaxOwed > 0 ? "#C24A4A" :
                   Model.TaxOwed < 0 ? "#129867" : "#5E7385";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>VAT Period Report — @Model.PeriodLabel</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 12px;
            color: #1a2b3c;
            padding: 20px;
            line-height: 1.5;
        }
        h1 {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 4px;
        }
        .subtitle {
            font-size: 11px;
            color: #5a6a7a;
            margin-bottom: 24px;
        }
        .report-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid #e8edf2;
        }
        .report-card h2 {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 3px;
        }
        .report-card .section-desc {
            font-size: 10px;
            color: #5a6a7a;
            margin-bottom: 12px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }
        thead th {
            text-align: left;
            padding: 7px 10px;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #fff;
            background: #0D5EA6;
        }
        thead th.right { text-align: right; }
        tbody td {
            padding: 7px 10px;
            border-bottom: 1px solid #e8edf2;
        }
        tbody td.right { text-align: right; font-variant-numeric: tabular-nums; }
        tbody td.bold { font-weight: 700; }
        .total-row td {
            font-weight: 700;
            background: #eef4f8;
            border-top: 2px solid #0D5EA6;
        }
        .period-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid #e8edf2;
        }
        .period-header .period-label {
            font-size: 11px;
            font-weight: 700;
            color: #0D5EA6;
            background: rgba(13,94,166,.08);
            padding: 4px 10px;
            border-radius: 6px;
        }
        .period-header .period-dates {
            font-size: 11px;
            color: #5a6a7a;
        }
        .summary-grid {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }
        .summary-box {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            background: #f7fafc;
            border: 1px solid #e8edf2;
        }
        .summary-box .label {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #5a6a7a;
            margin-bottom: 3px;
        }
        .summary-box .value {
            font-size: 16px;
            font-weight: 800;
        }
        .summary-box .value.blue { color: #0D5EA6; }
        .summary-box .value.green { color: #129867; }
        .summary-box .value.danger { color: #C24A4A; }
    </style>
</head>
<body>
    <h1>VAT Period Report</h1>
    <div class="subtitle">Generated: @DateTime.Now.ToString("dd MMM yyyy HH:mm")</div>

    <!-- Period Header & Summary -->
    <div class="report-card">
        <div class="period-header">
            <div>
                <h2>@Model.PeriodStartDate.ToString("dd MMM yyyy") – @Model.PeriodEndDate.ToString("dd MMM yyyy")</h2>
                <span class="period-dates">3-month VAT period</span>
            </div>
            <span class="period-label">@Model.PeriodLabel</span>
        </div>

        <div class="summary-grid">
            <div class="summary-box">
                <div class="label">Output VAT (Sales)</div>
                <div class="value blue">@Model.CurrencySymbol@Model.OutputVat.ToString("N2")</div>
            </div>
            <div class="summary-box">
                <div class="label">Input VAT (Purchases)</div>
                <div class="value green">@Model.CurrencySymbol@Model.InputVat.ToString("N2")</div>
            </div>
            <div class="summary-box">
                <div class="label">@netLabel</div>
                <div class="value" style="color:@netColor;">@Model.CurrencySymbol@Math.Abs(Model.TaxOwed).ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Section 1: Sales by Month -->
    <div class="report-card">
        <h2>1. Sales Amount by Month</h2>
        <p class="section-desc">Total sales invoices analysed by month within the period (Net / VAT / Gross)</p>
        <table>
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="right">Net (Excl. VAT)</th>
                    <th class="right">VAT Amount</th>
                    <th class="right">Gross (Incl. VAT)</th>
                    <th class="right">Invoice Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.SalesByMonth)
                {
                    <tr>
                        <td class="bold">@row.MonthName</td>
                        <td class="right">@Model.CurrencySymbol@row.Net.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.Vat.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.Gross.ToString("N2")</td>
                        <td class="right">@row.Count</td>
                    </tr>
                }
                <tr class="total-row">
                    <td>Period Total</td>
                    <td class="right">@Model.CurrencySymbol@Model.SalesByMonth.Sum(r => r.Net).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.SalesByMonth.Sum(r => r.Vat).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.SalesByMonth.Sum(r => r.Gross).ToString("N2")</td>
                    <td class="right">@Model.SalesByMonth.Sum(r => r.Count)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- External Revenue (Z-Reports) -->
    @if (Model.IsZReportEnabled && Model.ZReportRows.Any())
    {
        <div class="report-card">
            <h2>External Revenue (Z-Reports)</h2>
            <p class="section-desc">Revenue summaries from POS systems assigned to this period</p>
            <table>
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Z-Report #</th>
                        <th>Period</th>
                        <th style="text-align:right;">Net Amount</th>
                        <th style="text-align:right;">VAT Amount</th>
                        <th style="text-align:right;">Total</th>
                        <th style="text-align:right;">Discount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.ZReportRows)
                    {
                        <tr>
                            <td><strong>@row.SourceName</strong></td>
                            <td>@(row.ZReportNumber ?? "—")</td>
                            <td>@row.PeriodDisplay</td>
                            <td style="text-align:right;">@Model.CurrencySymbol@row.Net.ToString("N2")</td>
                            <td style="text-align:right;">@Model.CurrencySymbol@row.Vat.ToString("N2")</td>
                            <td style="text-align:right;">@Model.CurrencySymbol@row.Gross.ToString("N2")</td>
                            <td style="text-align:right;">@(row.Discount.HasValue ? $"{Model.CurrencySymbol}{row.Discount.Value:N2}" : "—")</td>
                        </tr>
                    }
                    <tr style="font-weight:700;border-top:2px solid #0D5EA6;">
                        <td colspan="3">Period Total</td>
                        <td style="text-align:right;">@Model.CurrencySymbol@Model.ZReportRows.Sum(r => r.Net).ToString("N2")</td>
                        <td style="text-align:right;">@Model.CurrencySymbol@Model.ZReportRows.Sum(r => r.Vat).ToString("N2")</td>
                        <td style="text-align:right;">@Model.CurrencySymbol@Model.ZReportRows.Sum(r => r.Gross).ToString("N2")</td>
                        <td style="text-align:right;">@(Model.ZReportRows.Sum(r => r.Discount ?? 0) > 0 ? $"{Model.CurrencySymbol}{Model.ZReportRows.Sum(r => r.Discount ?? 0):N2}" : "—")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <!-- Section 2: Purchases by Month -->
    <div class="report-card">
        <h2>2. Purchases Amount by Month</h2>
        <p class="section-desc">Total purchases analysed by month within the period (Net / VAT / Gross)</p>
        <table>
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="right">Net (Excl. VAT)</th>
                    <th class="right">VAT Amount</th>
                    <th class="right">Gross (Incl. VAT)</th>
                    <th class="right">Purchase Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.PurchasesByMonth)
                {
                    <tr>
                        <td class="bold">@row.MonthName</td>
                        <td class="right">@Model.CurrencySymbol@row.Net.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.Vat.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.Gross.ToString("N2")</td>
                        <td class="right">@row.Count</td>
                    </tr>
                }
                <tr class="total-row">
                    <td>Period Total</td>
                    <td class="right">@Model.CurrencySymbol@Model.PurchasesByMonth.Sum(r => r.Net).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.PurchasesByMonth.Sum(r => r.Vat).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.PurchasesByMonth.Sum(r => r.Gross).ToString("N2")</td>
                    <td class="right">@Model.PurchasesByMonth.Sum(r => r.Count)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Section 3: Purchases by Origin per Month -->
    <div class="report-card" style="page-break-before:always;">
        <h2>3. Purchases by Origin Type per Month</h2>
        <p class="section-desc">Monthly breakdown of purchase amounts by origin (Domestic, EU Reverse Charge, Non-EU)</p>
        <table>
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="right">Domestic</th>
                    <th class="right">EU Reverse Charge</th>
                    <th class="right">Non-EU</th>
                    <th class="right">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.PurchasesByOriginPerMonth)
                {
                    <tr>
                        <td class="bold">@row.MonthName</td>
                        <td class="right">@Model.CurrencySymbol@row.Domestic.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.EuReverseCharge.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.NonEu.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.Total.ToString("N2")</td>
                    </tr>
                    @if (row.ExpenseTypeRows.Any())
                    {
                    <tr style="font-size:10px;color:#5a6a7a;border:none;background:none;">
                        <td></td>
                        <td class="right">
                            @foreach (var et in row.ExpenseTypeRows)
                            {
                                <div>→ @et.ExpenseTypeName @Model.CurrencySymbol@et.Domestic.ToString("N2")</div>
                            }
                        </td>
                        <td class="right">
                            @foreach (var et in row.ExpenseTypeRows)
                            {
                                <div>→ @et.ExpenseTypeName @Model.CurrencySymbol@et.EuReverseCharge.ToString("N2")</div>
                            }
                        </td>
                        <td class="right">
                            @foreach (var et in row.ExpenseTypeRows)
                            {
                                <div>→ @et.ExpenseTypeName @Model.CurrencySymbol@et.NonEu.ToString("N2")</div>
                            }
                        </td>
                        <td></td>
                    </tr>
                    }
                }
                <tr class="total-row">
                    <td>Period Total</td>
                    <td class="right">@Model.CurrencySymbol@Model.PurchasesByOriginPerMonth.Sum(r => r.Domestic).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.PurchasesByOriginPerMonth.Sum(r => r.EuReverseCharge).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.PurchasesByOriginPerMonth.Sum(r => r.NonEu).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.PurchasesByOriginPerMonth.Sum(r => r.Total).ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Section 4: Period Totals by Origin -->
    <div class="report-card">
        <h2>4. Period Totals by Purchase Origin</h2>
        <p class="section-desc">Aggregate totals for the entire VAT period, grouped by purchase origin type</p>
        <table>
            <thead>
                <tr>
                    <th>Origin Type</th>
                    <th class="right">Net (Excl. VAT)</th>
                    <th class="right">VAT Amount</th>
                    <th class="right">Gross (Incl. VAT)</th>
                    <th class="right">Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.PeriodTotalsByOrigin)
                {
                    <tr>
                        <td class="bold">@row.OriginName</td>
                        <td class="right">@Model.CurrencySymbol@row.Net.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.Vat.ToString("N2")</td>
                        <td class="right">@Model.CurrencySymbol@row.Gross.ToString("N2")</td>
                        <td class="right">@row.Count</td>
                    </tr>
                }
                <tr class="total-row">
                    <td>All Origins</td>
                    <td class="right">@Model.CurrencySymbol@Model.PeriodTotalsByOrigin.Sum(r => r.Net).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.PeriodTotalsByOrigin.Sum(r => r.Vat).ToString("N2")</td>
                    <td class="right">@Model.CurrencySymbol@Model.PeriodTotalsByOrigin.Sum(r => r.Gross).ToString("N2")</td>
                    <td class="right">@Model.PeriodTotalsByOrigin.Sum(r => r.Count)</td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>
