@model Portal.Web.Models.VatSubmissionDetailViewModel
@{
    ViewData["Title"] = "VAT Submission Detail";

    var netLabel = Model.NetVatPayable > 0 ? "Tax Owed" :
                   Model.NetVatPayable < 0 ? "Refund Due" : "No Payment Due";

    var netColor = Model.NetVatPayable > 0 ? "#C24A4A" :
                   Model.NetVatPayable < 0 ? "#129867" : "#5E7385";
}

@Html.AntiForgeryToken()

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> VAT Submission</div>
        <h1 class="topbar-heading">@Model.PeriodLabel</h1>
        <p class="topbar-subtitle">
            @Model.PeriodStartDate.ToString("dd MMM yyyy") &ndash; @Model.PeriodEndDate.ToString("dd MMM yyyy")
        </p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        @if (Model.IsSubmitted)
        {
            <span class="pill pill-green">Submitted</span>
        }
        else
        {
            <span class="pill pill-gold">Pending</span>
        }
    </div>
</div>

<!-- VAT Breakdown -->
<section class="glass card-pad">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <div>
            <div class="label">VAT Breakdown</div>
            <h2 style="margin-top:8px;font-size:24px;">Period Summary</h2>
        </div>
        <a href="/Vat/PeriodReport?periodId=@Model.PeriodId" target="_blank"
           style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:12px;font-size:13px;font-weight:700;color:#fff;background:linear-gradient(135deg,#0D5EA6 0%,#57B8E8 100%);box-shadow:0 8px 20px rgba(13,94,166,.22);text-decoration:none;transition:all .2s;letter-spacing:.02em;"
           onmouseenter="this.style.transform='translateY(-1px)';this.style.boxShadow='0 12px 28px rgba(13,94,166,.28)'"
           onmouseleave="this.style.transform='none';this.style.boxShadow='0 8px 20px rgba(13,94,166,.22)'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Full Period Report
        </a>
    </div>

    <div class="grid-3" style="margin-top:24px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;">
        <!-- Output VAT -->
        <div class="card-pad" style="border-radius:20px;background:#EEF4F8;border:0;">
            <div class="label">Output VAT (Sales)</div>
            <div style="margin-top:10px;font-size:28px;font-weight:800;color:#0D5EA6;font-family:'Manrope',sans-serif;">
                @Model.CurrencySymbol@Model.TotalOutputVat.ToString("N2")
            </div>
        </div>

        <!-- Input VAT -->
        <div class="card-pad" style="border-radius:20px;background:#EEF4F8;border:0;">
            <div class="label">Input VAT (Purchases)</div>
            <div style="margin-top:10px;font-size:28px;font-weight:800;color:#0D5EA6;font-family:'Manrope',sans-serif;">
                @Model.CurrencySymbol@Model.TotalInputVat.ToString("N2")
            </div>
        </div>

        <!-- Net VAT Payable -->
        <div class="card-pad" style="border-radius:20px;background:#EEF4F8;border:0;">
            <div class="label">@netLabel</div>
            <div style="margin-top:10px;font-size:28px;font-weight:800;color:@netColor;font-family:'Manrope',sans-serif;">
                @Model.CurrencySymbol@Math.Abs(Model.NetVatPayable).ToString("N2")
            </div>
        </div>

        <!-- Totals summary — spans columns 2 and 3 -->
        <div class="card-pad totals" style="grid-column:2/4;background:#EEF4F8;border-radius:16px;border:0;margin-left:0;max-width:none;">
            <div class="row"><span class="muted">Output VAT</span><strong>@Model.CurrencySymbol@Model.TotalOutputVat.ToString("N2")</strong></div>
            <div class="row"><span class="muted">Input VAT</span><strong>- @Model.CurrencySymbol@Model.TotalInputVat.ToString("N2")</strong></div>
            <div class="row"><span>@netLabel</span><span class="big-total" style="color:@netColor;">@Model.CurrencySymbol@Math.Abs(Model.NetVatPayable).ToString("N2")</span></div>
        </div>
    </div>
</section>

<!-- Sales Invoices (Output VAT Breakdown) -->
<section class="glass card-pad" style="margin-top:24px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
        <div>
            <div class="label">Output VAT</div>
            <h2 style="margin-top:8px;font-size:24px;">Sales Invoices &nbsp;<span id="invoiceCount" style="font-size:14px;font-weight:500;color:#5E7385;font-family:'Inter',sans-serif;"></span></h2>
            <p class="muted" style="font-size:13px;margin-top:4px;">Issued invoices contributing to Output VAT for this period.</p>
        </div>
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <div style="background:rgba(13,94,166,.06);border:1.5px solid rgba(13,94,166,.12);border-radius:14px;padding:10px 20px;text-align:center;">
                <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#0D5EA6;">Total Output VAT</div>
                <div style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:800;color:#0D5EA6;margin-top:3px;">@Model.CurrencySymbol@Model.TotalOutputVat.ToString("N2")</div>
            </div>
            <a href="/Vat/ExportInvoicesCsv?periodId=@Model.PeriodId" class="btn btn-outline" style="font-size:13px;padding:8px 16px;display:inline-flex;align-items:center;gap:6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export CSV
            </a>
        </div>
    </div>
    <div style="margin-bottom:16px;">
        <input type="text" id="invoiceSearch" placeholder="Search by invoice number or customer..."
               style="width:100%;max-width:380px;padding:8px 14px;border-radius:10px;border:1.5px solid rgba(13,94,166,.20);font-size:13px;font-family:'Inter',sans-serif;outline:none;" />
    </div>
    <div id="invoiceBreakdownContainer">
        <div style="text-align:center;padding:32px;color:#5E7385;font-size:14px;">Loading...</div>
    </div>
</section>

<!-- Purchases (Input VAT Breakdown) -->
<section class="glass card-pad" style="margin-top:24px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
        <div>
            <div class="label">Input VAT</div>
            <h2 style="margin-top:8px;font-size:24px;">Purchases &nbsp;<span id="purchaseCount" style="font-size:14px;font-weight:500;color:#5E7385;font-family:'Inter',sans-serif;"></span></h2>
            <p class="muted" style="font-size:13px;margin-top:4px;">Purchases contributing to Input VAT for this period.</p>
        </div>
        <a href="/Vat/ExportPurchasesCsv?periodId=@Model.PeriodId" class="btn btn-outline" style="font-size:13px;padding:8px 16px;display:inline-flex;align-items:center;gap:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export CSV
        </a>
    </div>
    <!-- Origin type KPI strip — populated by JS after first AJAX load -->
    <div id="purchaseOriginSummary" style="display:flex;justify-content:space-between;align-items:stretch;flex-wrap:wrap;gap:14px;margin-bottom:18px;"></div>
    <div style="margin-bottom:16px;">
        <input type="text" id="purchaseSearch" placeholder="Search by reference, description or supplier..."
               style="width:100%;max-width:380px;padding:8px 14px;border-radius:10px;border:1.5px solid rgba(13,94,166,.20);font-size:13px;font-family:'Inter',sans-serif;outline:none;" />
    </div>
    <div id="purchaseBreakdownContainer">
        <div style="text-align:center;padding:32px;color:#5E7385;font-size:14px;">Loading...</div>
    </div>
</section>

@if (!Model.IsSubmitted)
{
<!-- Unassigned Purchases -->
<section class="glass card-pad" style="margin-top:24px;" id="unassignedSection">
    <div style="display:flex;justify-content:space-between;align-items:center;">
        <div>
            <div class="label">Action Required</div>
            <h2 style="margin-top:8px;font-size:20px;">Unassigned Purchases <span id="unassignedCount" style="font-size:14px;font-weight:600;color:#C8912E;"></span></h2>
        </div>
        <button type="button" class="btn btn-primary" id="assignSelectedBtn" style="display:none;" onclick="assignSelected()">Assign to this period</button>
    </div>
    <div id="unassignedContent" style="margin-top:16px;">
        <p class="muted" style="font-size:14px;">Loading...</p>
    </div>
</section>
}

<!-- Submission Status -->
<section class="glass card-pad" style="margin-top:24px;">
    <div class="label">Filing Status</div>
    @if (Model.IsSubmitted)
    {
        <div style="margin-top:12px;display:flex;align-items:center;gap:12px;">
            <span class="pill pill-green">Submitted</span>
            <span style="font-size:14px;color:#5E7385;">
                Filed on @Model.SubmittedAtUtc?.ToString("dd MMM yyyy 'at' HH:mm") UTC
            </span>
        </div>
    }
    else
    {
        <div style="margin-top:12px;">
            <p class="muted" style="font-size:14px;margin-bottom:16px;">This submission has not yet been marked as filed with the tax authority.</p>
            <button type="button" class="btn btn-primary" onclick="markAsSubmitted()">Mark as Submitted</button>
        </div>
    }
</section>


@if (Model.HasDiscrepancy)
{
    <section class="glass card-pad" style="margin-top:24px;border:1px solid rgba(194,138,46,0.3);background:rgba(194,138,46,0.04);">
        <div style="display:flex;align-items:flex-start;gap:12px;">
            <span style="font-size:22px;">⚠️</span>
            <div>
                <div style="font-weight:700;font-size:15px;color:#C8912E;margin-bottom:6px;">Audit Discrepancy Detected</div>
                <p class="muted" style="font-size:13px;margin:0;line-height:1.6;">
                    The Input VAT computed by invoice dates (@Model.CurrencySymbol@Model.InputVatByDate.ToString("N2"))
                    differs from the actual reported figure (@Model.CurrencySymbol@Model.TotalInputVat.ToString("N2")).
                </p>
                @if (Model.LatePurchasesIncluded > 0)
                {
                    <p style="font-size:13px;margin:6px 0 0;color:#5E7385;">
                        <strong>@Model.LatePurchasesIncluded</strong> late purchase@(Model.LatePurchasesIncluded > 1 ? "s" : "") from previous periods included in this submission.
                    </p>
                }
                @if (Model.PurchasesReportedLater > 0)
                {
                    <p style="font-size:13px;margin:6px 0 0;color:#5E7385;">
                        <strong>@Model.PurchasesReportedLater</strong> purchase@(Model.PurchasesReportedLater > 1 ? "s" : "") from this period reported in a later submission.
                    </p>
                }
            </div>
        </div>
    </section>
}

<!-- Recurring Expense Check -->
<section class="glass card-pad" style="margin-top:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;" onclick="toggleRecurringPanel()">
        <div style="display:flex;align-items:center;gap:14px;">
            <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,rgba(13,94,166,.08),rgba(87,184,232,.08));display:flex;align-items:center;justify-content:center;">
                <svg width="20" height="20" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>
            </div>
            <div>
                <div class="label">Advisory Check</div>
                <h2 style="margin-top:4px;font-size:20px;">Recurring Expense Check</h2>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
            <span id="recurringBadge" style="display:none;"></span>
            <svg id="recurringChevron" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"/></svg>
        </div>
    </div>
    <div id="recurringPanel" style="margin-top:20px;">
        <div id="recurringContent">
            <p class="muted" style="font-size:14px;">Loading...</p>
        </div>
        <div style="margin-top:14px;" id="recurringRevalidateBtn">
            <button type="button" class="btn btn-secondary" onclick="loadRecurringValidation()" style="font-size:13px;padding:8px 18px;">Re-validate</button>
        </div>
    </div>
</section>

<!-- Back link -->
<div style="margin-top:24px;display:flex;justify-content:flex-end;">
    <a href="/Vat/Index" class="btn btn-outline">&larr; Back to Periods</a>
</div>

@section Scripts {
    <script>
        var submissionId = @Model.SubmissionId;
        var periodId = @Model.PeriodId;
        var invoicePage = 1;
        var purchasePage = 1;
        var invoiceSearch = '';
        var purchaseSearch = '';
        var invoiceSearchTimer = null;
        var purchaseSearchTimer = null;

        // ── Invoice Breakdown ──────────────────────────────────────────────────

        async function loadInvoiceBreakdown() {
            var container = document.getElementById('invoiceBreakdownContainer');
            try {
                var url = '/Vat/GetInvoiceBreakdown?periodId=' + periodId
                    + '&page=' + invoicePage
                    + '&search=' + encodeURIComponent(invoiceSearch);
                var response = await fetch(url);
                var data = await response.json();
                if (!data.success) {
                    container.innerHTML = '<p class="muted" style="padding:16px;font-size:14px;">Failed to load invoices.</p>';
                    return;
                }
                renderInvoiceTable(data, container);
            } catch (e) {
                container.innerHTML = '<p class="muted" style="padding:16px;font-size:14px;">Error loading invoices.</p>';
            }
        }

        function renderInvoiceTable(data, container) {
            // Update count in header (always reflects total, not just current page)
            var countEl = document.getElementById('invoiceCount');
            if (countEl) countEl.textContent = '· ' + data.totalCount + ' invoice' + (data.totalCount !== 1 ? 's' : '');

            if (data.items.length === 0) {
                container.innerHTML = '<div style="text-align:center;padding:32px;color:#5E7385;font-size:14px;">'
                    + (invoiceSearch ? 'No invoices match your search.' : 'No invoices in this period.')
                    + '</div>';
                return;
            }

            var html = '<div class="scroll-hint">← Scroll horizontally →</div><div class="table-responsive"><table><thead><tr>'
                + '<th>Invoice</th>'
                + '<th>Customer</th>'
                + '<th>Invoice Date</th>'
                + '<th>Assignment</th>'
                + '<th>Subtotal</th>'
                + '<th>VAT Amount</th>'
                + '</tr></thead><tbody>';

            data.items.forEach(function (inv) {
                var badge = inv.isExplicitAssignment
                    ? '<span style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:rgba(13,94,166,.10);color:#0D5EA6;">Explicit</span>'
                    : '<span style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:rgba(94,115,133,.10);color:#5E7385;">Date Range</span>';
                html += '<tr>'
                    + '<td><a href="/Invoice/Detail/' + inv.id + '" style="color:#0D5EA6;font-weight:600;text-decoration:none;">' + escapeHtml(inv.invoiceNumber) + '</a></td>'
                    + '<td>' + escapeHtml(inv.customerName) + '</td>'
                    + '<td>' + inv.invoiceDate + '</td>'
                    + '<td>' + badge + '</td>'
                    + '<td>' + formatCurrency(inv.subtotal) + '</td>'
                    + '<td>' + formatCurrency(inv.taxAmount) + '</td>'
                    + '</tr>';
            });

            html += '</tbody></table></div>';

            var from = (data.page - 1) * data.pageSize + 1;
            var to = Math.min(data.page * data.pageSize, data.totalCount);
            html += renderPagingRow(from, to, data.totalCount, data.totalPages, data.page, 'invoice',
                'Total Output VAT: <strong>' + formatCurrency(@Model.TotalOutputVat) + '</strong>');

            container.innerHTML = html;
        }

        // ── Purchase Breakdown ─────────────────────────────────────────────────

        async function loadPurchaseBreakdown() {
            var container = document.getElementById('purchaseBreakdownContainer');
            try {
                var url = '/Vat/GetPurchaseBreakdown?periodId=' + periodId
                    + '&page=' + purchasePage
                    + '&search=' + encodeURIComponent(purchaseSearch);
                var response = await fetch(url);
                var data = await response.json();
                if (!data.success) {
                    container.innerHTML = '<p class="muted" style="padding:16px;font-size:14px;">Failed to load purchases.</p>';
                    return;
                }
                renderPurchaseTable(data, container);
            } catch (e) {
                container.innerHTML = '<p class="muted" style="padding:16px;font-size:14px;">Error loading purchases.</p>';
            }
        }

        function renderPurchaseTable(data, container) {
            // Update count in header (always reflects total, not just current page)
            var countEl = document.getElementById('purchaseCount');
            if (countEl) countEl.textContent = '· ' + data.totalCount + ' purchase' + (data.totalCount !== 1 ? 's' : '');

            // Render origin type KPI strip (only on first load / unfiltered)
            renderOriginSummary(data.originSummary);
            if (data.items.length === 0) {
                container.innerHTML = '<div style="text-align:center;padding:32px;color:#5E7385;font-size:14px;">'
                    + (purchaseSearch ? 'No purchases match your search.' : 'No purchases in this period.')
                    + '</div>';
                return;
            }

            var html = '<div class="scroll-hint">← Scroll horizontally →</div><div class="table-responsive"><table><thead><tr>'
                + '<th>Reference</th>'
                + '<th>Supplier</th>'
                + '<th>Purchase Date</th>'
                + '<th>Category</th>'
                + '<th>Assignment</th>'
                + '<th>VAT Amount</th>'
                + '</tr></thead><tbody>';

            data.items.forEach(function (p) {
                var badge = p.isExplicitAssignment
                    ? '<span style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:rgba(13,94,166,.10);color:#0D5EA6;">Explicit</span>'
                    : '<span style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:rgba(94,115,133,.10);color:#5E7385;">Date Range</span>';
                var originBadge = p.purchaseOriginTypeId === 2
                    ? ' <span style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:rgba(200,145,46,.12);color:#C8912E;">EU RC</span>'
                    : (p.purchaseOriginTypeId === 3
                        ? ' <span style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:rgba(94,115,133,.10);color:#5E7385;">Non-EU</span>'
                        : '');
                var refLine1 = '<span style="font-weight:600;">' + escapeHtml(p.categoryName) + '</span>';
                var refLine2 = p.description
                    ? '<div style="font-size:11px;color:#5E7385;margin-top:2px;">' + escapeHtml(p.description) + '</div>'
                    : '';
                html += '<tr>'
                    + '<td>' + refLine1 + refLine2 + '</td>'
                    + '<td>' + escapeHtml(p.supplierName) + '</td>'
                    + '<td>' + p.invoiceDate + '</td>'
                    + '<td>' + escapeHtml(p.categoryName) + '</td>'
                    + '<td>' + badge + originBadge + '</td>'
                    + '<td>' + formatCurrency(p.vatAmount) + '</td>'
                    + '</tr>';
            });

            html += '</tbody></table></div>';

            var from = (data.page - 1) * data.pageSize + 1;
            var to = Math.min(data.page * data.pageSize, data.totalCount);
            html += renderPagingRow(from, to, data.totalCount, data.totalPages, data.page, 'purchase',
                'Total Input VAT: <strong>' + formatCurrency(@Model.TotalInputVat) + '</strong>');

            container.innerHTML = html;
        }

        // ── Shared helpers ─────────────────────────────────────────────────────

        function renderOriginSummary(summary) {
            var strip = document.getElementById('purchaseOriginSummary');
            if (!strip || !summary || summary.length === 0) return;

            var labels = { 1: 'Domestic', 2: 'EU Reverse Charge', 3: 'Non-EU' };
            var colors = { 1: '#0D5EA6', 2: '#C8912E', 3: '#5E7385' };
            var bgColors = { 1: 'rgba(13,94,166,.07)', 2: 'rgba(200,145,46,.10)', 3: 'rgba(94,115,133,.08)' };

            var totalVat = 0;
            var totalCount = 0;
            var html = '<div style="display:flex;gap:14px;flex-wrap:wrap;">';

            summary.forEach(function(s) {
                var label = labels[s.originTypeId] || 'Other';
                var color = colors[s.originTypeId] || '#5E7385';
                var bg = bgColors[s.originTypeId] || 'rgba(94,115,133,.08)';
                totalVat += s.totalVat;
                totalCount += s.count;
                html += '<div style="background:' + bg + ';border-radius:14px;padding:14px 20px;min-width:160px;">'
                    + '<div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:' + color + ';">' + label + '</div>'
                    + '<div style="font-family:\'Manrope\',sans-serif;font-size:22px;font-weight:800;color:' + color + ';margin-top:6px;">' + formatCurrency(s.totalVat) + '</div>'
                    + '<div style="font-size:12px;color:#5E7385;margin-top:3px;">' + s.count + ' purchase' + (s.count !== 1 ? 's' : '') + '</div>'
                    + '</div>';
            });

            html += '</div>';

            // Total card — pushed to the right
            html += '<div style="background:rgba(13,94,166,.12);border-radius:14px;padding:14px 20px;min-width:160px;margin-left:auto;">'
                + '<div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#0D5EA6;">Total Input VAT</div>'
                + '<div style="font-family:\'Manrope\',sans-serif;font-size:22px;font-weight:800;color:#0D5EA6;margin-top:6px;">' + formatCurrency(totalVat) + '</div>'
                + '<div style="font-size:12px;color:#5E7385;margin-top:3px;">' + totalCount + ' purchase' + (totalCount !== 1 ? 's' : '') + '</div>'
                + '</div>';

            strip.innerHTML = html;
        }

        function renderPagingRow(from, to, total, totalPages, currentPage, type, totalLabel) {
            var html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding-top:14px;border-top:1px solid rgba(13,94,166,.10);flex-wrap:wrap;gap:10px;">';
            html += '<div style="font-size:13px;color:#5E7385;">Showing ' + from + '&ndash;' + to + ' of ' + total + ' &nbsp;&middot;&nbsp; ' + totalLabel + '</div>';
            html += '<div style="display:flex;gap:6px;align-items:center;">';

            // Prev button
            var prevStyle = currentPage <= 1
                ? 'padding:5px 12px;border-radius:8px;border:1.5px solid #e0e0e0;background:#f5f5f5;color:#b0bec5;font-size:13px;font-weight:700;cursor:default;font-family:\'Inter\',sans-serif;'
                : 'padding:5px 12px;border-radius:8px;border:1.5px solid rgba(13,94,166,.20);background:#fff;color:#0D5EA6;font-size:13px;font-weight:700;cursor:pointer;font-family:\'Inter\',sans-serif;';
            var prevDisabled = currentPage <= 1 ? 'disabled' : '';
            html += '<button ' + prevDisabled + ' onclick="changePage(\'' + type + '\',' + (currentPage - 1) + ')" style="' + prevStyle + '">&larr; Prev</button>';

            // Page number buttons (up to 5 around current)
            var start = Math.max(1, currentPage - 2);
            var end = Math.min(totalPages, currentPage + 2);

            if (start > 1) {
                html += '<button onclick="changePage(\'' + type + '\',1)" style="padding:5px 12px;border-radius:8px;border:1.5px solid rgba(13,94,166,.20);background:#fff;color:#0D5EA6;font-size:13px;font-weight:700;cursor:pointer;font-family:\'Inter\',sans-serif;">1</button>';
                html += '<span style="font-size:13px;color:#5E7385;">&hellip;</span>';
            }

            for (var i = start; i <= end; i++) {
                var activeStyle = i === currentPage
                    ? 'padding:5px 12px;border-radius:8px;border:1.5px solid #0D5EA6;background:#0D5EA6;color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:\'Inter\',sans-serif;'
                    : 'padding:5px 12px;border-radius:8px;border:1.5px solid rgba(13,94,166,.20);background:#fff;color:#0D5EA6;font-size:13px;font-weight:700;cursor:pointer;font-family:\'Inter\',sans-serif;';
                html += '<button onclick="changePage(\'' + type + '\',' + i + ')" style="' + activeStyle + '">' + i + '</button>';
            }

            if (end < totalPages) {
                html += '<span style="font-size:13px;color:#5E7385;">&hellip;</span>';
                html += '<button onclick="changePage(\'' + type + '\',' + totalPages + ')" style="padding:5px 12px;border-radius:8px;border:1.5px solid rgba(13,94,166,.20);background:#fff;color:#0D5EA6;font-size:13px;font-weight:700;cursor:pointer;font-family:\'Inter\',sans-serif;">' + totalPages + '</button>';
            }

            // Next button
            var nextStyle = currentPage >= totalPages
                ? 'padding:5px 12px;border-radius:8px;border:1.5px solid #e0e0e0;background:#f5f5f5;color:#b0bec5;font-size:13px;font-weight:700;cursor:default;font-family:\'Inter\',sans-serif;'
                : 'padding:5px 12px;border-radius:8px;border:1.5px solid rgba(13,94,166,.20);background:#fff;color:#0D5EA6;font-size:13px;font-weight:700;cursor:pointer;font-family:\'Inter\',sans-serif;';
            var nextDisabled = currentPage >= totalPages ? 'disabled' : '';
            html += '<button ' + nextDisabled + ' onclick="changePage(\'' + type + '\',' + (currentPage + 1) + ')" style="' + nextStyle + '">Next &rarr;</button>';

            html += '</div></div>';
            return html;
        }

        function changePage(type, page) {
            if (type === 'invoice') {
                invoicePage = page;
                loadInvoiceBreakdown();
            } else {
                purchasePage = page;
                loadPurchaseBreakdown();
            }
        }

        function formatCurrency(amount) {
            return '@Model.CurrencySymbol' + parseFloat(amount).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // ── Search with 400 ms debounce ────────────────────────────────────────

        document.getElementById('invoiceSearch').addEventListener('input', function () {
            clearTimeout(invoiceSearchTimer);
            invoiceSearchTimer = setTimeout(function () {
                invoiceSearch = document.getElementById('invoiceSearch').value;
                invoicePage = 1;
                loadInvoiceBreakdown();
            }, 400);
        });

        document.getElementById('purchaseSearch').addEventListener('input', function () {
            clearTimeout(purchaseSearchTimer);
            purchaseSearchTimer = setTimeout(function () {
                purchaseSearch = document.getElementById('purchaseSearch').value;
                purchasePage = 1;
                loadPurchaseBreakdown();
            }, 400);
        });

        // ── markAsSubmitted ────────────────────────────────────────────────────

        async function markAsSubmitted() {
            // Check for unassigned purchases first
            try {
                var countResp = await fetch('/Vat/AxGetUnassignedCount?periodId=' + periodId);
                var countData = await countResp.json();

                if (countData.count > 0) {
                    var result = await Swal.fire({
                        title: 'Unassigned Purchases',
                        html: '<p>There are <strong>' + countData.count + '</strong> unassigned purchase(s) within this period\'s date range.</p><p style="color:#5E7385;font-size:13px;margin-top:8px;">These purchases won\'t be included in the submission unless you assign them first.</p>',
                        icon: 'warning',
                        showCancelButton: true,
                        showDenyButton: true,
                        confirmButtonText: 'Submit Anyway',
                        denyButtonText: 'Review First',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#0D5EA6',
                        denyButtonColor: '#C8912E'
                    });

                    if (result.isDenied) {
                        // Scroll to unassigned panel
                        var panel = document.getElementById('unassignedSection');
                        if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        return;
                    }

                    if (!result.isConfirmed) return;
                    // User chose "Submit Anyway" — proceed below
                } else {
                    // No unassigned — standard confirmation
                    var confirmed = await Swal.fire({
                        title: 'Confirm Submission',
                        text: 'Are you sure you want to mark this VAT submission as filed?',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#0D5EA6',
                        confirmButtonText: 'Yes, mark as submitted'
                    });

                    if (!confirmed.isConfirmed) return;
                }
            } catch (e) {
                // If check fails, proceed with standard confirmation
                var confirmed = await Swal.fire({
                    title: 'Confirm Submission',
                    text: 'Are you sure you want to mark this VAT submission as filed?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0D5EA6',
                    confirmButtonText: 'Yes, mark as submitted'
                });

                if (!confirmed.isConfirmed) return;
            }

            // Proceed with submission
            BlockUI.show('Processing...');
            try {
                var response = await fetch('/Vat/MarkAsSubmitted', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: 'submissionId=' + submissionId
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({
                        title: 'Done!',
                        text: data.message,
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message,
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            }
        }

        // ── Recurring Expense Validation ───────────────────────────────────────

        var recurringPanelVisible = true;

        function toggleRecurringPanel() {
            recurringPanelVisible = !recurringPanelVisible;
            var panel = document.getElementById('recurringPanel');
            var chevron = document.getElementById('recurringChevron');
            panel.style.display = recurringPanelVisible ? 'block' : 'none';
            chevron.style.transform = recurringPanelVisible ? 'rotate(0deg)' : 'rotate(-90deg)';
        }

        async function loadRecurringValidation() {
            var container = document.getElementById('recurringContent');
            container.innerHTML = '<p class="muted" style="font-size:14px;">Validating...</p>';

            try {
                var response = await fetch('/RecurringExpense/Validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        startDate: '@Model.PeriodStartDate.ToString("yyyy-MM-dd")',
                        endDate: '@Model.PeriodEndDate.ToString("yyyy-MM-dd")'
                    })
                });
                var data = await response.json();

                if (!data.success || data.ruleResults.length === 0) {
                    container.innerHTML = '<div style="text-align:center;padding:28px 20px;">'
                        + '<div style="width:48px;height:48px;border-radius:12px;background:rgba(13,94,166,.06);display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px;"><svg width="22" height="22" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg></div>'
                        + '<p style="font-size:15px;font-weight:700;color:#0B1B28;margin:0 0 8px;">No recurring expense rules configured</p>'
                        + '<p style="font-size:13px;color:#5E7385;margin:0 0 18px;max-width:420px;display:inline-block;line-height:1.6;">Define expected recurring purchases per supplier to automatically verify that all regular expenses have been recorded before you submit this VAT period.</p>'
                        + '<div><a href="/RecurringExpense/Rules" class="btn btn-primary" style="font-size:13px;padding:10px 20px;">Set Up Rules</a></div>'
                        + '</div>';
                    document.getElementById('recurringBadge').style.display = 'none';
                    document.getElementById('recurringRevalidateBtn').style.display = 'none';
                    return;
                }

                renderRecurringResults(data, container);
                document.getElementById('recurringRevalidateBtn').style.display = '';
            } catch (e) {
                container.innerHTML = '<p class="muted" style="font-size:14px;">Unable to load validation.</p>';
            }
        }

        function renderRecurringResults(data, container) {
            var s = data.summary;

            // Update header badge
            var badge = document.getElementById('recurringBadge');
            if (s.failCount > 0) {
                badge.innerHTML = '<span style="display:inline-block;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(194,74,74,.12);color:#C24A4A;">' + s.failCount + ' missing</span>';
                badge.style.display = 'inline-block';
            } else if (s.warningCount > 0) {
                badge.innerHTML = '<span style="display:inline-block;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(200,145,46,.12);color:#C8912E;">' + s.warningCount + ' warning' + (s.warningCount > 1 ? 's' : '') + '</span>';
                badge.style.display = 'inline-block';
            } else {
                badge.innerHTML = '<span style="display:inline-block;padding:3px 10px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(18,152,103,.12);color:#129867;">All clear</span>';
                badge.style.display = 'inline-block';
            }

            // Summary strip
            var html = '<div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:16px;">';
            html += '<div style="font-size:13px;color:#5E7385;"><strong>' + s.totalRules + '</strong> rules checked</div>';
            if (s.passCount > 0) html += '<div style="font-size:13px;color:#129867;"><strong>' + s.passCount + '</strong> pass</div>';
            if (s.warningCount > 0) html += '<div style="font-size:13px;color:#C8912E;"><strong>' + s.warningCount + '</strong> warning</div>';
            if (s.failCount > 0) html += '<div style="font-size:13px;color:#C24A4A;"><strong>' + s.failCount + '</strong> fail</div>';
            html += '</div>';

            // Results table
            html += '<div class="table-responsive"><table><thead><tr>'
                + '<th>Supplier</th>'
                + '<th>Category</th>'
                + '<th>Description</th>'
                + '<th>Expected</th>'
                + '<th>Actual</th>'
                + '<th>Status</th>'
                + '</tr></thead><tbody>';

            data.ruleResults.forEach(function(r) {
                var statusBadge = '';
                if (r.status === 'pass') statusBadge = '<span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(18,152,103,.12);color:#129867;">Pass</span>';
                else if (r.status === 'warning') statusBadge = '<span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(200,145,46,.12);color:#C8912E;">Warning</span>';
                else statusBadge = '<span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(194,74,74,.12);color:#C24A4A;">Fail</span>';

                html += '<tr>'
                    + '<td>' + escapeHtml(r.supplierName) + '</td>'
                    + '<td>' + (r.categoryName ? escapeHtml(r.categoryName) : '<span style="color:#5E7385;">Any</span>') + '</td>'
                    + '<td style="font-size:13px;">' + escapeHtml(r.description) + '</td>'
                    + '<td style="text-align:center;">' + r.expectedCount + '</td>'
                    + '<td style="text-align:center;">' + r.actualCount + '</td>'
                    + '<td>' + statusBadge + '</td>'
                    + '</tr>';
            });

            html += '</tbody></table></div>';
            container.innerHTML = html;
        }

        // ── Unassigned Purchases ───────────────────────────────────────────────

        async function loadUnassignedPurchases() {
            var container = document.getElementById('unassignedContent');
            if (!container) return;

            try {
                var response = await fetch('/Vat/GetUnassignedPurchases?periodId=' + periodId);
                var data = await response.json();

                if (!data.success) {
                    container.innerHTML = '<p class="muted" style="font-size:14px;">Failed to load.</p>';
                    return;
                }

                var countEl = document.getElementById('unassignedCount');
                if (data.count === 0) {
                    container.innerHTML = '<div style="display:flex;align-items:center;gap:10px;padding:16px 0;color:#129867;font-size:14px;font-weight:600;"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> All purchases in this date range have been assigned.</div>';
                    countEl.textContent = '';
                    document.getElementById('assignSelectedBtn').style.display = 'none';
                    return;
                }

                countEl.textContent = '· ' + data.count + ' unassigned';
                renderUnassignedTable(data.items, container);
            } catch (e) {
                container.innerHTML = '<p class="muted" style="font-size:14px;">Error loading unassigned purchases.</p>';
            }
        }

        function renderUnassignedTable(items, container) {
            var html = '<div class="table-responsive"><table><thead><tr>';
            html += '<th><input type="checkbox" id="selectAllUnassigned" onchange="toggleSelectAll(this)"></th>';
            html += '<th>Description</th><th>Supplier</th><th>Date</th><th>Total</th><th>VAT</th><th></th>';
            html += '</tr></thead><tbody>';

            items.forEach(function(p) {
                html += '<tr id="unassigned-row-' + p.id + '">';
                html += '<td><input type="checkbox" class="unassigned-check" value="' + p.id + '" onchange="updateAssignButton()"></td>';
                html += '<td style="font-weight:600;">' + escapeHtml(p.description || p.invoiceNumber || '—') + '</td>';
                html += '<td>' + (p.supplierId || '') + '</td>';
                html += '<td>' + p.invoiceDate + '</td>';
                html += '<td>' + formatCurrency(p.totalAmount) + '</td>';
                html += '<td>' + formatCurrency(p.vatAmount) + '</td>';
                html += '<td><button type="button" class="btn btn-secondary" style="padding:3px 8px;font-size:11px;" onclick="dismissRow(' + p.id + ')">Dismiss</button></td>';
                html += '</tr>';
            });

            html += '</tbody></table></div>';
            container.innerHTML = html;
        }

        function toggleSelectAll(checkbox) {
            var checks = document.querySelectorAll('.unassigned-check');
            checks.forEach(function(c) { c.checked = checkbox.checked; });
            updateAssignButton();
        }

        function updateAssignButton() {
            var checked = document.querySelectorAll('.unassigned-check:checked');
            var btn = document.getElementById('assignSelectedBtn');
            if (btn) {
                btn.style.display = checked.length > 0 ? '' : 'none';
                btn.textContent = 'Assign ' + checked.length + ' to this period';
            }
        }

        function dismissRow(purchaseId) {
            var row = document.getElementById('unassigned-row-' + purchaseId);
            if (row) row.remove();
            updateAssignButton();
            // Update count
            var remaining = document.querySelectorAll('.unassigned-check').length;
            var countEl = document.getElementById('unassignedCount');
            if (remaining === 0) {
                document.getElementById('unassignedContent').innerHTML = '<div style="display:flex;align-items:center;gap:10px;padding:16px 0;color:#129867;font-size:14px;font-weight:600;"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> All purchases in this date range have been assigned.</div>';
                countEl.textContent = '';
                document.getElementById('assignSelectedBtn').style.display = 'none';
            } else {
                countEl.textContent = '· ' + remaining + ' unassigned';
            }
        }

        async function assignSelected() {
            var checked = document.querySelectorAll('.unassigned-check:checked');
            if (checked.length === 0) return;

            var ids = Array.from(checked).map(function(c) { return parseInt(c.value); });

            BlockUI.show('Assigning purchases...');
            try {
                var response = await fetch('/Vat/AxPostAssignPurchasesToPeriod', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ periodId: periodId, purchaseIds: ids })
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Assigned', text: data.message, confirmButtonColor: '#0D5EA6' }).then(function() {
                        loadUnassignedPurchases();
                        loadPurchaseBreakdown();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
            }
        }

        // ── Initial load ───────────────────────────────────────────────────────
        loadInvoiceBreakdown();
        loadPurchaseBreakdown();
        loadRecurringValidation();
        loadUnassignedPurchases();
    </script>
}
