@model Portal.Web.Models.ViewComponents.SubscriptionStatusIndicatorViewModel

@{
    var displayName = Model.PlanName;
    if (displayName.Length > 20)
    {
        displayName = displayName.Substring(0, 20) + "\u2026";
    }
}

@if (Model.IsOwner)
{
    <a href="/Account/Billing" aria-label="View billing and subscription" class="nav-item" style="display:flex;align-items:center;gap:10px;text-decoration:none;margin-top:16px;padding-top:12px;border-top:1px solid rgba(13,94,166,.08);">
        <span class="nav-text" style="font-size:13px;font-weight:600;color:#334155;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@displayName</span>
        <span class="nav-text" style="display:inline-flex;align-items:center;padding:3px 8px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;background-color:@Model.BadgeBackgroundColor;color:@Model.BadgeTextColor;" aria-label="Subscription status: @Model.BadgeText">@Model.BadgeText</span>
    </a>
}
else
{
    <div role="status" class="nav-item" style="display:flex;align-items:center;gap:10px;margin-top:16px;padding-top:12px;border-top:1px solid rgba(13,94,166,.08);">
        <span class="nav-text" style="font-size:13px;font-weight:600;color:#334155;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@displayName</span>
        <span class="nav-text" style="display:inline-flex;align-items:center;padding:3px 8px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;background-color:@Model.BadgeBackgroundColor;color:@Model.BadgeTextColor;" aria-label="Subscription status: @Model.BadgeText">@Model.BadgeText</span>
    </div>
}
