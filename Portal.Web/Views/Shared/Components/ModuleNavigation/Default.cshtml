@model Dictionary<string, string>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var moduleLinks = new Dictionary<string, (string Controller, string Action, string Label)>
    {
        { "customer", ("Customer", "Index", "Customers") },
        { "quotation", ("Quotation", "Index", "Quotations") },
        { "invoice", ("Invoice", "Index", "Invoices") },
        { "revenue", ("Revenue", "Index", "Revenue") },
        { "purchase", ("Purchase", "Index", "Purchases") },
        { "vat", ("Vat", "Index", "VAT") },
        { "audit", ("Audit", "Index", "Audit") }
    };

    var purchaseModuleLinks = new List<(string Controller, string Action, string Label)>
    {
        ("Supplier", "Index", "Suppliers")
    };
}

@foreach (var module in moduleLinks)
{
    if (Model.TryGetValue(module.Key, out var accessLevel) && accessLevel != "none")
    {
        var isActive = currentController.Equals(module.Value.Controller, StringComparison.OrdinalIgnoreCase);
        <a class="nav-item @(isActive ? "active" : "")" asp-controller="@module.Value.Controller" asp-action="@module.Value.Action">@module.Value.Label</a>
    }
}

@if (Model.TryGetValue("purchase", out var purchaseAccess) && purchaseAccess != "none")
{
    foreach (var link in purchaseModuleLinks)
    {
        var isActive = currentController.Equals(link.Controller, StringComparison.OrdinalIgnoreCase);
        <a class="nav-item @(isActive ? "active" : "")" asp-controller="@link.Controller" asp-action="@link.Action">@link.Label</a>
    }
}

@{
    var hasQuotationAccess = Model.TryGetValue("quotation", out var qAccess) && qAccess != "none";
    var hasInvoiceAccess = Model.TryGetValue("invoice", out var iAccess) && iAccess != "none";
}

@if (hasQuotationAccess || hasInvoiceAccess)
{
    var isSharedLinksActive = currentController.Equals("SharedLinks", StringComparison.OrdinalIgnoreCase);
    <a class="nav-item @(isSharedLinksActive ? "active" : "")" href="/shared-links">Shared Links</a>
}
