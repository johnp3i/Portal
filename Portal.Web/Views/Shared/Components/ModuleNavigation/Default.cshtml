@model Dictionary<string, string>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Icons
    var customerIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 00-3-3.87\"/><path d=\"M16 3.13a4 4 0 010 7.75\"/></svg>";
    var quotationIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M16 13H8m8 4H8m2-8H8\"/></svg>";
    var invoiceIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"18\" rx=\"2\"/><path d=\"M8 7h8m-8 4h8m-8 4h4\"/></svg>";
    var creditNoteIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M9 15l2 2 4-4\"/></svg>";
    var sharedLinksIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71\"/></svg>";
    var revenueIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17.2 7A7 7 0 0 0 6 12a7 7 0 0 0 11.2 5\"/><path d=\"M4 10h10M4 14h10\"/></svg>";
    var statementIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4h16v16H4z\"/><path d=\"M4 9h16M9 4v16\"/></svg>";
    var vatIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 12h16M4 17h10\"/><circle cx=\"19\" cy=\"17\" r=\"2\"/></svg>";
    var purchaseIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 01-8 0\"/></svg>";
    var supplierIcon = "<svg width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    var categoryIcon = "<svg width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z\"/></svg>";
    var productIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z\"/><path d=\"M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12\"/></svg>";
    var pnlIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M18 20V10M12 20V4M6 20v-6\"/></svg>";

    // Access checks
    var hasCustomerAccess = Model.TryGetValue("customer", out var custAccess) && custAccess != "none";
    var hasQuotationAccess = Model.TryGetValue("quotation", out var quotAccess) && quotAccess != "none";
    var hasInvoiceAccess = Model.TryGetValue("invoice", out var invAccess) && invAccess != "none";
    var hasCreditAccess = Model.TryGetValue("credit", out var credAccess) && credAccess != "none";
    var hasRevenueAccess = Model.TryGetValue("revenue", out var revAccess) && revAccess != "none";
    var hasPurchaseAccess = Model.TryGetValue("purchase", out var purAccess) && purAccess != "none";
    var hasProductAccess = Model.TryGetValue("products", out var prodAccess) && prodAccess != "none";
    var hasVatAccess = Model.TryGetValue("vat", out var vatAccess) && vatAccess != "none";
    var hasAuditAccess = Model.TryGetValue("audit", out var audAccess) && audAccess != "none";
    var hasAuditLogAccess = Model.TryGetValue("audit_log", out var alAccess) && alAccess != "none";
    var hasPnlAccess = Model.TryGetValue("pnl", out var pnlAccess) && pnlAccess != "none";
    var hasExpenseInsightsAccess = Model.TryGetValue("expense_insights", out var eiAccess) && eiAccess != "none";
    var hasPaymentReminderAccess = Model.TryGetValue("payment_reminder_manual", out var prAccess) && prAccess != "none";
    var hasPaymentReminderAutoAccess = Model.TryGetValue("payment_reminder_auto", out var praAccess) && praAccess != "none";
    var hasCashflowAccess = Model.TryGetValue("cashflow", out var cfAccess) && cfAccess != "none";
    var hasSchedulePaymentsAccess = Model.TryGetValue("schedule_payments", out var spAccess) && spAccess != "none";
    var hasAttachmentsAccess = Model.TryGetValue("attachments", out var attAccess) && attAccess != "none";
    var hasPurchaseImportAccess = Model.TryGetValue("purchase_import", out var piAccess) && piAccess != "none";
    var hasZReportImportAccess = Model.TryGetValue("zreport_import", out var zriAccess) && zriAccess != "none";

    var hasSalesSection = hasCustomerAccess || hasQuotationAccess || hasInvoiceAccess || hasCreditAccess;
    var hasFinanceSection = hasRevenueAccess || hasVatAccess || hasPnlAccess || hasPaymentReminderAccess || hasPaymentReminderAutoAccess || hasCashflowAccess || hasSchedulePaymentsAccess || hasAuditLogAccess;
    var hasPurchasingSection = hasPurchaseAccess || hasExpenseInsightsAccess;
    var hasCatalogSection = hasProductAccess;

    var hasSalesPipelineAccess = Model.TryGetValue("sales", out var salesAccess) && salesAccess != "none";
    var hasComplianceAccess = Model.TryGetValue("compliance", out var compAccess) && compAccess != "none";
    var hasPayrollAccess = Model.TryGetValue("payroll", out var payrollAccess) && payrollAccess != "none";
}

@* ═══ PIPELINE ═══ *@
@if (hasSalesPipelineAccess)
{
    var pipelineIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/></svg>";
    var contactsIcon = "<svg width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/></svg>";
    var salesProductIcon = "<svg width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z\"/></svg>";
    var meetingsIcon = "<svg width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg>";
    var templatesIcon = "<svg width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4h16v16H4z\"/><path d=\"M4 9h16M9 4v16\"/></svg>";

    <div class="nav-section">
        <div class="nav-title">Opportunities</div>
        @{
            var isPipelineActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Pipeline", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-item @(isPipelineActive ? "active" : "")" asp-controller="Sales" asp-action="Pipeline">
            <span class="nav-icon">@Html.Raw(pipelineIcon)</span>
            <span class="nav-text">Lead Board</span>
        </a>
        @{
            var isInsightsActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Insights", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-sub-item @(isInsightsActive ? "active" : "")" asp-controller="Sales" asp-action="Insights">
            <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6"/></svg></span>
            <span class="nav-text">Insights</span>
        </a>
        @{
            var isSalesContactsActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase)
                && (currentAction.Equals("Contacts", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("ContactDetail", StringComparison.OrdinalIgnoreCase));
        }
        <a class="nav-sub-item @(isSalesContactsActive ? "active" : "")" asp-controller="Sales" asp-action="Contacts">
            <span class="nav-icon">@Html.Raw(contactsIcon)</span>
            <span class="nav-text">Contacts</span>
        </a>
        @{
            var isSalesProductsActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Products", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-sub-item @(isSalesProductsActive ? "active" : "")" asp-controller="Sales" asp-action="Products">
            <span class="nav-icon">@Html.Raw(salesProductIcon)</span>
            <span class="nav-text">Products & Services</span>
        </a>
        @{
            var isMeetingsActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Meetings", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-sub-item @(isMeetingsActive ? "active" : "")" asp-controller="Sales" asp-action="Meetings">
            <span class="nav-icon">@Html.Raw(meetingsIcon)</span>
            <span class="nav-text">Meetings</span>
        </a>
        @{
            var isTasksActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Tasks", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-sub-item @(isTasksActive ? "active" : "")" asp-controller="Sales" asp-action="Tasks">
            <span class="nav-icon"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg></span>
            <span class="nav-text">Tasks</span>
            <span id="navTaskOverdueBadge" style="margin-left:auto;display:none;background:#C24A4A;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:6px;min-width:18px;text-align:center;"></span>
        </a>
        @{
            var isTemplatesActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Templates", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-sub-item @(isTemplatesActive ? "active" : "")" asp-controller="Sales" asp-action="Templates">
            <span class="nav-icon">@Html.Raw(templatesIcon)</span>
            <span class="nav-text">Templates</span>
        </a>
        @{
            var isTeamActive = currentController.Equals("Sales", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Team", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-sub-item @(isTeamActive ? "active" : "")" asp-controller="Sales" asp-action="Team">
            <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>
            <span class="nav-text">Team</span>
        </a>
    </div>
}

@* ═══ SALES ═══ *@
@if (hasSalesSection)
{
    <div class="nav-section">
        <div class="nav-title">Sales</div>
        @if (hasCustomerAccess)
        {
            var isActive = currentController.Equals("Customer", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" asp-controller="Customer" asp-action="Index">
                <span class="nav-icon">@Html.Raw(customerIcon)</span>
                <span class="nav-text">Customers</span>
            </a>
        }
        @if (hasQuotationAccess)
        {
            var isActive = currentController.Equals("Quotation", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" asp-controller="Quotation" asp-action="Index">
                <span class="nav-icon">@Html.Raw(quotationIcon)</span>
                <span class="nav-text">Quotations</span>
            </a>
        }
        @if (hasInvoiceAccess)
        {
            var isActive = currentController.Equals("Invoice", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" asp-controller="Invoice" asp-action="Index">
                <span class="nav-icon">@Html.Raw(invoiceIcon)</span>
                <span class="nav-text">Invoices</span>
            </a>
        }
        @if (hasCreditAccess)
        {
            var isActive = currentController.Equals("CreditNote", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" asp-controller="CreditNote" asp-action="Index">
                <span class="nav-icon">@Html.Raw(creditNoteIcon)</span>
                <span class="nav-text">Credit Notes</span>
            </a>
        }
        @if (hasQuotationAccess || hasInvoiceAccess)
        {
            var isActive = currentController.Equals("SharedLinks", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" href="/shared-links">
                <span class="nav-icon">@Html.Raw(sharedLinksIcon)</span>
                <span class="nav-text">Shared Links</span>
            </a>
        }
    </div>
}

@* ═══ FINANCE ═══ *@
@if (hasFinanceSection)
{
    <div class="nav-section">
        <div class="nav-title">Finance</div>
        @if (hasRevenueAccess)
        {
            var isActive = currentController.Equals("Revenue", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" asp-controller="Revenue" asp-action="Index">
                <span class="nav-icon">@Html.Raw(revenueIcon)</span>
                <span class="nav-text">Revenue</span>
            </a>
            var isStatementActive = currentController.Equals("Statement", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isStatementActive ? "active" : "")" asp-controller="Statement" asp-action="Index">
                <span class="nav-icon">@Html.Raw(statementIcon)</span>
                <span class="nav-text">Statement</span>
            </a>
            var isReceiptActive = currentController.Equals("Receipt", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isReceiptActive ? "active" : "")" asp-controller="Receipt" asp-action="Index">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 2v20l4-2 4 2 4-2 4 2V2l-4 2-4-2-4 2-4-2z"/><path d="M8 10h8M8 14h4"/></svg></span>
                <span class="nav-text">Receipts</span>
            </a>
            var isCardPaymentsActive = currentController.Equals("CardPayments", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isCardPaymentsActive ? "active" : "")" href="/Revenue/CardPayments">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
                <span class="nav-text">Card Payments</span>
            </a>
        }
        @if (hasVatAccess)
        {
            var isActive = currentController.Equals("Vat", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" asp-controller="Vat" asp-action="Index">
                <span class="nav-icon">@Html.Raw(vatIcon)</span>
                <span class="nav-text">VAT</span>
            </a>
        }
        @if (hasRevenueAccess)
        {
            var isZReportEnabled = (bool)(ViewData["IsZReportEnabled"] ?? false);
            if (isZReportEnabled)
            {
                var isZReportActive = currentController.Equals("ZReport", StringComparison.OrdinalIgnoreCase)
                    && !currentAction.Equals("Sources", StringComparison.OrdinalIgnoreCase);
                <a class="nav-item @(isZReportActive ? "active" : "")" asp-controller="ZReport" asp-action="Index">
                    <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 17H7A5 5 0 017 7h2"/><path d="M15 7h2a5 5 0 010 10h-2"/><path d="M8 12h8"/></svg></span>
                    <span class="nav-text">Z-Reports</span>
                </a>
                var isSourcesActive = currentController.Equals("ZReport", StringComparison.OrdinalIgnoreCase)
                    && currentAction.Equals("Sources", StringComparison.OrdinalIgnoreCase);
                <a class="nav-sub-item @(isSourcesActive ? "active" : "")" asp-controller="ZReport" asp-action="Sources">
                    <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><path d="M8 21h8M12 17v4"/></svg></span>
                    <span class="nav-text">Revenue Sources</span>
                </a>
                if (hasZReportImportAccess)
                {
                    var isImportActive = currentController.Equals("ZReportImport", StringComparison.OrdinalIgnoreCase);
                    <a class="nav-sub-item @(isImportActive ? "active" : "")" asp-controller="ZReportImport" asp-action="Index">
                        <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 16V4M8 8l4-4 4 4M4 14v4a2 2 0 002 2h12a2 2 0 002-2v-4"/></svg></span>
                        <span class="nav-text">Import Z-Reports</span>
                    </a>
                    var isSalesActive = currentController.Equals("SalesImport", StringComparison.OrdinalIgnoreCase);
                    <a class="nav-sub-item @(isSalesActive ? "active" : "")" asp-controller="SalesImport" asp-action="Records">
                        <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M12 11v6M9 14h6"/></svg></span>
                        <span class="nav-text">Sales Records</span>
                    </a>
                }
            }
        }
        @if (hasPnlAccess)
        {
            var isActive = currentController.Equals("ProfitLoss", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActive ? "active" : "")" href="/ProfitLoss">
                <span class="nav-icon">@Html.Raw(pnlIcon)</span>
                <span class="nav-text">Profit & Loss</span>
            </a>
        }
        @if (hasPaymentReminderAccess)
        {
            var isSettingsActive = currentController.Equals("PaymentReminder", StringComparison.OrdinalIgnoreCase)
                && currentAction.Equals("Settings", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isSettingsActive ? "active" : "")" asp-controller="PaymentReminder" asp-action="Settings">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span>
                <span class="nav-text">Payment Reminders</span>
            </a>
        }
        @if (hasPaymentReminderAutoAccess)
        {
            var isUpcomingActive = currentController.Equals("PaymentReminder", StringComparison.OrdinalIgnoreCase)
                && currentAction.Equals("Upcoming", StringComparison.OrdinalIgnoreCase);
            <a class="nav-sub-item @(isUpcomingActive ? "active" : "")" asp-controller="PaymentReminder" asp-action="Upcoming">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
                <span class="nav-text">Upcoming Reminders</span>
            </a>
        }
        @if (hasPaymentReminderAccess)
        {
            var isHistoryActive = currentController.Equals("PaymentReminder", StringComparison.OrdinalIgnoreCase)
                && currentAction.Equals("History", StringComparison.OrdinalIgnoreCase);
            <a class="nav-sub-item @(isHistoryActive ? "active" : "")" asp-controller="PaymentReminder" asp-action="History">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="12 8 12 12 14 14"/><circle cx="12" cy="12" r="10"/></svg></span>
                <span class="nav-text">Reminder History</span>
            </a>
        }
        @if (hasCashflowAccess)
        {
            var isCashFlowActive = currentController.Equals("CashFlow", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isCashFlowActive ? "active" : "")" asp-controller="CashFlow" asp-action="Index">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2.25 18L9 11.25l4.306 4.306a11.95 11.95 0 015.814-5.518l2.74-1.22"/><path d="M16.5 6h5.25v5.25"/></svg></span>
                <span class="nav-text">Cash Flow</span>
            </a>
        }
        @if (hasSchedulePaymentsAccess)
        {
            var isPaymentSchedulesActive = currentController.Equals("Revenue", StringComparison.OrdinalIgnoreCase)
                && currentAction.Equals("PaymentSchedules", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isPaymentSchedulesActive ? "active" : "")" asp-controller="Revenue" asp-action="PaymentSchedules">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 10h16M4 14h10M4 18h6"/><path d="M18 14l2 2 4-4"/></svg></span>
                <span class="nav-text">Payment Schedules</span>
            </a>
        }
        @if (hasAuditLogAccess)
        {
            var isActivityActive = currentController.Equals("Activity", StringComparison.OrdinalIgnoreCase);
            <a class="nav-item @(isActivityActive ? "active" : "")" asp-controller="Activity" asp-action="Index">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg></span>
                <span class="nav-text">Activity Log</span>
            </a>
        }
    </div>
}

@* ═══ PURCHASING ═══ *@
@if (hasPurchasingSection)
{
    <div class="nav-section">
        <div class="nav-title">Purchasing</div>
        @{
            var isPurchaseActive = currentController.Equals("Purchase", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-item @(isPurchaseActive ? "active" : "")" asp-controller="Purchase" asp-action="Index">
            <span class="nav-icon">@Html.Raw(purchaseIcon)</span>
            <span class="nav-text">Purchases</span>
        </a>
        @{
            var isSupplierActive = currentController.Equals("Supplier", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-sub-item @(isSupplierActive ? "active" : "")" asp-controller="Supplier" asp-action="Index">
            <span class="nav-icon">@Html.Raw(supplierIcon)</span>
            <span class="nav-text">Suppliers</span>
        </a>
        @{
