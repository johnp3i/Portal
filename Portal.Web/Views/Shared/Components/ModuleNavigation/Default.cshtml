@model Dictionary<string, string>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var moduleLinks = new Dictionary<string, (string Controller, string Action, string Label, string Icon)>
    {
        { "customer", ("Customer", "Index", "Customers", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 00-3-3.87\"/><path d=\"M16 3.13a4 4 0 010 7.75\"/></svg>") },
        { "quotation", ("Quotation", "Index", "Quotations", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M16 13H8m8 4H8m2-8H8\"/></svg>") },
        { "invoice", ("Invoice", "Index", "Invoices", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"18\" rx=\"2\"/><path d=\"M8 7h8m-8 4h8m-8 4h4\"/></svg>") },
        { "credit", ("CreditNote", "Index", "Credit Notes", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M9 15l2 2 4-4\"/></svg>") },
        { "revenue", ("Revenue", "Index", "Revenue", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 1v22m5-18H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H7\"/></svg>") },
        { "purchase", ("Purchase", "Index", "Purchases", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 01-8 0\"/></svg>") },
        { "products", ("Product", "Index", "Products", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z\"/><path d=\"M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12\"/></svg>") },
        { "vat", ("Vat", "Index", "VAT", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 12h16M4 17h10\"/><circle cx=\"19\" cy=\"17\" r=\"2\"/></svg>") }
    };

    var purchaseModuleLinks = new List<(string Controller, string Action, string Label, string Icon)>
    {
        ("Supplier", "Index", "Suppliers", "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>")
    };

    var statementIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4h16v16H4z\"/><path d=\"M4 9h16M9 4v16\"/></svg>";
    var sharedLinksIcon = "<svg width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71\"/></svg>";
}

@foreach (var module in moduleLinks)
{
    if (Model.TryGetValue(module.Key, out var accessLevel) && accessLevel != "none")
    {
        var isActive = currentController.Equals(module.Value.Controller, StringComparison.OrdinalIgnoreCase);
        <a class="nav-item @(isActive ? "active" : "")" asp-controller="@module.Value.Controller" asp-action="@module.Value.Action">
            <span class="nav-icon">@Html.Raw(module.Value.Icon)</span>
            <span class="nav-text">@module.Value.Label</span>
        </a>
    }
}

@if (Model.TryGetValue("purchase", out var purchaseAccess) && purchaseAccess != "none")
{
    foreach (var link in purchaseModuleLinks)
    {
        var isActive = currentController.Equals(link.Controller, StringComparison.OrdinalIgnoreCase);
        <a class="nav-item @(isActive ? "active" : "")" asp-controller="@link.Controller" asp-action="@link.Action">
            <span class="nav-icon">@Html.Raw(link.Icon)</span>
            <span class="nav-text">@link.Label</span>
        </a>
    }
}

@if (Model.TryGetValue("revenue", out var revenueAccess) && revenueAccess != "none")
{
    var isStatementActive = currentController.Equals("Statement", StringComparison.OrdinalIgnoreCase);
    <a class="nav-item @(isStatementActive ? "active" : "")" asp-controller="Statement" asp-action="Index">
        <span class="nav-icon">@Html.Raw(statementIcon)</span>
        <span class="nav-text">Statement</span>
    </a>
}

@{
    var hasQuotationAccess = Model.TryGetValue("quotation", out var qAccess) && qAccess != "none";
    var hasInvoiceAccess = Model.TryGetValue("invoice", out var iAccess) && iAccess != "none";
}

@if (hasQuotationAccess || hasInvoiceAccess)
{
    var isSharedLinksActive = currentController.Equals("SharedLinks", StringComparison.OrdinalIgnoreCase);
    <a class="nav-item @(isSharedLinksActive ? "active" : "")" href="/shared-links">
        <span class="nav-icon">@Html.Raw(sharedLinksIcon)</span>
        <span class="nav-text">Shared Links</span>
    </a>
}

@if (Model.TryGetValue("audit", out var auditAccess) && auditAccess != "none")
{
    <div style="margin-top:16px;padding-top:12px;border-top:1px solid rgba(13,94,166,.08);">
        <div class="nav-title" style="margin-top:0;">Administration</div>
        @{
            var isAuditActive = currentController.Equals("Audit", StringComparison.OrdinalIgnoreCase);
            var isAdminActive = currentController.Equals("Admin", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-item @(isAuditActive ? "active" : "")" asp-controller="Audit" asp-action="Index">
            <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg></span>
            <span class="nav-text">Audit Log</span>
        </a>
        @{
            var isSystemLogsActive = currentController.Equals("SystemLogs", StringComparison.OrdinalIgnoreCase);
        }
        <a class="nav-item @(isSystemLogsActive ? "active" : "")" href="/Admin/SystemLogs">
            <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/><circle cx="20" cy="18" r="2"/></svg></span>
            <span class="nav-text">System Logs</span>
        </a>
        <a class="nav-item @(isAdminActive ? "active" : "")" asp-controller="Admin" asp-action="Index">
            <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 11h-6m3-3v6"/></svg></span>
            <span class="nav-text">Users</span>
        </a>
    </div>
}
