@model Dictionary<string, string>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var moduleLinks = new Dictionary<string, (string Controller, string Action, string Label)>
    {
        { "customer", ("Customer", "Index", "Customers") },
        { "quotation", ("Quotation", "Index", "Quotations") },
        { "invoice", ("Invoice", "Index", "Invoices") },
        { "revenue", ("Revenue", "Index", "Revenue") },
        { "purchase", ("Purchase", "Index", "Purchases") },
        { "vat", ("Vat", "Index", "VAT") },
        { "audit", ("Audit", "Index", "Audit") }
    };
}

@foreach (var module in moduleLinks)
{
    if (Model.TryGetValue(module.Key, out var accessLevel) && accessLevel != "none")
    {
        var isActive = currentController.Equals(module.Value.Controller, StringComparison.OrdinalIgnoreCase);
        <a class="nav-item @(isActive ? "active" : "")" asp-controller="@module.Value.Controller" asp-action="@module.Value.Action">@module.Value.Label</a>
    }
}
