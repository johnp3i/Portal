@model Portal.Infrastructure.Models.AnnouncementDto

<section id="whats-new-banner" class="glass card-pad" style="margin-bottom:22px;border-left:4px solid var(--blue);padding:16px 18px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
        <svg width="14" height="14" fill="none" stroke="var(--blue)" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l2.09 6.26L20.5 9l-5 4.74L17 20l-5-3.5L7 20l1.5-6.26L3.5 9l6.41-.74L12 2z"/></svg>
        <span style="font-size:10px;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.06em;">What's New</span>
        <button type="button" onclick="dismissBannerAnnouncement(@Model.Id)" style="margin-left:auto;border:none;background:none;color:#8a9bab;font-size:18px;cursor:pointer;padding:0 4px;line-height:1;" title="Dismiss">&times;</button>
    </div>
    <h4 style="margin:0 0 4px;font-size:14px;font-weight:700;color:#1a2b3c;">@Model.Title</h4>
    <p style="margin:0 0 10px;font-size:12px;color:#5a6a7a;line-height:1.5;">@Model.Summary</p>
    <button type="button" onclick="toggleWhatsNewPanel()" style="border:1.5px solid var(--blue);background:none;color:var(--blue);padding:6px 12px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;">Learn More</button>
</section>

<script>
    function dismissBannerAnnouncement(id) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        fetch('/Home/AxPostDismissAnnouncement', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token ? token.value : '' },
            body: 'announcementId=' + id
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                var banner = document.getElementById('whats-new-banner');
                if (banner) banner.style.display = 'none';
                var badge = document.getElementById('whats-new-badge');
                if (badge) {
                    if (data.unreadCount > 0) {
                        badge.style.display = 'flex';
                        badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount.toString();
                    } else {
                        badge.style.display = 'none';
                    }
                }
            }
        });
    }
</script>
