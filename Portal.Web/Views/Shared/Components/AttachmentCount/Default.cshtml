@model int

<span class="attachment-count-indicator" title="@Model attachment@(Model == 1 ? "" : "s")">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" style="vertical-align: -2px;">
        <path d="M10.5 3.5L4.5 9.5a2.12 2.12 0 003 3l6-6a3.54 3.54 0 00-5-5l-6 6a4.95 4.95 0 007 7l5.5-5.5" stroke="#5a6a7a" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="attachment-count-number">@Model</span>
</span>

<style>
    .attachment-count-indicator {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 12px;
        font-weight: 600;
        color: #5a6a7a;
        background: #EEF4F8;
        border-radius: 12px;
        padding: 2px 8px 2px 6px;
        white-space: nowrap;
    }
    .attachment-count-number {
        font-size: 11px;
    }
</style>
