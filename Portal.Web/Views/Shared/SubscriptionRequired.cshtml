@{
    ViewData["Title"] = "Subscription Required";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Subscription</div>
        <h1 class="topbar-heading">Subscription Inactive</h1>
        <p class="topbar-subtitle">Your subscription is not currently active. Please update your billing to continue using the platform.</p>
    </div>
</div>

<section class="glass card-pad" style="max-width:600px;">
    <div style="text-align:center;padding:32px 16px;">
        <div style="margin-bottom:24px;">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#C24A4A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:20px;font-weight:700;color:#0B1B28;margin-bottom:12px;">
            Your Subscription Is Inactive
        </h2>
        <p style="font-size:14px;color:#5a6a7a;line-height:1.6;margin-bottom:8px;">
            Your subscription has been cancelled or is no longer active. To regain access to the platform modules, please visit the billing page to manage your subscription.
        </p>
        <p style="font-size:13px;color:#5a6a7a;line-height:1.6;margin-bottom:28px;">
            If you believe this is an error, please contact support for assistance.
        </p>
        <div style="display:flex;flex-direction:column;align-items:center;gap:12px;">
            <a href="/Checkout"
               style="display:inline-block;padding:12px 28px;background:#0D5EA6;color:#ffffff;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px;transition:background 0.2s;"
               aria-label="Subscribe now to regain access to the platform">
                Subscribe Now
            </a>
            <a href="/Account/Billing"
               style="display:inline-block;padding:10px 24px;background:transparent;color:#0D5EA6;border:2px solid #0D5EA6;border-radius:10px;text-decoration:none;font-weight:700;font-size:13px;transition:background 0.2s;"
               aria-label="Go to billing page to manage your subscription">
                Manage Subscription
            </a>
        </div>
    </div>
</section>
