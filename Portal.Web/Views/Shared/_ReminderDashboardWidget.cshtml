<div id="reminderDashboardWidget" class="glass card-pad" style="margin-top:24px;">
    <h4 style="font-family:Manrope,sans-serif;font-size:15px;font-weight:700;color:#0B1B28;margin-bottom:16px;">Payment Reminders</h4>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div>
            <div style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">Sent This Week</div>
            <div id="remindersSentCount" style="font-family:Manrope,sans-serif;font-size:26px;font-weight:800;color:#0B1B28;">—</div>
        </div>
        <div>
            <div style="font-size:11px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">Paid After Reminder</div>
            <div id="paymentsAfterReminderCount" style="font-family:Manrope,sans-serif;font-size:26px;font-weight:800;color:#129867;">—</div>
        </div>
    </div>
    <p id="reminderWidgetEmpty" style="display:none;font-size:13px;color:#5a6a7a;margin-top:12px;">No reminders sent this week. Configure your schedule in <a href="/PaymentReminder/Settings" style="color:#0D5EA6;">Settings → Payment Reminders</a>.</p>
</div>
