@{
    ViewData["Title"] = "No Business Association";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Access Error</div>
        <h1 class="topbar-heading">No Business Association</h1>
        <p class="topbar-subtitle">Your account is not currently associated with a business. Please contact your administrator for assistance.</p>
    </div>
</div>

<section class="glass card-pad" style="max-width:600px;">
    <div style="text-align:center;padding:32px 16px;">
        <div style="margin-bottom:24px;">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#C8912E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:20px;font-weight:700;color:#0B1B28;margin-bottom:12px;">
            No Business Found
        </h2>
        <p style="font-size:14px;color:#5a6a7a;line-height:1.6;margin-bottom:8px;">
            Your user account is not linked to any business on the platform. This may happen if your account setup is incomplete or your business association has been removed.
        </p>
        <p style="font-size:13px;color:#5a6a7a;line-height:1.6;margin-bottom:28px;">
            Please contact your administrator or support team to resolve this issue.
        </p>
        <a href="/"
           style="display:inline-block;padding:12px 28px;background:#0D5EA6;color:#ffffff;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px;transition:background 0.2s;"
           aria-label="Return to home page">
            Return Home
        </a>
    </div>
</section>
