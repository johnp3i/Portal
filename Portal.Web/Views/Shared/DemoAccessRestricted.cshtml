@{
    ViewData["Title"] = "Access Restricted";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Demo Session</div>
        <h1 class="topbar-heading">Access Restricted</h1>
        <p class="topbar-subtitle">Your demo session does not include access to this module.</p>
    </div>
</div>

<section class="glass card-pad" style="max-width:600px;">
    <div style="text-align:center;padding:32px 16px;">
        <div style="margin-bottom:24px;">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#C8912E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                <line x1="12" y1="15" x2="12" y2="19"></line>
            </svg>
        </div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:20px;font-weight:700;color:#0B1B28;margin-bottom:12px;">
            Access Restricted
        </h2>
        <p style="font-size:14px;color:#5a6a7a;line-height:1.6;margin-bottom:28px;">
            Your demo session does not include access to this module. Please return to the dashboard to explore the modules available to you.
        </p>
        <a href="/"
           style="display:inline-block;padding:12px 28px;background:#0D5EA6;color:#ffffff;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px;transition:background 0.2s;"
           aria-label="Return to the dashboard">
            Back to Dashboard
        </a>
    </div>
</section>
