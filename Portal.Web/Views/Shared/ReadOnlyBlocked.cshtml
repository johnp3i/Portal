@model Portal.Web.Models.SoftGateViewModel
@{
    ViewData["Title"] = "Read-Only Access";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot" style="background:#57B8E8;"></span> Access Level</div>
        <h1 class="topbar-heading">Read-Only Access</h1>
        <p class="topbar-subtitle">You have view-only access to @Model.ModuleDisplayName. Write operations are not permitted.</p>
    </div>
</div>

<section class="glass card-pad" style="max-width:600px;">
    <div style="text-align:center;padding:32px 16px;">
        <div style="margin-bottom:24px;">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#57B8E8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
        </div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:20px;font-weight:700;color:#0B1B28;margin-bottom:12px;">
            Read-Only Access
        </h2>
        <p style="font-size:14px;color:#5a6a7a;line-height:1.6;margin-bottom:8px;">
            You have view-only access to <strong style="color:#0B1B28;">@Model.ModuleDisplayName</strong>. Write operations are not permitted.
        </p>
        <p style="font-size:13px;color:#5a6a7a;line-height:1.6;margin-bottom:28px;">
            Contact your business owner to request full access.
        </p>
        <button type="button"
                onclick="history.back()"
                class="btn btn-secondary"
                style="padding:12px 28px;font-weight:700;font-size:14px;"
                aria-label="Go back to the previous page">
            Go Back
        </button>
    </div>
</section>
