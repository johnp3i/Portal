@{
    ViewData["Title"] = "Error";
}

<div class="topbar">
    <div class="topbar-left">
        <div class="eyebrow-label">Account</div>
        <h1 class="topbar-heading">Something Went Wrong</h1>
        <p class="topbar-description">We encountered an issue loading this page. Please try again later.</p>
    </div>
</div>

<section class="glass card-pad">
    <div style="text-align:center;padding:40px 20px;">
        <svg width="48" height="48" fill="none" stroke="#C24A4A" stroke-width="1.5" viewBox="0 0 24 24" style="margin-bottom:16px;">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4m0 4h.01"/>
        </svg>
        <h2 style="font-family:'Manrope',sans-serif;font-size:20px;font-weight:700;color:#0B1B28;margin-bottom:8px;">Unable to Load Page</h2>
        <p style="font-size:14px;color:#5E7385;max-width:400px;margin:0 auto 24px;">
            An unexpected error occurred while processing your request. Our team has been notified.
        </p>
        <a href="/" style="display:inline-block;padding:10px 24px;background:#0D5EA6;color:#fff;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;">
            Return to Dashboard
        </a>
    </div>
</section>
