@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">
                <img src="/images/logo_blue_web_toolbar_oi.png" alt="3 Inventors" style="width:180px;height:auto;" />
            </div>
            <div class="nav-title">Workspace</div>
            <a class="nav-item @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="nav-item @(currentController == "MyBusiness" ? "active" : "")" asp-controller="MyBusiness" asp-action="Index">My Business</a>
            @await Component.InvokeAsync("ModuleNavigation")
            <a class="nav-item @(currentController == "Invitation" ? "active" : "")" asp-controller="Invitation" asp-action="Create">Invite User</a>
        </aside>
        <main class="content">
            @RenderBody()
        </main>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
