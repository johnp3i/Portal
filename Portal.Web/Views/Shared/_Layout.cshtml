@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="msapplication-TileImage" content="/images/favicon/ms-icon-144x144.png" />
    <meta name="msapplication-TileColor" content="#0D5EA6" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/product-autocomplete.css" />
    <link rel="stylesheet" href="/css/mobile.css?v=8" />
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
    <style>.swal2-container{z-index:99999 !important}</style>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script src="/js/block-ui.js"></script>
</head>
<body>
    @if (User.HasClaim("IsImpersonating", "true"))
    {
        <div style="position:fixed;top:0;left:0;right:0;z-index:99999;background:linear-gradient(90deg,#C8912E,#e5a733);color:#fff;padding:10px 24px;display:flex;align-items:center;justify-content:center;gap:12px;font-size:13px;font-weight:600;font-family:'Inter',sans-serif;box-shadow:0 2px 8px rgba(0,0,0,.15);" id="impersonationBanner">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/></svg>
            <span>You are viewing as <strong>@User.Identity?.Name</strong> &mdash;</span>
            <form method="post" action="/Admin/Users/EndImpersonation" style="display:inline;margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" style="background:#fff;color:#C8912E;border:none;border-radius:8px;padding:5px 14px;font-size:12px;font-weight:700;cursor:pointer;">Return to your account</button>
            </form>
        </div>
        <div style="height:42px;"></div>
    }
    <div class="app" id="appShell">
        <script>if(localStorage.getItem('sidebar-collapsed')==='true')document.getElementById('appShell').classList.add('sidebar-collapsed');</script>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <header class="mobile-topbar">
                <button class="mobile-topbar__hamburger" aria-label="Open navigation">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
                </button>
                <a class="mobile-topbar__logo" href="/">
                    <img src="/images/logo_blue_web_toolbar_oi.png" alt="3 Inventors" style="height:28px;width:auto;" />
                </a>
                <button class="mobile-topbar__avatar" aria-label="Account menu">
                    @{
                        var userName = User.Identity?.Name ?? "";
                        var initials = userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "?";
                    }
                    <span>@initials</span>
                </button>
            </header>
            <div class="mobile-account-dropdown" id="mobileAccountDropdown" style="display:none;">
                <div style="padding:14px 18px;border-bottom:1px solid rgba(13,94,166,.06);">
                    <div style="font-size:12px;color:#5E7385;font-weight:600;">Signed in as</div>
                    <div style="font-size:13px;font-weight:700;color:#0B1B28;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@User.Identity?.Name</div>
                </div>
                @if (User.HasClaim("IsOwner", "true"))
                {
                    <a href="/Account/Billing" style="display:block;padding:12px 18px;font-size:13px;font-weight:600;color:#334155;text-decoration:none;border-bottom:1px solid rgba(13,94,166,.06);">Billing</a>
                }
                <form method="post" asp-controller="Account" asp-action="Logout" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="width:100%;text-align:left;padding:12px 18px;background:none;border:none;font-size:13px;font-weight:600;color:#C24A4A;cursor:pointer;font-family:inherit;">Sign Out</button>
                </form>
            </div>
        }
        <aside class="sidebar">
            <div class="brand">
                <img src="/images/logo_blue_web_toolbar_oi.png" alt="3 Inventors" style="width:180px;height:auto;" />
            </div>
            <button class="sidebar-toggle" onclick="toggleSidebar()" title="Toggle sidebar">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            @await Component.InvokeAsync("BusinessIdentityCard")
            <div class="nav-title">Workspace</div>
            <a class="nav-item @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12l9-9 9 9"/><path d="M5 10v10a1 1 0 001 1h3m10-11v10a1 1 0 01-1 1h-3m-6 0h6"/></svg></span>
                <span class="nav-text">Dashboard</span>
            </a>
            <a class="nav-item @(currentController == "MyBusiness" ? "active" : "")" asp-controller="MyBusiness" asp-action="Index">
                <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg></span>
                <span class="nav-text">My Business</span>
            </a>
            @await Component.InvokeAsync("ModuleNavigation")
            @if (User.IsInRole("SuperAdmin") || User.HasClaim("IsOwner", "true"))
            {
                <div style="margin-top:16px;padding-top:12px;border-top:1px solid rgba(13,94,166,.08);">
                    <div class="nav-title" style="margin-top:0;">Account</div>
                    <a class="nav-item @(currentController == "Invitation" ? "active" : "")" asp-controller="Invitation" asp-action="Create">
                        <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6m3-3h-6"/></svg></span>
                        <span class="nav-text">Invite User</span>
                    </a>
                    @if (User.HasClaim("IsOwner", "true"))
                    {
                        <a class="nav-item @(currentController == "Billing" ? "active" : "")" href="/Account/Billing">
                            <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
                            <span class="nav-text">Billing</span>
                        </a>
                        <a class="nav-item @(currentController == "MyBusiness" && ViewData["Title"]?.ToString() == "User Permissions" ? "active" : "")" href="/MyBusiness/UserPermissions">
                            <span class="nav-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>
                            <span class="nav-text">User Permissions</span>
                        </a>
                    }
                </div>
            }

            <a class="nav-item" href="/Help" style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(13,94,166,.08);background:rgba(87,184,232,.06);border-radius:12px;color:#0D5EA6;">
                <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0D5EA6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.5 9a3 3 0 015 1.5c0 2-3 2.5-3 4.5"/><circle cx="12" cy="18" r="0.5" fill="#0D5EA6" stroke="none"/></svg></span>
                <span class="nav-text" style="color:#0D5EA6;font-weight:700;">Help & Guide</span>
            </a>
            @await Component.InvokeAsync("SubscriptionStatusIndicator")
        </aside>
        <script>try{var _sb=document.querySelector('.sidebar'),_sp=sessionStorage.getItem('sidebar-scroll-pos');if(_sb&&_sp!==null)_sb.scrollTop=parseInt(_sp,10);}catch(e){}</script>
        <div class="mobile-backdrop" aria-hidden="true"></div>
        <main class="content" style="position:relative;">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Global Search Bar -->
                <div class="topbar-search-area" style="position:absolute;top:25px;right:200px;z-index:100;display:flex;align-items:center;gap:12px;">
                    @await Component.InvokeAsync("WhatsNew")
                    <div id="globalSearchContainer" style="width:350px;">
                    <div style="display:flex;align-items:center;gap:8px;">
                        <div style="position:relative;flex:1;">
                            <svg style="position:absolute;left:11px;top:50%;transform:translateY(-50%);pointer-events:none;" width="15" height="15" fill="none" stroke="#8899A6" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                            <input type="text" id="globalSearchInput" placeholder="Search..." autocomplete="off"
                                   style="width:100%;padding:9px 14px 9px 34px;border:1px solid rgba(13,94,166,.12);border-radius:10px;font-size:13px;font-family:'Inter',sans-serif;background:#fff;outline:none;transition:border-color .2s,box-shadow .2s;"
                                   onfocus="this.style.borderColor='#57B8E8';this.style.boxShadow='0 0 0 3px rgba(87,184,232,.12)'"
                                   onblur="this.style.borderColor='rgba(13,94,166,.12)';this.style.boxShadow='none'" />
                            <kbd id="globalSearchKbd" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:10px;color:#8899A6;background:rgba(13,94,166,.04);border:1px solid rgba(13,94,166,.10);border-radius:4px;padding:2px 5px;pointer-events:none;font-family:'Inter',sans-serif;">Ctrl+K</kbd>
                        </div>
                        <button type="button" onclick="showSearchHelp()" style="flex-shrink:0;width:28px;height:28px;border-radius:50%;border:1px solid rgba(13,94,166,.12);background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;" title="Search help" onmouseover="this.style.background='rgba(13,94,166,.06)'" onmouseout="this.style.background='#fff'">
                            <svg width="14" height="14" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                        </button>
                    </div>
                    <div id="globalSearchDropdown" style="display:none;position:absolute;top:100%;left:0;right:0;margin-top:6px;background:#fff;border:1px solid rgba(13,94,166,.10);border-radius:14px;box-shadow:0 12px 32px rgba(13,94,166,.12);max-height:420px;overflow-y:auto;z-index:1001;"></div>
                </div>
                </div>

                <div style="position:absolute;top:25px;right:24px;z-index:100;display:flex;align-items:center;gap:14px;" id="accountMenu">
                    <button type="button" onclick="var d=document.getElementById('accountDropdown');d.style.display=d.style.display==='none'?'block':'none';" style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;background:rgba(13,94,166,.04);border:1px solid rgba(13,94,166,.10);border-radius:20px;cursor:pointer;font-size:13px;font-weight:600;color:#334155;font-family:inherit;">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
                        My Account
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div id="accountDropdown" style="display:none;position:absolute;right:0;top:100%;margin-top:6px;background:#fff;border:1px solid rgba(13,94,166,.10);border-radius:12px;box-shadow:0 8px 24px rgba(13,94,166,.12);min-width:200px;z-index:1000;overflow:hidden;">
                        <div style="padding:14px 18px;border-bottom:1px solid rgba(13,94,166,.06);">
                            <div style="font-size:12px;color:#5E7385;font-weight:600;">Signed in as</div>
                            <div style="font-size:13px;font-weight:700;color:#0B1B28;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@User.Identity?.Name</div>
                        </div>
                        @if (User.HasClaim("IsOwner", "true"))
                        {
                            <a href="/Account/Billing" style="display:block;padding:12px 18px;font-size:13px;font-weight:600;color:#334155;text-decoration:none;border-bottom:1px solid rgba(13,94,166,.06);">Billing</a>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <a href="/AdminWhatsNew" style="display:block;padding:12px 18px;font-size:13px;font-weight:600;color:#334155;text-decoration:none;border-bottom:1px solid rgba(13,94,166,.06);">What's New (Admin)</a>
                        }
                        <form method="post" asp-controller="Account" asp-action="Logout" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" style="width:100%;text-align:left;padding:12px 18px;background:none;border:none;font-size:13px;font-weight:600;color:#C24A4A;cursor:pointer;font-family:inherit;">Sign Out</button>
                        </form>
                    </div>
                </div>
                <script>
                    document.addEventListener('click', function(e) {
                        var menu = document.getElementById('accountMenu');
                        var dropdown = document.getElementById('accountDropdown');
                        if (menu && dropdown && !menu.contains(e.target)) {
                            dropdown.style.display = 'none';
                        }
                    });
                </script>
            }
            @if (Context.Items.ContainsKey("DemoReadOnly") && (bool)Context.Items["DemoReadOnly"]!)
            {
                <div style="background:#FFF3CD;border:1px solid #FFEAA7;border-radius:10px;padding:10px 20px;margin-bottom:16px;display:flex;align-items:center;gap:10px;width:40%;">
                    <svg width="18" height="18" fill="none" stroke="#C8912E" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <span style="font-size:13px;font-weight:600;color:#856404;">Read-only access — You can view this module but cannot make changes.</span>
                </div>
            }
            @RenderBody()

        <!-- Mobile floating search + What's New buttons (visible only on phone via CSS) -->
        <div class="mobile-topbar-actions" style="display:none;">
            <button type="button" class="mobile-whats-new-btn" onclick="toggleWhatsNewPanel()" aria-label="What's New">
                <svg width="16" height="16" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l2.09 6.26L20.5 9l-5 4.74L17 20l-5-3.5L7 20l1.5-6.26L3.5 9l6.41-.74L12 2z"/></svg>
                <span class="mobile-wn-badge" id="mobileWnBadge" style="display:none;"></span>
            </button>
            <button type="button" class="mobile-search-btn" onclick="openMobileSearch()" aria-label="Search">
                <svg width="16" height="16" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            </button>
        </div>
        <div id="mobileSearchOverlay" class="mobile-search-overlay" style="display:none;" onclick="closeMobileSearch()"></div>
        <div id="mobileSearchExpanded" class="mobile-search-expanded" style="display:none !important;">
            <svg width="16" height="16" fill="none" stroke="#8899A6" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="mobileSearchInput" placeholder="Search..." autocomplete="off" />
            <button type="button" class="mobile-search-close" onclick="closeMobileSearch()">&times;</button>
        </div>
        <script>
            // Sync What's New badge count to mobile button
            (function() {
                var desktopBadge = document.getElementById('whats-new-badge');
                var mobileBadge = document.getElementById('mobileWnBadge');
                if (desktopBadge && mobileBadge && desktopBadge.textContent.trim()) {
                    mobileBadge.textContent = desktopBadge.textContent.trim();
                    mobileBadge.style.display = 'flex';
                }
            })();

            function openMobileSearch() {
                document.getElementById('mobileSearchOverlay').style.display = 'block';
                var expanded = document.getElementById('mobileSearchExpanded');
                expanded.style.display = 'flex !important';
                expanded.style.cssText = expanded.style.cssText.replace('display:none !important', 'display:flex !important');
                expanded.style.setProperty('display', 'flex', 'important');
                setTimeout(function() { document.getElementById('mobileSearchInput').focus(); }, 100);
            }

            function closeMobileSearch() {
                document.getElementById('mobileSearchOverlay').style.display = 'none';
                var expanded = document.getElementById('mobileSearchExpanded');
                expanded.style.setProperty('display', 'none', 'important');
                document.getElementById('mobileSearchInput').value = '';
            }

            // Mirror mobile search input to global search
            document.getElementById('mobileSearchInput')?.addEventListener('input', function() {
                var globalInput = document.getElementById('globalSearchInput');
                if (globalInput) {
                    globalInput.value = this.value;
                    globalInput.dispatchEvent(new Event('input', { bubbles: true }));
                }
            });
            document.getElementById('mobileSearchInput')?.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeMobileSearch();
                if (e.key === 'Enter') {
                    var globalInput = document.getElementById('globalSearchInput');
                    if (globalInput) {
                        globalInput.value = this.value;
                        globalInput.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', bubbles: true }));
                    }
                }
            });
        </script>
        </main>
        <nav class="bottom-tab-bar" aria-label="Quick navigation">
            <a href="/" class="bottom-tab-bar__item @(currentController == "Home" ? "active" : "")">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12l9-9 9 9"/><path d="M5 10v10a1 1 0 001 1h3m10-11v10a1 1 0 01-1 1h-3m-6 0h6"/></svg>
                <span>Dashboard</span>
            </a>
            <a href="/Quotation" class="bottom-tab-bar__item @(currentController == "Quotation" ? "active" : "")">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8m8 4H8m2-8H8"/></svg>
                <span>Quotes</span>
            </a>
            <a href="/Invoice" class="bottom-tab-bar__item @(currentController == "Invoice" ? "active" : "")">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                <span>Invoices</span>
            </a>
            <a href="/Revenue" class="bottom-tab-bar__item @(currentController == "Revenue" ? "active" : "")">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20m5-17H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H7"/></svg>
                <span>Revenue</span>
            </a>
        </nav>
    </div>
    <script src="/js/product-autocomplete.js"></script>
    <script>
        function toggleSidebar() {
            var app = document.getElementById('appShell');
            app.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebar-collapsed', app.classList.contains('sidebar-collapsed'));
        }
    </script>
    <script>
    (function(){
        var sb=document.querySelector('.sidebar');
        if(!sb)return;
        sb.addEventListener('click',function(e){
            var a=e.target.closest('a[href]');
            if(a){try{sessionStorage.setItem('sidebar-scroll-pos',sb.scrollTop);}catch(e){}}
        });
    })();
    </script>
    <script>
    // ─── Global Search Help ─────────────────────────────────────────────
    window.showSearchHelp = function() {
        Swal.fire({
            title: 'Global Search',
            html: '<div style="text-align:left;font-size:14px;line-height:1.8;">' +
                '<p><strong>How to search:</strong></p>' +
                '<p>Type at least 2 characters in the search bar. Results appear instantly, grouped by type.</p>' +
                '<p style="margin-top:12px;"><strong>What you can search:</strong></p>' +
                '<table style="width:100%;font-size:13px;border-collapse:collapse;margin-top:8px;">' +
                '<tr style="border-bottom:1px solid #eef3f8;"><td style="padding:6px 0;font-weight:600;">Invoices</td><td style="padding:6px 0;color:#5E7385;">Invoice number, customer name</td></tr>' +
                '<tr style="border-bottom:1px solid #eef3f8;"><td style="padding:6px 0;font-weight:600;">Customers</td><td style="padding:6px 0;color:#5E7385;">Name, email</td></tr>' +
                '<tr style="border-bottom:1px solid #eef3f8;"><td style="padding:6px 0;font-weight:600;">Quotations</td><td style="padding:6px 0;color:#5E7385;">Quotation number, customer name</td></tr>' +
                '<tr style="border-bottom:1px solid #eef3f8;"><td style="padding:6px 0;font-weight:600;">Purchases</td><td style="padding:6px 0;color:#5E7385;">Invoice number, description, supplier</td></tr>' +
                '<tr style="border-bottom:1px solid #eef3f8;"><td style="padding:6px 0;font-weight:600;">Suppliers</td><td style="padding:6px 0;color:#5E7385;">Supplier name</td></tr>' +
                '<tr><td style="padding:6px 0;font-weight:600;">Products</td><td style="padding:6px 0;color:#5E7385;">Product name, SKU</td></tr>' +
                '</table>' +
                '<p style="margin-top:16px;"><strong>Keyboard shortcuts:</strong></p>' +
                '<ul style="margin-top:6px;padding-left:18px;color:#5E7385;">' +
                '<li><kbd style="background:#EEF4F8;border:1px solid #dce6ef;border-radius:4px;padding:1px 5px;font-size:12px;">Ctrl+K</kbd> — Focus the search bar</li>' +
                '<li><kbd style="background:#EEF4F8;border:1px solid #dce6ef;border-radius:4px;padding:1px 5px;font-size:12px;">\u2191 \u2193</kbd> — Navigate results</li>' +
                '<li><kbd style="background:#EEF4F8;border:1px solid #dce6ef;border-radius:4px;padding:1px 5px;font-size:12px;">Enter</kbd> — Open selected result</li>' +
                '<li><kbd style="background:#EEF4F8;border:1px solid #dce6ef;border-radius:4px;padding:1px 5px;font-size:12px;">Esc</kbd> — Close search</li>' +
                '</ul>' +
                '</div>',
            icon: 'info',
            confirmButtonText: 'Got it',
            confirmButtonColor: '#0D5EA6',
            width: 480
        });
    };
    </script>
    <script>
    // ─── Global Search ───────────────────────────────────────────────────
    (function(){
        var input = document.getElementById('globalSearchInput');
        var dropdown = document.getElementById('globalSearchDropdown');
        var container = document.getElementById('globalSearchContainer');
        var kbd = document.getElementById('globalSearchKbd');
        if (!input || !dropdown || !container) return;

        var debounceTimer = null;
        var highlightIndex = -1;
        var currentItems = [];

        // Ctrl+K shortcut
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                input.focus();
                input.select();
            }
        });

        input.addEventListener('focus', function() {
            if (kbd) kbd.style.display = 'none';
            if (input.value.trim().length >= 2) {
                executeSearch(input.value.trim());
            } else {
                dropdown.style.display = 'block';
                dropdown.innerHTML = '<div style="padding:24px;text-align:center;color:#8899A6;font-size:13px;">Type at least 2 characters to search</div>';
            }
        });

        input.addEventListener('blur', function() {
            if (kbd) kbd.style.display = '';
        });

        input.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            var q = input.value.trim();
            if (q.length < 2) {
                dropdown.style.display = 'block';
                dropdown.innerHTML = '<div style="padding:24px;text-align:center;color:#8899A6;font-size:13px;">Type at least 2 characters to search</div>';
                return;
            }
            dropdown.innerHTML = '<div style="padding:18px;text-align:center;color:#8899A6;font-size:13px;">Searching...</div>';
            dropdown.style.display = 'block';
            debounceTimer = setTimeout(function() { executeSearch(q); }, 300);
        });

        input.addEventListener('keydown', function(e) {
            if (dropdown.style.display === 'none') return;
            if (e.key === 'ArrowDown') { e.preventDefault(); moveHighlight(1); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); moveHighlight(-1); }
            else if (e.key === 'Enter' && highlightIndex >= 0) { e.preventDefault(); navigateToHighlighted(); }
            else if (e.key === 'Escape') { closeDropdown(); }
        });

        document.addEventListener('click', function(e) {
            if (!container.contains(e.target)) closeDropdown();
        });

        async function executeSearch(query) {
            try {
                var response = await fetch('/Search/AxGetGlobalSearch?query=' + encodeURIComponent(query));
                var result = await response.json();
                if (!result.success) { showError(); return; }
                renderResults(result.data.groups || []);
            } catch (e) { showError(); }
        }

        function renderResults(groups) {
            highlightIndex = -1;
            currentItems = [];
            if (groups.length === 0) {
                dropdown.innerHTML = '<div style="padding:24px;text-align:center;color:#8899A6;font-size:13px;"><svg width="32" height="32" fill="none" stroke="#c0cdd8" stroke-width="1.5" viewBox="0 0 24 24" style="display:block;margin:0 auto 8px;"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>No results found</div>';
                dropdown.style.display = 'block';
                return;
            }
            var html = '';
            groups.forEach(function(group) {
                html += '<div style="padding:10px 16px 4px;font-size:11px;font-weight:700;color:#5E7385;text-transform:uppercase;letter-spacing:.05em;">' + escapeHtml(group.label) + '</div>';
                group.items.forEach(function(item) {
                    var idx = currentItems.length;
                    currentItems.push(item);
                    html += '<a href="' + escapeHtml(item.url) + '" class="gs-item" data-idx="' + idx + '" style="display:flex;align-items:center;gap:10px;padding:8px 16px;text-decoration:none;border-radius:8px;margin:2px 6px;transition:background .1s;" onmouseenter="highlightAt(' + idx + ')">';
                    html += '<div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:600;color:#0B1B28;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escapeHtml(item.primary) + '</div>';
                    if (item.secondary) html += '<div style="font-size:12px;color:#5E7385;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escapeHtml(item.secondary) + '</div>';
                    html += '</div>';
                    html += '<svg width="14" height="14" fill="none" stroke="#c0cdd8" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;"><polyline points="9 18 15 12 9 6"/></svg>';
                    html += '</a>';
                });
            });
            dropdown.innerHTML = html;
            dropdown.style.display = 'block';
        }

        function moveHighlight(dir) {
            if (currentItems.length === 0) return;
            highlightIndex += dir;
            if (highlightIndex < 0) highlightIndex = currentItems.length - 1;
            if (highlightIndex >= currentItems.length) highlightIndex = 0;
            updateHighlight();
        }

        window.highlightAt = function(idx) { highlightIndex = idx; updateHighlight(); };

        function updateHighlight() {
            dropdown.querySelectorAll('.gs-item').forEach(function(el, i) {
                el.style.background = i === highlightIndex ? 'rgba(13,94,166,.05)' : '';
            });
            if (highlightIndex >= 0) {
                var items = dropdown.querySelectorAll('.gs-item');
                if (items[highlightIndex]) items[highlightIndex].scrollIntoView({ block: 'nearest' });
            }
        }

        function navigateToHighlighted() {
            if (highlightIndex >= 0 && currentItems[highlightIndex]) {
                window.location.href = currentItems[highlightIndex].url;
            }
        }

        function showError() {
            dropdown.innerHTML = '<div style="padding:18px;text-align:center;color:#C24A4A;font-size:13px;">Search unavailable. Please try again.</div>';
            dropdown.style.display = 'block';
        }

        function closeDropdown() {
            dropdown.style.display = 'none';
            highlightIndex = -1;
        }

        function escapeHtml(str) {
            if (!str) return '';
            var d = document.createElement('div');
            d.appendChild(document.createTextNode(str));
            return d.innerHTML;
        }
    })();
    </script>
    @RenderSection("Scripts", required: false)
    @await Html.PartialAsync("_GraceAccessModal")
