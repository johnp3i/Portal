@{
    ViewData["Title"] = "Upgrade Required";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var requestedModule = ViewData["RequestedModule"]?.ToString() ?? "this feature";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Subscription</div>
        <h1 class="topbar-heading">Upgrade Required</h1>
        <p class="topbar-subtitle">The module you're trying to access is not included in your current plan.</p>
    </div>
</div>

<section class="glass card-pad" style="max-width:600px;">
    <div style="text-align:center;padding:32px 16px;">
        <div style="margin-bottom:24px;">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#C8912E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
            </svg>
        </div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:20px;font-weight:700;color:#0B1B28;margin-bottom:12px;">
            Module Not Available on Your Plan
        </h2>
        <p style="font-size:14px;color:#5a6a7a;line-height:1.6;margin-bottom:8px;">
            The <strong style="color:#0B1B28;">@requestedModule</strong> module is not included in your current subscription plan.
        </p>
        <p style="font-size:13px;color:#5a6a7a;line-height:1.6;margin-bottom:28px;">
            To access this module, please upgrade your plan. Visit the billing page to view available plans and their included modules.
        </p>
        <a href="/Account/Billing"
           style="display:inline-block;padding:12px 28px;background:#0D5EA6;color:#ffffff;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px;transition:background 0.2s;"
           aria-label="Go to billing page to upgrade your plan">
            View Plans & Upgrade
        </a>
    </div>
</section>
