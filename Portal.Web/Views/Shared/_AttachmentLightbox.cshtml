@*
    Image lightbox overlay for attachment image previews.
    Supports pinch-to-zoom on touch devices.
    Include once on any page that uses _AttachmentPanel.
*@

<div id="attachment-lightbox" class="attachment-lightbox" style="display:none;" onclick="closeLightboxOnBackdrop(event)">
    <div class="lightbox-toolbar">
        <a id="lightbox-download-btn" href="#" download class="lightbox-btn" title="Download">
            <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                <path d="M8 1v10M4 8l4 4 4-4M2 14h12" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>
        <button type="button" class="lightbox-btn" onclick="closeLightbox()" title="Close">
            <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                <path d="M4 4l8 8M12 4l-8 8" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
    <div class="lightbox-image-container">
        <img id="lightbox-image" src="" alt="" />
    </div>
    <div class="lightbox-filename" id="lightbox-filename"></div>
</div>

<style>
    .attachment-lightbox {
        position: fixed;
        inset: 0;
        z-index: 100000;
        background: rgba(0, 0, 0, .88);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        animation: lightbox-fadein .2s ease;
    }
    @@keyframes lightbox-fadein {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .lightbox-toolbar {
        position: absolute;
        top: 16px;
        right: 16px;
        display: flex;
        gap: 8px;
        z-index: 2;
    }
    .lightbox-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: none;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
        transition: background .15s;
    }
    .lightbox-btn:hover {
        background: rgba(255,255,255,.3);
    }
    .lightbox-image-container {
        max-width: 90vw;
        max-height: 80vh;
        overflow: auto;
        touch-action: pinch-zoom;
    }
    .lightbox-image-container img {
        max-width: 90vw;
        max-height: 80vh;
        object-fit: contain;
        border-radius: 8px;
        user-select: none;
        -webkit-user-select: none;
    }
    .lightbox-filename {
        position: absolute;
        bottom: 20px;
        color: rgba(255,255,255,.7);
        font-size: 13px;
        font-weight: 500;
        text-align: center;
        max-width: 80vw;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

<script>
    function openLightbox(src, filename) {
        var lightbox = document.getElementById('attachment-lightbox');
        var img = document.getElementById('lightbox-image');
        var nameEl = document.getElementById('lightbox-filename');
        var downloadBtn = document.getElementById('lightbox-download-btn');

        img.src = src;
        img.alt = filename || '';
        nameEl.textContent = filename || '';
        downloadBtn.href = src;
        lightbox.style.display = 'flex';

        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        var lightbox = document.getElementById('attachment-lightbox');
        lightbox.style.display = 'none';
        document.getElementById('lightbox-image').src = '';
        document.body.style.overflow = '';
    }

    function closeLightboxOnBackdrop(event) {
        if (event.target === document.getElementById('attachment-lightbox') ||
            event.target.classList.contains('lightbox-image-container')) {
            closeLightbox();
        }
    }

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            var lightbox = document.getElementById('attachment-lightbox');
            if (lightbox && lightbox.style.display !== 'none') {
                closeLightbox();
            }
        }
    });
</script>
