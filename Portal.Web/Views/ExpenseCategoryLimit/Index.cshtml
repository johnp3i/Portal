@model List<Portal.Infrastructure.Models.ExpenseCategoryLimitViewModel>
@{
    ViewData["Title"] = "Expense Category Limits";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Expense Category Limits</div>
        <h1 class="topbar-heading">Spending Limits</h1>
        <p class="topbar-subtitle">Configure advisory spending thresholds per expense category. Limits are soft warnings only — they never block purchases.</p>
    </div>
    <div>
        <button type="button" class="btn btn-secondary" onclick="openCreateCategoryModal()">Create Category</button>
    </div>
</div>

<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field" style="min-width:260px;flex:1;">
            <label for="searchInput">Search Categories</label>
            <input type="text" id="searchInput" placeholder="Type to filter by category name..." oninput="filterCategories()" style="width:100%;" />
        </div>
    </div>
</section>

<section class="glass card-pad">
    @if (Model != null && Model.Count > 0)
    {
        <table id="limitsTable">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Annual Limit (EUR)</th>
                    <th>Period Limit (EUR)</th>
                    <th>Progress</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-category-id="@item.ExpenseCategoryId">
                        <td><strong>@item.CategoryName</strong></td>
                        <td>
                            <input type="number"
                                   class="limit-input"
                                   id="annual-@item.ExpenseCategoryId"
                                   value="@(item.AnnualLimitEur?.ToString("0.00") ?? "")"
                                   placeholder="No limit"
                                   step="0.01"
                                   min="0.01"
                                   style="width:140px;padding:8px 12px;border:1px solid rgba(13,94,166,.15);border-radius:10px;font-size:14px;font-family:'Inter',sans-serif;" />
                        </td>
                        <td>
                            <input type="number"
                                   class="limit-input"
                                   id="period-@item.ExpenseCategoryId"
                                   value="@(item.PeriodLimitEur?.ToString("0.00") ?? "")"
                                   placeholder="No limit"
                                   step="0.01"
                                   min="0.01"
                                   style="width:140px;padding:8px 12px;border:1px solid rgba(13,94,166,.15);border-radius:10px;font-size:14px;font-family:'Inter',sans-serif;" />
                        </td>
                        <td style="min-width:240px;">
                            <div id="progress-@item.ExpenseCategoryId">
                                @if (item.AnnualLimitEur.HasValue || item.PeriodLimitEur.HasValue)
                                {
                                    <button type="button" class="progress-toggle" onclick="toggleProgress(this, @item.ExpenseCategoryId)">
                                        <span class="chevron">&#9660;</span> <span class="toggle-text">View Progress</span>
                                    </button>
                                    <div class="progress-body" id="progress-body-@item.ExpenseCategoryId"></div>
                                }
                                else
                                {
                                    <span style="font-size:12px;color:#94a3b8;font-style:italic;">No limits configured</span>
                                }
                            </div>
                        </td>
                        <td style="white-space:nowrap;">
                            <button type="button" class="tbl-action tbl-action--primary" onclick="saveLimit(@item.ExpenseCategoryId)">Save</button>
                            <button type="button" class="tbl-action tbl-action--danger" onclick="clearLimit(@item.ExpenseCategoryId, 'annual')">Clear Annual</button>
                            <button type="button" class="tbl-action tbl-action--danger" onclick="clearLimit(@item.ExpenseCategoryId, 'period')">Clear Period</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <p>No active expense categories found. Create expense categories first to configure spending limits.</p>
        </div>
    }
</section>

<form id="antiforgery-form" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Create Category Modal -->
<div id="createCategoryModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.4);backdrop-filter:blur(2px);align-items:flex-start;justify-content:center;overflow-y:auto;padding:24px 0;">
    <div style="background:#fff;border-radius:24px;padding:32px;width:100%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,.15);margin:auto;flex-shrink:0;">
        <h2 style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:700;color:#0B1B28;margin:0 0 24px 0;">Create Category</h2>
        <div class="field" style="margin-bottom:24px;">
            <label for="newCategoryName" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Name</label>
            <input type="text" id="newCategoryName" placeholder="Enter category name" style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;" />
        </div>
        <div class="field" style="margin-bottom:24px;">
            <label for="newExpenseTypeId" style="font-size:13px;font-weight:600;color:#5E7385;margin-bottom:6px;display:block;">Expense Type</label>
            <select id="newExpenseTypeId" style="width:100%;padding:12px 16px;border:1px solid rgba(13,94,166,.15);border-radius:12px;font-size:14px;font-family:'Inter',sans-serif;outline:none;background:#fff;appearance:auto;">
                <option value="">-- Select Expense Type --</option>
                <option value="1">Services</option>
                <option value="2">Goods</option>
            </select>
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button type="button" class="btn btn-secondary" onclick="closeCreateCategoryModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="saveNewCategory()">Create</button>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .progress-toggle {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            background: none;
            border: none;
            font-size: 12px;
            font-weight: 600;
            color: #0D5EA6;
            padding: 4px 8px;
            border-radius: 6px;
            font-family: inherit;
        }
        .progress-toggle:hover { background: rgba(13,94,166,.06); }
        .progress-toggle .chevron {
            transition: transform 0.2s ease;
            display: inline-block;
            font-size: 10px;
        }
        .progress-toggle.open .chevron { transform: rotate(180deg); }
        .progress-body {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.3s ease;
            padding-top: 0;
        }
        .progress-body.open {
            max-height: 300px;
            padding-top: 8px;
        }
        .progress-row { margin-bottom: 10px; }
        .progress-row:last-child { margin-bottom: 0; }
        .progress-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }
        .progress-label-left {
            font-size: 11px;
            font-weight: 600;
            color: #5E7385;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .progress-label-right {
            font-size: 12px;
            font-weight: 600;
            color: #0B1B28;
        }
        .progress-bar-container {
            width: 100%;
            height: 8px;
            background: #EEF4F8;
            border-radius: 10px;
            overflow: hidden;
        }
        .progress-bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.4s ease;
        }
        .progress-bar-fill.green { background: #129867; }
        .progress-bar-fill.amber { background: #C8912E; }
        .progress-bar-fill.red { background: #C24A4A; }
        .progress-detail {
            display: flex;
            justify-content: space-between;
            margin-top: 3px;
            font-size: 11px;
            color: #5E7385;
        }
        .progress-detail .remaining { font-weight: 600; }
        .progress-detail .remaining.over { color: #C24A4A; }
    </style>
    <script>
        function getAntiForgeryToken() {
            return document.querySelector('#antiforgery-form input[name="__RequestVerificationToken"]').value;
        }

        function filterCategories() {
            var query = document.getElementById('searchInput').value.toLowerCase().trim();
            var rows = document.querySelectorAll('#limitsTable tbody tr');
            rows.forEach(function(row) {
                var categoryName = row.querySelector('td:first-child').textContent.toLowerCase();
                row.style.display = categoryName.indexOf(query) !== -1 ? '' : 'none';
            });
        }

        async function saveLimit(expenseCategoryId) {
            var annualInput = document.getElementById('annual-' + expenseCategoryId);
            var periodInput = document.getElementById('period-' + expenseCategoryId);

            var annualValue = annualInput.value.trim();
            var periodValue = periodInput.value.trim();

            var annualLimitEur = annualValue ? parseFloat(annualValue) : null;
            var periodLimitEur = periodValue ? parseFloat(periodValue) : null;

            // Validate at least one limit is > 0
            if (annualLimitEur === null && periodLimitEur === null) {
                Swal.fire({ title: 'Validation', text: 'Please enter at least one limit value (annual or period).', icon: 'warning', confirmButtonColor: '#0D5EA6' });
                return;
            }

            if (annualLimitEur !== null && annualLimitEur <= 0) {
                Swal.fire({ title: 'Validation', text: 'Annual limit must be greater than zero.', icon: 'warning', confirmButtonColor: '#0D5EA6' });
                return;
            }

            if (periodLimitEur !== null && periodLimitEur <= 0) {
                Swal.fire({ title: 'Validation', text: 'Period limit must be greater than zero.', icon: 'warning', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var confirm = await Swal.fire({
                title: 'Save Limit',
                text: 'Are you sure you want to save this spending limit configuration?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0D5EA6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, save'
            });

            if (!confirm.isConfirmed) return;

            BlockUI.show('Saving limit...');
            try {
                var response = await fetch('/ExpenseCategoryLimit/Save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        expenseCategoryId: expenseCategoryId,
                        annualLimitEur: annualLimitEur,
                        periodLimitEur: periodLimitEur
                    })
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({
                        title: 'Saved!',
                        text: data.message || 'Spending limit saved successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'An error occurred while saving.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        async function clearLimit(expenseCategoryId, limitType) {
            var label = limitType === 'annual' ? 'annual' : 'period';

            var confirm = await Swal.fire({
                title: 'Clear ' + label.charAt(0).toUpperCase() + label.slice(1) + ' Limit',
                text: 'Are you sure you want to clear the ' + label + ' limit for this category?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, clear it'
            });

            if (!confirm.isConfirmed) return;

            BlockUI.show('Clearing limit...');
            try {
                var response = await fetch('/ExpenseCategoryLimit/Clear', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        expenseCategoryId: expenseCategoryId,
                        limitType: limitType
                    })
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    // Clear the input field
                    var input = document.getElementById(limitType + '-' + expenseCategoryId);
                    if (input) input.value = '';

                    Swal.fire({
                        title: 'Cleared!',
                        text: data.message || 'Limit has been cleared.',
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    });
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'An error occurred while clearing.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }

        // ─── Progress Bars ─────────────────────────────────────────────────
        var _progressData = null;

        async function loadProgressData() {
            try {
                var response = await fetch('/ExpenseCategoryLimit/Progress');
                _progressData = await response.json();
            } catch (e) {
                _progressData = [];
            }
        }

        function toggleProgress(btn, categoryId) {
            var body = document.getElementById('progress-body-' + categoryId);
            var isOpen = body.classList.contains('open');

            if (isOpen) {
                body.classList.remove('open');
                btn.classList.remove('open');
                btn.querySelector('.toggle-text').textContent = 'View Progress';
            } else {
                // Load and render progress data
                renderProgress(categoryId, body);
                body.classList.add('open');
                btn.classList.add('open');
                btn.querySelector('.toggle-text').textContent = 'Hide Progress';
            }
        }

        function renderProgress(categoryId, container) {
            if (!_progressData) {
                container.innerHTML = '<span style="font-size:12px;color:#94a3b8;">Loading...</span>';
                return;
            }

            var data = _progressData.find(function(p) { return p.expenseCategoryId === categoryId; });
            if (!data) {
                container.innerHTML = '<span style="font-size:12px;color:#94a3b8;">No spending data available</span>';
                return;
            }

            var html = '';

            // Annual bar
            if (data.annualLimitEur && data.annualSpent !== null) {
                var pct = Math.min((data.annualSpent / data.annualLimitEur) * 100, 100);
                var actualPct = (data.annualSpent / data.annualLimitEur) * 100;
                var barClass = actualPct > 100 ? 'red' : actualPct >= 75 ? 'amber' : 'green';
                var remaining = data.annualLimitEur - data.annualSpent;
                var remainingText = remaining >= 0
                    ? '€' + remaining.toFixed(2) + ' remaining'
                    : '€' + Math.abs(remaining).toFixed(2) + ' over limit';
                var remainingClass = remaining < 0 ? 'remaining over' : 'remaining';

                html += '<div class="progress-row">';
                html += '<div class="progress-label"><span class="progress-label-left">Annual (' + data.annualYear + ')</span>';
                html += '<span class="progress-label-right">€' + data.annualSpent.toFixed(2) + ' / €' + data.annualLimitEur.toFixed(2) + '</span></div>';
                html += '<div class="progress-bar-container"><div class="progress-bar-fill ' + barClass + '" style="width:' + pct + '%;"></div></div>';
                html += '<div class="progress-detail"><span>' + Math.round(actualPct) + '% used</span><span class="' + remainingClass + '">' + remainingText + '</span></div>';
                html += '</div>';
            } else if (data.annualLimitEur === null) {
                html += '<div style="font-size:11px;color:#94a3b8;font-style:italic;margin-bottom:6px;">No annual limit</div>';
            }

            // Period bar
            if (data.periodLimitEur && data.periodSpent !== null && data.periodLabel) {
                var pct = Math.min((data.periodSpent / data.periodLimitEur) * 100, 100);
                var actualPct = (data.periodSpent / data.periodLimitEur) * 100;
                var barClass = actualPct > 100 ? 'red' : actualPct >= 75 ? 'amber' : 'green';
                var remaining = data.periodLimitEur - data.periodSpent;
                var remainingText = remaining >= 0
                    ? '€' + remaining.toFixed(2) + ' remaining'
                    : '€' + Math.abs(remaining).toFixed(2) + ' over limit';
                var remainingClass = remaining < 0 ? 'remaining over' : 'remaining';

                html += '<div class="progress-row">';
                html += '<div class="progress-label"><span class="progress-label-left">Period (' + data.periodLabel + ')</span>';
                html += '<span class="progress-label-right">€' + data.periodSpent.toFixed(2) + ' / €' + data.periodLimitEur.toFixed(2) + '</span></div>';
                html += '<div class="progress-bar-container"><div class="progress-bar-fill ' + barClass + '" style="width:' + pct + '%;"></div></div>';
                html += '<div class="progress-detail"><span>' + Math.round(actualPct) + '% used</span><span class="' + remainingClass + '">' + remainingText + '</span></div>';
                html += '</div>';
            } else if (data.periodLimitEur === null) {
                html += '<div style="font-size:11px;color:#94a3b8;font-style:italic;">No period limit</div>';
            } else if (data.periodLimitEur && !data.periodLabel) {
                html += '<div style="font-size:11px;color:#94a3b8;font-style:italic;">No active VAT period</div>';
            }

            container.innerHTML = html || '<span style="font-size:12px;color:#94a3b8;">No data</span>';
        }

        // Load progress data on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadProgressData();
        });

        // ─── Create Category Modal ─────────────────────────────────────────
        function openCreateCategoryModal() {
            document.getElementById('newCategoryName').value = '';
            document.getElementById('newExpenseTypeId').value = '';
            document.getElementById('createCategoryModal').style.display = 'flex';
            document.getElementById('newCategoryName').focus();
        }

        function closeCreateCategoryModal() {
            document.getElementById('createCategoryModal').style.display = 'none';
        }

        document.getElementById('createCategoryModal').addEventListener('click', function(e) {
            if (e.target === this) closeCreateCategoryModal();
        });

        async function saveNewCategory() {
            var name = document.getElementById('newCategoryName').value.trim();
            if (!name) {
                Swal.fire({ title: 'Validation', text: 'Category name is required.', icon: 'warning', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var expenseTypeId = document.getElementById('newExpenseTypeId').value;
            if (!expenseTypeId) {
                Swal.fire({ title: 'Validation', text: 'Expense Type is required. Select Services or Goods.', icon: 'warning', confirmButtonColor: '#0D5EA6' });
                return;
            }

            var formData = new FormData();
            formData.append('Name', name);
            formData.append('expenseTypeId', expenseTypeId);

            BlockUI.show('Creating category...');
            closeCreateCategoryModal();

            try {
                var response = await fetch('/ExpenseCategory/Create', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() },
                    body: formData
                });
                var data = await response.json();
                BlockUI.hide();

                if (data.success) {
                    Swal.fire({ title: 'Created', text: 'Category created. Reload to configure its spending limit.', icon: 'success', confirmButtonColor: '#0D5EA6' }).then(function() { window.location.reload(); });
                } else {
                    Swal.fire({ title: 'Error', text: data.message || 'Failed to create category.', icon: 'error', confirmButtonColor: '#0D5EA6' });
                }
            } catch (e) {
                BlockUI.hide();
                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error', confirmButtonColor: '#0D5EA6' });
            }
        }
    </script>
}
