@model Portal.Web.Models.PurchaseFormViewModel
@{
    ViewData["Title"] = "Edit Purchase";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Edit Purchase</div>
        <h1 class="topbar-heading">Edit purchase</h1>
        <p class="topbar-subtitle">Update the details of this purchase entry.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form method="post" asp-action="Edit" asp-controller="Purchase" asp-route-id="@Model.Id" asp-antiforgery="true" id="purchaseForm">
        <input type="hidden" asp-for="Id" />
        <div class="form-grid">
            <!-- Supplier (autocomplete with inline create) -->
            <div class="field">
                <label asp-for="SupplierId">Supplier *</label>
                <div class="autocomplete-wrapper">
                    <input type="text" id="supplierText" placeholder="Type supplier..." autocomplete="off"
                           value="@(Model.Suppliers.FirstOrDefault(s => s.Id == Model.SupplierId)?.Name)" />
                    <input type="hidden" asp-for="SupplierId" id="supplierHidden" />
                    <span class="ac-status" id="supplierStatus"></span>
                </div>
                <span asp-validation-for="SupplierId" class="field-validation-error"></span>
            </div>

            <!-- Expense Category (autocomplete with inline create) -->
            <div class="field">
                <label asp-for="ExpenseCategoryId">Expense Category *</label>
                <div class="autocomplete-wrapper">
                    <input type="text" id="categoryText" placeholder="Type category..." autocomplete="off"
                           value="@(Model.ExpenseCategories.FirstOrDefault(c => c.Id == Model.ExpenseCategoryId)?.Name)" />
                    <input type="hidden" asp-for="ExpenseCategoryId" id="categoryHidden" />
                    <span class="ac-status" id="categoryStatus"></span>
                </div>
                <span asp-validation-for="ExpenseCategoryId" class="field-validation-error"></span>
                <span id="expenseTypeIndicator" class="expense-type-indicator" style="display:none;"></span>
            </div>

            <!-- Invoice Number -->
            <div class="field">
                <label asp-for="InvoiceNumber">Invoice Number</label>
                <input asp-for="InvoiceNumber" placeholder="e.g. INV-001" />
                <span asp-validation-for="InvoiceNumber" class="field-validation-error"></span>
            </div>

            <!-- Invoice Date -->
            <div class="field">
                <label asp-for="InvoiceDate">Invoice Date *</label>
                <input asp-for="InvoiceDate" type="date" />
                <span asp-validation-for="InvoiceDate" class="field-validation-error"></span>
            </div>

            <!-- Description -->
            <div class="field" style="grid-column:1 / -1;">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" placeholder="Describe the purchase (optional)"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <!-- Purchase Type -->
            <div class="field" style="grid-column:1 / -1;">
                <label>Purchase Type *</label>
                <div class="radio-group" style="display:flex;gap:24px;margin-top:6px;">
                    @foreach (var purchaseType in Model.PurchaseTypes)
                    {
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:400;">
                            <input type="radio" asp-for="PurchaseTypeId" value="@purchaseType.Id"
                                   checked="@(Model.PurchaseTypeId == purchaseType.Id ? "checked" : null)" />
                            @switch (purchaseType.Id)
                            {
                                case 1:
                                    <span>Asset</span>
                                    break;
                                case 2:
                                    <span>Stock</span>
                                    break;
                                case 3:
                                    <span>Expense</span>
                                    break;
                                default:
                                    <span>@purchaseType.Name</span>
                                    break;
                            }
                        </label>
                    }
                </div>
                <span asp-validation-for="PurchaseTypeId" class="field-validation-error"></span>
            </div>

            <!-- Purchase Origin Type -->
            <div class="field" style="grid-column:1 / -1;">
                <label>Purchase Origin Type *</label>
                <div class="radio-group" style="display:flex;gap:24px;margin-top:6px;">
                    @{
                        var displayOrder = new[] { 1, 2, 4, 3 };
                        var orderedOriginTypes = displayOrder
                            .Select(id => Model.OriginTypes.FirstOrDefault(o => o.Id == id))
                            .Where(o => o != null);
                    }
                    @foreach (var originType in orderedOriginTypes)
                    {
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:400;">
                            <input type="radio" asp-for="PurchaseOriginTypeId" value="@originType.Id"
                                   checked="@(Model.PurchaseOriginTypeId == originType.Id ? "checked" : null)"
                                   onchange="onOriginTypeChanged()" />
                            @switch (originType.Id)
                            {
                                case 1:
                                    <span>Domestic</span>
                                    break;
                                case 2:
                                    <span>EU Reverse Charge</span>
                                    break;
                                case 4:
                                    <span>EU Paid</span>
                                    break;
                                case 3:
                                    <span>Non-EU</span>
                                    break;
                                default:
                                    <span>@originType.Name</span>
                                    break;
                            }
                        </label>
                    }
                </div>
                <span asp-validation-for="PurchaseOriginTypeId" class="field-validation-error"></span>
            </div>

            <!-- Amount Excluding VAT -->
            <div class="field">
                <label asp-for="AmountExcludingVat">Amount Excl. VAT *</label>
                <input asp-for="AmountExcludingVat" type="number" step="0.01" min="0.01" placeholder="0.00" id="amountInput" oninput="onAmountEdit()" />
                <span asp-validation-for="AmountExcludingVat" class="field-validation-error"></span>
            </div>

            <!-- VAT Amount -->
            <div class="field" id="vatAmountField">
                <label asp-for="VatAmount">VAT Amount</label>
                <input type="number" step="0.01" min="0" placeholder="0.00" id="vatAmountInput" value="@Model.VatAmount" oninput="onVatEdit()" />
                <input type="hidden" asp-for="VatAmount" id="vatAmountHidden" />
                <span asp-validation-for="VatAmount" class="field-validation-error"></span>
            </div>

            <!-- Total Amount (editable, bidirectional) -->
            <div class="field">
                <label>Total Amount</label>
                <input type="number" step="0.01" min="0" id="totalAmountInput" placeholder="0.00" style="font-weight:600;" oninput="onTotalEdit()" value="@((Model.AmountExcludingVat + Model.VatAmount).ToString("F2"))" />
            </div>

            <!-- Country -->
            <div class="field" id="countryField" style="display:none;">
                <label asp-for="Country" id="countryLabel">Country</label>
                <input asp-for="Country" placeholder="e.g. Germany, France" />
                <span asp-validation-for="Country" class="field-validation-error"></span>
            </div>

            <!-- Notes -->
            <div class="field" style="grid-column:1 / -1;">
                <label asp-for="Notes">Notes</label>
                <textarea asp-for="Notes" placeholder="Optional notes"></textarea>
                <span asp-validation-for="Notes" class="field-validation-error"></span>
            </div>

            <!-- VAT Period Assignment -->
            <div class="field" style="margin-top:16px;">
                <label for="VatSubmissionPeriodId">VAT Period</label>
                @if (Model.IsVatPeriodLocked)
                {
                    <select id="VatSubmissionPeriodId" disabled>
                        <option>@Model.AssignedPeriodLabel</option>
                    </select>
                    <span class="helper" style="display:block;margin-top:4px;font-size:12px;color:#C8912E;">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                        Locked — assigned to a submitted period.
                    </span>
                }
                else
                {
                    <select id="VatSubmissionPeriodId" name="VatSubmissionPeriodId">
                        <option value="">— Not assigned —</option>
                        @if (Model.UnsubmittedVatPeriods != null)
                        {
                            @foreach (var period in Model.UnsubmittedVatPeriods)
                            {
                                <option value="@period.Id" selected="@(Model.VatSubmissionPeriodId == period.Id)">@period.PeriodLabel</option>
                            }
                        }
                    </select>
                }
            </div>
        </div>

        <!-- Limit Warning Banner -->
        <div id="limitWarningBanner" style="display:none;margin-top:18px;padding:14px 18px;border-radius:10px;background:rgba(200,145,46,0.10);border:1px solid #C8912E;color:#7A5A1A;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                <span style="font-size:16px;">&#9888;</span>
                <strong style="color:#C8912E;font-size:13px;letter-spacing:0.2px;">Warning — Advisory Limit Exceeded</strong>
                <button type="button" onclick="clearLimitWarning()" style="margin-left:auto;background:none;border:none;cursor:pointer;font-size:16px;color:#C8912E;padding:2px 6px;border-radius:4px;" title="Dismiss">&times;</button>
            </div>
            <div id="limitWarningMessages" style="font-size:13px;line-height:1.6;"></div>
        </div>

        <div style="display:none;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</section>

<!-- Document Attachments -->
@await Component.InvokeAsync("AttachmentPanel", new { entityType = "Purchase", entityId = Model.Id })

<!-- Bottom spacer for sticky action bar -->
<div style="height:80px;"></div>

<!-- Sticky Action Bar -->
@if (!Model.IsVatPeriodLocked)
{
    <div class="sticky-action-bar">
        <div class="sticky-action-bar__inner">
            <a href="/Purchase" class="btn btn-secondary purchase-back-link">Cancel</a>
            <button type="submit" form="purchaseForm" class="btn btn-primary">Save Purchase</button>
        </div>
    </div>
}
else
{
    <div class="sticky-action-bar">
        <div class="sticky-action-bar__inner">
            <a href="/Purchase" class="btn btn-secondary purchase-back-link">Back to Purchases</a>
        </div>
    </div>
}

<script>
    // Restore filter params on back/cancel links
    (function() {
        var saved = sessionStorage.getItem('purchase_filter_state');
        if (saved) {
            document.querySelectorAll('.purchase-back-link').forEach(function(link) {
                link.href = '/Purchase' + saved;
            });
        }
    })();
</script>

@section Scripts {
    <style>
        .expense-type-indicator {
            display: inline-block;
            margin-top: 6px;
            font-size: 12px;
            font-weight: 600;
            color: #5E7385;
            background: #EEF4F8;
            padding: 3px 10px;
            border-radius: 6px;
            letter-spacing: 0.2px;
        }
        .autocomplete-wrapper {
            position: relative;
        }
        .autocomplete-wrapper input[type="text"] {
            width: 100%;
            padding-right: 28px;
        }
        .autocomplete-wrapper .ac-status {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            pointer-events: none;
            line-height: 1;
        }
        .autocomplete-wrapper .ac-status.resolved {
            color: #129867;
        }
        .autocomplete-wrapper .ac-status.unresolved {
            color: #C8912E;
        }
        .autocomplete-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 1000;
            background: #fff;
            border: 1px solid rgba(13,94,166,.15);
            border-radius: 10px;
            margin-top: 4px;
            max-height: 200px;
            overflow-y: auto;
            box-shadow: 0 8px 24px rgba(11,27,40,.10);
            display: none;
        }
        .autocomplete-dropdown.open {
            display: block;
        }
        .autocomplete-dropdown .ac-item {
            padding: 8px 12px;
            font-size: 13px;
            cursor: pointer;
            color: var(--text);
        }
        .autocomplete-dropdown .ac-item.highlighted {
            background: rgba(13,94,166,.06);
        }
        .autocomplete-dropdown .ac-item:hover {
            background: rgba(13,94,166,.06);
        }
        .autocomplete-dropdown .ac-item.ac-create {
            font-style: italic;
            color: var(--blue);
            border-top: 1px solid rgba(13,94,166,.08);
        }
        .autocomplete-dropdown .ac-item.ac-create::before {
            content: "+ ";
            font-weight: 700;
        }
        .autocomplete-dropdown .ac-empty {
            padding: 8px 12px;
            font-size: 12px;
            color: #5E7385;
            font-style: italic;
        }
    </style>
    <script>
        // ─── Data arrays (from server) ─────────────────────────────────────────
        var suppliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Suppliers.Select(s => new { s.Id, s.Name }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        var categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategories.Select(c => new { c.Id, c.Name, c.ExpenseTypeId }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        var expenseTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseTypes.Select(t => new { t.Id, t.Name }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        // ─── Expense Type Indicator ────────────────────────────────────────────
        function updateExpenseTypeIndicator(categoryId) {
            var indicator = document.getElementById('expenseTypeIndicator');
            if (!categoryId) {
                indicator.style.display = 'none';
                indicator.textContent = '';
                return;
            }
            var category = categories.find(function(c) { return c.id === categoryId; });
            if (!category || !category.expenseTypeId) {
                indicator.style.display = 'none';
                indicator.textContent = '';
                return;
            }
            var expenseType = expenseTypes.find(function(t) { return t.id === category.expenseTypeId; });
            if (expenseType) {
                indicator.textContent = expenseType.name;
                indicator.style.display = '';
            } else {
                indicator.style.display = 'none';
                indicator.textContent = '';
            }
        }

        // ─── Autocomplete Engine ───────────────────────────────────────────────
        function initAutocomplete(input, hiddenInput, statusEl, getItems, createEndpoint, itemsArrayRef, onSelect) {
            var dropdown = document.createElement('div');
            dropdown.className = 'autocomplete-dropdown';
            input.parentNode.appendChild(dropdown);

            var highlightedIndex = -1;
            var currentItems = [];
            var blurTimeout = null;

            function getFilteredItems(query) {
                var items = getItems();
                if (!query) return items.slice();
                var lower = query.toLowerCase();
                return items.filter(function(item) {
                    return item.name.toLowerCase().indexOf(lower) !== -1;
                });
            }

            function hasExactMatch(query) {
                if (!query) return false;
                var lower = query.toLowerCase();
                return getItems().some(function(item) {
                    return item.name.toLowerCase() === lower;
                });
            }

            function renderDropdown(query) {
                var filtered = getFilteredItems(query);
                var showCreate = query && query.trim() !== '' && !hasExactMatch(query);
                currentItems = [];
                highlightedIndex = -1;
                dropdown.innerHTML = '';

                if (filtered.length === 0 && !showCreate) {
                    dropdown.innerHTML = '<div class="ac-empty">No matches found</div>';
                    dropdown.classList.add('open');
                    return;
                }

                filtered.forEach(function(item) {
                    var div = document.createElement('div');
                    div.className = 'ac-item';
                    div.textContent = item.name;
                    div.setAttribute('data-id', item.id);
                    div.setAttribute('data-name', item.name);
                    currentItems.push({ el: div, id: item.id, name: item.name, isCreate: false });
                    dropdown.appendChild(div);
                });

                if (showCreate) {
                    var createDiv = document.createElement('div');
                    createDiv.className = 'ac-item ac-create';
                    createDiv.textContent = 'Create "' + query.trim() + '"';
                    createDiv.setAttribute('data-create-name', query.trim());
                    currentItems.push({ el: createDiv, id: null, name: query.trim(), isCreate: true });
                    dropdown.appendChild(createDiv);
                }

                dropdown.classList.add('open');
            }

            function selectItem(id, name) {
                input.value = name;
                hiddenInput.value = id;
                dropdown.classList.remove('open');
                updateStatus(true);
                if (onSelect) onSelect(id);
            }

            function updateStatus(resolved) {
                if (resolved) {
                    statusEl.textContent = '\u2713';
                    statusEl.className = 'ac-status resolved';
                } else if (input.value.trim() !== '') {
                    statusEl.textContent = '\u26A0';
                    statusEl.className = 'ac-status unresolved';
                    hiddenInput.value = '';
                    if (onSelect) onSelect(null);
                } else {
                    statusEl.textContent = '';
                    statusEl.className = 'ac-status';
                    hiddenInput.value = '';
                    if (onSelect) onSelect(null);
                }
            }

            async function createItem(name) {
                BlockUI.show('Creating...');
                var formData = new FormData();
                formData.append('Name', name);

                try {
                    var response = await fetch(createEndpoint, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': getAntiForgeryToken()
                        },
                        body: formData
                    });
                    var data = await response.json();
                    BlockUI.hide();

                    if (data.success && data.id) {
                        itemsArrayRef.push({ id: data.id, name: name });
                        selectItem(data.id, name);
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: data.message || 'Failed to create record.',
                            icon: 'error',
                            confirmButtonColor: '#0D5EA6'
                        });
                    }
                } catch (e) {
                    BlockUI.hide();
                    Swal.fire({
                        title: 'Error',
                        text: 'An unexpected error occurred while creating the record.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            }

            function highlightItem(index) {
                currentItems.forEach(function(item, i) {
                    if (i === index) {
                        item.el.classList.add('highlighted');
                    } else {
                        item.el.classList.remove('highlighted');
                    }
                });
                highlightedIndex = index;
                if (index >= 0 && currentItems[index]) {
                    currentItems[index].el.scrollIntoView({ block: 'nearest' });
                }
            }

            input.addEventListener('input', function() {
                renderDropdown(input.value);
                var val = input.value.trim().toLowerCase();
                var match = getItems().find(function(item) {
                    return item.name.toLowerCase() === val;
                });
                if (match) {
                    hiddenInput.value = match.id;
                    updateStatus(true);
                    if (onSelect) onSelect(match.id);
                } else {
                    updateStatus(false);
                }
            });

            input.addEventListener('focus', function() {
                renderDropdown(input.value);
            });

            input.addEventListener('blur', function() {
                blurTimeout = setTimeout(function() {
                    dropdown.classList.remove('open');
                }, 180);
            });

            dropdown.addEventListener('mousedown', function(e) {
                e.preventDefault();
                if (blurTimeout) clearTimeout(blurTimeout);

                var target = e.target.closest('.ac-item');
                if (!target) return;

                if (target.classList.contains('ac-create')) {
                    var createName = target.getAttribute('data-create-name');
                    createItem(createName);
                } else {
                    var id = parseInt(target.getAttribute('data-id'));
                    var name = target.getAttribute('data-name');
                    selectItem(id, name);
                }
            });

            input.addEventListener('keydown', function(e) {
                if (!dropdown.classList.contains('open') || currentItems.length === 0) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var next = highlightedIndex + 1;
                    if (next >= currentItems.length) next = 0;
                    highlightItem(next);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    var prev = highlightedIndex - 1;
                    if (prev < 0) prev = currentItems.length - 1;
                    highlightItem(prev);
                } else if (e.key === 'Enter') {
                    if (highlightedIndex >= 0 && highlightedIndex < currentItems.length) {
                        e.preventDefault();
                        e.stopPropagation();
                        var selected = currentItems[highlightedIndex];
                        if (selected.isCreate) {
                            createItem(selected.name);
                        } else {
                            selectItem(selected.id, selected.name);
                        }
                    }
                } else if (e.key === 'Escape') {
                    dropdown.classList.remove('open');
                }
            });

            if (hiddenInput.value && input.value) {
                updateStatus(true);
            }
        }

        // ─── Bidirectional Amount Calculation ──────────────────────────────────
        var lastEditedField = 'amount';

        function getSelectedOriginTypeId() {
            var selected = document.querySelector('input[name="PurchaseOriginTypeId"]:checked');
            return selected ? parseInt(selected.value) : 1;
        }

        function onOriginTypeChanged() {
            var originTypeId = getSelectedOriginTypeId();
            var vatInput = document.getElementById('vatAmountInput');
            var vatHidden = document.getElementById('vatAmountHidden');
            var countryField = document.getElementById('countryField');
            var countryLabel = document.getElementById('countryLabel');

            if (originTypeId === 2) {
                // EU Reverse Charge: VAT disabled (forced to 0), Country required
                vatInput.value = '0';
                vatInput.disabled = true;
                vatInput.style.background = '#EEF4F8';
                vatHidden.value = '0';
                countryField.style.display = '';
                countryLabel.textContent = 'Country *';
            } else if (originTypeId === 3 || originTypeId === 4) {
                // Non-EU and EU Paid: VAT enabled, Country required
                vatInput.disabled = false;
                vatInput.style.background = '';
                countryField.style.display = '';
                countryLabel.textContent = 'Country *';
            } else {
                // Domestic: VAT enabled, Country hidden
                vatInput.disabled = false;
                vatInput.style.background = '';
                countryField.style.display = 'none';
                countryLabel.textContent = 'Country';
            }

            recalc();
        }

        function onAmountEdit() {
            lastEditedField = 'amount';
            recalc();
        }

        function onVatEdit() {
            lastEditedField = 'vat';
            recalc();
        }

        function onTotalEdit() {
            lastEditedField = 'total';
            recalc();
        }

        function recalc() {
            var amtInput = document.getElementById('amountInput');
            var vatInput = document.getElementById('vatAmountInput');
            var vatHidden = document.getElementById('vatAmountHidden');
            var totalInput = document.getElementById('totalAmountInput');
            var originTypeId = getSelectedOriginTypeId();

            var amt = parseFloat(amtInput.value) || 0;
            var vat = parseFloat(vatInput.value) || 0;
            var total = parseFloat(totalInput.value) || 0;

            if (originTypeId === 2) {
                vat = 0;
                vatInput.value = '0';
                vatHidden.value = '0';
                total = amt;
                totalInput.value = total.toFixed(2);
                clearAllStyles();
                return;
            }

            if (lastEditedField === 'total') {
                amt = total - vat;
                amtInput.value = amt.toFixed(2);
                markComputed(amtInput);
                clearComputed(vatInput);
                clearComputed(totalInput);
            } else if (lastEditedField === 'vat') {
                if (getOrCreateFlag().value === '1') {
                    amt = total - vat;
                    amtInput.value = amt.toFixed(2);
                    markComputed(amtInput);
                    clearComputed(vatInput);
                    clearComputed(totalInput);
                } else {
                    total = amt + vat;
                    totalInput.value = total.toFixed(2);
                    markComputed(totalInput);
                    clearComputed(amtInput);
                    clearComputed(vatInput);
                }
            } else {
                total = amt + vat;
                totalInput.value = total.toFixed(2);
                markComputed(totalInput);
                clearComputed(amtInput);
                clearComputed(vatInput);
            }

            vatHidden.value = vat;

            if (lastEditedField === 'total') {
                getOrCreateFlag().value = '1';
            } else if (lastEditedField === 'amount') {
                getOrCreateFlag().value = '0';
            }
        }

        function getOrCreateFlag() {
            var flag = document.getElementById('totalManuallySet');
            if (!flag) {
                flag = document.createElement('input');
                flag.type = 'hidden';
                flag.id = 'totalManuallySet';
                flag.value = '0';
                document.getElementById('purchaseForm').appendChild(flag);
            }
            return flag;
        }

        function markComputed(input) {
            input.style.fontStyle = 'italic';
            input.style.opacity = '0.75';
        }

        function clearComputed(input) {
            input.style.fontStyle = '';
            input.style.opacity = '';
        }

        function clearAllStyles() {
            clearComputed(document.getElementById('amountInput'));
            clearComputed(document.getElementById('vatAmountInput'));
            clearComputed(document.getElementById('totalAmountInput'));
        }

        // ─── Limit Check (Advisory Spending Warning) ─────────────────────────
        var _limitCheckTimer = null;
        var _currentPurchaseId = @Model.Id;

        function checkLimits() {
            var categoryId = parseInt(document.getElementById('categoryHidden').value);
            var totalAmount = parseFloat(document.getElementById('totalAmountInput').value) || 0;
            var invoiceDate = document.getElementById('InvoiceDate').value;

            // Clear warning if no category selected
            if (!categoryId) {
                clearLimitWarning();
                return;
            }

            // Debounce 300ms
            if (_limitCheckTimer) clearTimeout(_limitCheckTimer);
            _limitCheckTimer = setTimeout(function() {
                performLimitCheck(categoryId, totalAmount, invoiceDate);
            }, 300);
        }

        async function performLimitCheck(categoryId, totalAmount, invoiceDate) {
            try {
                var response = await fetch('/ExpenseCategoryLimit/CheckLimits', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        expenseCategoryId: categoryId,
                        totalAmount: totalAmount,
                        invoiceDate: invoiceDate,
                        purchaseId: _currentPurchaseId
                    })
                });
                var data = await response.json();

                if (data.hasWarning && data.warnings && data.warnings.length > 0) {
                    showLimitWarning(data.warnings);
                } else {
                    clearLimitWarning();
                }
            } catch (e) {
                // Fail-safe: on any error, clear warning and allow user to continue
                clearLimitWarning();
            }
        }

        function showLimitWarning(warnings) {
            var banner = document.getElementById('limitWarningBanner');
            var messagesDiv = document.getElementById('limitWarningMessages');
            var html = '';

            warnings.forEach(function(w) {
                var typeLabel = w.limitType === 'annual' ? 'Annual Limit' : 'Period Limit';
                html += '<div style="margin-bottom:4px;">';
                html += '<strong>' + typeLabel + ':</strong> ';
                html += 'Configured \u20AC' + w.configuredLimit.toFixed(2);
                html += ' &bull; Current total \u20AC' + w.cumulativeTotal.toFixed(2);
                html += ' &bull; Projected \u20AC' + w.projectedTotal.toFixed(2);
                html += ' &bull; Exceeded by <strong>\u20AC' + w.exceededBy.toFixed(2) + '</strong>';
                html += '</div>';
            });

            messagesDiv.innerHTML = html;
            banner.style.display = '';
        }

        function clearLimitWarning() {
            var banner = document.getElementById('limitWarningBanner');
            banner.style.display = 'none';
            document.getElementById('limitWarningMessages').innerHTML = '';
        }

        // ─── Initialize on page load ──────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            // Init supplier autocomplete
            initAutocomplete(
                document.getElementById('supplierText'),
                document.getElementById('supplierHidden'),
                document.getElementById('supplierStatus'),
                function() { return suppliers; },
                '/Supplier/Create',
                suppliers
            );

            // Init category autocomplete with limit check on selection
            initAutocomplete(
                document.getElementById('categoryText'),
                document.getElementById('categoryHidden'),
                document.getElementById('categoryStatus'),
                function() { return categories; },
                '/ExpenseCategory/Create',
                categories,
                function(categoryId) {
                    updateExpenseTypeIndicator(categoryId);
                    checkLimits();
                }
            );

            // Show expense type indicator for pre-selected category on edit
            var preSelectedCategoryId = parseInt(document.getElementById('categoryHidden').value);
            if (preSelectedCategoryId) {
                updateExpenseTypeIndicator(preSelectedCategoryId);
            }

            onOriginTypeChanged();

            // Hook amount and total input events for limit check
            document.getElementById('amountInput').addEventListener('input', function() { checkLimits(); });
            document.getElementById('vatAmountInput').addEventListener('input', function() { checkLimits(); });
            document.getElementById('totalAmountInput').addEventListener('input', function() { checkLimits(); });

            // Initial limit check on page load if category is already set
            if (preSelectedCategoryId) {
                checkLimits();
            }
        });
    </script>
}
