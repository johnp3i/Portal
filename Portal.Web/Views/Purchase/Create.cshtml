@model Portal.Web.Models.PurchaseFormViewModel
@{
    ViewData["Title"] = "Create Purchase";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Create Purchase</div>
        <h1 class="topbar-heading">Record a new purchase</h1>
        <p class="topbar-subtitle">Fill in the details below to record a new business expense.</p>
    </div>
</div>

<section class="glass card-pad">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form method="post" asp-action="Create" asp-controller="Purchase" asp-antiforgery="true" id="purchaseForm">
        <div class="form-grid">
            <!-- Supplier (autocomplete with inline create) -->
            <div class="field">
                <label asp-for="SupplierId">Supplier *</label>
                <div class="autocomplete-wrapper">
                    <input type="text" id="supplierText" placeholder="Type supplier..." autocomplete="off" />
                    <input type="hidden" asp-for="SupplierId" id="supplierHidden" />
                    <span class="ac-status" id="supplierStatus"></span>
                </div>
                <span asp-validation-for="SupplierId" class="field-validation-error"></span>
            </div>

            <!-- Expense Category (autocomplete with inline create) -->
            <div class="field">
                <label asp-for="ExpenseCategoryId">Expense Category *</label>
                <div class="autocomplete-wrapper">
                    <input type="text" id="categoryText" placeholder="Type category..." autocomplete="off" />
                    <input type="hidden" asp-for="ExpenseCategoryId" id="categoryHidden" />
                    <span class="ac-status" id="categoryStatus"></span>
                </div>
                <span asp-validation-for="ExpenseCategoryId" class="field-validation-error"></span>
                <span id="expenseTypeIndicator" class="expense-type-indicator" style="display:none;"></span>
            </div>

            <!-- Category Spending Progress (always visible when category has limits) -->
            <div id="categoryProgressPanel" class="category-progress-panel" style="display:none;grid-column:1 / -1;">
                <button type="button" class="category-progress-header" onclick="toggleCategoryProgress()">
                    <span class="category-progress-icon">📊</span>
                    <span id="categoryProgressTitle">Spending Status</span>
                    <span class="chevron" id="categoryProgressChevron">&#9660;</span>
                </button>
                <div id="categoryProgressContent" class="category-progress-content"></div>
            </div>

            <!-- Limit Warning Banner -->
            <div id="limitWarningBanner" class="limit-warning-banner" style="display:none;grid-column:1 / -1;">
                <div class="limit-warning-header">
                    <span class="limit-warning-icon">&#9888;</span>
                    <strong>Warning</strong>
                    <button type="button" onclick="hideLimitWarning()" style="margin-left:auto;background:none;border:none;cursor:pointer;font-size:16px;color:#C8912E;padding:2px 6px;border-radius:4px;" title="Dismiss">&times;</button>
                </div>
                <div id="limitWarningContent" class="limit-warning-content"></div>
                <button type="button" id="limitProgressToggle" class="limit-progress-toggle" onclick="toggleLimitProgress()" style="display:none;">
                    <span class="chevron" id="limitProgressChevron">&#9660;</span> <span id="limitProgressToggleText">View Progress</span>
                </button>
                <div id="limitProgressBody" class="limit-progress-body"></div>
            </div>

            <!-- Invoice Number -->
            <div class="field">
                <label asp-for="InvoiceNumber">Invoice Number</label>
                <input asp-for="InvoiceNumber" placeholder="e.g. INV-001" />
                <span asp-validation-for="InvoiceNumber" class="field-validation-error"></span>
            </div>

            <!-- Invoice Date -->
            <div class="field">
                <label asp-for="InvoiceDate">Invoice Date *</label>
                <input asp-for="InvoiceDate" type="date" />
                <span asp-validation-for="InvoiceDate" class="field-validation-error"></span>
            </div>

            <!-- Description -->
            <div class="field" style="grid-column:1 / -1;">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" placeholder="Describe the purchase (optional)"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <!-- Purchase Type -->
            <div class="field" style="grid-column:1 / -1;">
                <label>Purchase Type *</label>
                <div class="radio-group" style="display:flex;gap:24px;margin-top:6px;">
                    @foreach (var purchaseType in Model.PurchaseTypes)
                    {
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:400;">
                            <input type="radio" asp-for="PurchaseTypeId" value="@purchaseType.Id"
                                   checked="@(Model.PurchaseTypeId == purchaseType.Id ? "checked" : null)" />
                            @switch (purchaseType.Id)
                            {
                                case 1:
                                    <span>Asset</span>
                                    break;
                                case 2:
                                    <span>Stock</span>
                                    break;
                                case 3:
                                    <span>Expense</span>
                                    break;
                                default:
                                    <span>@purchaseType.Name</span>
                                    break;
                            }
                        </label>
                    }
                </div>
                <span asp-validation-for="PurchaseTypeId" class="field-validation-error"></span>
            </div>

            <!-- Purchase Origin Type -->
            <div class="field" style="grid-column:1 / -1;">
                <label>Purchase Origin Type *</label>
                <div class="radio-group" style="display:flex;gap:24px;margin-top:6px;">
                    @{
                        var displayOrder = new[] { 1, 2, 4, 3 };
                        var orderedOriginTypes = displayOrder
                            .Select(id => Model.OriginTypes.FirstOrDefault(o => o.Id == id))
                            .Where(o => o != null);
                    }
                    @foreach (var originType in orderedOriginTypes)
                    {
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:400;">
                            <input type="radio" asp-for="PurchaseOriginTypeId" value="@originType.Id"
                                   checked="@(Model.PurchaseOriginTypeId == originType.Id ? "checked" : null)"
                                   onchange="onOriginTypeChanged()" />
                            @switch (originType.Id)
                            {
                                case 1:
                                    <span>Domestic</span>
                                    break;
                                case 2:
                                    <span>EU Reverse Charge</span>
                                    break;
                                case 4:
                                    <span>EU Paid</span>
                                    break;
                                case 3:
                                    <span>Non-EU</span>
                                    break;
                                default:
                                    <span>@originType.Name</span>
                                    break;
                            }
                        </label>
                    }
                </div>
                <span asp-validation-for="PurchaseOriginTypeId" class="field-validation-error"></span>
            </div>

            <!-- Amount Excluding VAT -->
            <div class="field">
                <label asp-for="AmountExcludingVat">Amount Excl. VAT *</label>
                <input asp-for="AmountExcludingVat" type="number" step="0.01" min="0.01" placeholder="0.00" id="amountInput" oninput="onAmountEdit()" />
                <span asp-validation-for="AmountExcludingVat" class="field-validation-error"></span>
            </div>

            <!-- VAT Amount -->
            <div class="field" id="vatAmountField">
                <label asp-for="VatAmount">VAT Amount</label>
                <input type="number" step="0.01" min="0" placeholder="0.00" id="vatAmountInput" value="@Model.VatAmount" oninput="onVatEdit()" />
                <input type="hidden" asp-for="VatAmount" id="vatAmountHidden" />
                <span asp-validation-for="VatAmount" class="field-validation-error"></span>
            </div>

            <!-- Total Amount (editable, bidirectional) -->
            <div class="field">
                <label>Total Amount</label>
                <input type="number" step="0.01" min="0" id="totalAmountInput" placeholder="0.00" style="font-weight:600;" oninput="onTotalEdit()" value="0.00" />
            </div>

            <!-- Country -->
            <div class="field" id="countryField" style="display:none;">
                <label asp-for="Country" id="countryLabel">Country</label>
                <input asp-for="Country" placeholder="e.g. Germany, France" />
                <span asp-validation-for="Country" class="field-validation-error"></span>
            </div>

            <!-- Notes -->
            <div class="field" style="grid-column:1 / -1;">
                <label asp-for="Notes">Notes</label>
                <textarea asp-for="Notes" placeholder="Optional notes"></textarea>
                <span asp-validation-for="Notes" class="field-validation-error"></span>
            </div>

            <!-- VAT Period Assignment -->
            <div class="field" style="margin-top:16px;">
                <label for="VatSubmissionPeriodId">VAT Period <span style="font-weight:400;color:#5E7385;">(Optional)</span></label>
                <select id="VatSubmissionPeriodId" name="VatSubmissionPeriodId">
                    <option value="">— Not assigned —</option>
                    @if (Model.UnsubmittedVatPeriods != null)
                    {
                        @foreach (var period in Model.UnsubmittedVatPeriods)
                        {
                            <option value="@period.Id">@period.PeriodLabel</option>
                        }
                    }
                </select>
                <span class="helper" style="display:block;margin-top:4px;font-size:12px;color:#5E7385;">Assign to a VAT period now, or leave empty to assign later.</span>
            </div>
        </div>

    </form>
</section>

<!-- Bottom spacer for sticky action bar -->
<div style="height:80px;"></div>

<!-- Sticky Action Bar -->
<div class="sticky-action-bar">
    <div class="sticky-action-bar__inner">
        <a href="/Purchase" class="btn btn-secondary purchase-back-link">Cancel</a>
        <button type="submit" form="purchaseForm" class="btn btn-primary">Create Purchase</button>
    </div>
</div>

<script>
    // Restore filter params on cancel link
    (function() {
        var saved = sessionStorage.getItem('purchase_filter_state');
        if (saved) {
            document.querySelectorAll('.purchase-back-link').forEach(function(link) {
                link.href = '/Purchase' + saved;
            });
        }
    })();
</script>

@section Scripts {
    <style>
        .limit-warning-banner {
            background: #FEF6E8;
            border: 1px solid #C8912E;
            border-radius: 10px;
            padding: 14px 18px;
            margin-top: 4px;
            margin-bottom: 4px;
        }
        .limit-warning-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            color: #C8912E;
            font-size: 14px;
        }
        .limit-warning-icon {
            font-size: 16px;
        }
        .limit-warning-content {
            font-size: 13px;
            color: #5E4B1E;
            line-height: 1.6;
        }
        .limit-warning-content .limit-warning-item {
            padding: 6px 0;
            border-bottom: 1px solid rgba(200,145,46,0.15);
        }
        .limit-warning-content .limit-warning-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .limit-warning-content .limit-type-label {
            font-weight: 600;
            color: #9A6F1E;
        }
        .limit-progress-toggle {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            background: none;
            border: none;
            font-size: 12px;
            font-weight: 600;
            color: #0D5EA6;
            padding: 4px 0;
            margin-top: 8px;
            font-family: inherit;
        }
        .limit-progress-toggle:hover { opacity: 0.8; }
        .limit-progress-toggle .chevron {
            transition: transform 0.2s ease;
            display: inline-block;
            font-size: 10px;
        }
        .limit-progress-toggle.open .chevron { transform: rotate(180deg); }
        .limit-progress-body {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.3s ease;
        }
        .limit-progress-body.open {
            max-height: 300px;
            padding-top: 8px;
        }
        .category-progress-panel {
            background: #F7FAFC;
            border: 1px solid rgba(13,94,166,.10);
            border-radius: 12px;
            padding: 14px 18px;
        }
        .category-progress-header {
            display: flex;
            align-items: center;
            gap: 8px;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            color: #0B1B28;
            font-family: inherit;
            padding: 0;
            width: 100%;
        }
        .category-progress-header:hover { opacity: 0.8; }
        .category-progress-header .chevron {
            margin-left: auto;
            font-size: 10px;
            transition: transform 0.2s ease;
        }
        .category-progress-header.open .chevron { transform: rotate(180deg); }
        .category-progress-content {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.3s ease;
        }
        .category-progress-content.open {
            max-height: 300px;
            padding-top: 12px;
        }
        .lp-row { margin-bottom: 10px; }
        .lp-row:last-child { margin-bottom: 0; }
        .lp-label { display: flex; justify-content: space-between; margin-bottom: 4px; }
        .lp-label-left { font-size: 11px; font-weight: 600; color: #5E7385; text-transform: uppercase; letter-spacing: 0.04em; }
        .lp-label-right { font-size: 12px; font-weight: 600; color: #0B1B28; }
        .lp-bar { width: 100%; height: 8px; background: #EEF4F8; border-radius: 10px; overflow: hidden; }
        .lp-fill { height: 100%; border-radius: 10px; transition: width 0.4s ease; }
        .lp-fill.green { background: #129867; }
        .lp-fill.amber { background: #C8912E; }
        .lp-fill.red { background: #C24A4A; }
        .lp-detail { display: flex; justify-content: space-between; margin-top: 3px; font-size: 11px; color: #5E7385; }
        .lp-detail .remaining { font-weight: 600; }
        .lp-detail .remaining.over { color: #C24A4A; }
        .expense-type-indicator {
            display: inline-block;
            margin-top: 6px;
            font-size: 12px;
            font-weight: 600;
            color: #5E7385;
            background: #EEF4F8;
            padding: 3px 10px;
            border-radius: 6px;
            letter-spacing: 0.2px;
        }
        .autocomplete-wrapper {
            position: relative;
        }
        .autocomplete-wrapper input[type="text"] {
            width: 100%;
            padding-right: 28px;
        }
        .autocomplete-wrapper .ac-status {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            pointer-events: none;
            line-height: 1;
        }
        .autocomplete-wrapper .ac-status.resolved {
            color: #129867;
        }
        .autocomplete-wrapper .ac-status.unresolved {
            color: #C8912E;
        }
        .autocomplete-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 1000;
            background: #fff;
            border: 1px solid rgba(13,94,166,.15);
            border-radius: 10px;
            margin-top: 4px;
            max-height: 200px;
            overflow-y: auto;
            box-shadow: 0 8px 24px rgba(11,27,40,.10);
            display: none;
        }
        .autocomplete-dropdown.open {
            display: block;
        }
        .autocomplete-dropdown .ac-item {
            padding: 8px 12px;
            font-size: 13px;
            cursor: pointer;
            color: var(--text);
        }
        .autocomplete-dropdown .ac-item.highlighted {
            background: rgba(13,94,166,.06);
        }
        .autocomplete-dropdown .ac-item:hover {
            background: rgba(13,94,166,.06);
        }
        .autocomplete-dropdown .ac-item.ac-create {
            font-style: italic;
            color: var(--blue);
            border-top: 1px solid rgba(13,94,166,.08);
        }
        .autocomplete-dropdown .ac-item.ac-create::before {
            content: "+ ";
            font-weight: 700;
        }
        .autocomplete-dropdown .ac-empty {
            padding: 8px 12px;
            font-size: 12px;
            color: #5E7385;
            font-style: italic;
        }
    </style>
    <script>
        // ─── Data arrays (from server) ─────────────────────────────────────────
        var suppliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Suppliers.Select(s => new { s.Id, s.Name }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        var categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategories.Select(c => new { c.Id, c.Name, c.ExpenseTypeId }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        var expenseTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseTypes.Select(t => new { t.Id, t.Name }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        // ─── Expense Type Indicator ────────────────────────────────────────────
        function updateExpenseTypeIndicator(categoryId) {
            var indicator = document.getElementById('expenseTypeIndicator');
            if (!categoryId) {
                indicator.style.display = 'none';
                indicator.textContent = '';
                return;
            }
            var category = categories.find(function(c) { return c.id === categoryId; });
            if (!category || !category.expenseTypeId) {
                indicator.style.display = 'none';
                indicator.textContent = '';
                return;
            }
            var expenseType = expenseTypes.find(function(t) { return t.id === category.expenseTypeId; });
            if (expenseType) {
                indicator.textContent = expenseType.name;
                indicator.style.display = '';
            } else {
                indicator.style.display = 'none';
                indicator.textContent = '';
            }
        }

        // ─── Autocomplete Engine ───────────────────────────────────────────────
        function initAutocomplete(input, hiddenInput, statusEl, getItems, createEndpoint, itemsArrayRef, onSelect) {
            var dropdown = document.createElement('div');
            dropdown.className = 'autocomplete-dropdown';
            input.parentNode.appendChild(dropdown);

            var highlightedIndex = -1;
            var currentItems = [];
            var blurTimeout = null;

            function getFilteredItems(query) {
                var items = getItems();
                if (!query) return items.slice();
                var lower = query.toLowerCase();
                return items.filter(function(item) {
                    return item.name.toLowerCase().indexOf(lower) !== -1;
                });
            }

            function hasExactMatch(query) {
                if (!query) return false;
                var lower = query.toLowerCase();
                return getItems().some(function(item) {
                    return item.name.toLowerCase() === lower;
                });
            }

            function renderDropdown(query) {
                var filtered = getFilteredItems(query);
                var showCreate = query && query.trim() !== '' && !hasExactMatch(query);
                currentItems = [];
                highlightedIndex = -1;
                dropdown.innerHTML = '';

                if (filtered.length === 0 && !showCreate) {
                    dropdown.innerHTML = '<div class="ac-empty">No matches found</div>';
                    dropdown.classList.add('open');
                    return;
                }

                filtered.forEach(function(item) {
                    var div = document.createElement('div');
                    div.className = 'ac-item';
                    div.textContent = item.name;
                    div.setAttribute('data-id', item.id);
                    div.setAttribute('data-name', item.name);
                    currentItems.push({ el: div, id: item.id, name: item.name, isCreate: false });
                    dropdown.appendChild(div);
                });

                if (showCreate) {
                    var createDiv = document.createElement('div');
                    createDiv.className = 'ac-item ac-create';
                    createDiv.textContent = 'Create "' + query.trim() + '"';
                    createDiv.setAttribute('data-create-name', query.trim());
                    currentItems.push({ el: createDiv, id: null, name: query.trim(), isCreate: true });
                    dropdown.appendChild(createDiv);
                }

                dropdown.classList.add('open');
            }

            function selectItem(id, name) {
                input.value = name;
                hiddenInput.value = id;
                dropdown.classList.remove('open');
                updateStatus(true);
                if (onSelect) onSelect(id);
            }

            function updateStatus(resolved) {
                if (resolved) {
                    statusEl.textContent = '\u2713';
                    statusEl.className = 'ac-status resolved';
                } else if (input.value.trim() !== '') {
                    statusEl.textContent = '\u26A0';
                    statusEl.className = 'ac-status unresolved';
                    hiddenInput.value = '';
                    if (onSelect) onSelect(null);
                } else {
                    statusEl.textContent = '';
                    statusEl.className = 'ac-status';
                    hiddenInput.value = '';
                    if (onSelect) onSelect(null);
                }
            }

            async function createItem(name) {
                // If creating an expense category, prompt for Expense Type selection
                if (createEndpoint === '/ExpenseCategory/Create') {
                    var { value: expenseTypeId } = await Swal.fire({
                        title: 'Create Expense Category',
                        html: '<div style="overflow:hidden;"><p style="margin-bottom:16px;">Select an Expense Type for <strong>' + name + '</strong>:</p>' +
                              '<select id="swal-expense-type" style="width:100%;max-width:100%;box-sizing:border-box;padding:12px 14px;border-radius:10px;border:1px solid rgba(13,94,166,.15);font-size:14px;appearance:auto;">' +
                              '<option value="">-- Select Expense Type --</option>' +
                              '<option value="1">Services</option>' +
                              '<option value="2">Goods</option>' +
                              '</select></div>',
                        width: 420,
                        padding: '2em 1.5em',
                        showCancelButton: true,
                        confirmButtonText: 'Create',
                        confirmButtonColor: '#0D5EA6',
                        cancelButtonColor: '#6c757d',
                        preConfirm: function() {
                            var val = document.getElementById('swal-expense-type').value;
                            if (!val) {
                                Swal.showValidationMessage('Expense Type is required. Select Services or Goods.');
                                return false;
                            }
                            return val;
                        }
                    });

                    if (!expenseTypeId) return; // User cancelled

                    BlockUI.show('Creating...');
                    var formData = new FormData();
                    formData.append('Name', name);
                    formData.append('expenseTypeId', expenseTypeId);

                    try {
                        var response = await fetch(createEndpoint, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': getAntiForgeryToken()
                            },
                            body: formData
                        });
                        var data = await response.json();
                        BlockUI.hide();

                        if (data.success && data.id) {
                            itemsArrayRef.push({ id: data.id, name: name, expenseTypeId: parseInt(expenseTypeId) });
                            selectItem(data.id, name);
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: data.message || 'Failed to create category.',
                                icon: 'error',
                                confirmButtonColor: '#0D5EA6'
                            });
                        }
                    } catch (e) {
                        BlockUI.hide();
                        Swal.fire({
                            title: 'Error',
                            text: 'An unexpected error occurred while creating the category.',
                            icon: 'error',
                            confirmButtonColor: '#0D5EA6'
                        });
                    }
                    return;
                }

                // Default creation flow (e.g. Supplier)
                BlockUI.show('Creating...');
                var formData = new FormData();
                formData.append('Name', name);

                try {
                    var response = await fetch(createEndpoint, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': getAntiForgeryToken()
                        },
                        body: formData
                    });
                    var data = await response.json();
                    BlockUI.hide();

                    if (data.success && data.id) {
                        itemsArrayRef.push({ id: data.id, name: name });
                        selectItem(data.id, name);
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: data.message || 'Failed to create record.',
                            icon: 'error',
                            confirmButtonColor: '#0D5EA6'
                        });
                    }
                } catch (e) {
                    BlockUI.hide();
                    Swal.fire({
                        title: 'Error',
                        text: 'An unexpected error occurred while creating the record.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            }

            function highlightItem(index) {
                currentItems.forEach(function(item, i) {
                    if (i === index) {
                        item.el.classList.add('highlighted');
                    } else {
                        item.el.classList.remove('highlighted');
                    }
                });
                highlightedIndex = index;
                if (index >= 0 && currentItems[index]) {
                    currentItems[index].el.scrollIntoView({ block: 'nearest' });
                }
            }

            input.addEventListener('input', function() {
                renderDropdown(input.value);
                var val = input.value.trim().toLowerCase();
                var match = getItems().find(function(item) {
                    return item.name.toLowerCase() === val;
                });
                if (match) {
                    hiddenInput.value = match.id;
                    updateStatus(true);
                    if (onSelect) onSelect(match.id);
                } else {
                    updateStatus(false);
                }
            });

            input.addEventListener('focus', function() {
                renderDropdown(input.value);
            });

            input.addEventListener('blur', function() {
                blurTimeout = setTimeout(function() {
                    dropdown.classList.remove('open');
                }, 180);
            });

            dropdown.addEventListener('mousedown', function(e) {
                e.preventDefault();
                if (blurTimeout) clearTimeout(blurTimeout);

                var target = e.target.closest('.ac-item');
                if (!target) return;

                if (target.classList.contains('ac-create')) {
                    var createName = target.getAttribute('data-create-name');
                    createItem(createName);
                } else {
                    var id = parseInt(target.getAttribute('data-id'));
                    var name = target.getAttribute('data-name');
                    selectItem(id, name);
                }
            });

            input.addEventListener('keydown', function(e) {
                if (!dropdown.classList.contains('open') || currentItems.length === 0) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var next = highlightedIndex + 1;
                    if (next >= currentItems.length) next = 0;
                    highlightItem(next);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    var prev = highlightedIndex - 1;
                    if (prev < 0) prev = currentItems.length - 1;
                    highlightItem(prev);
                } else if (e.key === 'Enter') {
                    if (highlightedIndex >= 0 && highlightedIndex < currentItems.length) {
                        e.preventDefault();
                        e.stopPropagation();
                        var selected = currentItems[highlightedIndex];
                        if (selected.isCreate) {
                            createItem(selected.name);
                        } else {
                            selectItem(selected.id, selected.name);
                        }
                    }
                } else if (e.key === 'Escape') {
                    dropdown.classList.remove('open');
                }
            });

            if (hiddenInput.value && input.value) {
                updateStatus(true);
            }
        }

        // ─── Bidirectional Amount Calculation ──────────────────────────────────
        var lastEditedField = 'amount';

        function getSelectedOriginTypeId() {
            var selected = document.querySelector('input[name="PurchaseOriginTypeId"]:checked');
            return selected ? parseInt(selected.value) : 1;
        }

        function onOriginTypeChanged() {
            var originTypeId = getSelectedOriginTypeId();
            var vatInput = document.getElementById('vatAmountInput');
            var vatHidden = document.getElementById('vatAmountHidden');
            var countryField = document.getElementById('countryField');
            var countryLabel = document.getElementById('countryLabel');

            if (originTypeId === 2) {
                // EU Reverse Charge: VAT disabled (forced to 0), Country required
                vatInput.value = '0';
                vatInput.disabled = true;
                vatInput.style.background = '#EEF4F8';
                vatHidden.value = '0';
                countryField.style.display = '';
                countryLabel.textContent = 'Country *';
            } else if (originTypeId === 3 || originTypeId === 4) {
                // Non-EU and EU Paid: VAT enabled, Country required
                vatInput.disabled = false;
                vatInput.style.background = '';
                countryField.style.display = '';
                countryLabel.textContent = 'Country *';
            } else {
                // Domestic: VAT enabled, Country hidden
                vatInput.disabled = false;
                vatInput.style.background = '';
                countryField.style.display = 'none';
                countryLabel.textContent = 'Country';
            }

            recalc();
        }

        function onAmountEdit() {
            lastEditedField = 'amount';
            recalc();
        }

        function onVatEdit() {
            lastEditedField = 'vat';
            recalc();
        }

        function onTotalEdit() {
            lastEditedField = 'total';
            recalc();
        }

        function recalc() {
            var amtInput = document.getElementById('amountInput');
            var vatInput = document.getElementById('vatAmountInput');
            var vatHidden = document.getElementById('vatAmountHidden');
            var totalInput = document.getElementById('totalAmountInput');
            var originTypeId = getSelectedOriginTypeId();

            var amt = parseFloat(amtInput.value) || 0;
            var vat = parseFloat(vatInput.value) || 0;
            var total = parseFloat(totalInput.value) || 0;

            if (originTypeId === 2) {
                vat = 0;
                vatInput.value = '0';
                vatHidden.value = '0';
                total = amt;
                totalInput.value = total.toFixed(2);
                clearAllStyles();
                return;
            }

            if (lastEditedField === 'total') {
                amt = total - vat;
                amtInput.value = amt.toFixed(2);
                markComputed(amtInput);
                clearComputed(vatInput);
                clearComputed(totalInput);
            } else if (lastEditedField === 'vat') {
                if (document.getElementById('totalManuallySet') && document.getElementById('totalManuallySet').value === '1') {
                    amt = total - vat;
                    amtInput.value = amt.toFixed(2);
                    markComputed(amtInput);
                    clearComputed(vatInput);
                    clearComputed(totalInput);
                } else {
                    total = amt + vat;
                    totalInput.value = total.toFixed(2);
                    markComputed(totalInput);
                    clearComputed(amtInput);
                    clearComputed(vatInput);
                }
            } else {
                total = amt + vat;
                totalInput.value = total.toFixed(2);
                markComputed(totalInput);
                clearComputed(amtInput);
                clearComputed(vatInput);
            }

            vatHidden.value = vat;

            if (lastEditedField === 'total') {
                getOrCreateFlag().value = '1';
            } else if (lastEditedField === 'amount') {
                getOrCreateFlag().value = '0';
            }
        }

        function getOrCreateFlag() {
            var flag = document.getElementById('totalManuallySet');
            if (!flag) {
                flag = document.createElement('input');
                flag.type = 'hidden';
                flag.id = 'totalManuallySet';
                flag.value = '0';
                document.getElementById('purchaseForm').appendChild(flag);
            }
            return flag;
        }

        function markComputed(input) {
            input.style.fontStyle = 'italic';
            input.style.opacity = '0.75';
        }

        function clearComputed(input) {
            input.style.fontStyle = '';
            input.style.opacity = '';
        }

        function clearAllStyles() {
            clearComputed(document.getElementById('amountInput'));
            clearComputed(document.getElementById('vatAmountInput'));
            clearComputed(document.getElementById('totalAmountInput'));
        }

        // ─── Expense Category Limit Check (Advisory) ────────────────────────
        var _limitCheckTimer = null;
        var _limitCheckDebounceMs = 300;

        function checkLimits() {
            var categoryId = parseInt(document.getElementById('categoryHidden').value);
            var totalInput = document.getElementById('totalAmountInput');
            var invoiceDateInput = document.querySelector('input[name="InvoiceDate"]');
            var totalAmount = parseFloat(totalInput.value) || 0;
            var invoiceDate = invoiceDateInput ? invoiceDateInput.value : '';

            // If no category selected or no amount, clear warning
            if (!categoryId || totalAmount <= 0 || !invoiceDate) {
                hideLimitWarning();
                return;
            }

            fetch('/ExpenseCategoryLimit/CheckLimits', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    expenseCategoryId: categoryId,
                    totalAmount: totalAmount,
                    invoiceDate: invoiceDate,
                    purchaseId: null
                })
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.hasWarning && data.warnings && data.warnings.length > 0) {
                    showLimitWarning(data.warnings);
                } else {
                    hideLimitWarning();
                }
            })
            .catch(function() {
                hideLimitWarning();
            });
        }

        function debouncedCheckLimits() {
            if (_limitCheckTimer) clearTimeout(_limitCheckTimer);
            _limitCheckTimer = setTimeout(checkLimits, _limitCheckDebounceMs);
        }

        function showLimitWarning(warnings) {
            var banner = document.getElementById('limitWarningBanner');
            var content = document.getElementById('limitWarningContent');
            var html = '';

            warnings.forEach(function(w) {
                var typeLabel = w.limitType === 'annual' ? 'Annual Limit' : 'Period Limit';
                html += '<div class="limit-warning-item">';
                html += '<span class="limit-type-label">' + typeLabel + ':</span> ';
                html += 'Configured limit: <strong>\u20AC' + formatDecimal(w.configuredLimit) + '</strong> &mdash; ';
                html += 'Current total: \u20AC' + formatDecimal(w.cumulativeTotal) + ' &mdash; ';
                html += 'Projected total: \u20AC' + formatDecimal(w.projectedTotal) + ' &mdash; ';
                html += 'Exceeded by: <strong>\u20AC' + formatDecimal(w.exceededBy) + '</strong>';
                html += '</div>';
            });

            content.innerHTML = html;
            banner.style.display = '';

            // Show progress toggle and load progress data
            var categoryId = parseInt(document.getElementById('categoryHidden').value);
            if (categoryId) {
                document.getElementById('limitProgressToggle').style.display = '';
                loadCategoryProgress(categoryId);
            }
        }

        function hideLimitWarning() {
            var banner = document.getElementById('limitWarningBanner');
            banner.style.display = 'none';
            document.getElementById('limitWarningContent').innerHTML = '';
            document.getElementById('limitProgressToggle').style.display = 'none';
            document.getElementById('limitProgressBody').classList.remove('open');
            document.getElementById('limitProgressBody').innerHTML = '';
            document.getElementById('limitProgressToggle').classList.remove('open');
            document.getElementById('limitProgressToggleText').textContent = 'View Progress';
        }

        function toggleLimitProgress() {
            var body = document.getElementById('limitProgressBody');
            var btn = document.getElementById('limitProgressToggle');
            var isOpen = body.classList.contains('open');
            if (isOpen) {
                body.classList.remove('open');
                btn.classList.remove('open');
                document.getElementById('limitProgressToggleText').textContent = 'View Progress';
            } else {
                body.classList.add('open');
                btn.classList.add('open');
                document.getElementById('limitProgressToggleText').textContent = 'Hide Progress';
            }
        }

        function loadCategoryProgress(categoryId) {
            fetch('/ExpenseCategoryLimit/CategoryProgress?expenseCategoryId=' + categoryId)
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    if (result.found) {
                        renderCategoryProgress(result.data);
                    }
                })
                .catch(function() {});
        }

        function renderCategoryProgress(data) {
            var container = document.getElementById('limitProgressBody');
            var html = '';

            if (data.annualLimitEur && data.annualSpent !== null) {
                var pct = Math.min((data.annualSpent / data.annualLimitEur) * 100, 100);
                var actualPct = (data.annualSpent / data.annualLimitEur) * 100;
                var barClass = actualPct > 100 ? 'red' : actualPct >= 75 ? 'amber' : 'green';
                var remaining = data.annualLimitEur - data.annualSpent;
                var remainingText = remaining >= 0 ? '\u20AC' + remaining.toFixed(2) + ' remaining' : '\u20AC' + Math.abs(remaining).toFixed(2) + ' over limit';
                var remainingClass = remaining < 0 ? 'remaining over' : 'remaining';

                html += '<div class="lp-row">';
                html += '<div class="lp-label"><span class="lp-label-left">Annual (' + data.annualYear + ')</span><span class="lp-label-right">\u20AC' + data.annualSpent.toFixed(2) + ' / \u20AC' + data.annualLimitEur.toFixed(2) + '</span></div>';
                html += '<div class="lp-bar"><div class="lp-fill ' + barClass + '" style="width:' + pct + '%;"></div></div>';
                html += '<div class="lp-detail"><span>' + Math.round(actualPct) + '% used</span><span class="' + remainingClass + '">' + remainingText + '</span></div>';
                html += '</div>';
            }

            if (data.periodLimitEur && data.periodSpent !== null && data.periodLabel) {
                var pct = Math.min((data.periodSpent / data.periodLimitEur) * 100, 100);
                var actualPct = (data.periodSpent / data.periodLimitEur) * 100;
                var barClass = actualPct > 100 ? 'red' : actualPct >= 75 ? 'amber' : 'green';
                var remaining = data.periodLimitEur - data.periodSpent;
                var remainingText = remaining >= 0 ? '\u20AC' + remaining.toFixed(2) + ' remaining' : '\u20AC' + Math.abs(remaining).toFixed(2) + ' over limit';
                var remainingClass = remaining < 0 ? 'remaining over' : 'remaining';

                html += '<div class="lp-row">';
                html += '<div class="lp-label"><span class="lp-label-left">Period (' + data.periodLabel + ')</span><span class="lp-label-right">\u20AC' + data.periodSpent.toFixed(2) + ' / \u20AC' + data.periodLimitEur.toFixed(2) + '</span></div>';
                html += '<div class="lp-bar"><div class="lp-fill ' + barClass + '" style="width:' + pct + '%;"></div></div>';
                html += '<div class="lp-detail"><span>' + Math.round(actualPct) + '% used</span><span class="' + remainingClass + '">' + remainingText + '</span></div>';
                html += '</div>';
            }

            container.innerHTML = html || '';
        }

        // ─── Always-Visible Category Progress Panel ─────────────────────────
        var _categoryProgressOpen = true;

        function loadCategoryProgressPanel(categoryId) {
            var panel = document.getElementById('categoryProgressPanel');
            var content = document.getElementById('categoryProgressContent');

            if (!categoryId) {
                panel.style.display = 'none';
                content.innerHTML = '';
                return;
            }

            fetch('/ExpenseCategoryLimit/CategoryProgress?expenseCategoryId=' + categoryId)
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    if (result.found && (result.data.annualLimitEur || result.data.periodLimitEur)) {
                        var html = renderProgressBarsHtml(result.data);
                        content.innerHTML = html;
                        panel.style.display = '';
                        // Auto-open on first load
                        if (_categoryProgressOpen) {
                            content.classList.add('open');
                            document.querySelector('.category-progress-header').classList.add('open');
                        }
                    } else {
                        panel.style.display = 'none';
                        content.innerHTML = '';
                    }
                })
                .catch(function() {
                    panel.style.display = 'none';
                    content.innerHTML = '';
                });
        }

        function toggleCategoryProgress() {
            var content = document.getElementById('categoryProgressContent');
            var header = document.querySelector('.category-progress-header');
            var isOpen = content.classList.contains('open');
            if (isOpen) {
                content.classList.remove('open');
                header.classList.remove('open');
                _categoryProgressOpen = false;
            } else {
                content.classList.add('open');
                header.classList.add('open');
                _categoryProgressOpen = true;
            }
        }

        function renderProgressBarsHtml(data) {
            var html = '';
            if (data.annualLimitEur && data.annualSpent !== null) {
                var pct = Math.min((data.annualSpent / data.annualLimitEur) * 100, 100);
                var actualPct = (data.annualSpent / data.annualLimitEur) * 100;
                var barClass = actualPct > 100 ? 'red' : actualPct >= 75 ? 'amber' : 'green';
                var remaining = data.annualLimitEur - data.annualSpent;
                var remainingText = remaining >= 0 ? '\u20AC' + remaining.toFixed(2) + ' remaining' : '\u20AC' + Math.abs(remaining).toFixed(2) + ' over limit';
                var remainingClass = remaining < 0 ? 'remaining over' : 'remaining';

                html += '<div class="lp-row">';
                html += '<div class="lp-label"><span class="lp-label-left">Annual (' + data.annualYear + ')</span><span class="lp-label-right">\u20AC' + data.annualSpent.toFixed(2) + ' / \u20AC' + data.annualLimitEur.toFixed(2) + '</span></div>';
                html += '<div class="lp-bar"><div class="lp-fill ' + barClass + '" style="width:' + pct + '%;"></div></div>';
                html += '<div class="lp-detail"><span>' + Math.round(actualPct) + '% used</span><span class="' + remainingClass + '">' + remainingText + '</span></div>';
                html += '</div>';
            }
            if (data.periodLimitEur && data.periodSpent !== null && data.periodLabel) {
                var pct = Math.min((data.periodSpent / data.periodLimitEur) * 100, 100);
                var actualPct = (data.periodSpent / data.periodLimitEur) * 100;
                var barClass = actualPct > 100 ? 'red' : actualPct >= 75 ? 'amber' : 'green';
                var remaining = data.periodLimitEur - data.periodSpent;
                var remainingText = remaining >= 0 ? '\u20AC' + remaining.toFixed(2) + ' remaining' : '\u20AC' + Math.abs(remaining).toFixed(2) + ' over limit';
                var remainingClass = remaining < 0 ? 'remaining over' : 'remaining';

                html += '<div class="lp-row">';
                html += '<div class="lp-label"><span class="lp-label-left">Period (' + data.periodLabel + ')</span><span class="lp-label-right">\u20AC' + data.periodSpent.toFixed(2) + ' / \u20AC' + data.periodLimitEur.toFixed(2) + '</span></div>';
                html += '<div class="lp-bar"><div class="lp-fill ' + barClass + '" style="width:' + pct + '%;"></div></div>';
                html += '<div class="lp-detail"><span>' + Math.round(actualPct) + '% used</span><span class="' + remainingClass + '">' + remainingText + '</span></div>';
                html += '</div>';
            }
            return html;
        }

        function formatDecimal(value) {
            return parseFloat(value).toFixed(2);
        }

        // ─── Initialize on page load ──────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            // Init supplier autocomplete
            initAutocomplete(
                document.getElementById('supplierText'),
                document.getElementById('supplierHidden'),
                document.getElementById('supplierStatus'),
                function() { return suppliers; },
                '/Supplier/Create',
                suppliers
            );

            // Init category autocomplete
            initAutocomplete(
                document.getElementById('categoryText'),
                document.getElementById('categoryHidden'),
                document.getElementById('categoryStatus'),
                function() { return categories; },
                '/ExpenseCategory/Create',
                categories,
                function(categoryId) {
                    updateExpenseTypeIndicator(categoryId);
                    debouncedCheckLimits();
                    loadCategoryProgressPanel(categoryId);
                }
            );

            // Hook amount and total inputs for limit checking
            document.getElementById('amountInput').addEventListener('input', debouncedCheckLimits);
            document.getElementById('totalAmountInput').addEventListener('input', debouncedCheckLimits);

            onOriginTypeChanged();
        });
    </script>
}
