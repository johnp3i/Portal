@model PurchaseListViewModel
@{
    ViewData["Title"] = "Purchases";
}

<div class="topbar">
    <div>
        <div class="eyebrow"><span class="dot"></span> Purchases</div>
        <h1 class="topbar-heading">Purchases</h1>
        <p class="topbar-subtitle">Track and manage your business expenses.</p>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a asp-action="Create" class="btn btn-primary">Create Purchase</a>
        <a asp-action="BulkEntry" class="btn btn-secondary" style="background:rgba(13,94,166,.08);border:1.5px solid var(--blue);color:var(--blue);">Bulk Entry</a>
        <a asp-action="CsvImport" class="btn btn-secondary">CSV Import</a>
        <a class="btn btn-secondary" href="/Purchase/ExportCsv?supplierId=@Model.SupplierId&expenseCategoryId=@Model.ExpenseCategoryId&purchaseOriginTypeId=@Model.PurchaseOriginTypeId&purchaseTypeId=@Model.PurchaseTypeId&vatPeriodId=@Model.VatPeriodId&dateFrom=@(Model.DateFrom?.ToString("yyyy-MM-dd"))&dateTo=@(Model.DateTo?.ToString("yyyy-MM-dd"))&searchTerm=@Model.SearchTerm">Export CSV</a>
        <a class="btn btn-secondary" href="/Purchase/ExportPdf?supplierId=@Model.SupplierId&expenseCategoryId=@Model.ExpenseCategoryId&purchaseOriginTypeId=@Model.PurchaseOriginTypeId&purchaseTypeId=@Model.PurchaseTypeId&vatPeriodId=@Model.VatPeriodId&dateFrom=@(Model.DateFrom?.ToString("yyyy-MM-dd"))&dateTo=@(Model.DateTo?.ToString("yyyy-MM-dd"))&searchTerm=@Model.SearchTerm">Export PDF</a>
    </div>
</div>

<!-- Filter Panel -->
<section class="glass card-pad" style="margin-bottom:22px;">
    <form method="get" asp-action="Index">
        <button type="button" class="filter-toggle" aria-expanded="false" aria-controls="purchaseFilterPanel">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 4h18M7 9h10M10 14h4"/></svg>
            Filters
        </button>
        <div class="filter-panel" id="purchaseFilterPanel">
            <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;">
                <div class="field" style="flex:1;min-width:200px;">
                    <label for="searchTerm">Search</label>
                    <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Description, invoice #, or supplier..." />
                </div>
                <div class="field" style="flex:1;min-width:180px;">
                    <label for="supplierId">Supplier</label>
                    <select id="supplierId" name="supplierId">
                        <option value="">All Suppliers</option>
                        @foreach (var supplier in Model.Suppliers.OrderBy(s => s.Name))
                        {
                            <option value="@supplier.Id" selected="@(Model.SupplierId == supplier.Id)">@supplier.Name</option>
                        }
                    </select>
                </div>
                <div class="field" style="flex:1;min-width:180px;">
                    <label for="expenseCategoryId">Expense Category</label>
                    <select id="expenseCategoryId" name="expenseCategoryId">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.ExpenseCategories.OrderBy(c => c.Name))
                        {
                            <option value="@category.Id" selected="@(Model.ExpenseCategoryId == category.Id)">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="field" style="flex:1;min-width:160px;">
                    <label for="purchaseOriginTypeId">Origin Type</label>
                    <select id="purchaseOriginTypeId" name="purchaseOriginTypeId">
                        <option value="">All Origins</option>
                        @foreach (var originType in Model.OriginTypes)
                        {
                            <option value="@originType.Id" selected="@(Model.PurchaseOriginTypeId == originType.Id)">
                                @(originType.Id == 2 ? "EU Reverse Charge" : originType.Id == 3 ? "Non-EU" : originType.Id == 4 ? "EU Paid" : originType.Name)
                            </option>
                        }
                    </select>
                </div>
                <div class="field" style="flex:1;min-width:160px;">
                    <label for="purchaseTypeId">Purchase Type</label>
                    <select id="purchaseTypeId" name="purchaseTypeId">
                        <option value="">All Types</option>
                        @foreach (var purchaseType in Model.PurchaseTypes)
                        {
                            <option value="@purchaseType.Id" selected="@(Model.PurchaseTypeId == purchaseType.Id)">@purchaseType.Name</option>
                        }
                    </select>
                </div>
                <div class="field" style="flex:1;min-width:180px;">
                    <label for="vatPeriodId">VAT Period</label>
                    <select id="vatPeriodId" name="vatPeriodId">
                        <option value="">All Periods</option>
                        @foreach (var period in Model.VatPeriods.OrderByDescending(p => p.PeriodStartDate))
                        {
                            <option value="@period.Id" selected="@(Model.VatPeriodId == period.Id)">
                                @period.PeriodLabel (@period.PeriodStartDate.ToString("dd MMM yyyy") – @period.PeriodEndDate.ToString("dd MMM yyyy"))
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;margin-top:14px;">
                <div class="field" style="min-width:160px;">
                    <label for="dateFrom">Date From</label>
                    <input type="date" id="dateFrom" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="field" style="min-width:160px;">
                    <label for="dateTo">Date To</label>
                    <input type="date" id="dateTo" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div style="display:flex;gap:10px;padding-bottom:2px;margin-left:auto;">
                    <button type="submit" class="btn btn-primary" style="padding:14px 20px;">Filter</button>
                    <a asp-action="Index" class="btn btn-secondary" style="padding:14px 20px;">Clear</a>
                </div>
            </div>
        </div>
    </form>
</section>

<!-- Active Filter Indicator -->
@{
    var hasAnyFilter = Model.SupplierId.HasValue || Model.ExpenseCategoryId.HasValue
        || Model.PurchaseOriginTypeId.HasValue || Model.PurchaseTypeId.HasValue
        || Model.VatPeriodId.HasValue || Model.DateFrom.HasValue || Model.DateTo.HasValue
        || !string.IsNullOrWhiteSpace(Model.SearchTerm);

    var filterLabel = "Showing all purchases (no filters applied)";
    if (hasAnyFilter)
    {
        var parts = new List<string>();
        if (Model.VatPeriodId.HasValue)
        {
            var selectedPeriod = Model.VatPeriods.FirstOrDefault(p => p.Id == Model.VatPeriodId.Value);
            if (selectedPeriod != null)
            {
                parts.Add($"VAT Period: {selectedPeriod.PeriodLabel}");
            }
        }
        if (Model.DateFrom.HasValue && Model.DateTo.HasValue)
        {
            parts.Add($"{Model.DateFrom.Value.ToString("dd MMM yyyy")} – {Model.DateTo.Value.ToString("dd MMM yyyy")}");
        }
        else if (Model.DateFrom.HasValue)
        {
            parts.Add($"From {Model.DateFrom.Value.ToString("dd MMM yyyy")}");
        }
        else if (Model.DateTo.HasValue)
        {
            parts.Add($"Until {Model.DateTo.Value.ToString("dd MMM yyyy")}");
        }
        if (Model.SupplierId.HasValue)
        {
            var supplierName = Model.Suppliers.FirstOrDefault(s => s.Id == Model.SupplierId.Value)?.Name;
            if (supplierName != null) parts.Add($"Supplier: {supplierName}");
        }
        if (Model.ExpenseCategoryId.HasValue)
        {
            var catName = Model.ExpenseCategories.FirstOrDefault(c => c.Id == Model.ExpenseCategoryId.Value)?.Name;
            if (catName != null) parts.Add($"Category: {catName}");
        }
        if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            parts.Add($"Search: \"{Model.SearchTerm}\"");
        }
        filterLabel = "Filtered: " + string.Join(" · ", parts);
    }
}
<!-- KPI Cards (computed from filtered results) -->
@{
    var activePurchases = Model.Purchases?.Where(p => !p.IsCancelled).ToList() ?? new List<Portal.Infrastructure.Entities.Purchase>();
    var totalPurchases = activePurchases.Count;
    var totalSpend = activePurchases.Sum(p => p.TotalAmount);
    var totalVat = activePurchases.Sum(p => p.VatAmount);
    var outdatedCount = activePurchases.Count(p =>
        p.VatSubmissionPeriod != null
        && (p.InvoiceDate < p.VatSubmissionPeriod.PeriodStartDate
            || p.InvoiceDate > p.VatSubmissionPeriod.PeriodEndDate));
    var domesticCount = activePurchases.Count(p => p.PurchaseOriginTypeId == 1);
    var euRcCount = activePurchases.Count(p => p.PurchaseOriginTypeId == 2);
    var euPaidCount = activePurchases.Count(p => p.PurchaseOriginTypeId == 4);
    var nonEuCount = activePurchases.Count(p => p.PurchaseOriginTypeId == 3);
}
<section class="glass card-pad" style="margin-bottom:22px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:18px;">
        <div style="padding:18px;border-radius:14px;background:rgba(13,94,166,0.04);border:1px solid rgba(13,94,166,0.08);">
            <div style="font-size:13px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">Total Purchases</div>
            <div style="font-size:28px;font-weight:800;color:#1a2b3c;margin-top:6px;font-family:'Manrope',sans-serif;">@totalPurchases</div>
        </div>
        <div style="padding:18px;border-radius:14px;background:rgba(18,152,103,0.04);border:1px solid rgba(18,152,103,0.08);">
            <div style="font-size:13px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">Total Spend</div>
            <div style="font-size:28px;font-weight:800;color:#129867;margin-top:6px;font-family:'Manrope',sans-serif;">@Model.CurrencySymbol@totalSpend.ToString("N2")</div>
        </div>
        <div style="padding:18px;border-radius:14px;background:rgba(87,184,232,0.04);border:1px solid rgba(87,184,232,0.08);">
            <div style="font-size:13px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">Total VAT</div>
            <div style="font-size:28px;font-weight:800;color:#1a2b3c;margin-top:6px;font-family:'Manrope',sans-serif;">@Model.CurrencySymbol@totalVat.ToString("N2")</div>
        </div>
        <div style="padding:18px;border-radius:14px;background:rgba(194,74,74,0.04);border:1px solid rgba(194,74,74,0.08);">
            <div style="font-size:13px;font-weight:600;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">Outdated</div>
            <div style="font-size:28px;font-weight:800;color:@(outdatedCount > 0 ? "#C24A4A" : "#1a2b3c");margin-top:6px;font-family:'Manrope',sans-serif;">@outdatedCount</div>
        </div>
    </div>
    <!-- Origin Type Breakdown -->
    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center;margin-top:18px;padding-top:16px;border-top:1px solid rgba(13,94,166,0.06);">
        <div style="padding:10px 18px;border-radius:10px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.06);">
            <span style="font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">Domestic</span>
            <div style="font-size:1.1rem;font-weight:800;margin-top:4px;font-family:'Manrope',sans-serif;">@domesticCount</div>
        </div>
        <div style="padding:10px 18px;border-radius:10px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.06);">
            <span style="font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">EU RC</span>
            <div style="font-size:1.1rem;font-weight:800;color:#0D5EA6;margin-top:4px;font-family:'Manrope',sans-serif;">@euRcCount</div>
        </div>
        <div style="padding:10px 18px;border-radius:10px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.06);">
            <span style="font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">EU Paid</span>
            <div style="font-size:1.1rem;font-weight:800;color:#1A8AB5;margin-top:4px;font-family:'Manrope',sans-serif;">@euPaidCount</div>
        </div>
        <div style="padding:10px 18px;border-radius:10px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.06);">
            <span style="font-size:11px;font-weight:700;color:#5a6a7a;text-transform:uppercase;letter-spacing:0.5px;">Non-EU</span>
            <div style="font-size:1.1rem;font-weight:800;color:#8D5D07;margin-top:4px;font-family:'Manrope',sans-serif;">@nonEuCount</div>
        </div>
        <div style="margin-left:auto;padding:14px 22px;border-radius:10px;background:rgba(13,94,166,.03);border:1px solid rgba(13,94,166,.06);font-size:13px;font-weight:700;color:#0B1B28;display:flex;align-items:center;gap:10px;font-family:'Manrope',sans-serif;">
            <svg width="16" height="16" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><path d="M3 4h18M7 9h10M10 14h4"/></svg>
            @filterLabel
        </div>
    </div>
</section>

<!-- Purchase Table -->
<section class="glass card-pad">
    @if (Model.Purchases != null && Model.Purchases.Count > 0)
    {
        <div class="table-responsive index-table">
        <div class="scroll-hint">← Scroll horizontally →</div>
        <table id="purchaseTable">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Supplier</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th style="text-align:right;">Excl. VAT</th>
                    <th style="text-align:right;">VAT</th>
                    <th style="text-align:right;">Total</th>
                    <th>Origin</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="purchaseTableBody">
                @foreach (var purchase in Model.Purchases.OrderByDescending(p => p.InvoiceDate))
                {
                    <tr>
                        <td>
                            <strong>@(string.IsNullOrWhiteSpace(purchase.Description) ? purchase.ExpenseCategory?.Name ?? "Purchase" : purchase.Description)</strong>
                            <div style="font-size:11px;color:#5a6a7a;margin-top:2px;">@purchase.InvoiceDate.ToString("dd MMM yyyy")</div>
                        </td>
                        <td>@purchase.Supplier?.Name</td>
                        <td data-mobile="hide">@purchase.InvoiceDate.ToString("dd MMM yyyy")</td>
                        <td data-mobile="hide">@purchase.ExpenseCategory?.Name</td>
                        <td data-mobile="hide" style="text-align:right;font-weight:600;">@Model.CurrencySymbol@purchase.AmountExcludingVat.ToString("N2")</td>
                        <td data-mobile="hide" style="text-align:right;">@Model.CurrencySymbol@purchase.VatAmount.ToString("N2")</td>
                        <td data-mobile="amount" style="text-align:right;font-weight:700;">@Model.CurrencySymbol@purchase.TotalAmount.ToString("N2")</td>
                        <td data-mobile="status">
                            @if (purchase.IsCancelled)
                            {
                                <span class="pill pill-red">Cancelled</span>
                            }
                            else if (purchase.PurchaseOriginTypeId == 2)
                            {
                                <span class="pill pill-blue">EU RC</span>
                            }
                            else if (purchase.PurchaseOriginTypeId == 3)
                            {
                                <span class="pill pill-gold">Non-EU</span>
                            }
                            else if (purchase.PurchaseOriginTypeId == 4)
                            {
                                <span class="pill pill-cyan">EU Paid</span>
                            }
                            else if (purchase.PurchaseTypeId == 1)
                            {
                                <span class="pill pill-blue">Asset</span>
                            }
                            else if (purchase.PurchaseTypeId == 2)
                            {
                                <span class="pill pill-green">Stock</span>
                            }
                            else if (purchase.PurchaseTypeId == 3)
                            {
                                <span class="pill pill-grey">Expense</span>
                            }
                        </td>
                        <td data-mobile="hide">
                            @if (purchase.PurchaseOriginTypeId == 2)
                            {
                                <span class="pill pill-blue">EU RC</span>
                            }
                            else if (purchase.PurchaseOriginTypeId == 3)
                            {
                                <span class="pill pill-gold">Non-EU</span>
                            }
                            else if (purchase.PurchaseOriginTypeId == 4)
                            {
                                <span class="pill pill-cyan">EU Paid</span>
                            }
                        </td>
                        <td data-mobile="hide">
                            @if (purchase.VatSubmissionPeriod != null
                                && (purchase.InvoiceDate < purchase.VatSubmissionPeriod.PeriodStartDate
                                    || purchase.InvoiceDate > purchase.VatSubmissionPeriod.PeriodEndDate))
                            {
                                <span class="pill pill-red" title="This purchase was reported in a different VAT period than its invoice date">Outdated — @purchase.VatSubmissionPeriod.PeriodLabel</span>
                            }
                        </td>
                        <td data-mobile="hide" style="white-space:nowrap;">
                            @await Component.InvokeAsync("AttachmentCount", new { entityType = "Purchase", entityId = purchase.Id })
                            <a asp-action="Edit" asp-route-id="@purchase.Id" class="tbl-action tbl-action--primary">Edit</a>
                            @if (!purchase.IsCancelled)
                            {
                                <button type="button" class="tbl-action tbl-action--danger btn-cancel-purchase" data-id="@purchase.Id">Cancel</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <!-- Pagination Controls -->
        <div id="paginationContainer" style="display:flex;justify-content:space-between;align-items:center;margin-top:18px;flex-wrap:wrap;gap:12px;">
            <div id="paginationInfo" style="font-size:14px;color:#5a6a7a;"></div>
            <div id="paginationControls" style="display:flex;gap:4px;align-items:center;"></div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No purchases found. Create your first purchase or adjust your filters.</p>
        </div>
    }
</section>

<!-- Expense Insights Teaser (shown only for Starter plan users without expense_insights access) -->
@if (Model.ShowExpenseInsightsTeaser)
{
<section class="glass card-pad" style="margin-top:24px;opacity:0.85;position:relative;overflow:hidden;cursor:pointer;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.85'">
    <a href="/ExpenseInsight" style="text-decoration:none;display:block;">
        <div style="display:flex;align-items:center;gap:16px;">
            <div style="width:48px;height:48px;border-radius:12px;background:#EEF4F8;display:flex;align-items:center;justify-content:center;">
                <svg width="22" height="22" fill="none" stroke="#0D5EA6" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <div style="flex:1;">
                <h3 style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;color:#1a2b3c;margin:0 0 4px;">Expense Insights</h3>
                <p style="font-size:14px;color:#5a6a7a;margin:0;">Visualise spending patterns by category with charts, budget alerts, and trend analysis.</p>
            </div>
            <span class="btn btn-primary" style="min-width:120px;text-align:center;">Learn More</span>
        </div>
