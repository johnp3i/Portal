<script>
    // ─── Mobile action-bar "More" menu ──────────────────────────────────────
    function togglePurchaseMoreMenu(event) {
        event.stopPropagation();
        var panel = document.getElementById('purchaseMorePanel');
        var toggle = event.currentTarget;
        var isOpen = panel.classList.toggle('open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
    // Close the menu when tapping/clicking outside it.
    document.addEventListener('click', function (e) {
        var panel = document.getElementById('purchaseMorePanel');
        if (!panel || !panel.classList.contains('open')) return;
        if (e.target.closest('.mab-more')) return;
        panel.classList.remove('open');
        var toggle = document.querySelector('.mab-more-toggle');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
</script>

<script>
    // ─── Filter State Persistence ──────────────────────────────────────────
    // Remembers the active purchase filters across navigation. Common flow:
    // filter by supplier → open/create a purchase → come back to the list → filters restored.
    //
    //  • When the page has a query string, save it as the current filter state.
    //  • When the page has NO query string but a filter state was saved, restore it by
    //    redirecting to /Purchase{savedQuery}. Landing there then has a query string, so it
    //    saves (not re-restores) — no redirect loop.
    //  • The "Clear" button removes the saved state, so clearing is sticky too.
    (function() {
        var STORAGE_KEY = 'purchase_filter_state';
        var search = window.location.search;

        if (search && search !== '?') {
            // Explicit filters in the URL → treat as the current state.
            sessionStorage.setItem(STORAGE_KEY, search);
            return;
        }

        // Bare /Purchase → restore the last-used filters if we have any.
        var saved = sessionStorage.getItem(STORAGE_KEY);
        if (saved && saved !== '?' && saved.length > 1) {
            window.location.replace('/Purchase' + saved);
        }
    })();
</script>
<script>
async function showAttachmentModal(entityId, label) {
    // Open the modal, then load its contents. This modal both LISTS existing files and lets
    // the user UPLOAD a new one directly from the purchase list — no need to open the full
    // edit page just to attach an invoice.
    Swal.fire({
        title: 'Attachments \u2014 ' + label,
        html: '<div id="attachModalBody" style="text-align:left;">Loading\u2026</div>',
        width: 560,
        showConfirmButton: true,
        confirmButtonText: 'Close',
        confirmButtonColor: '#0D5EA6',
        didOpen: function () { renderAttachmentModal(entityId); }
    });
}

function attachTokenValue() {
    var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    return tokenInput ? tokenInput.value : '';
}

// Rewrites a row's File-cell to reflect the current attachment count, mirroring the
// AttachmentCount view component (which renders NOTHING at 0). Keeps the "attach" hint for
// empty cells so there's always a clickable affordance — never a bare "0" badge.
function updateAttachmentCountCell(entityId, count) {
    var cell = document.getElementById('attachCell-' + entityId);
    if (!cell) return;

    var hint =
        '<span class="attach-add-hint" title="Attach a file">' +
        '<svg width="15" height="15" viewBox="0 0 16 16" fill="none" style="vertical-align:-3px;">' +
        '<path d="M10.5 3.5L4.5 9.5a2.12 2.12 0 003 3l6-6a3.54 3.54 0 00-5-5l-6 6a4.95 4.95 0 007 7l5.5-5.5" stroke="#0D5EA6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>' +
        '</svg><span>Add</span></span>';

    if (count > 0) {
        var badge =
            '<span class="attachment-count-indicator" title="' + count + ' attachment' + (count === 1 ? '' : 's') + '">' +
            '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" style="vertical-align:-2px;">' +
            '<path d="M10.5 3.5L4.5 9.5a2.12 2.12 0 003 3l6-6a3.54 3.54 0 00-5-5l-6 6a4.95 4.95 0 007 7l5.5-5.5" stroke="#5a6a7a" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>' +
            '</svg>' +
            '<span class="attachment-count-number">' + count + '</span>' +
            '</span>';
        cell.innerHTML = badge;
    } else {
        // No files: show only the faint attach hint (matches the server-side empty state).
        cell.innerHTML = hint;
    }
}

// (Re)renders the attachment modal body: the existing file list (with delete) plus the
// upload control. Called on open and after each upload/delete so the view stays fresh.
async function renderAttachmentModal(entityId) {
    var body = document.getElementById('attachModalBody');
    if (!body) return;
    body.innerHTML = 'Loading\u2026';

    var files = [];
    try {
        var response = await fetch('/Attachment/AxGetList?entityType=Purchase&entityId=' + entityId);
        var result = await response.json();
        if (result.success && Array.isArray(result.data)) files = result.data;
    } catch (e) { /* fall through to empty list */ }

    // Keep the table's paperclip badge in sync with the current count (live, no reload).
    updateAttachmentCountCell(entityId, files.length);

    var html = '';

    // Existing files
    if (files.length === 0) {
        html += '<div style="font-size:13px;color:#5E7385;padding:8px 0 4px;">No files attached yet.</div>';
    } else {
        files.forEach(function (file) {
            var sizeKb = (file.fileSizeBytes / 1024).toFixed(1);
            var uploadDate = new Date(file.createdAtUtc.endsWith('Z') ? file.createdAtUtc : file.createdAtUtc + 'Z');
            var dateStr = uploadDate.toLocaleDateString() + ' ' + uploadDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
            html += '<div style="padding:12px 0;border-bottom:1px solid #f0f4f7;display:flex;justify-content:space-between;align-items:center;gap:12px;">';
            html += '<div style="min-width:0;">';
            html += '<div style="font-weight:600;font-size:14px;color:#0B1B28;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + file.originalFileName + '</div>';
            html += '<div style="font-size:12px;color:#5E7385;margin-top:3px;">' + sizeKb + ' KB &middot; ' + dateStr + '</div>';
            html += '</div>';
            html += '<div style="display:flex;gap:6px;flex-shrink:0;">';
            html += '<a href="/Attachment/AxGetDownload?id=' + file.id + '" class="btn btn-primary" style="font-size:12px;padding:6px 14px;white-space:nowrap;">Download</a>';
            html += '<button type="button" class="btn btn-secondary" style="font-size:12px;padding:6px 12px;white-space:nowrap;color:#C24A4A;" onclick="deleteAttachmentFromModal(' + file.id + ',' + entityId + ')">Delete</button>';
            html += '</div>';
            html += '</div>';
        });
    }

    // Upload control (max 5 files per purchase; the server enforces the limit and file types)
    if (files.length >= 5) {
        html += '<div style="margin-top:14px;font-size:12px;color:#C8912E;">Maximum of 5 files reached. Delete one to add another.</div>';
    } else {
        html += '<div style="margin-top:16px;padding-top:14px;border-top:1px solid #f0f4f7;">';
        html += '<label style="font-size:12px;font-weight:700;color:#5E7385;display:block;margin-bottom:8px;">Attach a file (PDF, PNG, JPG, WEBP \u2014 max 5 MB)</label>';
        // Native file input is hidden and triggered by a themed button, so the control matches
        // the app theme (the browser default "Browse..." button cannot be styled directly).
        html += '<input type="file" id="attachFileInput" accept=".pdf,.png,.jpg,.jpeg,.webp" capture="environment" style="display:none;" onchange="onAttachFileChosen()" />';
        html += '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">';
        html += '<button type="button" class="btn btn-secondary" style="font-size:13px;padding:8px 16px;" onclick="document.getElementById(\'attachFileInput\').click()">Choose file</button>';
        html += '<span id="attachFileName" style="font-size:13px;color:#8a9bab;flex:1;min-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">No file selected</span>';
        html += '<button type="button" class="btn btn-primary" style="font-size:13px;padding:8px 16px;" onclick="uploadAttachmentFromModal(' + entityId + ')">Upload</button>';
        html += '</div></div>';
    }

    body.innerHTML = html;
}

// Reflects the chosen filename next to the themed "Choose file" button.
function onAttachFileChosen() {
    var input = document.getElementById('attachFileInput');
    var nameEl = document.getElementById('attachFileName');
    if (!input || !nameEl) return;
    if (input.files && input.files.length > 0) {
        nameEl.textContent = input.files[0].name;
        nameEl.style.color = '#0B1B28';
    } else {
        nameEl.textContent = 'No file selected';
        nameEl.style.color = '#8a9bab';
    }
}

async function uploadAttachmentFromModal(entityId) {
    var input = document.getElementById('attachFileInput');
    if (!input || !input.files || input.files.length === 0) {
        Swal.fire({ icon: 'warning', title: 'No file', text: 'Please choose a file to upload.', confirmButtonColor: '#0D5EA6' });
        return;
    }

    var formData = new FormData();
    formData.append('file', input.files[0]);
    formData.append('entityType', 'Purchase');
    formData.append('entityId', entityId);

    BlockUI.show('Uploading\u2026');
    try {
        var response = await fetch('/Attachment/AxPostUpload', {
            method: 'POST',
            headers: { 'RequestVerificationToken': attachTokenValue() },
            body: formData
        });
        var result = await response.json();
        BlockUI.hide();
        if (result.success) {
            // Refresh the modal body so the new file appears; the paperclip count in the table
            // updates on the next page load.
            renderAttachmentModal(entityId);
        } else {
            Swal.fire({ icon: 'error', title: 'Upload failed', text: result.message || 'Could not upload the file.', confirmButtonColor: '#0D5EA6' });
        }
    } catch (e) {
        BlockUI.hide();
        Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred while uploading.', confirmButtonColor: '#0D5EA6' });
    }
}

function deleteAttachmentFromModal(attachmentId, entityId) {
    Swal.fire({
        title: 'Delete file?',
        text: 'This will remove the attachment from this purchase.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, delete',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#C24A4A'
    }).then(async function (r) {
        if (!r.isConfirmed) return;
        BlockUI.show('Deleting\u2026');
        try {
            var response = await fetch('/Attachment/AxPostDelete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': attachTokenValue() },
                body: 'id=' + encodeURIComponent(attachmentId)
            });
            var result = await response.json();
            BlockUI.hide();
            if (result.success) {
                renderAttachmentModal(entityId);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Could not delete the file.', confirmButtonColor: '#0D5EA6' });
            }
        } catch (e) {
            BlockUI.hide();
            Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#0D5EA6' });
        }
    });
}

function setQuickPeriod(preset) {
    var now = new Date();
    var from, to;
    switch (preset) {
        case 'this_month': from = new Date(now.getFullYear(), now.getMonth(), 1); to = now; break;
        case 'last_month': from = new Date(now.getFullYear(), now.getMonth() - 1, 1); to = new Date(now.getFullYear(), now.getMonth(), 0); break;
        case 'last_3': from = new Date(now.getFullYear(), now.getMonth() - 3, 1); to = now; break;
        case 'last_6': from = new Date(now.getFullYear(), now.getMonth() - 6, 1); to = now; break;
        case 'this_year': from = new Date(now.getFullYear(), 0, 1); to = now; break;
        case 'last_year': from = new Date(now.getFullYear() - 1, 0, 1); to = new Date(now.getFullYear() - 1, 11, 31); break;
        case 'all': from = null; to = null; break;
    }
    document.getElementById('dateFrom').value = from ? formatDateISO(from) : '';
    document.getElementById('dateTo').value = to ? formatDateISO(to) : '';
    document.querySelectorAll('.period-shortcut').forEach(function(b) { b.classList.remove('active'); });
    event.target.classList.add('active');
    document.getElementById('filterForm').submit();
}

function formatDateISO(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}
</script>
<script>
(function() {
    // =========================================================================
    // Client-side Pagination
    // =========================================================================
    var table = document.getElementById('purchaseTable');
    if (!table) return;

    var tbody = document.getElementById('purchaseTableBody');
    var rows = Array.from(tbody.querySelectorAll('tr'));
    var pageSize = 20;
    var currentPage = 1;
    var totalRows = rows.length;
    var totalPages = Math.ceil(totalRows / pageSize);

    function renderPage(page) {
        currentPage = page;
        var start = (page - 1) * pageSize;
        var end = start + pageSize;

        rows.forEach(function(row, index) {
            row.style.display = (index >= start && index < end) ? '' : 'none';
        });

        renderPaginationInfo(start, end);
        renderPaginationControls();
    }

    function renderPaginationInfo(start, end) {
        var info = document.getElementById('paginationInfo');
        if (!info) return;
        var showing = Math.min(end, totalRows);
        info.textContent = 'Showing ' + (start + 1) + '-' + showing + ' of ' + totalRows + ' purchases';
    }

    function renderPaginationControls() {
        var container = document.getElementById('paginationControls');
        if (!container) return;
        container.innerHTML = '';

        if (totalPages <= 1) return;

        // Previous button
        var prevBtn = document.createElement('button');
        prevBtn.className = 'pagination-btn';
        prevBtn.textContent = 'Previous';
        prevBtn.disabled = currentPage === 1;
        prevBtn.addEventListener('click', function() { renderPage(currentPage - 1); });
        container.appendChild(prevBtn);

        // Page number buttons
        var startPage = Math.max(1, currentPage - 2);
        var endPage = Math.min(totalPages, currentPage + 2);

        if (startPage > 1) {
            container.appendChild(createPageBtn(1));
            if (startPage > 2) {
                var ellipsis = document.createElement('span');
                ellipsis.textContent = '...';
                ellipsis.style.padding = '0 6px';
                ellipsis.style.color = '#5a6a7a';
                container.appendChild(ellipsis);
            }
        }

        for (var i = startPage; i <= endPage; i++) {
            container.appendChild(createPageBtn(i));
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                var ellipsis2 = document.createElement('span');
                ellipsis2.textContent = '...';
                ellipsis2.style.padding = '0 6px';
                ellipsis2.style.color = '#5a6a7a';
                container.appendChild(ellipsis2);
            }
            container.appendChild(createPageBtn(totalPages));
        }

        // Next button
        var nextBtn = document.createElement('button');
        nextBtn.className = 'pagination-btn';
        nextBtn.textContent = 'Next';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.addEventListener('click', function() { renderPage(currentPage + 1); });
        container.appendChild(nextBtn);
    }

    function createPageBtn(page) {
        var btn = document.createElement('button');
        btn.className = 'pagination-btn' + (page === currentPage ? ' active' : '');
        btn.textContent = page;
        btn.addEventListener('click', function() { renderPage(page); });
        return btn;
    }

    // Initialize pagination
    renderPage(1);

    // =========================================================================
    // Cancel Purchase — Two-step SweetAlert2 confirmation
    // =========================================================================
    function getAntiForgeryToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-cancel-purchase');
        if (!btn) return;

        var purchaseId = btn.getAttribute('data-id');

        // Step 1: Initial confirmation
        Swal.fire({
            title: 'Are you sure you want to cancel this purchase?',
            text: 'This will mark the purchase as cancelled.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#C24A4A',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, proceed',
            cancelButtonText: 'No, keep it'
        }).then(function(result) {
            if (!result.isConfirmed) return;

            // Step 2: Type CANCEL to confirm
            Swal.fire({
                title: 'This action cannot be undone.',
                text: 'Type CANCEL to confirm.',
                icon: 'warning',
                input: 'text',
                inputPlaceholder: 'Type CANCEL here',
                showCancelButton: true,
                confirmButtonColor: '#C24A4A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Confirm Cancellation',
                cancelButtonText: 'Go back',
                inputValidator: function(value) {
                    if (value !== 'CANCEL') {
                        return 'You must type CANCEL to proceed.';
                    }
                }
            }).then(function(result2) {
                if (!result2.isConfirmed) return;

                // Execute cancellation
                BlockUI.show('Cancelling purchase...');

                fetch('/Purchase/Cancel', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: 'id=' + encodeURIComponent(purchaseId)
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    BlockUI.hide();
                    if (data.success) {
                        Swal.fire({
                            title: 'Cancelled',
                            text: data.message,
                            icon: 'success',
                            confirmButtonColor: '#0D5EA6'
                        }).then(function() {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: data.message,
                            icon: 'error',
                            confirmButtonColor: '#0D5EA6'
                        });
                    }
                })
                .catch(function() {
                    BlockUI.hide();
                    Swal.fire({
                        title: 'Error',
                        text: 'An unexpected error occurred.',
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                });
            });
        });
    });

    // Mark a purchase paid / unpaid.
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-set-paid');
        if (!btn) return;

        var purchaseId = btn.getAttribute('data-id');
        var setPaid = btn.getAttribute('data-paid') === 'true';

        Swal.fire({
            title: setPaid ? 'Mark this purchase as paid?' : 'Mark this purchase as unpaid?',
            text: setPaid
                ? 'It will stop appearing in your upcoming supplier payments.'
                : 'It will reappear in your upcoming supplier payments if still due.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0D5EA6',
            cancelButtonColor: '#6c757d',
            confirmButtonText: setPaid ? 'Yes, mark paid' : 'Yes, mark unpaid',
            cancelButtonText: 'Cancel'
        }).then(function(result) {
            if (!result.isConfirmed) return;

            BlockUI.show(setPaid ? 'Marking as paid...' : 'Marking as unpaid...');

            fetch('/Purchase/AxPostSetPaidState', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: 'id=' + encodeURIComponent(purchaseId) + '&isPaid=' + (setPaid ? 'true' : 'false')
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                BlockUI.hide();
                if (data.success) {
                    Swal.fire({
                        title: 'Done',
                        text: data.message,
                        icon: 'success',
                        confirmButtonColor: '#0D5EA6'
                    }).then(function() {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message,
                        icon: 'error',
                        confirmButtonColor: '#0D5EA6'
                    });
                }
            })
            .catch(function() {
                BlockUI.hide();
                Swal.fire({
                    title: 'Error',
                    text: 'An unexpected error occurred.',
                    icon: 'error',
                    confirmButtonColor: '#0D5EA6'
                });
            });
        });
    });
})();
</script>
